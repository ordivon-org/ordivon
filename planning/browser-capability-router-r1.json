      "mustNotOwn": [
        "browser effects",
        "provider authorization",
        "Runtime execution truth",
        "semantic success inference"
      ]
    }
  ],
  "edges": [
    {"from": "BCR01", "to": "BCR04", "type": "DATA"},
    {"from": "BCR02", "to": "BCR04", "type": "POLICY"},
    {"from": "BCR03", "to": "BCR04", "type": "READINESS"},
