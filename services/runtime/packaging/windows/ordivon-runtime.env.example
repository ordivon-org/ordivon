# Native Windows Runtime service configuration.
# This file is read only when the binary is started with --env-file.
# Keep bearer material in the separate ACL-protected token file; inline secrets are rejected.
RUST_LOG=ordivon_runtime_mcp=info,rmcp=warn
ORDIVON_BIND=127.0.0.1:8897
ORDIVON_BEARER_TOKEN_FILE=C:\ProgramData\Ordivon\Runtime\secrets\runtime-mcp.token
ORDIVON_TRUST_CF_ACCESS=false
ORDIVON_STORE_ROOT=C:\ProgramData\Ordivon\Runtime\store
ORDIVON_REGISTRY_ROOT=C:\ProgramData\Ordivon\Runtime\registry
ORDIVON_WINDOWS_LAUNCHER_PATH=C:\ProgramData\Ordivon\Runtime\bin\ordivon-windows-job-launcher.exe
ORDIVON_ALLOWED_EXECUTABLE_ROOTS=C:\Windows;C:\Program Files;C:\ProgramData\Ordivon\Runtime
ORDIVON_NODE_ID=windows-main
ORDIVON_PRINCIPAL=principal:windows-main
ORDIVON_PRINCIPAL_MODE=static
ORDIVON_EXEC_HOME=C:\ProgramData\Ordivon\Runtime\service-home
ORDIVON_EXEC_PATH=C:\Windows\System32;C:\Windows;C:\ProgramData\Ordivon\Runtime\bin
ORDIVON_GLOBAL_MAX_CONCURRENCY=12
ORDIVON_BODY_LIMIT_BYTES=1048576
ORDIVON_DEFAULT_RUNTIME_MS=3600000
ORDIVON_MAX_RUNTIME_MS=86400000
ORDIVON_MAX_OUTPUT_BYTES=16777216
ORDIVON_BUSY_TIMEOUT_MS=5000
ORDIVON_STARTUP_GRACE_MS=2000
ORDIVON_RECONCILE_INTERVAL_MS=15000
ORDIVON_RECONCILE_BATCH_SIZE=32
ORDIVON_TRACE_PATH=C:\ProgramData\Ordivon\Runtime\registry\runtime-trace.jsonl

# Optional native-Windows opaque credential materialization control plane.
# The bindings JSON exposes logical names and principal allowlists only; secret paths and
# endpoint paths live in the separate operator-only broker configuration file.
# ORDIVON_CREDENTIAL_MATERIALIZATION_BINDINGS_JSON=[{"name":"gateway.windows.runtime","allowedPrincipals":["principal:windows-main"]}]
# ORDIVON_WINDOWS_CREDENTIAL_MATERIALIZATION_CONFIG=C:\ProgramData\Ordivon\Runtime\config\credential-materialization.json
# Activate a dedicated Gateway remote bearer only after credential.materialize has committed
# both owner-local endpoint files. Do not reuse ORDIVON_BEARER_TOKEN_FILE.
# ORDIVON_REMOTE_BEARER_TOKEN_FILE=C:\ProgramData\Ordivon\Runtime\secrets\gateway-windows-runtime.remote.token
# ORDIVON_REMOTE_PRINCIPAL=principal:gateway-windows-runtime
# ORDIVON_PRINCIPAL_MODE=factorized
