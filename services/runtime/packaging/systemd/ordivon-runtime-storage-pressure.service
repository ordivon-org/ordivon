[Unit]
Description=Ordivon Runtime host-storage pressure feedback controller
After=ordivon-runtime.service
Requires=ordivon-runtime.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
SuccessExitStatus=2
ExecStart=/usr/local/libexec/ordivon/ordivon-runtime-pressure-control cycle --database /var/lib/ordivon/registry/registry.sqlite3 --registry-root /var/lib/ordivon/registry --runtime-store-root /var/lib/ordivon/runtime --env-file /etc/ordivon/ordivon-runtime.env --policy-file /etc/ordivon/storage-pressure-control.json --state-file /var/lib/ordivon/runtime/storage-pressure-control/state.json --receipt-root /var/lib/ordivon/runtime/storage-pressure-control/receipts --lock-file /run/ordivon-runtime-storage-pressure-control.lock --reclaim-lock-file /run/ordivon-runtime-storage-pressure-reclaim.lock --cache-lock-file /run/ordivon-runtime-storage-pressure-cache.lock
