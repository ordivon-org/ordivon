[Unit]
Description=Ordivon PG Runtime native Workspace lifecycle retention
After=ordivon-runtime.service postgresql.service
Requires=ordivon-runtime.service postgresql.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/ordivon/runtime-pg-operator/.venv/bin/python -B /usr/local/libexec/ordivon/ordivon-runtime-pg-reclaim --apply --env-file /etc/ordivon/ordivon-runtime-pg-only.env --installed-runtime-environment --source-repo /root/projects/ordivon --workspace-root /var/lib/ordivon/pg-candidate/workspaces --receipt-root /var/lib/ordivon/pg-candidate/lifecycle-receipts --lock-file /run/ordivon-runtime-pg-reclaim.lock --policy-file /etc/ordivon/workspace-retention.json --min-age-hours 4 --limit 25
ExecStart=/opt/ordivon/runtime-pg-operator/.venv/bin/python -B /usr/local/libexec/ordivon/ordivon-runtime-pg-reclaim --apply --env-file /etc/ordivon/ordivon-runtime-pg-only.env --installed-runtime-environment --source-repo /root/projects/ordivon-research-v2 --integration-ref refs/heads/main --workspace-root /var/lib/ordivon/pg-candidate/workspaces --receipt-root /var/lib/ordivon/pg-candidate/lifecycle-receipts --lock-file /run/ordivon-runtime-pg-reclaim.lock --policy-file /etc/ordivon/workspace-retention.json --min-age-hours 4 --limit 25
ExecStart=/opt/ordivon/runtime-pg-operator/.venv/bin/python -B /usr/local/libexec/ordivon/ordivon-runtime-pg-reclaim --apply --env-file /etc/ordivon/ordivon-runtime-pg-only.env --installed-runtime-environment --source-repo /root/projects/ordivon-paper2 --integration-ref refs/heads/main --workspace-root /var/lib/ordivon/pg-candidate/workspaces --receipt-root /var/lib/ordivon/pg-candidate/lifecycle-receipts --lock-file /run/ordivon-runtime-pg-reclaim.lock --policy-file /etc/ordivon/workspace-retention.json --min-age-hours 4 --limit 25
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
