from collections.abc import Callable
from pathlib import Path

from mcp_probe import load_bearer_token, load_environment_file, probe_catalog

SCHEMA_VERSION = 2
LEGACY_SCHEMA_VERSION = 1
DEFAULT_BINARIES = (
    "ordivon-runtime",
    "ordivon-runtime-runner",
    "ordivon-runtime-doctor",
    "ordivon-runtime-inspect",
    "ordivon-runtime-repair",
)
DEFAULT_OPERATOR_ARTIFACTS = (
    ("ordivon-runtime-deploy", "scripts/ordivon-runtime-deploy", 0o755, "operator"),
    ("ordivon-runtime-lifecycle", "scripts/ordivon-runtime-lifecycle", 0o755, "operator"),
    ("ordivon-runtime-reclaim", "scripts/ordivon-runtime-reclaim", 0o755, "operator"),
    ("ordivon-runtime-pg-reclaim", "scripts/ordivon-runtime-pg-reclaim", 0o755, "operator"),
    ("ordivon-runtime-cache", "scripts/ordivon-runtime-cache", 0o755, "operator"),
    ("ordivon-runtime-status", "scripts/ordivon-runtime-status", 0o755, "operator"),
    (
        "ordivon-runtime-pressure-control",
        "scripts/ordivon-runtime-pressure-control",
        0o755,
        "operator",
    ),
    (
        "ordivon-runtime-capacity-acceptance",
        "scripts/ordivon-runtime-capacity-acceptance",
        0o755,
        "operator",
    ),
    ("mcp_probe.py", "scripts/mcp_probe.py", 0o644, "support"),
)
# The independent Root control plane is a different installation authority
# from the Server/Runner/Reclaimer payloads. Plan only: never self-promote.
ROOT_OPERATOR_BUNDLE = (
    ("ordivon-runtime-deploy", 0o755),
    ("ordivon-runtime-pg-operator", 0o755),
    ("ordivon-runtime-pg-release-dispatch", 0o755),
    ("ordivon_runtime_pg_operator.py", 0o644),
    ("mcp_probe.py", 0o644),
)

DEFAULT_REQUIRED_TOOLS = (
    "release.apply",
    "release.get",
    "runtime.describe",
    "workspace.content",
    "workspace.execBoundTrusted",
    "workspace.execPlan",
    "workspace.get",
    "workspace.list",
)
COMMIT_PATTERN = re.compile(r"^[0-9a-f]{40}$")
SHA256_PATTERN = re.compile(r"^sha256:[0-9a-f]{64}$")
RELEASE_EFFECT_ID_PATTERN = re.compile(r"^[0-9a-f]{64}$")
RELEASE_REQUEST_DIGEST_PATTERN = re.compile(r"^runtime-release-v1:sha256:[0-9a-f]{64}$")
ATTEMPT_UNIT_PATTERN = re.compile(r"/ordivon-(attempt-[^.\s/]+)\.service(?:$|/)")
DEFAULT_READINESS_WAIT_SECONDS = 60.0
MCP_READINESS_PROBE_SLICE_SECONDS = 2.0
RUNTIME_POLICY_SCHEMA_VERSION = 1
RUNTIME_POLICY_SOURCE = Path("packaging/systemd/ordivon-runtime.env.example")
RUNTIME_POLICY_ENV_KEYS = (
    ("ORDIVON_DEFAULT_RUNTIME_MS", "defaultRuntimeMs"),
    ("ORDIVON_MAX_RUNTIME_MS", "maxRuntimeMs"),
    ("ORDIVON_GLOBAL_MAX_CONCURRENCY", "globalMaxConcurrency"),
)
RUNTIME_POLICY_LEGACY_OPTIONAL_FIELDS = frozenset({"globalMaxConcurrency"})
RELEASE_AUTHORITY_SCHEMA_VERSION = 1
RELEASE_AUTHORITY_ENV_KEYS = (
    ("ORDIVON_RELEASE_SOURCE_REPO", "sourceRepo"),
    ("ORDIVON_RELEASE_REQUIRED_REF", "requiredRef"),
)
STRUCTURED_RELEASE_DRAIN_TIMEOUT_ENV = "ORDIVON_RELEASE_DRAIN_TIMEOUT_MS"



def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="ordivon-runtime-deploy")
    subparsers = parser.add_subparsers(dest="command", required=True)

    root_plan = subparsers.add_parser(
        "root-bundle-plan",
        help="read-only SourceCut and installed Root operator bundle comparison",
    )
    root_plan.add_argument("--source-repo", type=absolute_path, required=True)
    root_plan.add_argument("--commit", type=exact_commit, required=True)
    root_plan.add_argument("--require-ref", default="origin/main")
    root_plan.add_argument("--expected-owner-tree", required=True)
    root_plan.add_argument("--install-dir", type=absolute_path, required=True)
    root_plan.add_argument("--git", type=absolute_path, default=Path("/usr/bin/git"))
    root_plan.add_argument("--pretty", action="store_true")

    root_stage = subparsers.add_parser(
        "root-bundle-stage",
        help="stage exact Git Root controller bytes into a new isolated candidate; never install",
    )
    root_stage.add_argument("--source-repo", type=absolute_path, required=True)
    root_stage.add_argument("--commit", type=exact_commit, required=True)
    root_stage.add_argument("--require-ref", default="origin/main")
    root_stage.add_argument("--expected-owner-tree", required=True)
    root_stage.add_argument("--install-dir", type=absolute_path, required=True)
    root_stage.add_argument("--candidate-dir", type=absolute_path, required=True)
    root_stage.add_argument("--git", type=absolute_path, default=Path("/usr/bin/git"))
    root_stage.add_argument("--pretty", action="store_true")

    inspect_retention = subparsers.add_parser(
        "candidate-retention-inspect",
        help="project bounded release retirement obligations without authorizing deletion",
    )
    inspect_retention.add_argument("--candidate-dir", type=absolute_path, required=True)
    inspect_retention.add_argument("--commit", type=exact_commit, required=True)
    inspect_retention.add_argument("--receipt-root", type=absolute_path, required=True)
    inspect_retention.add_argument("--limit", type=int, default=25)
    inspect_retention.add_argument("--after", default=None)

    prepare = subparsers.add_parser(
        "prepare", help="build one exact clean commit and write a digest-bound candidate manifest"
    )
    prepare.add_argument("--source-repo", type=absolute_path, required=True)
    prepare.add_argument("--commit", type=exact_commit, required=True)
    prepare.add_argument("--candidate-dir", type=absolute_path, required=True)
    prepare.add_argument("--candidate-manifest", type=absolute_path, required=True)
    prepare.add_argument("--cargo", type=absolute_path, required=True)
    prepare.add_argument("--binary", action="append", dest="binaries")
    prepare.add_argument("--include-pg-reclaimer", action="store_true")
    prepare.add_argument("--pretty", action="store_true")

    plan = subparsers.add_parser("plan", help="validate a candidate deployment without mutation")
    add_deployment_arguments(plan, require_confirmation=False)
    plan.add_argument("--pretty", action="store_true")

    apply = subparsers.add_parser("apply", help="atomically drain admission, install, restart, probe, and receipt")
    add_deployment_arguments(apply, require_confirmation=True)
    apply.add_argument("--drain-seconds", type=positive_float, default=30.0)
    apply.add_argument("--effect-id", type=exact_release_effect_id)
    apply.add_argument("--effect-request-digest", type=exact_release_request_digest)
    apply.add_argument("--candidate-manifest-digest", type=exact_sha256_digest)

    rollback = subparsers.add_parser(
        "rollback", help="restore release artifacts retained by one deployment receipt"
    )
    rollback.add_argument("--receipt", type=absolute_path, required=True)
    rollback.add_argument("--install-dir", type=absolute_path, required=True)
    rollback.add_argument("--service", default="ordivon-runtime.service")
    rollback.add_argument("--env-file", type=absolute_path, required=True)
    rollback.add_argument("--database", type=absolute_path)
    rollback.add_argument("--systemctl", type=absolute_path, default=Path("/usr/bin/systemctl"))
    rollback.add_argument("--lock-file", type=absolute_path, default=Path("/run/ordivon-runtime-deploy.lock"))
    rollback.add_argument(
        "--wait-seconds", type=positive_float, default=DEFAULT_READINESS_WAIT_SECONDS
    )
    rollback.add_argument("--drain-seconds", type=positive_float, default=30.0)
    rollback.add_argument("--confirm-receipt", type=absolute_path, required=True)
    return parser.parse_args()


def add_deployment_arguments(parser: argparse.ArgumentParser, *, require_confirmation: bool) -> None:
    parser.add_argument("--source-repo", type=absolute_path, required=True)
    parser.add_argument("--commit", type=exact_commit, required=True)
    parser.add_argument("--candidate-dir", type=absolute_path, required=True)
    parser.add_argument("--candidate-manifest", type=absolute_path, required=True)
    parser.add_argument("--install-dir", type=absolute_path, required=True)
    parser.add_argument("--database", type=absolute_path, required=True)
    parser.add_argument("--env-file", type=absolute_path, required=True)
    parser.add_argument("--receipt-root", type=absolute_path, required=True)
    parser.add_argument("--service", default="ordivon-runtime.service")
    parser.add_argument("--systemctl", type=absolute_path, default=Path("/usr/bin/systemctl"))
    parser.add_argument("--git", type=absolute_path, default=Path("/usr/bin/git"))
    parser.add_argument("--lock-file", type=absolute_path, default=Path("/run/ordivon-runtime-deploy.lock"))
    parser.add_argument("--binary", action="append", dest="binaries")
    parser.add_argument("--include-pg-reclaimer", action="store_true")
    parser.add_argument("--required-tool", action="append", dest="required_tools")
    parser.add_argument("--expected-tool-count", type=nonnegative_int)
    parser.add_argument("--require-ref", default="origin/main")
    parser.add_argument(
        "--wait-seconds", type=positive_float, default=DEFAULT_READINESS_WAIT_SECONDS
    )
    if require_confirmation:
        parser.add_argument("--confirm-commit", type=exact_commit, required=True)


def absolute_path(value: str) -> Path:
    path = Path(value)
    if not path.is_absolute():
        raise argparse.ArgumentTypeError("path must be absolute")
    return path


def exact_commit(value: str) -> str:
    if not COMMIT_PATTERN.fullmatch(value):
        raise argparse.ArgumentTypeError("commit must be exactly 40 lowercase hexadecimal characters")
    return value


def exact_sha256_digest(value: str) -> str:
    if not SHA256_PATTERN.fullmatch(value):
        raise argparse.ArgumentTypeError("digest must be sha256 followed by 64 lowercase hexadecimal characters")
    return value


def exact_release_effect_id(value: str) -> str:
    if not RELEASE_EFFECT_ID_PATTERN.fullmatch(value):
        raise argparse.ArgumentTypeError("effect-id must be exactly 64 lowercase hexadecimal characters")
    return value


def exact_release_request_digest(value: str) -> str:
    if not RELEASE_REQUEST_DIGEST_PATTERN.fullmatch(value):
        raise argparse.ArgumentTypeError(
            "effect-request-digest must be runtime-release-v1:sha256:<64 lowercase hex>"
        )
    return value


def positive_float(value: str) -> float:
    parsed = float(value)
    if not math.isfinite(parsed) or parsed <= 0:
        raise argparse.ArgumentTypeError("value must be finite and positive")
    return parsed


def nonnegative_int(value: str) -> int:
    parsed = int(value)
    if parsed < 0:
        raise argparse.ArgumentTypeError("value must be nonnegative")
    return parsed


def binaries(args: argparse.Namespace) -> tuple[str, ...]:
    values = tuple(args.binaries or DEFAULT_BINARIES)
    if not values or len(values) != len(set(values)):
        raise RuntimeError("binary names must be nonempty and unique")
    for value in values:
        if value in {".", ".."} or "/" in value or chr(0) in value:
            raise RuntimeError(f"invalid binary name: {value}")
    return values


def release_operator_artifacts(
    args: argparse.Namespace,
) -> tuple[tuple[str, str, int, str], ...]:
    """Select only explicitly qualified support files for a native PG release.

    The two-binary PG build must not use the legacy --all-features build path,
    while its lifecycle consumer should not be an unreceipted sidecar.
    """
    if args.binaries is None:
        return DEFAULT_OPERATOR_ARTIFACTS
    if not getattr(args, "include_pg_reclaimer", False):
        return ()
    names = binaries(args)
    if len(names) != 2 or set(names) != {
        "ordivon-runtime-pg", "ordivon-runtime-runner",
    }:
        raise RuntimeError("PG Reclaimer release requires the full native PG binary pair")
    return tuple(
        item for item in DEFAULT_OPERATOR_ARTIFACTS
        if item[0] == "ordivon-runtime-pg-reclaim"
    )


def release_artifact_specs(args: argparse.Namespace) -> tuple[dict[str, object], ...]:
    specs: list[dict[str, object]] = [
        {"name": name, "kind": "binary", "mode": 0o755} for name in binaries(args)
    ]
    specs.extend(
        {"name": name, "source": source, "mode": mode, "kind": kind}
        for name, source, mode, kind in release_operator_artifacts(args)
    )
    names = [str(spec["name"]) for spec in specs]
    if len(names) != len(set(names)):
        raise RuntimeError("release artifact names must be unique")
    return tuple(specs)


def stage_operator_artifacts(args: argparse.Namespace, source_root: Path) -> None:
    for name, relative_source, mode, _kind in release_operator_artifacts(args):
        source = source_root / relative_source
        if source.is_symlink() or not source.is_file():
            raise RuntimeError(f"release operator artifact is missing or unsafe: {source}")
        atomic_copy(source, args.candidate_dir / name, mode=mode)

def required_tools(args: argparse.Namespace) -> tuple[str, ...]:
    values = tuple(args.required_tools or DEFAULT_REQUIRED_TOOLS)
    if len(values) != len(set(values)) or any(not value.strip() for value in values):
        raise RuntimeError("required tool names must be nonempty and unique")
    return values


def run(
    command: list[str],
    *,
    check: bool = True,
    cwd: Path | None = None,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        command, text=True, capture_output=True, check=False, cwd=cwd, env=env
    )
    if check and result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
        raise RuntimeError(f"command failed ({' '.join(command)}): {detail}")
    return result


def git_text(git: Path, repo: Path, arguments: list[str]) -> str:
    return run([str(git), "-C", str(repo), *arguments]).stdout.strip()


def release_source_layout(git: Path, source_repo: Path) -> tuple[Path, Path]:
    owner_root = source_repo.resolve(strict=True)
    git_root = Path(git_text(git, owner_root, ["rev-parse", "--show-toplevel"])).resolve(strict=True)
    prefix_text = git_text(git, owner_root, ["rev-parse", "--show-prefix"]).rstrip("/")
    owner_prefix = Path(prefix_text) if prefix_text else Path()
    expected_owner = (git_root / owner_prefix).resolve(strict=True)
    if expected_owner != owner_root:
        raise RuntimeError(
            f"release source owner {owner_root} does not match Git prefix {owner_prefix}"
        )
    return git_root, owner_prefix


def owner_revision(git: Path, source_repo: Path, revision: str) -> str:
    exact = git_text(git, source_repo, ["rev-parse", "--verify", f"{revision}^{{commit}}"])
    if not COMMIT_PATTERN.fullmatch(exact):
        raise RuntimeError("release source revision is not one exact Git commit")
    _git_root, owner_prefix = release_source_layout(git, source_repo)
    if owner_prefix == Path():
        return exact
    owner = git_text(git, source_repo, ["log", "-1", "--format=%H", exact, "--", "."])
    if not COMMIT_PATTERN.fullmatch(owner):
        raise RuntimeError("release source revision has no commit for the configured owner")
    return owner


def committed_source_path(git: Path, source_repo: Path, relative: Path) -> str:
    _git_root, owner_prefix = release_source_layout(git, source_repo)
    path = owner_prefix / relative
    return relative.as_posix() if owner_prefix == Path() else path.as_posix()


def required_ref_authority(
    git: Path,
    source_repo: Path,
    commit: str,
    required_ref: str,
) -> dict[str, object]:
    git_root, owner_prefix = release_source_layout(git, source_repo)
    required_ref_commit = git_text(
        git, source_repo, ["rev-parse", "--verify", f"{required_ref}^{{commit}}"]
    )
    if owner_prefix == Path():
        return {
            "mode": "exact_commit",
            "ownerRelativePath": "",
            "requiredRefCommit": required_ref_commit,
            "candidateIsAncestor": required_ref_commit == commit,
            "candidateOwnerTree": None,
            "requiredRefOwnerTree": None,
            "authorized": required_ref_commit == commit,
        }

    ancestor = run(
        [
            str(git),
            "-C",
            str(git_root),
            "merge-base",
            "--is-ancestor",
            commit,
            required_ref_commit,
        ],
        check=False,
    )
    if ancestor.returncode not in (0, 1):
        detail = ancestor.stderr.strip() or ancestor.stdout.strip() or f"exit {ancestor.returncode}"
        raise RuntimeError(
            f"cannot determine whether candidate Commit is an ancestor of required ref: {detail}"
        )
    owner_path = owner_prefix.as_posix()
    candidate_owner_tree = git_text(
        git,
        git_root,
        ["rev-parse", f"{commit}:{owner_path}"],
    )
    required_ref_owner_tree = git_text(
        git,
        git_root,
        ["rev-parse", f"{required_ref_commit}:{owner_path}"],
    )
    candidate_is_ancestor = ancestor.returncode == 0
    return {
        "mode": "owner_tree",
        "ownerRelativePath": owner_path,
        "requiredRefCommit": required_ref_commit,
        "candidateIsAncestor": candidate_is_ancestor,
        "candidateOwnerTree": candidate_owner_tree,
        "requiredRefOwnerTree": required_ref_owner_tree,
        "authorized": candidate_is_ancestor and candidate_owner_tree == required_ref_owner_tree,
    }


def root_operator_bundle_plan(args: argparse.Namespace) -> dict[str, object]:
    """Read-only Root controller qualification; not an installer or approval."""
    git = args.git
    repo = args.source_repo
    commit = args.commit
    root = args.install_dir
    expected_tree = args.expected_owner_tree
    if not COMMIT_PATTERN.fullmatch(expected_tree):
        raise RuntimeError("expected Root owner tree must be one exact Git tree OID")
    if not root.is_absolute() or ".." in root.parts or root.is_symlink():
        raise RuntimeError("Root bundle install path must be absolute without aliases")
    if not root.is_dir() or not root.resolve(strict=True) == root:
        raise RuntimeError("Root bundle install path is absent or resolves through a symlink")
    directory_metadata = root.stat()
    if directory_metadata.st_uid != 0 or directory_metadata.st_mode & 0o022:
        raise RuntimeError("Root bundle directory is not root-owned and nonwritable by others")
    resolved = git_text(git, repo, ["rev-parse", "--verify", f"{commit}^{{commit}}"])
    if resolved != commit:
        raise RuntimeError("Root bundle Commit is not an exact Git commit")
    authority = required_ref_authority(git, repo, commit, args.require_ref)
    git_root, owner_prefix = release_source_layout(git, repo)
    owner_tree = git_text(git, git_root, ["rev-parse", f"{commit}:{owner_prefix.as_posix()}"])
    if not COMMIT_PATTERN.fullmatch(owner_tree):
        raise RuntimeError("Root bundle owner tree is not a Git object ID")
    bundle: list[dict[str, object]] = []
    for name, mode in ROOT_OPERATOR_BUNDLE:
        relative = committed_source_path(git, repo, Path("scripts") / name)
        ls_tree = git_text(git, git_root, ["ls-tree", commit, "--", relative])
        record = ls_tree.split("\t", 1)
        if len(record) != 2 or record[1] != relative:
            raise RuntimeError(f"Root bundle Git source missing: {name}")
        git_mode, kind, blob_oid = record[0].split()
        if kind != "blob" or git_mode != ("100755" if mode == 0o755 else "100644") or not COMMIT_PATTERN.fullmatch(blob_oid):
            raise RuntimeError(f"Root bundle Git file is not a regular expected-mode blob: {name}")
        contents = subprocess.run(
            [str(git), "-C", str(git_root), "cat-file", "blob", blob_oid],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        ).stdout
        source_hash = "sha256:" + hashlib.sha256(contents).hexdigest()
        target = root / name
        installed_hash: str | None = None
        installed_mode: int | None = None
        installed_uid: int | None = None
        status = "missing"
        if target.exists() or target.is_symlink():
            if target.is_symlink() or not target.is_file():
                status = "unsafe"
            else:
                metadata = target.stat()
                installed_mode = stat.S_IMODE(metadata.st_mode)
                installed_uid = metadata.st_uid
                if installed_uid != 0 or installed_mode != mode or metadata.st_nlink != 1:
                    status = "unsafe"
                else:
                    installed_hash = sha256(target)
                    status = "current" if source_hash == installed_hash else "drift"
        bundle.append({
            "name": name,
            "sourcePath": relative,
            "sourceBlobOid": blob_oid,
            "sourceSha256": source_hash,
            "installedSha256": installed_hash,
            "installedMode": installed_mode,
            "installedUid": installed_uid,
            "expectedMode": mode,
            "currentness": status,
        })
    authorized = bool(authority["authorized"]) and owner_tree == expected_tree
    return {
        "schemaVersion": 1,
        "kind": "ordivon.runtime-root-bundle-readonly-plan",
        "truthBoundary": "source Git objects and local root files; no bootstrap, root authority, or release executed",
        "commit": commit,
        "sourceOwnerTree": owner_tree,
        "expectedOwnerTree": expected_tree,
        "requiredRefAuthority": authority,
        "installDir": str(root),
        "bundle": bundle,
        "currentCount": sum(x["currentness"] == "current" for x in bundle),
        "drifted": [x["name"] for x in bundle if x["currentness"] == "drift"],
        "missing": [x["name"] for x in bundle if x["currentness"] == "missing"],
        "unsafe": [x["name"] for x in bundle if x["currentness"] == "unsafe"],
        "sourceAuthorized": authorized,
        "eligibleForRootOwnerReview": authorized and all(x["currentness"] != "unsafe" for x in bundle),
        "productionInstallExecuted": False,
    }


def stage_root_operator_bundle(args: argparse.Namespace) -> dict[str, object]:
    """Materialize only a disposable Git-qualified candidate; NEVER install Root.

    The staging directory is controlled by the calling Agent, not the Root
    operator. It is not an installation authority and not a trusted rollback
    preimage. The eventual Root owner must requalify each Git blob and actual
    Root bytes under its own credential before any physical systemd/PG effect.
    """
    candidate_dir = args.candidate_dir
    root = args.install_dir
    if (
        not candidate_dir.is_absolute()
        or ".." in candidate_dir.parts
        or candidate_dir == root
        or root in candidate_dir.parents
        or candidate_dir in root.parents
    ):
        raise RuntimeError("Root bundle candidate must be separate from its live installation")
    if candidate_dir.exists() or candidate_dir.is_symlink():
        raise RuntimeError("Root bundle candidate directory already exists")
    parent = candidate_dir.parent
    if not parent.is_dir() or parent.is_symlink() or parent.resolve(strict=True) != parent:
        raise RuntimeError("Root bundle candidate parent is missing or aliases a symlink")
    plan = root_operator_bundle_plan(args)
    if not plan["eligibleForRootOwnerReview"]:
        raise RuntimeError("Root bundle candidate source is not Git-qualified for operator review")
    git_root, _ = release_source_layout(args.git, args.source_repo)
    staged: list[dict[str, object]] = []
    candidate_dir.mkdir(mode=0o700, parents=False, exist_ok=False)
    try:
        for record in plan["bundle"]:
            name = str(record["name"])
            expected_mode = int(record["expectedMode"])
            payload = subprocess.run(
                [str(args.git), "-C", str(git_root), "cat-file", "blob", record["sourceBlobOid"]],
                check=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            ).stdout
            digest = "sha256:" + hashlib.sha256(payload).hexdigest()
            if digest != record["sourceSha256"]:
                raise RuntimeError("Git Root candidate blob drifted after qualification")
            target = candidate_dir / name
            with target.open("xb") as handle:
                handle.write(payload)
                handle.flush()
                os.fsync(handle.fileno())
            target.chmod(expected_mode)
            if sha256(target) != digest:
                raise RuntimeError("Root candidate stage bytes changed after write")
            staged.append({
                "name": name,
                "kind": "root_control",
                "mode": expected_mode,
                "digest": digest,
                "sourceBlobOid": record["sourceBlobOid"],
                "preimageDigestAtPlan": record["installedSha256"],
                "preimageStatusAtPlan": record["currentness"],
            })
        # A move of origin/main that changes the Runtime owner tree invalidates
        # a stage; no immutable candidate may silently inherit new authority.
        latest = required_ref_authority(
            args.git, args.source_repo, args.commit, args.require_ref,
        )
        if not latest["authorized"] or latest["requiredRefOwnerTree"] != plan["sourceOwnerTree"]:
            raise RuntimeError("required Git ref or Runtime owner tree changed during staging")
        manifest = {
            "schemaVersion": 1,
            "kind": "ordivon.runtime-root-bundle-staged-candidate",
            "commit": args.commit,
            "sourceOwnerTree": plan["sourceOwnerTree"],
            "requiredRef": args.require_ref,
            "installDir": str(root),
            "artifacts": staged,
            "productionInstallExecuted": False,
            "rootOwnerApprovalRequired": True,
            "trustedRollbackPreimageCaptured": False,
            "physicalServiceQuiesced": False,
            "releaseAdmissionFenced": False,
        }
        manifest_path = candidate_dir / "ordivon-root-bundle-candidate.json"
        write_json_atomic(manifest_path, manifest)
        if any(
            sha256(candidate_dir / item["name"]) != item["digest"]
            for item in staged
        ):
            raise RuntimeError("Root staged candidate cannot verify all artifact bytes")
        return {
            "schemaVersion": 1,
            "kind": manifest["kind"],
            "commit": args.commit,
            "sourceOwnerTree": plan["sourceOwnerTree"],
            "candidateDir": str(candidate_dir),
            "candidateManifest": str(manifest_path),
            "candidateManifestDigest": sha256(manifest_path),
            "artifactCount": len(staged),
            "rootOwnerApprovalRequired": True,
            "productionInstallExecuted": False,
        }
    except BaseException:
        # The caller created this directory exclusively in this invocation;
        # failed candidates must never remain next to a live Root installation.
        shutil.rmtree(candidate_dir)
        raise


@contextmanager
def _directory_descriptor(path: Path):
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        yield descriptor
    finally:
        os.close(descriptor)


def linux_exchange_sibling_root_bundle_directories(
    live: Path, staged: Path,
) -> None:
    """One Linux same-filesystem atomic directory exchange, NOT Root approval.

    The Root operator must first provide *its own* evidence of: a trusted
    exact Git candidate; existing live preimage; PG Release admission fully
    fenced; zero unresolved effects; dispatcher timer persistently disabled;
    dispatcher service inactive; a durable recovery journal and ownership
    lock. This internal physical primitive does none of those operations.
    It must never be published directly as a caller-invokable MCP effect.

    Linux renameat2(RENAME_EXCHANGE) is one namespace linearization point for
    TWO NONEMPTY sibling directories. Ordinary os.rename has no equivalent
    semantics, so unsupported platforms/filesystems fail closed.
    """
    if (
        not live.is_absolute()
        or not staged.is_absolute()
        or live == staged
        or live.parent != staged.parent
        or live.name in (".", "..")
        or staged.name in (".", "..")
        or "/" in live.name
        or "/" in staged.name
        or live.parent.is_symlink()
        or live.parent.resolve(strict=True) != live.parent
    ):
        raise RuntimeError("Root exchange requires two distinct direct sibling directories")
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    with _directory_descriptor(live.parent) as parent_fd:
        names = [live.name.encode(), staged.name.encode()]
        snapshots: list[os.stat_result] = []
        for name in names:
            descriptor = os.open(name, flags, dir_fd=parent_fd)
            try:
                item = os.fstat(descriptor)
                if not stat.S_ISDIR(item.st_mode):
                    raise RuntimeError("Root exchange target is not an actual directory")
                snapshots.append(item)
                os.fsync(descriptor)
            finally:
                os.close(descriptor)
        if (
            snapshots[0].st_dev != snapshots[1].st_dev
            or snapshots[0].st_ino == snapshots[1].st_ino
        ):
            raise RuntimeError("Root exchange requires two different directories on one device")
        linux_libc = ctypes.CDLL("libc.so.6", use_errno=True)
        syscall = getattr(linux_libc, "renameat2", None)
        if syscall is None:
            raise RuntimeError("Linux renameat2(RENAME_EXCHANGE) unavailable")
        syscall.argtypes = [
            ctypes.c_int, ctypes.c_char_p, ctypes.c_int,
            ctypes.c_char_p, ctypes.c_uint,
        ]
        syscall.restype = ctypes.c_int
        if syscall(parent_fd, names[0], parent_fd, names[1], 2) != 0:
            error_number = ctypes.get_errno()
            raise OSError(
                error_number, f"atomic Root directory exchange failed: {os.strerror(error_number)}",
            )
        # After renameat2 succeeds, ANY error is a post-effect ambiguity.
        # Even an fsync failure does not justify retrying blindly: a future
        # Root owner must classify both byte sets against its durable journal.
        try:
            os.fsync(parent_fd)
            new_live = os.stat(names[0], dir_fd=parent_fd, follow_symlinks=False)
            new_staged = os.stat(names[1], dir_fd=parent_fd, follow_symlinks=False)
            if (
                (new_live.st_dev, new_live.st_ino) !=
                (snapshots[1].st_dev, snapshots[1].st_ino)
                or (new_staged.st_dev, new_staged.st_ino) !=
                (snapshots[0].st_dev, snapshots[0].st_ino)
            ):
                raise RuntimeError("directory identities drifted during Root exchange")
        except (OSError, RuntimeError) as error:
            raise RuntimeError(
                "RECONCILIATION_REQUIRED: atomic Root exchange may already have "
                "committed; classify the journal and both directories"
            ) from error


def root_bundle_candidate_namespace_closed(path: Path) -> bool:
    """Allow only the five committed scripts and optional stage manifest.

    Extra Python modules, symlinks, backup executables or bytecode caches in
    the staged candidate are not independently Git-qualified and may affect
    the future import namespace. This is source-shape evidence only, not an
    authorization decision. Existing OLD Root contents are separately
    preserved as an unmodified preimage, not certified as clean.
    """
    names = {name for name, _ in ROOT_OPERATOR_BUNDLE}
    try:
        entries = {entry.name: entry for entry in path.iterdir()}
    except OSError:
        return False
    allowed = names | {"ordivon-root-bundle-candidate.json"}
    if set(entries) - allowed or not names.issubset(entries):
        return False
    optional = entries.get("ordivon-root-bundle-candidate.json")
    return optional is None or (not optional.is_symlink() and optional.is_file())


def root_bundle_exchange_readback(
    live: Path,
    staged: Path,
    *,
    old_artifacts: dict[str, str],
    candidate_artifacts: dict[str, str],
) -> str:
    """Classify a durable Root journal against two real directory byte sets.

    This is only physical namespace/byte evidence, never an installed service
    or PG release qualification. Unknown or partially damaged state stays
    UNKNOWN; the owner cannot automatically retry or resume the timer.
    """
    names = {name for name, _ in ROOT_OPERATOR_BUNDLE}
    if set(old_artifacts) != names or set(candidate_artifacts) != names:
        raise RuntimeError("Root journal lacks exactly the five qualified artifact names")
    if any(
        not SHA256_PATTERN.fullmatch(value)
        for value in [*old_artifacts.values(), *candidate_artifacts.values()]
    ):
        raise RuntimeError("Root journal contains an invalid artifact digest")
    # Identical version byte sets cannot establish whether an exchange
    # happened. The natural Root owner should treat this as a no-op rather
    # than granting an unobserved installation or rollback receipt.
    if old_artifacts == candidate_artifacts:
        return "UNKNOWN"
    actual: list[dict[str, str]] = []
    for path in (live, staged):
        if path.is_symlink() or not path.is_dir():
            return "UNKNOWN"
        records: dict[str, str] = {}
        for name, mode in ROOT_OPERATOR_BUNDLE:
            item = path / name
            if item.is_symlink() or not item.is_file():
                return "UNKNOWN"
            metadata = item.stat()
            if (
                stat.S_IMODE(metadata.st_mode) != mode
                or metadata.st_nlink != 1
            ):
                return "UNKNOWN"
            records[name] = sha256(item)
        actual.append(records)
    if actual == [old_artifacts, candidate_artifacts]:
        return "PREPARED" if root_bundle_candidate_namespace_closed(staged) else "UNKNOWN"
    if actual == [candidate_artifacts, old_artifacts]:
        return "EXCHANGED" if root_bundle_candidate_namespace_closed(live) else "UNKNOWN"
    return "UNKNOWN"


@contextmanager
def exact_source_checkout(source_repo: Path, commit: str):
    git = Path("/usr/bin/git")
    git_root, owner_prefix = release_source_layout(git, source_repo)
    resolved_owner = owner_revision(git, source_repo, commit)
    if resolved_owner != commit:
        raise RuntimeError(
            f"requested commit {commit} is not the exact configured owner revision {resolved_owner}"
        )
    # Materialize the exact requested tree, not unrelated historical objects.
    # An unavailable required blob must fail before a release can be built.
    archive = subprocess.run(
        [str(git), "-C", str(git_root), "archive", "--format=tar", commit],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
    )
    if archive.returncode != 0:
        detail = archive.stderr.strip() or f"exit {archive.returncode}"
        raise RuntimeError(f"cannot materialize exact release source: {detail}")
    with tempfile.TemporaryDirectory(prefix="ordivon-runtime-release-source-") as temporary:
        checkout = Path(temporary) / "source"
        # Git disables local cloning for shallow repositories; upload-pack
        # can then require unrelated missing historical promisor blobs. Use
        # Git's native local object alternate instead of negotiating history.
        # The requested tree was materialized above; checkout must not fetch.
        objects = Path(git_text(git, git_root, [
            "rev-parse", "--path-format=absolute", "--git-path", "objects",
        ])).resolve(strict=True)
        if (not objects.is_dir()
                or any(c in str(objects) for c in ("\n", "\r"))
                or str(objects).startswith('"')):
            raise RuntimeError("release source object directory is unsafe")
        object_format = git_text(git, git_root, ["rev-parse", "--show-object-format"])
        run([str(git), "init", "--quiet", "--template=",
             f"--object-format={object_format}", str(checkout)])
        alternates = checkout / ".git/objects/info/alternates"
        alternates.write_bytes(os.fsencode(objects) + b"\n")
        # Preserve the source's existing shallow-history boundary rather than
        # representing an incomplete history as a full clone.
        shallow = Path(git_text(git, git_root, [
            "rev-parse", "--path-format=absolute", "--git-path", "shallow",
        ]))
        if shallow.is_file():
            (checkout / ".git/shallow").write_bytes(shallow.read_bytes())
        run([str(git), "-C", str(checkout), "checkout", "--quiet", "--detach", commit],
            env={**os.environ, "GIT_NO_LAZY_FETCH": "1"})
        head = git_text(git, checkout, ["rev-parse", "HEAD"])
        if head != commit:
            raise RuntimeError(
                f"detached release source resolved to {head} instead of requested commit {commit}"
            )
        status = git_text(git, checkout, ["status", "--porcelain", "--untracked-files=all"])
        if status:
            raise RuntimeError("detached release source is not clean after exact checkout")
        materialized_owner = checkout / owner_prefix
        if materialized_owner.is_symlink() or not materialized_owner.is_dir():
            raise RuntimeError(
                f"configured release owner is absent or unsafe at commit {commit}: {owner_prefix}"
            )
        yield materialized_owner


def executable_identity(path: Path) -> dict[str, object]:
    resolved = path.resolve(strict=True)
    if resolved.is_symlink() or not resolved.is_file() or not os.access(resolved, os.X_OK):
        raise RuntimeError(f"toolchain executable is missing or unsafe: {path}")
    version = run([str(path), "--version", "--verbose"]).stdout.strip().splitlines()
    if not version:
        raise RuntimeError(f"toolchain executable returned no version: {path}")
    return {
        "path": str(path),
        "resolvedPath": str(resolved),
        "digest": sha256(resolved),
        "version": version[0],
        "details": version[1:],
    }


def build_toolchain_identity(cargo: Path) -> dict[str, object]:
    rustc = cargo.with_name("rustc")
    if not rustc.is_file() or not os.access(rustc, os.X_OK):
        raise RuntimeError("release Cargo must have an executable sibling rustc")
    cargo_identity = executable_identity(cargo)
    rustc_identity = executable_identity(rustc)
    host = None
    for line in rustc_identity["details"]:
        if isinstance(line, str) and line.startswith("host: "):
            host = line.removeprefix("host: ")
            break
    if not host:
        raise RuntimeError("rustc --version --verbose omitted host target")
    return {
        "cargo": cargo_identity,
        "rustc": rustc_identity,
        "host": host,
    }


def current_attempt_id() -> str | None:
    try:
        cgroup = Path("/proc/self/cgroup").read_text(encoding="utf-8")
    except OSError:
        return None
    match = ATTEMPT_UNIT_PATTERN.search(cgroup)
    return match.group(1) if match else None


def runtime_inspect_binary() -> Path:
    configured = os.environ.get("ORDIVON_RUNTIME_INSPECT")
    candidates: list[Path] = []
    if configured:
        candidate = Path(configured)
        if not candidate.is_absolute():
            raise RuntimeError("ORDIVON_RUNTIME_INSPECT must be an absolute path")
        candidates.append(candidate)
    candidates.extend(
        [
            Path(__file__).resolve().with_name("ordivon-runtime-inspect"),
            Path(__file__).resolve().parents[1] / "target/debug/ordivon-runtime-inspect",
        ]
    )
    for candidate in candidates:
        if candidate.is_file() and not candidate.is_symlink() and os.access(candidate, os.X_OK):
            return candidate
    raise RuntimeError(
        "ordivon-runtime-inspect is unavailable; install it beside this script or set "
        "ORDIVON_RUNTIME_INSPECT to an absolute executable path"
    )


def registry_projection(database: Path, attempt_id: str | None) -> dict[str, object]:
    arguments = [
        str(runtime_inspect_binary()),
        "registry",
        "--database",
        str(database),
        "--busy-timeout-ms",
        "5000",
    ]
    if attempt_id is not None:
        arguments.extend(["--attempt-id", attempt_id])
    completed = subprocess.run(arguments, check=False, text=True, capture_output=True)
    if completed.returncode != 0:
        detail = completed.stderr.strip() or completed.stdout.strip() or f"exit {completed.returncode}"
        raise RuntimeError(f"Runtime registry inspection failed: {detail}")
    try:
        value = json.loads(completed.stdout)
    except json.JSONDecodeError as error:
        raise RuntimeError("Runtime registry inspection returned invalid JSON") from error
    if not isinstance(value, dict) or not isinstance(value.get("activeJobIds"), list):
        raise RuntimeError("Runtime registry inspection omitted activeJobIds")
    return value


def active_job_ids(database: Path) -> tuple[list[str], str | None]:
    attempt_id = current_attempt_id()
    projection = registry_projection(database, attempt_id)
    raw_jobs = projection["activeJobIds"]
    assert isinstance(raw_jobs, list)
    if any(not isinstance(job_id, str) for job_id in raw_jobs):
        raise RuntimeError("Runtime registry inspection returned invalid activeJobIds")
    # Preserve the historical deployment fence semantics: sort globally, cap the
    # observed blocking set at 100, then ignore this deployment's own Runtime Job.
    jobs = sorted(raw_jobs)[:100]
    current_job_id = projection.get("resolvedAttemptJobId")
    if current_job_id is not None and not isinstance(current_job_id, str):
        raise RuntimeError("Runtime registry inspection returned invalid resolvedAttemptJobId")
    if current_job_id is not None:
        jobs = [job_id for job_id in jobs if job_id != current_job_id]
    return jobs, current_job_id


def registry_migration_version(database: Path) -> int:
    projection = registry_projection(database, None)
    value = projection.get("migrationVersion")
    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
        raise RuntimeError("Runtime registry inspection returned invalid migrationVersion")
    return value


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return "sha256:" + digest.hexdigest()


def validate_runtime_policy(value: object, *, require_complete: bool) -> dict[str, object]:
    if not isinstance(value, dict):
        raise RuntimeError("Runtime policy must be an object")
    if value.get("schemaVersion") != RUNTIME_POLICY_SCHEMA_VERSION:
        raise RuntimeError("Runtime policy schemaVersion is unsupported")
    result: dict[str, object] = {"schemaVersion": RUNTIME_POLICY_SCHEMA_VERSION}
    for _env_key, field in RUNTIME_POLICY_ENV_KEYS:
        field_present = field in value
        raw = value.get(field)
        if raw is None:
            if require_complete and field not in RUNTIME_POLICY_LEGACY_OPTIONAL_FIELDS:
                raise RuntimeError(f"Runtime policy lacks {field}")
            if field not in RUNTIME_POLICY_LEGACY_OPTIONAL_FIELDS or field_present:
                result[field] = None
            continue
        if isinstance(raw, bool) or not isinstance(raw, int) or raw <= 0:
            raise RuntimeError(f"Runtime policy {field} must be a positive integer")
        result[field] = raw
    default = result["defaultRuntimeMs"]
    maximum = result["maxRuntimeMs"]
    if isinstance(default, int) and isinstance(maximum, int) and default > maximum:
        raise RuntimeError("Runtime policy defaultRuntimeMs must not exceed maxRuntimeMs")
    return result


def runtime_policy_from_text(
    text: str,
    *,
    label: str,
    track_optional_absence: bool = False,
) -> dict[str, object]:
    observed: dict[str, int | None] = {}
    for env_key, field in RUNTIME_POLICY_ENV_KEYS:
        matches = []
        for line in text.splitlines():
            if not line.startswith(env_key + "="):
                continue
            raw = line.split("=", 1)[1].strip()
            if not raw.isdigit() or int(raw) <= 0:
                raise RuntimeError(f"{label} {env_key} must be a positive integer")
            matches.append(int(raw))
        if len(matches) > 1:
            raise RuntimeError(f"{label} contains duplicate {env_key}")
        if matches:
            observed[field] = matches[0]
        elif field not in RUNTIME_POLICY_LEGACY_OPTIONAL_FIELDS or track_optional_absence:
            observed[field] = None
    return validate_runtime_policy(
        {"schemaVersion": RUNTIME_POLICY_SCHEMA_VERSION, **observed},
        require_complete=False,
    )


def runtime_policy_state(
    path: Path,
    *,
    track_optional_absence: bool = False,
) -> dict[str, object]:
    if path.is_symlink() or not path.is_file():
        raise RuntimeError(f"Runtime env file is missing or unsafe: {path}")
    policy = runtime_policy_from_text(
        path.read_text(encoding="utf-8"),
        label="Runtime env",
        track_optional_absence=track_optional_absence,
    )
    return {**policy, "envFileDigest": sha256(path)}


def runtime_policy_transaction_preimage(
    path: Path,
    candidate_policy: object,
) -> dict[str, object]:
    candidate = validate_runtime_policy(candidate_policy, require_complete=False)
    previous = runtime_policy_state(path, track_optional_absence=True)
    for field in RUNTIME_POLICY_LEGACY_OPTIONAL_FIELDS:
        if field not in candidate:
            previous.pop(field, None)
    return previous


def candidate_runtime_policy(source_root: Path) -> dict[str, object]:
    source = source_root / RUNTIME_POLICY_SOURCE
    state = runtime_policy_state(source)
    return validate_runtime_policy(state, require_complete=True)


def committed_runtime_policy(git: Path, source_repo: Path, commit: str) -> dict[str, object]:
    source_path = committed_source_path(git, source_repo, RUNTIME_POLICY_SOURCE)
    text = git_text(git, source_repo, ["show", f"{commit}:{source_path}"])
    policy = runtime_policy_from_text(text, label="Committed Runtime policy")
    return validate_runtime_policy(policy, require_complete=True)


def validate_release_authority(value: object, *, require_complete: bool) -> dict[str, object]:
    if not isinstance(value, dict):
        raise RuntimeError("release authority must be an object")
    if value.get("schemaVersion") != RELEASE_AUTHORITY_SCHEMA_VERSION:
        raise RuntimeError("release authority schemaVersion is unsupported")
    result: dict[str, object] = {"schemaVersion": RELEASE_AUTHORITY_SCHEMA_VERSION}
    source_repo = value.get("sourceRepo")
    if source_repo is None:
        if require_complete:
            raise RuntimeError("release authority lacks sourceRepo")
        result["sourceRepo"] = None
    else:
        if not isinstance(source_repo, str) or not source_repo or "\n" in source_repo or "\r" in source_repo:
            raise RuntimeError("release authority sourceRepo must be one absolute path")
        source_path = Path(source_repo)
        if not source_path.is_absolute():
            raise RuntimeError("release authority sourceRepo must be absolute")
        result["sourceRepo"] = str(source_path)

    required_ref = value.get("requiredRef")
    if required_ref is None:
        if require_complete:
            raise RuntimeError("release authority lacks requiredRef")
        result["requiredRef"] = None
    else:
        if (
            not isinstance(required_ref, str)
            or not required_ref
            or required_ref.strip() != required_ref
            or any(ord(ch) < 32 or ord(ch) == 127 for ch in required_ref)
        ):
            raise RuntimeError("release authority requiredRef is invalid")
        result["requiredRef"] = required_ref
    return result


def release_authority_from_text(text: str, *, label: str) -> dict[str, object]:
    observed: dict[str, str | None] = {}
    for env_key, field in RELEASE_AUTHORITY_ENV_KEYS:
        matches = []
        for line in text.splitlines():
            if not line.startswith(env_key + "="):
                continue
            matches.append(line.split("=", 1)[1])
        if len(matches) > 1:
            raise RuntimeError(f"{label} contains duplicate {env_key}")
        observed[field] = matches[0] if matches else None
    return validate_release_authority(
        {"schemaVersion": RELEASE_AUTHORITY_SCHEMA_VERSION, **observed},
        require_complete=False,
    )


def release_authority_state(path: Path) -> dict[str, object]:
    if path.is_symlink() or not path.is_file():
        raise RuntimeError(f"Runtime env file is missing or unsafe: {path}")
    authority = release_authority_from_text(
        path.read_text(encoding="utf-8"),
        label="Runtime env",
    )
    return {**authority, "envFileDigest": sha256(path)}


def candidate_release_authority(args: argparse.Namespace) -> dict[str, object]:
    return validate_release_authority(
        {
            "schemaVersion": RELEASE_AUTHORITY_SCHEMA_VERSION,
            "sourceRepo": str(args.source_repo.resolve()),
            "requiredRef": args.require_ref,
        },
        require_complete=True,
    )


def atomic_update_runtime_environment(
    path: Path,
    *,
    runtime_policy: object | None = None,
    release_authority: object | None = None,
    expected_current_runtime_policy: object | None = None,
    expected_current_release_authority: object | None = None,
) -> dict[str, object]:
    if path.is_symlink() or not path.is_file():
        raise RuntimeError(f"Runtime env file is missing or unsafe: {path}")
    original_bytes = path.read_bytes()
    try:
        original = original_bytes.decode("utf-8")
    except UnicodeDecodeError as error:
        raise RuntimeError("Runtime env file is not valid UTF-8") from error

    current_policy = runtime_policy_from_text(original, label="Runtime env")
    current_authority = release_authority_from_text(original, label="Runtime env")
    if expected_current_runtime_policy is not None:
        expected_policy = validate_runtime_policy(
            expected_current_runtime_policy,
            require_complete=False,
        )
        for _env_key, field in RUNTIME_POLICY_ENV_KEYS:
            if field not in expected_policy:
                continue
            if current_policy.get(field) != expected_policy.get(field):
                raise RuntimeError(f"Runtime env policy changed before commit: {field}")
    if expected_current_release_authority is not None:
        expected_authority = validate_release_authority(
            expected_current_release_authority,
            require_complete=False,
        )
        for _env_key, field in RELEASE_AUTHORITY_ENV_KEYS:
            if current_authority.get(field) != expected_authority.get(field):
                raise RuntimeError(
                    f"Runtime env release authority changed before commit: {field}"
                )

    desired: dict[str, object | None] = {}
    if runtime_policy is not None:
        policy = validate_runtime_policy(runtime_policy, require_complete=False)
        for env_key, field in RUNTIME_POLICY_ENV_KEYS:
            if field in policy:
                desired[env_key] = policy[field]
    if release_authority is not None:
        authority = validate_release_authority(release_authority, require_complete=False)
        for env_key, field in RELEASE_AUTHORITY_ENV_KEYS:
            desired[env_key] = authority.get(field)

    lines = original.splitlines(keepends=True)
    output: list[str] = []
    seen: set[str] = set()
    for line in lines:
        matched = False
        for env_key, value in desired.items():
            if line.startswith(env_key + "="):
                seen.add(env_key)
                if value is not None:
                    ending = "\n" if line.endswith("\n") else ""
                    output.append(f"{env_key}={value}{ending}")
                matched = True
                break
        if not matched:
            output.append(line)
    for env_key, value in desired.items():
        if env_key in seen or value is None:
            continue
        if output and not output[-1].endswith("\n"):
            output[-1] += "\n"
        output.append(f"{env_key}={value}\n")

    updated = "".join(output)
    if updated != original:
        metadata = path.stat()
        temporary = path.with_name(path.name + f".tmp-runtime-environment-{os.getpid()}")
        try:
            temporary.write_text(updated, encoding="utf-8")
            os.chmod(temporary, stat.S_IMODE(metadata.st_mode))
            os.chown(temporary, metadata.st_uid, metadata.st_gid)
            with temporary.open("rb") as handle:
                os.fsync(handle.fileno())
            os.replace(temporary, path)
            directory = os.open(str(path.parent), os.O_RDONLY | os.O_DIRECTORY)
            try:
                os.fsync(directory)
            finally:
                os.close(directory)
        finally:
            temporary.unlink(missing_ok=True)

    return {
        "runtimePolicy": runtime_policy_state(path),
        "releaseAuthority": release_authority_state(path),
    }


def atomic_update_runtime_policy(
    path: Path,
    target: object,
    *,
    expected_current: object | None = None,
) -> dict[str, object]:
    result = atomic_update_runtime_environment(
        path,
        runtime_policy=target,
        expected_current_runtime_policy=expected_current,
    )
    return result["runtimePolicy"]


def release_artifact_fingerprint(records: object) -> dict[str, tuple[str, int]] | None:
    if not isinstance(records, list) or not records:
        return None
    fingerprint: dict[str, tuple[str, int]] = {}
    for item in records:
        if not isinstance(item, dict):
            return None
        name = item.get("name")
        digest = item.get("digest")
        mode = item.get("mode")
        kind = item.get("kind") if isinstance(item.get("kind"), str) else "binary"
        if not isinstance(name, str) or not isinstance(digest, str):
            return None
        if mode is None and kind == "binary":
            mode = 0o755
        if not isinstance(mode, int) or name in fingerprint:
            return None
        fingerprint[name] = (digest, mode)
    return fingerprint


def release_history_states(deployment_root: Path) -> list[dict[str, object]]:
    if not deployment_root.is_dir():
        return []
    states: list[dict[str, object]] = []
    for pattern, valid_status in (
        ("*/result.json", "deployed"),
        ("*/rollback-result.json", "restored_previous"),
    ):
        for path in deployment_root.glob(pattern):
            try:
                event = json.loads(path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                continue
            if not isinstance(event, dict) or event.get("status") != valid_status:
                continue
            commit = event.get("commit")
            finished = event.get("finishedAtMs")
            fingerprint = release_artifact_fingerprint(event.get("installed"))
            if (
                not isinstance(commit, str)
                or not COMMIT_PATTERN.fullmatch(commit)
                or not isinstance(finished, int)
                or finished < 0
                or fingerprint is None
            ):
                continue
            states.append(
                {
                    "finishedAtMs": finished,
                    "commit": commit,
                    "fingerprint": fingerprint,
                    "receiptEvent": str(path),
                }
            )
    return states


def latest_release_state(deployment_root: Path) -> dict[str, object] | None:
    states = release_history_states(deployment_root)
    if not states:
        return None
    return max(states, key=lambda item: (int(item["finishedAtMs"]), str(item["receiptEvent"])))


def installed_baseline_drift(
    expected: dict[str, tuple[str, int]], installed: list[dict[str, object]]
) -> list[dict[str, object]]:
    """Expose the existing receipt comparison as exact, read-only evidence.

    This cannot authorize a release: eligibility continues to use the full
    fingerprint equality and all original admission/rollback guards.
    """
    current = {str(item["name"]): item for item in installed}
    differences: list[dict[str, object]] = []
    for name in sorted(expected.keys() | current.keys()):
        recorded = expected.get(name)
        observed = current.get(name)
        expected_digest, expected_mode = recorded if recorded is not None else (None, None)
        observed_digest = observed.get("digest") if observed is not None else None
        observed_mode = observed.get("mode") if observed is not None else None
        fields: list[str] = []
        if recorded is None:
            fields.append("unexpected")
        elif observed is None or not bool(observed.get("present")):
            fields.append("missing_or_nonregular")
        else:
            if expected_digest != observed_digest:
                fields.append("digest")
            if expected_mode != observed_mode:
                fields.append("mode")
            if not bool(observed.get("usable")):
                fields.append("unusable")
        if fields:
            differences.append(
                {
                    "name": name,
                    "differenceFields": fields,
                    "expectedDigest": expected_digest,
                    "observedDigest": observed_digest,
                    "expectedMode": expected_mode,
                    "observedMode": observed_mode,
                }
            )
    return differences


def matching_release_commit(
    deployment_root: Path, installed_records: object
) -> str | None:
    target = release_artifact_fingerprint(installed_records)
    if target is None:
        return None
    candidates = [
        state
        for state in release_history_states(deployment_root)
        if state["fingerprint"] == target
    ]
    if not candidates:
        return None
    return str(max(candidates, key=lambda item: (int(item["finishedAtMs"]), str(item["receiptEvent"])))["commit"])


def artifact_description(
    path: Path,
    spec: dict[str, object],
    *,
    enforce_mode: bool = True,
) -> dict[str, object]:
    if path.is_symlink() or not path.is_file():
        raise RuntimeError(f"release artifact is missing or unsafe: {path}")
    name = str(spec["name"])
    kind = str(spec.get("kind", "binary"))
    expected_mode = int(spec.get("mode", 0o755))
    observed_mode = stat.S_IMODE(path.stat().st_mode)
    if enforce_mode and observed_mode != expected_mode:
        raise RuntimeError(
            f"release artifact mode mismatch for {name}: "
            f"expected {expected_mode:#05o}, observed {observed_mode:#05o}"
        )
    if enforce_mode and expected_mode & 0o111 and not os.access(path, os.X_OK):
        raise RuntimeError(f"release artifact is not executable: {path}")
    return {
        "name": name,
        "kind": kind,
        "mode": observed_mode,
        "path": str(path),
        "bytes": path.stat().st_size,
        "digest": sha256(path),
    }


def binary_description(path: Path, name: str) -> dict[str, object]:
    # Compatibility helper for focused binary-only tests and older callers.
    return artifact_description(
        path, {"name": name, "kind": "binary", "mode": 0o755}, enforce_mode=True
    )


def candidate_artifacts(args: argparse.Namespace) -> list[dict[str, object]]:
    return [
        artifact_description(args.candidate_dir / str(spec["name"]), spec)
        for spec in release_artifact_specs(args)
    ]

def candidate_build_commands(
    cargo: Path, candidate_dir: Path, binary_names: list[str], *,
    explicit_binary_selection: bool,
) -> list[list[str]]:
    """Build native PG and Runner separately so Cargo cannot unify SQLite features.

    Cargo Feature unification is scoped to an invocation. The two production
    native consumers share the target cache, not the legacy Runtime feature.
    Other/legacy release profiles keep their previous full-Workspace build.
    """
    target = ["--target-dir", str(candidate_dir.parent)]
    if explicit_binary_selection and set(binary_names) == {
        "ordivon-runtime-pg", "ordivon-runtime-runner",
    }:
        return [
            [str(cargo), "build", "--release", "-p", "ordivon-runtime-mcp",
             "--bin", "ordivon-runtime-pg", "--no-default-features",
             "--features", "postgres-runtime", *target],
            [str(cargo), "build", "--release", "-p", "ordivon-runtime-core",
             "--bin", "ordivon-runtime-runner", "--no-default-features",
             "--features", "postgres-registry-admission", *target],
        ]
    return [[str(cargo), "build", "--release", "--workspace",
             "--all-features", *target]]


def run_candidate_build(command: list[str], *, cwd: Path, env: dict[str, str]) -> None:
    # Keep stdout reserved for the final machine-readable release manifest.
    # Native Cargo output must reach the original Job stderr while the child
    # is alive: an external timeout/kill otherwise discards captured progress.
    result = subprocess.run(command, cwd=cwd, env=env, stdout=sys.stderr, check=False)
    if result.returncode != 0:
        raise RuntimeError(f"candidate build failed (exit {result.returncode}): {' '.join(command)}")


def prepare_candidate(args: argparse.Namespace) -> dict[str, object]:
    binary_names = binaries(args)
    if args.candidate_dir.name != "release":
        raise RuntimeError("candidate-dir must be the release directory under one Cargo target root")
    toolchain = build_toolchain_identity(args.cargo)
    # Preserve the invocation path for rustup-style proxy symlinks. The resolved
    # path remains digest-bound in the manifest, but invoking that resolved
    # binary directly would lose the proxy basename (rustc/rustdoc) semantics.
    rustc = Path(str(toolchain["rustc"]["path"]))
    build_env = os.environ.copy()
    build_env["RUSTC"] = str(rustc)
    rustdoc = args.cargo.with_name("rustdoc")
    if rustdoc.is_file() and os.access(rustdoc, os.X_OK):
        build_env["RUSTDOC"] = str(rustdoc)
    build_env["PATH"] = str(args.cargo.parent) + os.pathsep + build_env.get("PATH", "")
    runtime_policy = None
    print("prepare: materializing exact source", file=sys.stderr, flush=True)
    with exact_source_checkout(args.source_repo, args.commit) as build_source:
        stage_operator_artifacts(args, build_source)
        if args.binaries is None:
            runtime_policy = candidate_runtime_policy(build_source)
        commands = candidate_build_commands(
            args.cargo, args.candidate_dir, binary_names,
            explicit_binary_selection=args.binaries is not None,
        )
        for index, command in enumerate(commands, start=1):
            print(f"prepare: building native candidate {index}/{len(commands)}", file=sys.stderr, flush=True)
            run_candidate_build(command, cwd=build_source, env=build_env)
        print("prepare: validating source and artifact identities", file=sys.stderr, flush=True)
        post_build_status = git_text(
            Path("/usr/bin/git"),
            build_source,
            ["status", "--porcelain", "--untracked-files=all"],
        )
        if post_build_status:
            raise RuntimeError("candidate build changed the detached release source")
    candidate = candidate_artifacts(args)
    binary_set = set(binary_names)
    _git_root, owner_prefix = release_source_layout(Path("/usr/bin/git"), args.source_repo)
    manifest = {
        "schemaVersion": SCHEMA_VERSION,
        "commit": args.commit,
        "sourceRepo": str(args.source_repo.resolve()),
        "sourceOwnerPrefix": "" if owner_prefix == Path() else owner_prefix.as_posix(),
        "sourceMaterialization": "detached_git_checkout",
        "candidateDir": str(args.candidate_dir.resolve()),
        "builtAtMs": int(time.time() * 1000),
        "cargo": str(args.cargo),
        "toolchain": toolchain,
        "artifacts": candidate,
        "binaries": [item for item in candidate if str(item["name"]) in binary_set],
    }
    if runtime_policy is not None:
        manifest["runtimePolicy"] = runtime_policy
    write_json_atomic(args.candidate_manifest, manifest)
    return {**manifest, "candidateManifest": str(args.candidate_manifest.resolve())}

def validate_candidate_manifest(
    args: argparse.Namespace, candidate: list[dict[str, object]]
) -> tuple[dict[str, object], list[str]]:
    manifest = json.loads(args.candidate_manifest.read_text(encoding="utf-8"))
    blockers: list[str] = []
    if manifest.get("schemaVersion") != SCHEMA_VERSION:
        blockers.append("candidate manifest schemaVersion is unsupported")
    if manifest.get("commit") != args.commit:
        blockers.append("candidate manifest commit does not match requested commit")
    if Path(str(manifest.get("sourceRepo"))).resolve() != args.source_repo.resolve():
        blockers.append("candidate manifest source repository does not match source-repo")
    _git_root, owner_prefix = release_source_layout(args.git, args.source_repo)
    if (
        "sourceOwnerPrefix" in manifest
        and manifest.get("sourceOwnerPrefix")
        != ("" if owner_prefix == Path() else owner_prefix.as_posix())
    ):
        blockers.append("candidate manifest source owner prefix does not match source-repo")
    if Path(str(manifest.get("candidateDir"))).resolve() != args.candidate_dir.resolve():
        blockers.append("candidate manifest directory does not match candidate-dir")
    if manifest.get("sourceMaterialization") != "detached_git_checkout":
        blockers.append("candidate manifest source materialization is unsupported")
    toolchain = manifest.get("toolchain")
    if not isinstance(toolchain, dict):
        blockers.append("candidate manifest lacks build toolchain identity")
    else:
        for name in ("cargo", "rustc"):
            identity = toolchain.get(name)
            if (
                not isinstance(identity, dict)
                or not isinstance(identity.get("version"), str)
                or not isinstance(identity.get("resolvedPath"), str)
                or not isinstance(identity.get("digest"), str)
                or not str(identity.get("digest")).startswith("sha256:")
            ):
                blockers.append(f"candidate manifest has invalid {name} identity")
        if not isinstance(toolchain.get("host"), str) or not toolchain.get("host"):
            blockers.append("candidate manifest lacks Rust host target")
    manifest_by_name = {
        str(item.get("name")): item
        for item in manifest.get("artifacts", [])
        if isinstance(item, dict)
    }
    for item in candidate:
        name = str(item["name"])
        recorded = manifest_by_name.get(name)
        if recorded is None:
            blockers.append(f"candidate manifest lacks release artifact {name}")
            continue
        for field in ("digest", "bytes", "mode", "kind"):
            if recorded.get(field) != item.get(field):
                blockers.append(f"candidate release artifact does not match manifest: {name}")
                break
    candidate_names = {str(item["name"]) for item in candidate}
    if set(manifest_by_name) != candidate_names:
        blockers.append("candidate manifest artifact set does not match requested release set")
    manifest_binary_names = {
        str(item.get("name"))
        for item in manifest.get("binaries", [])
        if isinstance(item, dict)
    }
    expected_binary_names = {
        str(item["name"]) for item in candidate if item.get("kind") == "binary"
    }
    if manifest_binary_names != expected_binary_names:
        blockers.append("candidate manifest binary subset does not match release artifacts")
    runtime_policy = None
    if args.binaries is None:
        try:
            runtime_policy = validate_runtime_policy(
                manifest.get("runtimePolicy"), require_complete=True
            )
            source_policy = committed_runtime_policy(args.git, args.source_repo, args.commit)
            if runtime_policy != source_policy:
                blockers.append("candidate Runtime policy does not match exact source Commit")
        except RuntimeError as error:
            blockers.append(str(error))
    elif manifest.get("runtimePolicy") is not None:
        blockers.append("binary-subset candidate manifest must not carry Runtime policy")
    observed_manifest_digest = sha256(args.candidate_manifest)
    expected_manifest_digest = getattr(args, "candidate_manifest_digest", None)
    if expected_manifest_digest is not None and observed_manifest_digest != expected_manifest_digest:
        blockers.append("candidate manifest digest does not match structured release request")
    summary = {
        "path": str(args.candidate_manifest.resolve()),
        "digest": observed_manifest_digest,
        "commit": manifest.get("commit"),
        "sourceRepo": manifest.get("sourceRepo"),
        "candidateDir": manifest.get("candidateDir"),
        "sourceMaterialization": manifest.get("sourceMaterialization"),
        "builtAtMs": manifest.get("builtAtMs"),
        "toolchain": toolchain,
        "artifactCount": len(manifest_by_name),
        "runtimePolicy": runtime_policy,
    }
    return summary, blockers

def deployment_plan(args: argparse.Namespace) -> dict[str, object]:
    specs = release_artifact_specs(args)
    repository_head = git_text(args.git, args.source_repo, ["rev-parse", "HEAD"])
    head = owner_revision(args.git, args.source_repo, repository_head)
    status = git_text(args.git, args.source_repo, ["status", "--porcelain", "--", "."])
    required_ref_authorization = required_ref_authority(
        args.git,
        args.source_repo,
        args.commit,
        args.require_ref,
    )
    required_repository_ref = str(required_ref_authorization["requiredRefCommit"])
    required_ref = owner_revision(args.git, args.source_repo, required_repository_ref)
    jobs, ignored_current_job_id = active_job_ids(args.database)
    candidate = candidate_artifacts(args)
    candidate_manifest, manifest_blockers = validate_candidate_manifest(args, candidate)
    release_authority = (
        {
            "previous": release_authority_state(args.env_file),
            "candidate": candidate_release_authority(args),
        }
        if args.binaries is None
        else None
    )
    installed: list[dict[str, object]] = []
    for spec in specs:
        name = str(spec["name"])
        path = args.install_dir / name
        present = path.is_file() and not path.is_symlink()
        observed_mode = stat.S_IMODE(path.stat().st_mode) if present else None
        executable_required = bool(int(spec["mode"]) & 0o111)
        executable_ok = present and (not executable_required or os.access(path, os.X_OK))
        installed.append(
            {
                "name": name,
                "kind": str(spec["kind"]),
                "path": str(path),
                "present": present,
                "usable": executable_ok,
                "mode": observed_mode,
                "digest": sha256(path) if present else None,
                "bytes": path.stat().st_size if present else None,
            }
        )
    baseline = latest_release_state(args.receipt_root)
    present_installed = [item for item in installed if bool(item["present"])]
    current_fingerprint = release_artifact_fingerprint(present_installed) or {}
    baseline_fingerprint = (
        baseline["fingerprint"]
        if baseline is not None and isinstance(baseline.get("fingerprint"), dict)
        else None
    )
    baseline_authorized = (
        baseline_fingerprint is not None and current_fingerprint == baseline_fingerprint
    )
    candidate_names = {str(spec["name"]) for spec in specs}
    baseline_names = set(baseline_fingerprint) if baseline_fingerprint is not None else set()
    additive_candidate_names = (
        sorted(candidate_names - baseline_names) if baseline_authorized else []
    )
    blockers: list[str] = list(manifest_blockers)
    if not bool(required_ref_authorization["authorized"]):
        if required_ref_authorization["mode"] == "exact_commit":
            blockers.append(f"required ref {args.require_ref} resolves to {required_repository_ref}")
        elif not bool(required_ref_authorization["candidateIsAncestor"]):
            blockers.append(
                f"candidate Commit {args.commit} is not an ancestor of required ref "
                f"{args.require_ref} at {required_repository_ref}"
            )
        else:
            blockers.append(
                f"required ref {args.require_ref} changed Runtime owner tree "
                f"{required_ref_authorization['ownerRelativePath']}"
            )
    if jobs:
        blockers.append("active or held Jobs exist other than the deployment Job")
    if baseline is None:
        if any(not item["present"] or not item["usable"] for item in installed):
            blockers.append("one or more installed release artifacts are missing or unusable")
    elif not baseline_authorized:
        blockers.append("installed release artifacts do not match the latest deployment receipt")
    elif not baseline_names.issubset(candidate_names):
        blockers.append("candidate release artifact set drops artifacts from the latest deployment receipt")
    return {
        "schemaVersion": SCHEMA_VERSION,
        "commit": args.commit,
        "sourceRepo": str(args.source_repo),
        "sourceHead": head,
        "sourceRepositoryHead": repository_head,
        "sourceHeadMatchesCommit": head == args.commit,
        "requiredRef": args.require_ref,
        "requiredRefCommit": required_ref,
        "requiredRefRepositoryCommit": required_repository_ref,
        "requiredRefAuthority": required_ref_authorization,
        "sourceClean": not bool(status),
        "activeJobIds": jobs,
        "ignoredCurrentJobId": ignored_current_job_id,
        "service": args.service,
        "candidate": candidate,
        "candidateManifest": candidate_manifest,
        "releaseAuthority": release_authority,
        "installed": installed,
        "installedBaseline": (
            None
            if baseline is None
            else {
                "commit": baseline["commit"],
                "finishedAtMs": baseline["finishedAtMs"],
                "receiptEvent": baseline["receiptEvent"],
                "artifactCount": len(baseline_names),
                "artifactNames": sorted(baseline_names),
                "authorized": baseline_authorized,
                "artifactDrift": installed_baseline_drift(baseline_fingerprint, installed),
                "additiveCandidateArtifacts": additive_candidate_names,
            }
        ),
        "eligible": not blockers,
        "blockers": blockers,
    }

def probe_mcp(
    env_file: Path,
    *,
    expected_tool_count: int | None,
    required: tuple[str, ...],
    wait_seconds: float,
    require_modern: bool,
    allow_legacy_fallback: bool,
) -> dict[str, object]:
    environment = load_environment_file(env_file)
    bind = environment.get("ORDIVON_BIND")
    if not bind:
        raise RuntimeError("environment file must define ORDIVON_BIND")
    token = load_bearer_token(environment)
    return probe_catalog(
        f"http://{bind}/mcp",
        token,
        client_name="ordivon-runtime-deploy",
        expected_tool_count=expected_tool_count,
        required_tools=required,
        wait_seconds=wait_seconds,
        require_modern=require_modern,
        allow_legacy_fallback=allow_legacy_fallback,
    )

def service_active(systemctl: Path, service: str) -> bool:
    return run([str(systemctl), "is-active", service], check=False).stdout.strip() == "active"


def wait_service_active(systemctl: Path, service: str, wait_seconds: float) -> None:
    deadline = time.monotonic() + wait_seconds
    while time.monotonic() < deadline:
        if service_active(systemctl, service):
            return
        time.sleep(0.2)
    raise RuntimeError(f"service did not become active: {service}")


def wait_for_service_mcp_ready(
    systemctl: Path,
    service: str,
    env_file: Path,
    *,
    expected_tool_count: int | None,
    required: tuple[str, ...],
    wait_seconds: float,
    require_modern: bool,
    allow_legacy_fallback: bool,
    readiness_probe: Callable[[float], dict[str, object]] | None = None,
) -> dict[str, object]:
    deadline = time.monotonic() + wait_seconds
    wait_service_active(systemctl, service, max(0.001, deadline - time.monotonic()))
    last_error: Exception | None = None
    while True:
        if not service_active(systemctl, service):
            raise RuntimeError(f"service stopped before MCP readiness: {service}") from last_error
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            if last_error is not None:
                raise RuntimeError(str(last_error)) from last_error
            raise RuntimeError(f"MCP readiness deadline expired: {service}")
        try:
            slice_seconds = min(MCP_READINESS_PROBE_SLICE_SECONDS, remaining)
            if readiness_probe is not None:
                observed = readiness_probe(slice_seconds)
                if not isinstance(observed, dict) or not observed:
                    raise RuntimeError("rollback readiness probe returned no qualified evidence")
                return observed
            return probe_mcp(
                env_file,
                expected_tool_count=expected_tool_count,
                required=required,
                wait_seconds=slice_seconds,
                require_modern=require_modern,
                allow_legacy_fallback=allow_legacy_fallback,
            )
        except Exception as error:
            last_error = error
            if not service_active(systemctl, service):
                raise RuntimeError(f"service stopped before MCP readiness: {service}") from error
            if time.monotonic() >= deadline:
                raise RuntimeError(str(error)) from error


def atomic_copy(source: Path, destination: Path, *, mode: int = 0o755) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary = destination.with_name(destination.name + f".tmp-{os.getpid()}")
    try:
        shutil.copy2(source, temporary)
        os.chmod(temporary, mode)
        with temporary.open("rb") as handle:
            os.fsync(handle.fileno())
        os.replace(temporary, destination)
    finally:
        temporary.unlink(missing_ok=True)


def write_json_atomic(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + f".tmp-{os.getpid()}")
    try:
        temporary.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        with temporary.open("rb") as handle:
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


@contextmanager
def exclusive_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a+") as handle:
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RuntimeError(f"deployment lock is already held: {path}") from error
        yield


def admission_fence_path(database: Path) -> Path:
    return database.parent / "admission.lock"


def rollback_database(args: argparse.Namespace) -> Path:
    if args.database is not None:
        return args.database
    environment = load_environment_file(args.env_file)
    registry_root = environment.get("ORDIVON_REGISTRY_ROOT")
    if not registry_root:
        raise RuntimeError(
            "rollback requires --database or ORDIVON_REGISTRY_ROOT in the environment file"
        )
    root = Path(registry_root)
    if not root.is_absolute():
        raise RuntimeError("ORDIVON_REGISTRY_ROOT must be absolute for rollback")
    return root / "registry.sqlite3"


def acquire_exclusive_admission_fence(database: Path):
    path = admission_fence_path(database)
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = path.open("a+")
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
    except Exception:
        handle.close()
        raise
    return handle


def wait_for_execution_drain(database: Path, timeout_seconds: float) -> list[str]:
    deadline = time.monotonic() + timeout_seconds
    while True:
        jobs, _ = active_job_ids(database)
        if not jobs:
            return []
        if time.monotonic() >= deadline:
            return jobs
        time.sleep(0.1)


@contextmanager
def fenced_execution_drain(database: Path, timeout_seconds: float):
    handle = acquire_exclusive_admission_fence(database)
    try:
        remaining_jobs = wait_for_execution_drain(database, timeout_seconds)
        if remaining_jobs:
            raise RuntimeError(
                "rollback drain timed out with active or held Jobs: "
                + ", ".join(remaining_jobs)
            )
        yield
    finally:
        handle.close()


def receipt_path(root: Path, commit: str) -> Path:
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    candidate = root / f"{stamp}-{commit[:12]}"
    suffix = 1
    while candidate.exists():
        candidate = root / f"{stamp}-{commit[:12]}-{suffix}"
        suffix += 1
    return candidate


def structured_release_drain_policy(
    args: argparse.Namespace, release_effect: dict[str, object] | None
) -> tuple[float, str]:
    if release_effect is None:
        return float(args.drain_seconds), "cli"
    environment = load_environment_file(args.env_file)
    raw = environment.get(STRUCTURED_RELEASE_DRAIN_TIMEOUT_ENV)
    if raw is None:
        return float(args.drain_seconds), "cli"
    try:
        timeout_ms = int(raw)
    except ValueError as error:
        raise RuntimeError(
            f"{STRUCTURED_RELEASE_DRAIN_TIMEOUT_ENV} must be a positive integer number of milliseconds"
        ) from error
    if timeout_ms <= 0:
        raise RuntimeError(
            f"{STRUCTURED_RELEASE_DRAIN_TIMEOUT_ENV} must be a positive integer number of milliseconds"
        )
    return timeout_ms / 1000.0, STRUCTURED_RELEASE_DRAIN_TIMEOUT_ENV


def structured_release_effect(args: argparse.Namespace) -> dict[str, object] | None:
    values = (
        getattr(args, "effect_id", None),
        getattr(args, "effect_request_digest", None),
        getattr(args, "candidate_manifest_digest", None),
    )
    if all(value is None for value in values):
        return None
    if any(value is None for value in values):
        raise RuntimeError(
            "structured release requires effect-id, effect-request-digest, and candidate-manifest-digest together"
        )
    return {
        "contract": "runtime_release_v1",
        "effectId": values[0],
        "requestDigest": values[1],
        "commit": args.commit,
        "candidateManifestDigest": values[2],
        "sourceRepo": str(args.source_repo.resolve()),
        "candidateDir": str(args.candidate_dir.resolve()),
        "candidateManifest": str(args.candidate_manifest.resolve()),
        "installDir": str(args.install_dir.resolve()),
        "database": str(args.database.resolve()),
        "envFile": str(args.env_file.resolve()),
        "receiptRoot": str(args.receipt_root.resolve()),
        "service": args.service,
        "requiredRef": args.require_ref,
        "requiredTools": list(required_tools(args)),
        "expectedToolCount": args.expected_tool_count,
        "releaseArtifacts": [
            {
                "name": str(spec["name"]),
                "kind": str(spec["kind"]),
                "mode": int(spec["mode"]),
            }
            for spec in release_artifact_specs(args)
        ],
    }


def structured_receipt_path(root: Path, effect_id: str) -> Path:
    return root / f"effect-{effect_id}"


def existing_structured_release_result(
    receipt: Path, expected: dict[str, object]
) -> dict[str, object] | None:
    if not receipt.exists():
        return None
    if receipt.is_symlink() or not receipt.is_dir():
        raise RuntimeError("structured release receipt path is not a safe directory")
    request_path = receipt / "effect-request.json"
    if request_path.is_symlink() or not request_path.is_file():
        raise RuntimeError("structured release receipt lacks its effect request")
    recorded = json.loads(request_path.read_text(encoding="utf-8"))
    if recorded != expected:
        raise RuntimeError("effect-id is already bound to a different release request")
    result_path = receipt / "result.json"
    if not result_path.exists():
        raise RuntimeError(
            "structured release effect exists without a terminal result; reconcile it instead of repeating apply"
        )
    if result_path.is_symlink() or not result_path.is_file():
        raise RuntimeError("structured release terminal result is unsafe")
    result = json.loads(result_path.read_text(encoding="utf-8"))
    if not isinstance(result, dict):
        raise RuntimeError("structured release terminal result is invalid")
    release_effect = result.get("releaseEffect")
    if release_effect != expected:
        raise RuntimeError("structured release terminal result does not match its effect request")
    return {**result, "replayed": True}


def receipt_record_mode(record: dict[str, object]) -> int:
    mode = record.get("mode")
    if mode is None:
        # v1 receipts contained binaries only and installed them as 0755.
        return 0o755
    if not isinstance(mode, int) or not 0 <= mode <= 0o777:
        raise RuntimeError("deployment receipt contains an invalid artifact mode")
    return mode


def restore_previous(
    previous: Path,
    install_dir: Path,
    records: list[dict[str, object]],
    systemctl: Path,
    service: str,
    env_file: Path,
    wait_seconds: float,
    *,
    runtime_policy: object | None = None,
    expected_current_runtime_policy: object | None = None,
    release_authority: object | None = None,
    expected_current_release_authority: object | None = None,
    readiness_probe: Callable[[float], dict[str, object]] | None = None,
) -> dict[str, object]:
    # The shared physical rollback is backend-neutral. Its default readiness
    # path is the legacy SQLite MCP probe; PG callers supply the existing
    # PG-native authenticated catalog + Runner witness instead.
    run([str(systemctl), "stop", service], check=False)
    restored_environment = None
    if runtime_policy is not None or release_authority is not None:
        restored_environment = atomic_update_runtime_environment(
            env_file,
            runtime_policy=runtime_policy,
            release_authority=release_authority,
            expected_current_runtime_policy=expected_current_runtime_policy,
            expected_current_release_authority=expected_current_release_authority,
        )
    removed_artifacts: list[str] = []
    for record in records:
        name = str(record.get("name", ""))
        if not name or name in {".", ".."} or "/" in name:
            raise RuntimeError("rollback receipt contains an invalid artifact name")
        target = install_dir / name
        if record.get("present", True) is False:
            target.unlink(missing_ok=True)
            removed_artifacts.append(name)
            continue
        source = previous / name
        if source.is_symlink() or not source.is_file():
            raise RuntimeError(f"rollback artifact is missing or unsafe: {source}")
        expected = record.get("digest")
        if isinstance(expected, str) and sha256(source) != expected:
            raise RuntimeError(f"rollback artifact digest does not match receipt: {name}")
        atomic_copy(source, target, mode=receipt_record_mode(record))
    run([str(systemctl), "start", service])
    if readiness_probe is None:
        probe = wait_for_service_mcp_ready(
            systemctl,
            service,
            env_file,
            expected_tool_count=None,
            required=(),
            wait_seconds=wait_seconds,
            require_modern=False,
            allow_legacy_fallback=True,
        )
    else:
        probe = wait_for_service_mcp_ready(
            systemctl,
            service,
            env_file,
            expected_tool_count=None,
            required=(),
            wait_seconds=wait_seconds,
            require_modern=True,
            allow_legacy_fallback=False,
            readiness_probe=readiness_probe,
        )
    result: dict[str, object] = {
        "serviceActive": True,
        "probe": probe,
        "removedArtifacts": removed_artifacts,
    }
    if restored_environment is not None:
        if runtime_policy is not None:
            result["runtimePolicy"] = restored_environment["runtimePolicy"]
        if release_authority is not None:
            result["releaseAuthority"] = restored_environment["releaseAuthority"]
    return result

def read_retention_record(path: Path) -> tuple[bytes, object]:
    """Bound one observation to the opened regular file, not its pathname alone.

    Duplicate keys and non-finite values are ambiguous evidence, even when
    unrelated fields appear valid. This is not a namespace or effect-time lock.
    """
    def identity(info: os.stat_result) -> tuple:
        return (info.st_dev, info.st_ino, info.st_mode, info.st_size,
                info.st_mtime_ns, info.st_ctime_ns)

    def unique_object(pairs: list[tuple[str, object]]) -> dict:
        value = {}
        for name, item in pairs:
            if name in value:
                raise ValueError("duplicate_record_member")
            value[name] = item
        return value

    def reject_constant(value: str) -> object:
        raise ValueError("nonfinite_record_number")

    def finite_float(value: str) -> float:
        import math
        result = float(value)
        if not math.isfinite(result):
            raise ValueError("nonfinite_record_number")
        return result

    limit = 2 * 1024 * 1024
    if path.resolve() != path:
        raise ValueError("noncanonical_record")
    before = path.lstat()
    if not stat.S_ISREG(before.st_mode) or before.st_size > limit:
        raise ValueError("record_not_bounded_regular_file")
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        if identity(os.fstat(fd)) != identity(before):
            raise ValueError("record_changed_before_read")
        with os.fdopen(fd, "rb", closefd=False) as handle:
            raw = handle.read(limit + 1)
        if (len(raw) > limit or identity(os.fstat(fd)) != identity(before)
                or identity(path.lstat()) != identity(before)
                or path.resolve() != path):
            raise ValueError("record_changed_during_read")
    finally:
        os.close(fd)
    return raw, json.loads(raw, object_pairs_hook=unique_object,
                           parse_constant=reject_constant, parse_float=finite_float)


def retention_history(deployment_root: Path, current_commit: str, keep: int) -> dict:
    """Positive deployment observations only; malformed/missing history is explicit."""
    deployed = []
    issues: dict[str, int] = {}
    checked = 0
    def issue(name: str) -> None:
        issues[name] = issues.get(name, 0) + 1
    try:
        if deployment_root.resolve() != deployment_root or not deployment_root.is_dir():
            raise ValueError("receipt_root_unknown")
        with os.scandir(deployment_root) as listing:
            for child in listing:
                checked += 1
                if checked > 4096:
                    issue("history_budget_exceeded")
                    break
                if not child.is_dir(follow_symlinks=False):
                    if child.is_symlink():
                        issue("noncanonical_receipt_directory")
                    continue
                result_path = Path(child.path) / "result.json"
                try:
                    _, value = read_retention_record(result_path)
                    if not isinstance(value, dict):
                        raise ValueError("invalid_receipt")
                    if "status" not in value:
                        # The shared directory also holds receipts from
                        # other release protocols. Do not assert corruption
                        # or interpret their state as this schema's status.
                        issue("unclassified_receipt_schema")
                        continue
                    if not isinstance(value["status"], str):
                        raise ValueError("invalid_receipt")
                    if value["status"] != "deployed":
                        continue
                    commit, finished = value.get("commit"), value.get("finishedAtMs")
                    if (not isinstance(commit, str) or not COMMIT_PATTERN.fullmatch(commit)
                            or type(finished) is not int or finished < 0):
                        raise ValueError("invalid_receipt")
                    deployed.append((finished, commit))
                except FileNotFoundError:
                    issue("missing_result")
                except (OSError, ValueError, TypeError):
                    issue("invalid_receipt")
    except (OSError, ValueError):
        issue("receipt_root_unknown")
    protected = {current_commit}
    for _, commit in sorted(deployed, reverse=True):
        if len(protected) >= keep:
            break
        protected.add(commit)
    return {"protected": protected, "historyStanding": "UNKNOWN" if issues else "OBSERVED",
            "historyIssues": issues, "historyEntriesChecked": checked}


def prune_candidate_artifacts(
    candidate_dir: Path,
    deployment_root: Path,
    current_commit: str,
    *,
    keep: int = 2,
) -> dict[str, object]:
    """Project the historical retention preference without deleting release values.

    A deployed receipt proves that one release succeeded at a past time; it
    neither releases another exact candidate's consumer nor proves a retained
    equivalent copy. The current and previous successful commits are protected,
    and all other commit-shaped directories remain deferred until the release
    owner supplies independent retirement evidence. Never infer deletion
    authority from age, a missing receipt, or chronological rank. This projection
    deliberately performs no filesystem mutation; build-cache reclamation has
    a separate reconstructibility and native-lock contract.
    """
    candidate_commit_dir = candidate_dir.resolve().parent
    candidate_root = candidate_commit_dir.parent
    if (
        candidate_dir.name != "release"
        or candidate_commit_dir.name != current_commit
        or not candidate_root.is_dir()
    ):
        return {"status": "skipped", "reason": "nonstandard_candidate_layout", "actions": [], "failures": []}
    history = retention_history(deployment_root, current_commit, keep)
    preserved = history["protected"]
    deferred = [
        child.name for child in sorted(candidate_root.iterdir())
        if child.is_dir() and not child.is_symlink()
        and COMMIT_PATTERN.fullmatch(child.name) and child.name not in preserved
    ]
    return {
        "status": "deferred" if deferred else "completed",
        "candidateRoot": str(candidate_root),
        "preservedCommits": sorted(preserved),
        "deferredCommits": deferred,
        "historyStanding": history["historyStanding"],
        "historyIssues": history["historyIssues"],
        "reason": "independent_candidate_retirement_not_established" if deferred else None,
        "actions": [],
        "failures": [],
    }


def retention_manifest(child: Path) -> tuple[str, list[str]]:
    """Observe two known manifest filenames without preferring conflicting bytes.

    Historical prepare accepted an explicit --candidate-manifest path. These
    are the two observed conventions, not proof of complete manifest coverage.
    A missing modern name may have a qualified historical representation;
    a present but invalid modern record must never be shadowed by another.
    """
    observed = []
    for name in ("ordivon-deployment-manifest.json", "manifest.json"):
        path = child / "release" / name
        try:
            path.lstat()
        except FileNotFoundError:
            continue
        raw, value = read_retention_record(path)
        if (not isinstance(value, dict) or value.get("commit") != child.name
                or value.get("candidateDir") != str(child / "release")):
            raise ValueError("manifest_subject_mismatch")
        if (
            type(value.get("schemaVersion")) is not int
            or value["schemaVersion"] != SCHEMA_VERSION
            or value.get("sourceMaterialization") != "detached_git_checkout"
        ):
            raise ValueError("manifest_schema_unqualified")
        observed.append((path, raw))
    if not observed:
        raise ValueError("manifest_not_observed")
    if any(raw != observed[0][1] for _, raw in observed):
        raise ValueError("conflicting_manifest_representations")
    return "sha256:" + hashlib.sha256(observed[0][1]).hexdigest(), [
        str(path) for path, _ in observed
    ]


def retention_subject(child: Path, protected: set[str], *, max_entries: int = 20000) -> dict:
    """Reverse projection: explain observed retention cost and missing evidence.

    Directory/manifest identity is an observation, not a generation lease.
    Allocation is per-subject distinct inode blocks, not exclusive free bytes.
    Any unreadable, foreign, nonregular, symlink or over-budget subtree makes
    the allocation UNKNOWN. No filesystem effects or consumer certification.
    """
    subject = {
        "name": child.name, "path": str(child), "disposition": "UNKNOWN",
        "allocationStanding": "UNKNOWN", "allocatedBytes": None,
        "duplicateInodeEntries": 0, "manifestDigest": None, "manifestPaths": [],
        "identity": None, "missingEvidence": [], "observations": [],
    }
    try:
        entry = child.lstat()
        if not stat.S_ISDIR(entry.st_mode) or child.resolve() != child:
            subject["observations"].append("noncanonical_candidate_path")
            subject["missingEvidence"].append("EXACT_RESOURCE_IDENTITY")
            return subject
        subject["identity"] = {"device": entry.st_dev, "inode": entry.st_ino,
                               "mtimeNs": entry.st_mtime_ns}
        standard = COMMIT_PATTERN.fullmatch(child.name) is not None
        if standard:
            subject["disposition"] = "PROTECTED" if child.name in protected else "DEFERRED"
            if child.name not in protected:
                subject["missingEvidence"] = [
                    "EXACT_CONSUMER_RELEASE", "INDEPENDENT_PRESERVATION",
                    "EFFECT_TIME_NATIVE_FENCE",
                ]
        else:
            subject["missingEvidence"] = ["EXACT_RESOURCE_CLASSIFICATION"]
        try:
            subject["manifestDigest"], subject["manifestPaths"] = retention_manifest(child)
        except (OSError, ValueError, TypeError):
            subject["observations"].append("manifest_identity_unqualified")
            subject["missingEvidence"].append("EXACT_MANIFEST_IDENTITY")
        seen = set()
        pending = [child]
        blocks = 0
        visited = 0
        while pending:
            item = pending.pop()
            info = item.lstat()
            visited += 1
            if visited > max_entries:
                raise ValueError("entry_budget_exceeded")
            if (info.st_dev != entry.st_dev or os.path.ismount(item)
                    or not (stat.S_ISREG(info.st_mode) or stat.S_ISDIR(info.st_mode))):
                raise ValueError("foreign_or_nonregular_entry")
            key = (info.st_dev, info.st_ino)
            if key in seen:
                subject["duplicateInodeEntries"] += 1
                continue
            seen.add(key)
            blocks += info.st_blocks * 512
            if stat.S_ISDIR(info.st_mode):
                with os.scandir(item) as listing:
                    for sub in listing:
                        if visited + len(pending) >= max_entries:
                            raise ValueError("entry_budget_exceeded")
                        pending.append(Path(sub.path))
        end = child.lstat()
        if (end.st_dev, end.st_ino, end.st_mtime_ns) != (
                entry.st_dev, entry.st_ino, entry.st_mtime_ns):
            raise ValueError("candidate_changed_during_scan")
        subject.update(allocationStanding="OBSERVED", allocatedBytes=blocks)
    except (OSError, ValueError) as error:
        subject["missingEvidence"].append("COMPLETE_ALLOCATION_OBSERVATION")
        subject["observations"].append(
            str(error) if isinstance(error, ValueError) else type(error).__name__
        )
    return subject


def inspect_candidate_retention(args: argparse.Namespace) -> dict:
    """Bounded read-only projection; cursor is lexical, not a stable snapshot."""
    if not 1 <= args.limit <= 100:
        raise ValueError("limit must be 1..100")
    if args.after is not None and (not args.after or Path(args.after).name != args.after):
        raise ValueError("after must be an exact child name")
    candidate = args.candidate_dir
    root = candidate.parent.parent
    if (candidate.resolve() != candidate or candidate.name != "release"
            or candidate.parent.name != args.commit or not candidate.is_dir()
            or not root.is_dir() or root.resolve() != root):
        raise ValueError("noncanonical candidate layout")
    history = retention_history(args.receipt_root, args.commit, 2)
    protected = history["protected"]
    names = []
    with os.scandir(root) as listing:
        for child in listing:
            names.append(child.name)
            if len(names) > 4096:
                raise ValueError("candidate root census budget exceeded")
    remaining = sorted(n for n in names if args.after is None or n > args.after)
    chosen = remaining[:args.limit]
    subjects = [retention_subject(root / n, protected) for n in chosen]
    if history["historyStanding"] == "UNKNOWN":
        for subject in subjects:
            if subject["disposition"] != "PROTECTED":
                subject["missingEvidence"].append("COMPLETE_RETENTION_HISTORY")
    return {
        "schemaVersion": 1, "kind": "ordivon.release-retention-observation",
        "observedAtMs": int(time.time() * 1000), "effect": "none",
        "candidateRoot": str(root), "referenceCommit": args.commit,
        "referenceAuthority": "caller_supplied_not_installed_state",
        "censusCount": len(names), "subjects": subjects, "actions": [],
        "historyStanding": history["historyStanding"],
        "historyIssues": history["historyIssues"],
        "historyEntriesChecked": history["historyEntriesChecked"],
        "nextAfter": chosen[-1] if len(remaining) > len(chosen) else None,
        "snapshotStanding": "bounded_observation_not_atomic",
        "allocationMeaning": "distinct inode blocks per subject; not exclusive reclaim bytes",
        "authority": "observation_only",
    }


def apply_deployment(args: argparse.Namespace) -> dict[str, object]:
    if args.confirm_commit != args.commit:
        raise RuntimeError("confirm-commit must exactly equal commit")
    release_effect = structured_release_effect(args)
    drain_seconds, drain_policy_source = structured_release_drain_policy(args, release_effect)
    with exclusive_lock(args.lock_file):
        if release_effect is not None:
            receipt = structured_receipt_path(args.receipt_root, str(release_effect["effectId"]))
            replay = existing_structured_release_result(receipt, release_effect)
            if replay is not None:
                return replay
            receipt.mkdir(parents=True, exist_ok=False)
            write_json_atomic(receipt / "effect-request.json", release_effect)
        else:
            receipt = receipt_path(args.receipt_root, args.commit)

        try:
            initial_plan = deployment_plan(args)
            non_job_blockers = [
                blocker
                for blocker in initial_plan["blockers"]
                if blocker != "active or held Jobs exist other than the deployment Job"
            ]
            if non_job_blockers:
                raise RuntimeError("deployment is not eligible: " + "; ".join(non_job_blockers))
        except Exception as setup_error:
            if release_effect is not None:
                write_json_atomic(
                    receipt / "result.json",
                    {
                        "schemaVersion": SCHEMA_VERSION,
                        "status": "not_committed",
                        "commit": args.commit,
                        "finishedAtMs": int(time.time() * 1000),
                        "deploymentError": str(setup_error),
                        "receipt": str(receipt),
                        "releaseEffect": release_effect,
                    },
                )
            raise

        plan = initial_plan
        specs = release_artifact_specs(args)
        previous = receipt / "previous"
        previous.mkdir(parents=True)
        installed_by_name = {str(item["name"]): item for item in plan["installed"]}
        baseline_projection = plan.get("installedBaseline")
        previous_commit = (
            str(baseline_projection["commit"])
            if isinstance(baseline_projection, dict)
            and isinstance(baseline_projection.get("commit"), str)
            else matching_release_commit(
                args.receipt_root,
                [item for item in plan["installed"] if bool(item.get("present"))],
            )
        )
        runtime_policy = plan["candidateManifest"].get("runtimePolicy")
        release_authority = (
            candidate_release_authority(args) if runtime_policy is not None else None
        )
        previous_runtime_policy = (
            runtime_policy_transaction_preimage(args.env_file, runtime_policy)
            if runtime_policy is not None
            else None
        )
        previous_release_authority = (
            release_authority_state(args.env_file) if release_authority is not None else None
        )
        registry_migration_before: int | None = None
        previous_records: list[dict[str, object]] = []
        commit_started = False
        environment_committed = False
        stopped = False
        admission_fence_handle = None
        try:
            for spec in specs:
                name = str(spec["name"])
                installed = installed_by_name[name]
                if not bool(installed.get("present")):
                    previous_records.append(
                        {
                            "name": name,
                            "kind": str(spec["kind"]),
                            "present": False,
                            "mode": None,
                            "bytes": None,
                            "digest": None,
                        }
                    )
                    continue
                if not bool(installed.get("usable")):
                    raise RuntimeError(f"installed release artifact is unusable: {name}")
                previous_mode = installed.get("mode")
                if not isinstance(previous_mode, int):
                    raise RuntimeError(f"installed release artifact has no mode: {name}")
                atomic_copy(args.install_dir / name, previous / name, mode=previous_mode)
                record = artifact_description(
                    previous / name,
                    {"name": name, "kind": spec["kind"], "mode": previous_mode},
                )
                record["present"] = True
                previous_records.append(record)
            write_json_atomic(
                receipt / "manifest.json",
                {
                    "schemaVersion": SCHEMA_VERSION,
                    "commit": args.commit,
                    "service": args.service,
                    "artifacts": [
                        {
                            "name": str(spec["name"]),
                            "kind": str(spec["kind"]),
                            "mode": int(spec["mode"]),
                        }
                        for spec in specs
                    ],
                    "binaries": list(binaries(args)),
                    "previousCommit": previous_commit,
                    "installDir": str(args.install_dir),
                    "envFile": str(args.env_file),
                    "previous": previous_records,
                    "candidate": plan["candidate"],
                    "runtimePolicy": (
                        {
                            "previous": previous_runtime_policy,
                            "candidate": runtime_policy,
                        }
                        if runtime_policy is not None
                        else None
                    ),
                    "releaseAuthority": (
                        {
                            "previous": validate_release_authority(
                                previous_release_authority, require_complete=False
                            ),
                            "candidate": release_authority,
                        }
                        if release_authority is not None
                        else None
                    ),
                    "releaseEffect": release_effect,
                },
            )
            admission_fence_handle = acquire_exclusive_admission_fence(args.database)
            remaining_jobs = wait_for_execution_drain(args.database, drain_seconds)
            if remaining_jobs:
                raise RuntimeError(
                    "deployment drain timed out with active or held Jobs: "
                    + ", ".join(remaining_jobs)
                )
            # Stop ingress immediately after the Registry first reaches zero. This ordering is
            # required for the one-time bootstrap from a Runtime that does not yet participate in
            # admission.lock; doing full candidate/ref revalidation before stop would reopen the
            # plan→apply race we are trying to remove. Future fenced Runtimes cannot admit here.
            run([str(args.systemctl), "stop", args.service])
            stopped = True
            race_jobs, _ = active_job_ids(args.database)
            if race_jobs:
                raise RuntimeError(
                    "active or held Jobs appeared after service stop: "
                    + ", ".join(race_jobs)
                )
            plan = deployment_plan(args)
            if not plan["eligible"]:
                raise RuntimeError(
                    "deployment is not eligible after ingress stop: "
                    + "; ".join(plan["blockers"])
                )
            registry_migration_before = registry_migration_version(args.database)
            plan["registryMigrationBefore"] = registry_migration_before
            plan["admissionFence"] = str(admission_fence_path(args.database))
            plan["drainSeconds"] = drain_seconds
            plan["drainPolicySource"] = drain_policy_source
            write_json_atomic(receipt / "plan.json", plan)
            # Keep the drain phase non-perturbing with respect to the installed Runtime
            # tree. Candidate bytes are already staged in candidate_dir, so no path
            # beneath install_dir is created, removed, or replaced until admission is
            # fenced, active Jobs have drained to zero, ingress is stopped, and the
            # candidate/ref plan has been revalidated against that cut.
            for spec in specs:
                name = str(spec["name"])
                atomic_copy(
                    args.candidate_dir / name,
                    args.install_dir / f"{name}.next",
                    mode=int(spec["mode"]),
                )
            for record in previous_records:
                if record.get("present", True) is False:
                    continue
                name = str(record["name"])
                atomic_copy(
                    previous / name,
                    args.install_dir / f"{name}.previous",
                    mode=int(record["mode"]),
                )
            commit_started = True
            if runtime_policy is not None or release_authority is not None:
                atomic_update_runtime_environment(
                    args.env_file,
                    runtime_policy=runtime_policy,
                    release_authority=release_authority,
                    expected_current_runtime_policy=previous_runtime_policy,
                    expected_current_release_authority=previous_release_authority,
                )
                environment_committed = True
            for spec in specs:
                name = str(spec["name"])
                os.replace(args.install_dir / f"{name}.next", args.install_dir / name)
            run([str(args.systemctl), "start", args.service])
            probe = wait_for_service_mcp_ready(
                args.systemctl,
                args.service,
                args.env_file,
                expected_tool_count=args.expected_tool_count,
                required=required_tools(args),
                wait_seconds=args.wait_seconds,
                require_modern=True,
                allow_legacy_fallback=False,
            )
            installed = [
                artifact_description(args.install_dir / str(spec["name"]), spec)
                for spec in specs
            ]
            candidate_prune = prune_candidate_artifacts(
                args.candidate_dir,
                args.receipt_root,
                args.commit,
            )
            result = {
                "schemaVersion": SCHEMA_VERSION,
                "status": "deployed",
                "commit": args.commit,
                "finishedAtMs": int(time.time() * 1000),
                "serviceActive": True,
                "probe": probe,
                "installed": installed,
                "candidatePrune": candidate_prune,
                "receipt": str(receipt),
                "releaseEffect": release_effect,
            }
            write_json_atomic(receipt / "result.json", result)
            return result
        except Exception as deployment_error:
            for spec in specs:
                name = str(spec["name"])
                (args.install_dir / f"{name}.next").unlink(missing_ok=True)
            rollback_error: Exception | None = None
            reconciliation_issue: str | None = None
            registry_migration_after: int | None = None
            registry_migration_error: str | None = None
            if commit_started:
                try:
                    registry_migration_after = registry_migration_version(args.database)
                except Exception as error:
                    registry_migration_error = str(error)

                migration_unchanged = (
                    registry_migration_before is not None
                    and registry_migration_after is not None
                    and registry_migration_after == registry_migration_before
                )
                if migration_unchanged:
                    try:
                        rollback = restore_previous(
                            previous,
                            args.install_dir,
                            previous_records,
                            args.systemctl,
                            args.service,
                            args.env_file,
                            args.wait_seconds,
                            runtime_policy=(
                                previous_runtime_policy if environment_committed else None
                            ),
                            expected_current_runtime_policy=(
                                runtime_policy if environment_committed else None
                            ),
                            release_authority=(
                                previous_release_authority if environment_committed else None
                            ),
                            expected_current_release_authority=(
                                release_authority if environment_committed else None
                            ),
                        )
                    except Exception as error:
                        rollback_error = error
                        rollback = {"serviceActive": service_active(args.systemctl, args.service)}
                    status = "rolled_back" if rollback_error is None else "rollback_failed"
                else:
                    if registry_migration_error is not None:
                        reconciliation_issue = "REGISTRY_SCHEMA_STATE_UNKNOWN_ROLLBACK_UNSAFE"
                    elif (
                        registry_migration_before is not None
                        and registry_migration_after is not None
                        and registry_migration_after > registry_migration_before
                    ):
                        reconciliation_issue = "REGISTRY_SCHEMA_ADVANCED_ROLLBACK_UNSAFE"
                    else:
                        reconciliation_issue = "REGISTRY_SCHEMA_CHANGED_ROLLBACK_UNSAFE"
                    rollback = {
                        "suppressed": True,
                        "reason": reconciliation_issue,
                        "serviceActive": service_active(args.systemctl, args.service),
                    }
                    status = "reconciliation_required"
            else:
                recovery_error: Exception | None = None
                recovery: dict[str, object] | None = None
                if stopped or not service_active(args.systemctl, args.service):
                    try:
                        run([str(args.systemctl), "start", args.service])
                        recovery = {
                            "serviceActive": True,
                            "probe": wait_for_service_mcp_ready(
                                args.systemctl,
                                args.service,
                                args.env_file,
                                expected_tool_count=args.expected_tool_count,
                                required=required_tools(args),
                                wait_seconds=args.wait_seconds,
                                require_modern=False,
                                allow_legacy_fallback=True,
                            ),
                        }
                    except Exception as error:
                        recovery_error = error
                        recovery = {
                            "serviceActive": service_active(args.systemctl, args.service)
                        }
                rollback = recovery
                rollback_error = recovery_error
                status = "not_committed" if recovery_error is None else "recovery_failed"
            result = {
                "schemaVersion": SCHEMA_VERSION,
                "status": status,
                "commit": args.commit,
                "finishedAtMs": int(time.time() * 1000),
                "deploymentError": str(deployment_error),
                "rollbackError": str(rollback_error) if rollback_error else None,
                "rollback": rollback,
                "reconciliationIssue": reconciliation_issue,
                "registryMigration": {
                    "before": registry_migration_before,
                    "after": registry_migration_after,
                    "inspectionError": registry_migration_error,
                },
                "serviceWasStopped": stopped,
                "receipt": str(receipt),
                "releaseEffect": release_effect,
            }
            write_json_atomic(receipt / "result.json", result)
            raise RuntimeError(
                f"deployment failed and {status}: {deployment_error}"
                + (f"; rollback: {rollback_error}" if rollback_error else "")
            ) from deployment_error
        finally:
            if admission_fence_handle is not None:
                admission_fence_handle.close()

def require_current_rollback_receipt(receipt: Path) -> None:
    """Allow rollback only from the latest successful release epoch.

    Historical preimages are authentic data, not authority to replace a later
    release. This guard does not forbid recovery of an unknown installed-file
    drift from the latest actual release.
    """
    latest = latest_release_state(receipt.parent)
    expected_event = receipt / "result.json"
    if latest is None or Path(str(latest["receiptEvent"])).resolve() != expected_event:
        raise RuntimeError("rollback receipt is not the current release")
    # A successful rollback can have no previousCommit (unknown provenance),
    # so release_history_states intentionally omits it from known-Commit
    # baselines. It still consumes the rollback epoch and must block replay.
    for event_path in receipt.parent.glob("*/rollback-result.json"):
        if event_path.is_symlink():
            raise RuntimeError("rollback history is unsafe")
        try:
            event = json.loads(event_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as error:
            raise RuntimeError("rollback history is unreadable") from error
        if not isinstance(event, dict) or event.get("status") != "restored_previous":
            continue
        finished = event.get("finishedAtMs")
        if type(finished) is not int or finished >= int(latest["finishedAtMs"]):
            raise RuntimeError("rollback receipt is not the current release")


def rollback_deployment(args: argparse.Namespace) -> dict[str, object]:
    receipt = args.receipt.resolve()
    if args.confirm_receipt.resolve() != receipt:
        raise RuntimeError("confirm-receipt must exactly equal receipt")
    manifest = json.loads((receipt / "manifest.json").read_text(encoding="utf-8"))
    version = manifest.get("schemaVersion")
    if version not in {LEGACY_SCHEMA_VERSION, SCHEMA_VERSION}:
        raise RuntimeError("deployment receipt schemaVersion is unsupported")
    if version == SCHEMA_VERSION:
        raw_artifacts = manifest.get("artifacts")
        if not isinstance(raw_artifacts, list) or not raw_artifacts:
            raise RuntimeError("deployment receipt has no release artifacts")
        names = tuple(
            str(item.get("name")) for item in raw_artifacts if isinstance(item, dict)
        )
    else:
        names = tuple(str(name) for name in manifest.get("binaries", []))
    if not names or len(names) != len(set(names)):
        raise RuntimeError("deployment receipt has an invalid artifact set")
    if manifest.get("installDir") != str(args.install_dir):
        raise RuntimeError("install-dir does not match the deployment receipt")
    if manifest.get("service") != args.service:
        raise RuntimeError("service does not match the deployment receipt")
    if manifest.get("envFile") != str(args.env_file):
        raise RuntimeError("env-file does not match the deployment receipt")
    previous_records = [
        item for item in manifest.get("previous", []) if isinstance(item, dict)
    ]
    previous_by_name = {str(item.get("name")): item for item in previous_records}
    if set(previous_by_name) != set(names):
        raise RuntimeError("deployment receipt previous-artifact set is incomplete")
    for name in names:
        record = previous_by_name[name]
        previous = receipt / "previous" / name
        if record.get("present", True) is False:
            if previous.exists() or previous.is_symlink():
                raise RuntimeError(f"absent previous artifact unexpectedly has bytes: {name}")
            if record.get("digest") is not None or record.get("mode") is not None:
                raise RuntimeError(f"absent previous artifact has invalid receipt metadata: {name}")
            continue
        expected = record.get("digest")
        if not isinstance(expected, str) or sha256(previous) != expected:
            raise RuntimeError(f"previous artifact digest does not match receipt: {name}")
        receipt_record_mode(record)
    runtime_policy_record = manifest.get("runtimePolicy")
    previous_runtime_policy = None
    candidate_runtime_policy_value = None
    if runtime_policy_record is not None:
        if not isinstance(runtime_policy_record, dict):
            raise RuntimeError("deployment receipt Runtime policy record is invalid")
        previous_runtime_policy = validate_runtime_policy(
            runtime_policy_record.get("previous"), require_complete=False
        )
        candidate_runtime_policy_value = validate_runtime_policy(
            runtime_policy_record.get("candidate"), require_complete=True
        )
    release_authority_record = manifest.get("releaseAuthority")
    previous_release_authority = None
    candidate_release_authority_value = None
    if release_authority_record is not None:
        if not isinstance(release_authority_record, dict):
            raise RuntimeError("deployment receipt release authority record is invalid")
        previous_release_authority = validate_release_authority(
            release_authority_record.get("previous"), require_complete=False
        )
        candidate_release_authority_value = validate_release_authority(
            release_authority_record.get("candidate"), require_complete=True
        )
    database = rollback_database(args)
    with exclusive_lock(args.lock_file), fenced_execution_drain(database, args.drain_seconds):
        # Release apply uses this same lock. Recheck after acquiring it so a
        # concurrent successful deploy cannot make this preimage stale.
        # Legacy v1 recovery receipts did not record a current release
        # fingerprint. Keep their explicitly confirmed recovery contract;
        # modern v2 receipts must prove they are the latest release event.
        if version == SCHEMA_VERSION:
            require_current_rollback_receipt(receipt)
        current = receipt / f"rollback-current-{int(time.time() * 1000)}"
        current.mkdir()
        current_runtime_policy = (
            runtime_policy_state(args.env_file) if previous_runtime_policy is not None else None
        )
        current_release_authority = (
            release_authority_state(args.env_file)
            if previous_release_authority is not None
            else None
        )
        current_records: list[dict[str, object]] = []
        for name in names:
            path = args.install_dir / name
            if path.is_symlink() or not path.is_file():
                raise RuntimeError(f"current release artifact is missing or unsafe: {path}")
            mode = stat.S_IMODE(path.stat().st_mode)
            kind = str(previous_by_name[name].get("kind", "binary"))
            atomic_copy(path, current / name, mode=mode)
            current_records.append(
                artifact_description(
                    current / name,
                    {"name": name, "kind": kind, "mode": mode},
                )
            )
        try:
            outcome = restore_previous(
                receipt / "previous",
                args.install_dir,
                previous_records,
                args.systemctl,
                args.service,
                args.env_file,
                args.wait_seconds,
                runtime_policy=previous_runtime_policy,
                expected_current_runtime_policy=candidate_runtime_policy_value,
                release_authority=previous_release_authority,
                expected_current_release_authority=candidate_release_authority_value,
            )
        except Exception as rollback_error:
            current_restore_error: Exception | None = None
            try:
                current_outcome = restore_previous(
                    current,
                    args.install_dir,
                    current_records,
                    args.systemctl,
                    args.service,
                    args.env_file,
                    args.wait_seconds,
                    runtime_policy=current_runtime_policy,
                    release_authority=current_release_authority,
                )
            except Exception as error:
                current_restore_error = error
                current_outcome = {"serviceActive": service_active(args.systemctl, args.service)}
            failed = {
                "schemaVersion": SCHEMA_VERSION,
                "status": (
                    "rollback_failed_current_restored"
                    if current_restore_error is None
                    else "rollback_failed_current_restore_failed"
                ),
                "receipt": str(receipt),
                "finishedAtMs": int(time.time() * 1000),
                "rollbackError": str(rollback_error),
                "currentRestoreError": str(current_restore_error) if current_restore_error else None,
                "currentBackup": str(current),
                "currentRestore": current_outcome,
            }
            write_json_atomic(receipt / "rollback-result.json", failed)
            raise RuntimeError(
                f"explicit rollback failed: {rollback_error}"
                + (
                    f"; current restore also failed: {current_restore_error}"
                    if current_restore_error
                    else "; current deployment was restored"
                )
            ) from rollback_error
        restored_records: list[dict[str, object]] = []
        for name in names:
            record = previous_by_name[name]
            path = args.install_dir / name
            if record.get("present", True) is False:
                if path.exists() or path.is_symlink():
                    raise RuntimeError(f"rollback failed to restore artifact absence: {name}")
                continue
            restored_records.append(
                artifact_description(
                    path,
                    {
                        "name": name,
                        "kind": str(record.get("kind", "binary")),
                        "mode": receipt_record_mode(record),
                    },
                )
            )
        previous_commit = manifest.get("previousCommit")
        if not isinstance(previous_commit, str) or not COMMIT_PATTERN.fullmatch(previous_commit):
            previous_commit = None
        result = {
            "schemaVersion": SCHEMA_VERSION,
            "status": "restored_previous",
            "releaseDisposition": "rollback",
            "commit": previous_commit,
            "commitKnown": previous_commit is not None,
            "receipt": str(receipt),
            "finishedAtMs": int(time.time() * 1000),
            "currentBackup": str(current),
            "installed": restored_records,
            **outcome,
        }
        write_json_atomic(receipt / "rollback-result.json", result)
        return result

def main() -> int:
    try:
        args = parse_args()
        if args.command == "root-bundle-plan":
            value = root_operator_bundle_plan(args)
            print(json.dumps(value, indent=2 if args.pretty else None, sort_keys=args.pretty))
            return 0 if value["eligibleForRootOwnerReview"] else 2
        if args.command == "root-bundle-stage":
            value = stage_root_operator_bundle(args)
            print(json.dumps(value, indent=2 if args.pretty else None, sort_keys=args.pretty))
            return 0
        if args.command == "candidate-retention-inspect":
            print(json.dumps(inspect_candidate_retention(args), sort_keys=True))
            return 0
        if args.command == "prepare":
            value = prepare_candidate(args)
            print(json.dumps(value, indent=2 if args.pretty else None, sort_keys=args.pretty))
            return 0
        if args.command == "plan":
            value = deployment_plan(args)
            print(json.dumps(value, indent=2 if args.pretty else None, sort_keys=args.pretty))
            return 0 if value["eligible"] else 2
        if args.command == "apply":
            print(json.dumps(apply_deployment(args), sort_keys=True))
            return 0
        if args.command == "rollback":
            print(json.dumps(rollback_deployment(args), sort_keys=True))
            return 0
        raise RuntimeError(f"unsupported command: {args.command}")
    except (OSError, RuntimeError, json.JSONDecodeError) as error:
        print(f"runtime deployment failed: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
