}

falsify_workspace_multi_agent_release() {
  verify_jar
  local label config invariant result output
  for label in reachability unsafe-single unsafe-age; do
    config="WorkspaceMultiAgentReleaseR1.$label.cfg"
    invariant="ClosedImpliesEveryConsumerReleased"
    if [[ "$label" == reachability ]]; then invariant="ClosedUnreachable"; fi
    set +e
    output=$(cd "$ROOT/formal" && java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
      -config "$config" WorkspaceMultiAgentReleaseR1.tla 2>&1)
    result=$?
    set -e
    if [[ "$result" != 12 ]] ||
       ! printf '%s\n' "$output" | grep -Fxq "Error: Invariant $invariant is violated." ||
       ! printf '%s\n' "$output" | grep -Eq '^State [1-9][0-9]*:'; then
      echo "Workspace multi-Agent $label counterexample FAILED" >&2
      printf '%s\n' "$output" | tail -38 >&2
      exit 1
    fi
    echo "Workspace multi-Agent $label named counterexample PASS"
  done
}

workspace_close_expect_named_counterexample() {
  local folder="$1" config="$2" property="$3" label="$4"
  local model="${5:-WorkspaceConsumerCloseR1.tla}"
  local output="$folder/result.log" result
  set +e
  (cd "$folder"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
    -config "$config" "$model") > "$output" 2>&1
  result=$?
  set -e
  if [[ "$result" -ne 12 ]] ||
      ! grep -Fxq "Error: Invariant $property is violated." "$output" ||
      ! grep -Fxq 'Error: The behavior up to this point is:' "$output" ||
      ! grep -Eq '^State [1-9][0-9]*:' "$output"; then
    echo "Workspace consumer close $label negative control FAILED" >&2
    tail -45 "$output" >&2
    exit 1
  fi
  echo "Workspace consumer close $label negative control PASS: $property"
}

workspace_close_expect_temporal_counterexample() {
  local folder="$1" config="$2" label="$3"
  local output="$folder/result.log" result
  set +e
  (cd "$folder"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
    -config "$config" WorkspaceConsumerCloseR1.tla) > "$output" 2>&1
  result=$?
  set -e
  if [[ "$result" -ne 13 ]] ||
      ! grep -Fxq 'Error: Temporal properties were violated.' "$output" ||
      ! grep -Fxq 'Error: The following behavior constitutes a counter-example:' "$output" ||
      ! grep -Eq '^State [1-9][0-9]*:' "$output" ||
      ! grep -Eq '^State [1-9][0-9]*: Stuttering$' "$output"; then
    echo "Workspace consumer close $label temporal negative control FAILED" >&2
    tail -50 "$output" >&2
    exit 1
  fi
  echo "Workspace consumer close $label temporal negative control PASS"
}

check_workspace_consumer_close_counterexamples() {
  verify_jar
  (
    tmp_dir=$(mktemp -d -t ordivon-workspace-close-XXXXXX)
    trap 'rm -rf -- "$tmp_dir"' EXIT
    for kind in reachability unguarded spoofed ageonly fairness r2unguarded r2fairness r2reachable collectorunguarded collectorreachable; do
      mkdir "$tmp_dir/$kind"
      cp "$ROOT/formal/WorkspaceConsumerCloseR1.tla" "$tmp_dir/$kind/"
      cp "$ROOT/formal/WorkspaceConsumerCloseR1.cfg" "$tmp_dir/$kind/"
    done
    cp "$ROOT/formal/WorkspaceConsumerCloseR1.reachability.cfg" "$tmp_dir/reachability/"
    cp "$ROOT/formal/WorkspaceConsumerCloseR1.liveness.cfg" "$tmp_dir/fairness/"
    cp "$ROOT/formal/WorkspaceConsumerCloseR1.r2-candidate.cfg" "$tmp_dir/r2unguarded/"
    cp "$ROOT/formal/WorkspaceConsumerCloseR1.r2-candidate.cfg" "$tmp_dir/r2fairness/"
    cp "$ROOT/formal/WorkspaceConsumerCloseR1.r2-candidate.cfg" "$tmp_dir/r2reachable/"
    cp "$ROOT/formal/WorkspaceConsumerCloseR1.collector.cfg" "$tmp_dir/collectorunguarded/"
    cp "$ROOT/formal/WorkspaceConsumerCloseR1.collector.cfg" "$tmp_dir/collectorreachable/"
    workspace_close_expect_named_counterexample "$tmp_dir/reachability" \
      WorkspaceConsumerCloseR1.reachability.cfg ClosedUnreachable reachable

    python3 - "$tmp_dir" <<'PY_WORKSPACE_CLOSE'
from pathlib import Path
import sys

root = Path(sys.argv[1])
model = "WorkspaceConsumerCloseR1.tla"
source = (root / "unguarded" / model).read_text(encoding="utf-8")
guard = '    /\\ (released \\/ age = "expired")\n'
close_start = source.index("Close ==\n")
close_end = source.index("\nNext ==\n", close_start)
close_transition = source[close_start:close_end]
assert close_transition.count(guard) == 1, "close guard drift"
(root / "unguarded" / model).write_text(
    source[:close_start]
    + close_transition.replace(guard, "", 1)
    + source[close_end:],
    encoding="utf-8",
)

source = (root / "spoofed" / model).read_text(encoding="utf-8")
honest = '    /\\ consumer = "finished"\n    /\\ ~released'
spoof = '    /\\ consumer = "active"\n    /\\ ~released'
assert source.count(honest) == 1, "release transition drift"
(root / "spoofed" / model).write_text(
    source.replace(honest, spoof, 1), encoding="utf-8"
)
cfg = root / "spoofed" / "WorkspaceConsumerCloseR1.cfg"
content = cfg.read_text(encoding="utf-8")
qualification = "INVARIANT ReleasedAssumesConsumerFinished\n"
assert content.count(qualification) == 1
cfg.write_text(content.replace(qualification, "", 1), encoding="utf-8")

# Model-space known gap: age expiry alone can still close an active consumer.
cfg = root / "ageonly" / "WorkspaceConsumerCloseR1.cfg"
cfg_source = cfg.read_text(encoding="utf-8")
ending = "CHECK_DEADLOCK FALSE\n"
assert cfg_source.count(ending) == 1
cfg.write_text(
    cfg_source.replace(ending, "INVARIANT ExpiredActiveConsumerCannotBeClosed\n" + ending, 1),
    encoding="utf-8",
)

# Liveness is conditional on fairness. Deleting that assumption must
# yield a real infinite-stuttering trace instead of a vacuous PASS.
model_path = root / "fairness" / model
source = model_path.read_text(encoding="utf-8")
fair = "FairCloseSpec == Spec /\\ WF_vars(Close)"
assert source.count(fair) == 1, "close fairness contract drift"
model_path.write_text(source.replace(fair, "FairCloseSpec == Spec", 1), encoding="utf-8")

# The R2 candidate MUST be sensitive to its consumer-confirmation guard.
# Restrict the mutation to this action, not the earlier consumer event
# or the historical R1 Close action.
model_path = root / "r2unguarded" / model
source = model_path.read_text(encoding="utf-8")
start = source.index("R2CandidateClose ==\n")
end = source.index("\nNextR2Candidate ==\n", start)
action = source[start:end]
guard = '    /\\ consumer = "finished"\n'
assert action.count(guard) == 1, "R2 candidate close guard drift"
model_path.write_text(
    source[:start] + action.replace(guard, "", 1) + source[end:],
    encoding="utf-8",
)

# The second R2 control prevents a vacuous progress claim from
# passing merely because the scheduler is free to stutter forever.
model_path = root / "r2fairness" / model
source = model_path.read_text(encoding="utf-8")
fair = "FairR2CandidateSpec == R2CandidateSpec /\\ WF_vars(R2CandidateClose)"
assert source.count(fair) == 1, "R2 candidate fairness drift"
model_path.write_text(
    source.replace(fair, "FairR2CandidateSpec == R2CandidateSpec", 1),
    encoding="utf-8",
)

# Non-vacuity: R2 must actually close a fresh Workspace after a
# finished-and-released consumer, without waiting for the age limit.
cfg = root / "r2reachable" / "WorkspaceConsumerCloseR1.r2-candidate.cfg"
content = cfg.read_text(encoding="utf-8")
assert content.count("SPECIFICATION FairR2CandidateSpec\n") == 1
assert content.count("CHECK_DEADLOCK FALSE\n") == 1
cfg.write_text(
    content.replace("SPECIFICATION FairR2CandidateSpec\n",
                    "SPECIFICATION R2CandidateSpec\n", 1)
           .replace("CHECK_DEADLOCK FALSE\n",
                    "INVARIANT R2CandidateFreshReleasedCloseUnreachable\nCHECK_DEADLOCK FALSE\n", 1),
    encoding="utf-8",
)
# The collector must reject expiry without release, but must reach close
# after exact release and expiry. Keep the independent invariant unchanged.
path = root / "collectorunguarded" / model
source = path.read_text(encoding="utf-8")
guard = 'CollectorEligible ==\n    /\\ R2CandidateEligible\n    /\\ age = "expired"\n    /\\ released\n'
assert source.count(guard) == 1, "collector release guard drift"
path.write_text(source.replace(guard, guard.rsplit("    /\\ released\n", 1)[0]), encoding="utf-8")
cfg = root / "collectorreachable" / "WorkspaceConsumerCloseR1.collector.cfg"
content = cfg.read_text(encoding="utf-8")
assert content.count("CHECK_DEADLOCK FALSE\n") == 1
cfg.write_text(content.replace("CHECK_DEADLOCK FALSE\n",
    "INVARIANT ClosedUnreachable\nCHECK_DEADLOCK FALSE\n"), encoding="utf-8")
PY_WORKSPACE_CLOSE
    workspace_close_expect_named_counterexample "$tmp_dir/unguarded" \
      WorkspaceConsumerCloseR1.cfg FreshActiveConsumerCannotBeClosed unguarded
    # Scope counterexample: a claimed release is not authenticated consumer truth.
    workspace_close_expect_named_counterexample "$tmp_dir/spoofed" \
      WorkspaceConsumerCloseR1.cfg FreshActiveConsumerCannotBeClosed spoofed
    workspace_close_expect_named_counterexample "$tmp_dir/ageonly" \
      WorkspaceConsumerCloseR1.cfg ExpiredActiveConsumerCannotBeClosed age-only-active-consumer
    workspace_close_expect_temporal_counterexample "$tmp_dir/fairness" \
      WorkspaceConsumerCloseR1.liveness.cfg fairness-removed
    workspace_close_expect_named_counterexample "$tmp_dir/r2reachable" \
      WorkspaceConsumerCloseR1.r2-candidate.cfg R2CandidateFreshReleasedCloseUnreachable r2-fresh-release-reachable
    workspace_close_expect_named_counterexample "$tmp_dir/r2unguarded" \
      WorkspaceConsumerCloseR1.r2-candidate.cfg R2CandidateClosedConsumerFinished r2-active-consumer
    workspace_close_expect_temporal_counterexample "$tmp_dir/r2fairness" \
      WorkspaceConsumerCloseR1.r2-candidate.cfg r2-fairness-removed
    workspace_close_expect_named_counterexample "$tmp_dir/collectorunguarded" \
      WorkspaceConsumerCloseR1.collector.cfg CollectorClosedHasRelease collector-release-removed
    workspace_close_expect_named_counterexample "$tmp_dir/collectorreachable" \
      WorkspaceConsumerCloseR1.collector.cfg ClosedUnreachable collector-close-reachable
    for field in generation source activity reachable; do
      folder="$tmp_dir/binding-$field"
      mkdir "$folder"
      cp "$ROOT/formal/WorkspaceReleaseBindingR1."{tla,cfg} "$folder/"
      python3 - "$folder" "$field" <<'PY_BINDING'
from pathlib import Path
import sys
folder = Path(sys.argv[1])
field = sys.argv[2]
if field == "reachable":
    cfg = folder / "WorkspaceReleaseBindingR1.cfg"
    cfg.write_text(cfg.read_text() + "INVARIANT ClosedUnreachable\n")
else:
    model = folder / "WorkspaceReleaseBindingR1.tla"
    source = model.read_text()
    guard = "    /\\ release." + field + " = " + field + "\n"
    assert source.count(guard) == 1, "release binding guard drift"
    model.write_text(source.replace(guard, ""))
PY_BINDING
      property=ClosedHasCurrentRelease
      if [[ "$field" == reachable ]]; then property=ClosedUnreachable; fi
      workspace_close_expect_named_counterexample "$folder" WorkspaceReleaseBindingR1.cfg \
        "$property" "binding-$field" WorkspaceReleaseBindingR1.tla
    done
  )
}

