# R35: refine R24's abstract atomicReceiver with native OS crash/ACK
# counterexamples. This remains SOURCE-ONLY; qualification of the OS receiver
# and OriginalRun epoch/Domain ACK is independent of TLC's abstract actions.
check_issuer_revoke_ack_formal() {
  verify_jar
  java -XX:+UseParallelGC -cp "$JAR" tla2sany.SANY "$ROOT/formal/IssuerRevokeAckR1.tla"
  (cd "$ROOT/formal"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
    -config IssuerRevokeAckR1.safe.cfg IssuerRevokeAckR1.tla)
}

falsify_issuer_revoke_ack_formal() (
  set -e
  verify_jar
  local label invariant result output
  for label in backend-loss-counterexample ack-positive-reach spawn-positive-reach; do
    case "$label" in
      backend-loss-counterexample) invariant=NoSpawnAfterRevokeCommit ;;
      ack-positive-reach) invariant=AckUnreachable ;;
      spawn-positive-reach) invariant=TargetSpawnUnreachable ;;
    esac
    set +e
    output=$(cd "$ROOT/formal" && java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC \
      -workers 1 -config "IssuerRevokeAckR1.$label.cfg" IssuerRevokeAckR1.tla 2>&1)
    result=$?
    set -e
    if [[ "$result" -ne 12 ]] ||
       ! grep -Fxq "Error: Invariant $invariant is violated." <<< "$output" ||
       ! grep -Fxq 'Error: The behavior up to this point is:' <<< "$output" ||
       ! grep -Eq '^State [1-9][0-9]*:' <<< "$output"; then
      echo "Issuer revoke $label named TLC counterexample FAILED" >&2
      printf '%s\n' "$output" | tail -40 >&2
      exit 1
    fi
    if [[ "$label" == backend-loss-counterexample ]] &&
       ! grep -Fq 'pgGuard = "lost"' <<< "$output"; then
      echo "Issuer revoke PG backend-loss gate is vacuous" >&2
      exit 1
    fi
    echo "Issuer revoke $label named TLC counterexample PASS"
  done

  local dir result
  dir=$(mktemp -d -t ordivon-issuer-ack-cegar-XXXXXX)
  trap 'rm -rf -- "$dir"' EXIT
  cp "$ROOT/formal/IssuerRevokeAckR1.tla" "$dir/"
  cp "$ROOT/formal/IssuerRevokeAckR1.safe.cfg" "$dir/IssuerRevokeAckR1.cfg"

  # Deliberately let the revoke ACK commit while the OS Unit is still
  # pending. TLC MUST demonstrate an actual post-ACK native target spawn.
  python3 - "$dir/IssuerRevokeAckR1.tla" <<'PY_UNSAFE_ACK'
from pathlib import Path
import sys
path = Path(sys.argv[1])
src = path.read_text(encoding="utf-8")
start, end = src.index("PublishRevokeAck ==\n"), src.index("Next ==\n")
segment = src[start:end]
guard = '    /\\ nativeUnit = "quiescent"\n'
assert segment.count(guard) == 1, "Issuer ACK native quiescence guard drifted"
path.write_text(src[:start] + segment.replace(guard, "", 1) + src[end:], encoding="utf-8")
PY_UNSAFE_ACK
  # Remove the more immediate ACK-quiescence invariant from THIS negative
  # cfg so that the stronger NoFutureSpawn property is observed after spawn.
  sed -i '/^[[:space:]]*AckRequiresPhysicalQuiescence$/d' "$dir/IssuerRevokeAckR1.cfg"
  set +e
  output=$(cd "$dir" && java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC \
    -workers 1 -config IssuerRevokeAckR1.cfg IssuerRevokeAckR1.tla 2>&1)
  result=$?
  set -e
  if [[ "$result" -ne 12 ]] ||
     ! grep -Fxq 'Error: Invariant NoSpawnAfterRevokeAck is violated.' <<< "$output" ||
     ! grep -Fq 'revokeAck = TRUE' <<< "$output"; then
    echo "Issuer revoke premature ACK native target counterexample FAILED" >&2
    printf '%s\n' "$output" | tail -38 >&2
    exit 1
  fi
  echo "Issuer revoke premature ACK native target counterexample PASS"

  # Independently prove why durable stop/recovery fencing matters:
  # resurrecting a physically quiescent Unit after ACK can still spawn.
  cp "$ROOT/formal/IssuerRevokeAckR1.tla" "$dir/IssuerRevokeAckR1.tla"
  python3 - "$dir/IssuerRevokeAckR1.tla" <<'PY_UNSAFE_RECOVERY'
from pathlib import Path
import sys
path = Path(sys.argv[1])
src = path.read_text(encoding="utf-8")
marker = "Next ==\n"
unsafe = r'''UnsafeUnitRecoveryAfterAck ==
    /\ revokeAck
    /\ nativeUnit = "quiescent"
    /\ nativeUnit' = "pending"
    /\ UNCHANGED <<issuer, attempt, pgGuard, dispatchCount,
                   stopIntent, dispatchFenced, revokeAck,
                   spawnedAfterCommit, spawnedAfterAck>>

'''
assert src.count(marker) == 1, "Issuer ACK Next transition source drifted"
path.write_text(src.replace(marker, unsafe + marker +
                  r"    \/ UnsafeUnitRecoveryAfterAck" + "\n", 1), encoding="utf-8")
PY_UNSAFE_RECOVERY
  set +e
  output=$(cd "$dir" && java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC \
    -workers 1 -config IssuerRevokeAckR1.cfg IssuerRevokeAckR1.tla 2>&1)
  result=$?
  set -e
  if [[ "$result" -ne 12 ]] ||
     ! grep -Fxq 'Error: Invariant NoSpawnAfterRevokeAck is violated.' <<< "$output" ||
     ! grep -Fq 'revokeAck = TRUE' <<< "$output"; then
    echo "Issuer revoke post-ACK recovery redispatch counterexample FAILED" >&2
    printf '%s\n' "$output" | tail -38 >&2
    exit 1
  fi
  echo "Issuer revoke post-ACK recovery redispatch counterexample PASS"
)


# R35: The physical NoFutureSpawn ACK is epoch-wide, not a one-Unit receipt.
# The two Attempt identities and OS-quiet observations are design assumptions
# until the OriginalRun/Harness and native Runtime consumers are qualified.
check_issuer_revoke_epoch_formal() {
  verify_jar
  java -XX:+UseParallelGC -cp "$JAR" tla2sany.SANY "$ROOT/formal/IssuerRevokeEpochR1.tla"
  (cd "$ROOT/formal"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
    -config IssuerRevokeEpochR1.safe.cfg IssuerRevokeEpochR1.tla)
}

falsify_issuer_revoke_epoch_formal() (
  set -e
  verify_jar
  local result output dir
  set +e
  output=$(cd "$ROOT/formal" && java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC \
    -workers 1 -config IssuerRevokeEpochR1.ack-positive-reach.cfg IssuerRevokeEpochR1.tla 2>&1)
  result=$?
  set -e
  if [[ "$result" -ne 12 ]] ||
     ! grep -Fxq 'Error: Invariant AckUnreachable is violated.' <<< "$output" ||
     ! grep -Fq 'revokeAck = TRUE' <<< "$output"; then
    echo "Issuer all-Attempt ACK reachability FAILED" >&2
    printf '%s\n' "$output" | tail -40 >&2
    exit 1
  fi
  echo "Issuer all-Attempt ACK reachability PASS"

  # A positive native unit MUST be reachable, or NoFutureSpawn is vacuous.
  set +e
  output=$(cd "$ROOT/formal" && java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC \
    -workers 1 -config IssuerRevokeEpochR1.start-positive-reach.cfg IssuerRevokeEpochR1.tla 2>&1)
  result=$?
  set -e
  if [[ "$result" -ne 12 ]] ||
     ! grep -Fxq 'Error: Invariant TargetSpawnUnreachable is violated.' <<< "$output" ||
     ! grep -Fq '"running"' <<< "$output" ||
     ! grep -Eq '^State [1-9][0-9]*:' <<< "$output"; then
    echo "Issuer native target spawn positive-path reachability FAILED" >&2
    printf '%s\n' "$output" | tail -40 >&2
    exit 1
  fi
  echo "Issuer native target spawn positive-path reachability PASS"

  dir=$(mktemp -d -t ordivon-revoke-epoch-cegar-XXXXXX)
  trap 'rm -rf -- "$dir"' EXIT
  cp "$ROOT/formal/IssuerRevokeEpochR1.tla" "$dir/"
  cp "$ROOT/formal/IssuerRevokeEpochR1.safe.cfg" "$dir/IssuerRevokeEpochR1.cfg"
  # Bad algorithm: acknowledge when ANY one native Unit is quiet, although a
  # second original issued Unit may still have a pending start manager job.
  python3 - "$dir/IssuerRevokeEpochR1.tla" <<'PY_PARTIAL_ACK'
from pathlib import Path
import sys
p = Path(sys.argv[1])
src = p.read_text(encoding="utf-8")
start, end = src.index("PublishAck ==\n"), src.index("Next ==\n")
block = src[start:end]
guard = "    /\\ \\A a \\in AttemptIds: LaunchFinalized(a)\n"
assert block.count(guard) == 1, "original Run epoch ACK all-Units guard drift"
p.write_text(src[:start] + block.replace(
    guard, "    /\\ \\E a \\in AttemptIds: LaunchFinalized(a)\n", 1) + src[end:], encoding="utf-8")
PY_PARTIAL_ACK
  # Let the stronger post-ACK effect invariant identify the later spawn,
  # instead of stopping immediately on the weaker all-quiet predicate.
  sed -i '/^[[:space:]]*AckRequiresAllIssuedQuiescent$/d' "$dir/IssuerRevokeEpochR1.cfg"
  sed -i '/^[[:space:]]*AckRequiresNoHandoffPending$/d' "$dir/IssuerRevokeEpochR1.cfg"
  sed -i '/^[[:space:]]*NoUnitBirthAfterAck$/d' "$dir/IssuerRevokeEpochR1.cfg"
  set +e
  output=$(cd "$dir" && java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
    -config IssuerRevokeEpochR1.cfg IssuerRevokeEpochR1.tla 2>&1)
  result=$?
  set -e
  if [[ "$result" -ne 12 ]] ||
     ! grep -Fxq 'Error: Invariant NoSpawnAfterAck is violated.' <<< "$output" ||
     ! grep -Fq 'revokeAck = TRUE' <<< "$output" ||
     ! grep -Eq '^State [1-9][0-9]*:' <<< "$output"; then
    echo "Issuer one-of-two native Units premature ACK negative control FAILED" >&2
    printf '%s\n' "$output" | tail -40 >&2
    exit 1
  fi
  echo "Issuer one-of-two native Units premature ACK counterexample PASS"

  # R37: pre-Unit gap. Issued PG Attempt + native launcher inflight exists,
  # but systemctl currently sees no Unit. Weak ACK based only on Unit absence
  # must permit an actual post-ACK native Unit birth and physical spawn.
  cp "$ROOT/formal/IssuerRevokeEpochR1.tla" "$dir/IssuerRevokeEpochR1.tla"
  cp "$ROOT/formal/IssuerRevokeEpochR1.safe.cfg" "$dir/IssuerRevokeEpochR1.cfg"
  python3 - "$dir/IssuerRevokeEpochR1.tla" <<'PY_PREUNIT_ACK'
from pathlib import Path
import sys
p = Path(sys.argv[1])
src = p.read_text(encoding="utf-8")
start, end = src.index("PublishAck ==\n"), src.index("Next ==\n")
block = src[start:end]
guard = r'    /\ \A a \in AttemptIds: LaunchFinalized(a)' + "\n"
weaken = r'    /\ \A a \in AttemptIds: nativeUnit[a] \in {"absent", "quiescent"}' + "\n"
assert block.count(guard) == 1, "issuer pre-Unit ACK guard drift"
p.write_text(src[:start] + block.replace(guard, weaken, 1) + src[end:], encoding="utf-8")
PY_PREUNIT_ACK
  # Observe NoSpawnAfterAck AFTER the late Unit birth, not the earlier
  # acknowledgement-completeness and Unit-birth safety invariants.
  sed -i -e '/^[[:space:]]*AckRequiresAllIssuedQuiescent$/d' \
         -e '/^[[:space:]]*AckRequiresNoHandoffPending$/d' \
         -e '/^[[:space:]]*NoUnitBirthAfterAck$/d' "$dir/IssuerRevokeEpochR1.cfg"
  set +e
  output=$(cd "$dir" && java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
    -config IssuerRevokeEpochR1.cfg IssuerRevokeEpochR1.tla 2>&1)
  result=$?
  set -e
  if [[ "$result" -ne 12 ]] ||
     ! grep -Fxq 'Error: Invariant NoSpawnAfterAck is violated.' <<< "$output" ||
     ! grep -Fq 'revokeAck = TRUE' <<< "$output" ||
     ! grep -Fq '"inflight"' <<< "$output" ||
     ! grep -Fq 'unitBornAfterAck = TRUE' <<< "$output" ||
     ! grep -Eq '^State [1-9][0-9]*:' <<< "$output"; then
    echo "Issuer PG-issued-but-Unit-absent premature ACK negative control FAILED" >&2
    printf '%s\n' "$output" | tail -55 >&2
    exit 1
  fi
  echo "Issuer pre-Unit stale-launcher physical-late-start counterexample PASS"

  # A caller can die after submitting an async systemd manager start while no
  # Unit is visible. The genuine OS handoff can still deliver a native Unit.
  # This positive reachability prevents a vacuous crash branch that never
  # lets native delivery, stop and a legitimate post-drain ACK occur.
  set +e
  output=$(cd "$ROOT/formal" && java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC \
    -workers 1 -config IssuerRevokeEpochR1.crash-ack-positive-reach.cfg \
    IssuerRevokeEpochR1.tla 2>&1)
  result=$?
  set -e
  if [[ "$result" -ne 12 ]] ||
     ! grep -Fxq 'Error: Invariant CrashThenAckUnreachable is violated.' <<< "$output" ||
     ! grep -Fq 'revokeAck = TRUE' <<< "$output" ||
     ! grep -Eq 'crashedCallers = \{"[ab]"' <<< "$output"; then
    echo "Issuer crashed native caller then legitimately drained ACK reachability FAILED" >&2
    printf '%s\n' "$output" | tail -55 >&2
    exit 1
  fi
  echo "Issuer crashed-native-caller recovered physical ACK reachability PASS"

  # A successful exact Manager cancellation is an independent safe path:
  # caller definitely stopped, the original queued systemd Job was really
  # cancelled, and all other issued Attempts are independently settled.
  # This is a positive reachability test of an abstract OS ACK, not a
  # Rust/PG implementation or proof from absence of a Unit alone.
  set +e
  output=$(cd "$ROOT/formal" && java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC \
    -workers 1 -config IssuerRevokeEpochR1.exact-cancel-ack-positive-reach.cfg \
    IssuerRevokeEpochR1.tla 2>&1)
  result=$?
  set -e
  if [[ "$result" -ne 12 ]] ||
     ! grep -Fxq 'Error: Invariant ExactCancelAckUnreachable is violated.' <<< "$output" ||
     ! grep -Fq 'revokeAck = TRUE' <<< "$output" ||
     ! grep -Fq '"crashed_unknown"' <<< "$output" ||
     ! grep -Fq 'nativeHandoffPending = {}' <<< "$output" ||
     ! grep -Eq '^State [1-9][0-9]*:' <<< "$output"; then
    echo "Issuer exact native Manager cancellation ACK positive path FAILED" >&2
    printf '%s\n' "$output" | tail -60 >&2
    exit 1
  fi
  echo "Issuer exact-Manager-cancel / all-issued safe ACK reachability PASS"

  # CEGAR native OS: "No currently visible systemd Unit" does NOT cancel an
  # already-submitted manager request. This bad algorithm falsely reclassifies
  # a crashed but still pending launcher as permanently blocked, then ACKs.
  # The real manager may create the Unit after ACK and start the target.
  cp "$ROOT/formal/IssuerRevokeEpochR1.tla" "$dir/IssuerRevokeEpochR1.tla"
  cp "$ROOT/formal/IssuerRevokeEpochR1.safe.cfg" "$dir/IssuerRevokeEpochR1.cfg"
  python3 - "$dir/IssuerRevokeEpochR1.tla" <<'PY_CRASH_ABSENCE'
from pathlib import Path
import sys
p = Path(sys.argv[1])
src = p.read_text(encoding="utf-8")
marker = "Next ==\n"
unsafe = r'''UnsafeCrashUnitAbsentMeansFenced(a) ==
    /\ issuer = "revoked"
    /\ a \in nativeHandoffPending
    /\ launcher[a] = "crashed_unknown"
    /\ nativeUnit[a] = "absent"
    /\ launcher' = [launcher EXCEPT ![a] = "blocked"]
    /\ UNCHANGED <<issuer, issued, nativeUnit, stopIntent, fenced,
                   revokeAck, unitBornAfterAck, spawnedAfterAck,
                   nativeHandoffPending, crashedCallers>>

'''
assert src.count(marker) == 1, "native crash model Next source drift"
p.write_text(src.replace(
    marker,
    unsafe + marker + r"    \/ \E a \in AttemptIds: UnsafeCrashUnitAbsentMeansFenced(a)" + "\n",
    1,
))
PY_CRASH_ABSENCE
  # Ignore the earlier "ACK has pending manager request" and Unit-birth
  # invariants deliberately, so the independent physical target late spawn
  # violation (not just early bookkeeping) must actually be reachable.
  sed -i -e '/^[[:space:]]*AckRequiresAllIssuedQuiescent$/d' \
         -e '/^[[:space:]]*AckRequiresNoHandoffPending$/d' \
         -e '/^[[:space:]]*NoUnitBirthAfterAck$/d' "$dir/IssuerRevokeEpochR1.cfg"
  set +e
  output=$(cd "$dir" && java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC \
    -workers 1 -config IssuerRevokeEpochR1.cfg IssuerRevokeEpochR1.tla 2>&1)
  result=$?
  set -e
  if [[ "$result" -ne 12 ]] ||
     ! grep -Fxq 'Error: Invariant NoSpawnAfterAck is violated.' <<< "$output" ||
     ! grep -Fq '"crashed_unknown"' <<< "$output" ||
     ! grep -Fq 'revokeAck = TRUE' <<< "$output" ||
     ! grep -Fq 'unitBornAfterAck = TRUE' <<< "$output" ||
     ! grep -Eq '^State [1-9][0-9]*:' <<< "$output"; then
    echo "Issuer crashed-unit-absent premature ACK native-late-start counterexample FAILED" >&2
    printf '%s\n' "$output" | tail -80 >&2
    exit 1
  fi
  echo "Issuer crashed-launcher unit-absent native late-spawn counterexample PASS"

  # Exact issued-set stability and early ACK reachability are model gates,
  # not optional unit tests that can skip on a cold Owner checkout.
  ORDIVON_TLA_TOOLS_JAR="$JAR" python3 "$ROOT/scripts/verify_issuer_revoke_epoch_model.py" -v
)

case "${1:-check}" in
  bootstrap) bootstrap ;;
  verify) verify_jar; echo "TLA+ toolchain digest verification PASS" ;;
  check-issuer-revoke-ack) check_issuer_revoke_ack_formal ;;
  falsify-issuer-revoke-ack) falsify_issuer_revoke_ack_formal ;;
  check-issuer-revoke-epoch) check_issuer_revoke_epoch_formal ;;
  falsify-issuer-revoke-epoch) falsify_issuer_revoke_epoch_formal ;;
  check-dispatch) check_runtime_dispatch ;;
  check-runner-bound) check_runner_bound ;;
  check-workspace-crossdb) check_workspace_cross_database_claim ;;
  falsify-workspace-crossdb) falsify_workspace_cross_database_claim ;;
  falsify-runner-bound) falsify_runner_bound ;;
  check-windows-pg-attempt) check_windows_pg_attempt ;;
  check-pg-buildcache) check_pg_build_cache_eviction ;;
  falsify-pg-buildcache) falsify_pg_build_cache_eviction ;;
  falsify-windows-pg-attempt) check_windows_pg_attempt_counterexample ;;
  check-resource) check_runtime_resource_queue ;;
  falsify-resource) falsify_runtime_resource_queue ;;
  # Current fresh-PG epoch: no SQLite parity copy or Windows-first ordering.
  # Preserve historical models and their independent negative controls on demand.
  check) check_runtime_dispatch; check_workspace_consumer_close; check_workspace_consumer_close_liveness; check_workspace_consumer_close_r2_candidate; check_workspace_multi_agent_release; check_windows_pg_attempt; check_runtime_resource_queue; check_pg_build_cache_eviction; check_runner_bound; check_workspace_cross_database_claim; check_issuer_spawn_formal; check_issuer_revoke_ack_formal; check_issuer_revoke_epoch_formal ;;
  check-historical) check_runtime_pg_cutover; check_windows_first_pg_order ;;
  falsify-dispatch) check_runtime_counterexample; check_local_cancel_evidence_counterexamples; check_terminal_pointer_counterexample; check_partial_output_counterexample; check_foreign_result_recovery_counterexample ;;
  falsify) check_runtime_counterexample; check_local_cancel_evidence_counterexamples; check_terminal_pointer_counterexample; check_partial_output_counterexample; check_foreign_result_recovery_counterexample; check_workspace_consumer_close_counterexamples; falsify_workspace_multi_agent_release; check_windows_pg_attempt_counterexample; falsify_runtime_resource_queue; falsify_pg_build_cache_eviction; falsify_runner_bound; falsify_workspace_cross_database_claim; falsify_issuer_spawn_formal; falsify_issuer_revoke_ack_formal; falsify_issuer_revoke_epoch_formal ;;
  falsify-historical) check_pg_cutover_counterexample; check_windows_first_pg_falsifiers ;;
  *)
    echo "usage: scripts/tla-formal [bootstrap|verify|check|falsify|check-historical|falsify-historical|check-runner-bound|falsify-runner-bound|check-issuer-revoke-ack|falsify-issuer-revoke-ack|check-issuer-revoke-epoch|falsify-issuer-revoke-epoch]" >&2
    exit 2
    ;;
esac
