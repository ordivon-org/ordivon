#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOCK="$ROOT/formal/toolchain.lock.json"

read_lock() {
  python - "$LOCK" "$1" <<'PY'
import json, sys
value = json.load(open(sys.argv[1], encoding="utf-8"))
print(value[sys.argv[2]])
PY
}

VERSION="$(read_lock version)"
URL="$(read_lock url)"
SHA1="$(read_lock upstreamSha1)"
SHA256="$(read_lock sha256)"
REL="$(read_lock cacheRelativePath)"
LOCAL_JAR="$ROOT/$REL"
# Caller-owned Runtime hostDependencies can fence the external file at execution
# admission. This script additionally checks both pinned upstream digests.
JAR="${ORDIVON_TLA_TOOLS_JAR-$LOCAL_JAR}"

verify_jar() {
  if [[ "${ORDIVON_TLA_TOOLS_JAR+x}" == x ]]; then
    if [[ "$JAR" != /* || ! -f "$JAR" || -L "$JAR" ]]; then
      echo "TLA+ external jar must be an absolute regular non-symlink file: $JAR" >&2
      exit 2
    fi
  fi
  if [[ ! -f "$JAR" ]]; then
    echo "TLA+ tools missing: $JAR" >&2
    echo "Run: scripts/tla-formal bootstrap" >&2
    exit 2
  fi
  if [[ "$(sha1sum -- "$JAR" | awk '{print $1}')" != "$SHA1" ]]; then
    echo "TLA+ tools SHA-1 digest mismatch: $JAR" >&2
    exit 2
  fi
  if [[ "$(sha256sum -- "$JAR" | awk '{print $1}')" != "$SHA256" ]]; then
    echo "TLA+ tools SHA-256 digest mismatch: $JAR" >&2
    exit 2
  fi
}

bootstrap() {
  # Bootstrap always populates the project's local ignored cache, never an
  # external Runtime dependency or other owner-controlled path.
  mkdir -p "$(dirname "$LOCAL_JAR")"
  tmp="$LOCAL_JAR.tmp.$$"
  trap 'rm -f "$tmp"' EXIT
  curl --fail --location --silent --show-error "$URL" -o "$tmp"
  test "$(sha1sum "$tmp" | awk '{print $1}')" = "$SHA1"
  test "$(sha256sum "$tmp" | awk '{print $1}')" = "$SHA256"
  mv "$tmp" "$LOCAL_JAR"
  trap - EXIT
  echo "TLA+ tools $VERSION materialized and verified at $LOCAL_JAR"
}

check_runtime_dispatch() {
  verify_jar
  java -XX:+UseParallelGC -cp "$JAR" tla2sany.SANY "$ROOT/formal/RuntimeDispatchR1.tla"
  (
    cd "$ROOT/formal"
    java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 -config RuntimeDispatchR1.cfg RuntimeDispatchR1.tla
  )
}

# PostgreSQL-first R06 registry cutover is a separate finite *design* model.
# It is not evidence that the current SQLite production registry has migrated.
check_runtime_pg_cutover() {
  verify_jar
  java -XX:+UseParallelGC -cp "$JAR" tla2sany.SANY "$ROOT/formal/RuntimePgCutoverR1.tla"
  (cd "$ROOT/formal"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
      -config RuntimePgCutoverR1.cfg RuntimePgCutoverR1.tla)
}

# Node-order policy is distinct from the per-node SQL parity/consumer proof.
# It does NOT prove installed Windows/PG writer qualification.
check_windows_first_pg_order() {
  verify_jar
  java -XX:+UseParallelGC -cp "$JAR" tla2sany.SANY "$ROOT/formal/RuntimeWindowsFirstPgR1.tla"
  (cd "$ROOT/formal"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
      -config RuntimeWindowsFirstPgR1.cfg RuntimeWindowsFirstPgR1.tla)
}

check_windows_first_pg_falsifiers() {
  verify_jar
  (
    tmp_dir=$(mktemp -d -t ordivon-winfirst-pg-cegar-XXXXXX)
    trap 'rm -rf -- "$tmp_dir"' EXIT
    cp "$ROOT/formal/RuntimeWindowsFirstPgR1.tla" "$tmp_dir/"
    cp "$ROOT/formal/RuntimeWindowsFirstPgR1.cfg" "$tmp_dir/"

    # Non-vacuity: a Windows-qualified transition MUST allow Linux afterward.
    printf '\nINVARIANT LinuxNeverPromoted\n' >> "$tmp_dir/RuntimeWindowsFirstPgR1.cfg"
    set +e
    (cd "$tmp_dir"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
      -config RuntimeWindowsFirstPgR1.cfg RuntimeWindowsFirstPgR1.tla) \
      > "$tmp_dir/reachable.log" 2>&1
    code=$?
    set -e
    if [[ "$code" -ne 12 ]] ||
       ! grep -Fxq 'Error: Invariant LinuxNeverPromoted is violated.' "$tmp_dir/reachable.log" ||
       ! grep -Eq '^State [1-9][0-9]*:' "$tmp_dir/reachable.log"; then
      echo "Windows-first PG reachability control FAILED" >&2
      tail -30 "$tmp_dir/reachable.log" >&2
      exit 1
    fi
    echo 'TLC Windows-first PG qualified promotion reachable PASS'

    python3 - "$ROOT/formal/RuntimeWindowsFirstPgR1.tla" \
      "$tmp_dir/RuntimeWindowsFirstPgR1.tla" <<'PY_BAD_ORDER'
from pathlib import Path
import sys
source = Path(sys.argv[1]).read_text(encoding='utf-8')
marker = 'Next ==\n'
unsafe = r'''UnsafeLinuxPromoteWithoutWindows ==
    /\ linux = "staged"
    /\ windows = "sqlite"
    /\ linux' = "postgres"
    /\ linuxReceipt' = TRUE
    /\ UNCHANGED <<windows, windowsReceipt>>

'''
assert source.count(marker) == 1
Path(sys.argv[2]).write_text(
    source.replace(marker, unsafe + marker + r'    \/ UnsafeLinuxPromoteWithoutWindows' + '\n'),
    encoding='utf-8',
)
PY_BAD_ORDER
    cp "$ROOT/formal/RuntimeWindowsFirstPgR1.cfg" "$tmp_dir/RuntimeWindowsFirstPgR1.cfg"
    set +e
    (cd "$tmp_dir"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
      -config RuntimeWindowsFirstPgR1.cfg RuntimeWindowsFirstPgR1.tla) \
      > "$tmp_dir/unsafe.log" 2>&1
    code=$?
    set -e
    if [[ "$code" -ne 12 ]] ||
       ! grep -Fxq 'Error: Invariant WindowsBeforeLinuxPg is violated.' "$tmp_dir/unsafe.log" ||
       ! grep -Eq '^State [1-9][0-9]*:' "$tmp_dir/unsafe.log"; then
      echo "Windows-first PG Linux-premature-promotion negative control FAILED" >&2
      tail -30 "$tmp_dir/unsafe.log" >&2
      exit 1
    fi
    echo 'TLC Windows-first PG Linux-premature-promotion rejected PASS'

    # CEGAR: weakening Windows rollback to accept Linux's qualified-but-not-PG
    # stage leaves Linux holding a now-revoked Windows receipt.
    python3 - "$ROOT/formal/RuntimeWindowsFirstPgR1.tla" \
      "$tmp_dir/RuntimeWindowsFirstPgR1.tla" <<'PY_STALE_WIN_RECEIPT'
from pathlib import Path
import sys
source = Path(sys.argv[1]).read_text(encoding='utf-8')
strong = r'    /\ linux \in {"sqlite", "staged"}'
weak = r'    /\ linux \notin PgPhases'
assert source.count(strong) == 1
Path(sys.argv[2]).write_text(source.replace(strong, weak), encoding='utf-8')
PY_STALE_WIN_RECEIPT
    set +e
    (cd "$tmp_dir"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
      -config RuntimeWindowsFirstPgR1.cfg RuntimeWindowsFirstPgR1.tla) \
      > "$tmp_dir/stale-windows-receipt.log" 2>&1
    code=$?
    set -e
    if [[ "$code" -ne 12 ]] ||
       ! grep -Fxq 'Error: Invariant WindowsBeforeLinuxPg is violated.' "$tmp_dir/stale-windows-receipt.log" ||
       ! grep -Eq '^State [1-9][0-9]*:' "$tmp_dir/stale-windows-receipt.log"; then
      echo "Windows-first PG stale-Windows-receipt rollback control FAILED" >&2
      tail -30 "$tmp_dir/stale-windows-receipt.log" >&2
      exit 1
    fi
    echo 'TLC Windows-first PG stale-Windows-receipt rollback rejected PASS'
  )
}

# CEGAR non-vacuity: deliberately let a paused SQLite source admit a PG writer
# without parity certification. TLC must find an actual named state trace.
check_pg_cutover_counterexample() {
  verify_jar
  (
    tmp_dir=$(mktemp -d -t ordivon-pg-cutover-falsifier-XXXXXX)
    trap 'rm -rf -- "$tmp_dir"' EXIT
    python - "$ROOT/formal/RuntimePgCutoverR1.tla" "$tmp_dir/RuntimePgCutoverR1.tla" <<'PY_PG_CEX'
from pathlib import Path
import sys
source = Path(sys.argv[1]).read_text(encoding="utf-8")
marker = "Next ==\n"
unsafe = r"""UnsafePromoteWithoutParity ==
    /\ owner = "paused"
    /\ owner' = "postgres"
    /\ cutoverCertified' = FALSE
    /\ pgWriterActive' = TRUE
    /\ UNCHANGED <<sqliteRevision, pgRevision, copied, parityVerified,
                   sqliteContent, pgContent, pgCommitted, rolledBack,
                   sqliteWriterActive, consumersQualified, consumerReceipt>>

"""
assert source.count(marker) == 1, "pg-cutover Next source drift"
Path(sys.argv[2]).write_text(
    source.replace(marker, unsafe + marker + r"    \/ UnsafePromoteWithoutParity" + "\n"),
    encoding="utf-8",
)
PY_PG_CEX
    cp -- "$ROOT/formal/RuntimePgCutoverR1.cfg" "$tmp_dir/RuntimePgCutoverR1.cfg"
    set +e
    (cd "$tmp_dir"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
       -config RuntimePgCutoverR1.cfg RuntimePgCutoverR1.tla) > "$tmp_dir/result.log" 2>&1
    result=$?
    set -e
    if [[ "$result" -ne 12 ]] ||
       ! grep -Fxq 'Error: Invariant PostgresRequiresCertifiedCutover is violated.' "$tmp_dir/result.log" ||
       ! grep -Fxq 'Error: The behavior up to this point is:' "$tmp_dir/result.log" ||
       ! grep -Eq '^State [1-9][0-9]*:' "$tmp_dir/result.log"; then
      echo "PostgreSQL cutover TLC negative control FAILED: missing actual named state trace" >&2
      tail -35 "$tmp_dir/result.log" >&2
      exit 1
    fi
    echo "TLC PostgreSQL cutover negative control PASS: uncertified promotion rejected"

    mkdir "$tmp_dir/rollback"
    python - "$ROOT/formal/RuntimePgCutoverR1.tla" "$tmp_dir/rollback/RuntimePgCutoverR1.tla" <<'PY_PG_ROLLBACK'
from pathlib import Path
import sys
source = Path(sys.argv[1]).read_text(encoding="utf-8")
marker = "Next ==\n"
unsafe = r"""UnsafeRollbackAfterPgCommit ==
    /\ owner = "postgres"
    /\ pgCommitted
    /\ owner' = "sqlite"
    /\ sqliteWriterActive' = TRUE
    /\ pgWriterActive' = FALSE
    /\ UNCHANGED <<sqliteRevision, pgRevision, copied, parityVerified,
                   sqliteContent, pgContent, cutoverCertified, pgCommitted,
                   rolledBack, consumersQualified, consumerReceipt>>

"""
assert source.count(marker) == 1, "pg-cutover rollback mutation source drift"
Path(sys.argv[2]).write_text(
    source.replace(marker, unsafe + marker + r"    \/ UnsafeRollbackAfterPgCommit" + "\n"),
    encoding="utf-8",
)
PY_PG_ROLLBACK
    cp -- "$ROOT/formal/RuntimePgCutoverR1.cfg" "$tmp_dir/rollback/RuntimePgCutoverR1.cfg"
    set +e
    (cd "$tmp_dir/rollback"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
       -config RuntimePgCutoverR1.cfg RuntimePgCutoverR1.tla) > "$tmp_dir/rollback/result.log" 2>&1
    result=$?
    set -e
    if [[ "$result" -ne 12 ]] ||
       ! grep -Fxq 'Error: Invariant NoLostPostgresCommit is violated.' "$tmp_dir/rollback/result.log" ||
       ! grep -Fxq 'Error: The behavior up to this point is:' "$tmp_dir/rollback/result.log" ||
       ! grep -Eq '^State [1-9][0-9]*:' "$tmp_dir/rollback/result.log"; then
      echo "PostgreSQL rollback TLC negative control FAILED: missing actual lost-commit state trace" >&2
      tail -35 "$tmp_dir/rollback/result.log" >&2
      exit 1
    fi
    echo "TLC PostgreSQL rollback negative control PASS: old SQLite cannot consume committed PG effects"

    # CEGAR: the same revision number cannot establish content parity.
    # A bad verifier that ignores copied content must give a real TLC trace.
    mkdir "$tmp_dir/content"
    python - "$ROOT/formal/RuntimePgCutoverR1.tla" "$tmp_dir/content/RuntimePgCutoverR1.tla" <<'PY_PG_CONTENT'
from pathlib import Path
import sys
source = Path(sys.argv[1]).read_text(encoding="utf-8")
guard = r"    /\ pgContent = sqliteContent" + "\n"
assert source.count(guard) == 2, "PG parity and consumer qualification guards drift"
Path(sys.argv[2]).write_text(source.replace(guard, "", 1), encoding="utf-8")
PY_PG_CONTENT
    cp -- "$ROOT/formal/RuntimePgCutoverR1.cfg" "$tmp_dir/content/RuntimePgCutoverR1.cfg"
    set +e
    (cd "$tmp_dir/content"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
       -config RuntimePgCutoverR1.cfg RuntimePgCutoverR1.tla) > "$tmp_dir/content/result.log" 2>&1
    result=$?
    set -e
    if [[ "$result" -ne 12 ]] ||
       ! grep -Fxq 'Error: Invariant VerifiedContentWasFrozen is violated.' "$tmp_dir/content/result.log" ||
       ! grep -Fxq 'Error: The behavior up to this point is:' "$tmp_dir/content/result.log" ||
       ! grep -Eq '^State [1-9][0-9]*:' "$tmp_dir/content/result.log"; then
      echo "PostgreSQL content parity TLC negative control FAILED: missing content-mismatch trace" >&2
      tail -35 "$tmp_dir/content/result.log" >&2
      exit 1
    fi
    echo "TLC PostgreSQL content parity negative control PASS: revision-equal corrupt copy rejected"

    # Refine owner == postgres with two independent installed-writer activities.
    # A lingering SQLite process and a newly admitted PG writer must falsify
    # the actual invariant, even when certification/parity appear legitimate.
    mkdir "$tmp_dir/overlap"
    python - "$ROOT/formal/RuntimePgCutoverR1.tla" "$tmp_dir/overlap/RuntimePgCutoverR1.tla" <<'PY_PG_OVERLAP'
from pathlib import Path
import sys
source = Path(sys.argv[1]).read_text(encoding="utf-8")
marker = "Next ==\n"
unsafe = r"""UnsafeConcurrentInstalledWriters ==
    /\ owner = "paused"
    /\ parityVerified
    /\ ~sqliteWriterActive
    /\ ~pgWriterActive
    /\ owner' = "postgres"
    /\ pgWriterActive' = TRUE
    /\ sqliteWriterActive' = TRUE
    /\ cutoverCertified' = TRUE
    /\ rolledBack' = FALSE
    /\ UNCHANGED <<sqliteRevision, pgRevision, copied, parityVerified,
                   pgCommitted, sqliteContent, pgContent, consumersQualified, consumerReceipt>>

"""
assert source.count(marker) == 1, "PG overlapping writers source drift"
Path(sys.argv[2]).write_text(
    source.replace(marker, unsafe + marker + r"    \/ UnsafeConcurrentInstalledWriters" + "\n"),
    encoding="utf-8",
)
PY_PG_OVERLAP
    cp -- "$ROOT/formal/RuntimePgCutoverR1.cfg" "$tmp_dir/overlap/RuntimePgCutoverR1.cfg"
    set +e
    (cd "$tmp_dir/overlap"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
      -config RuntimePgCutoverR1.cfg RuntimePgCutoverR1.tla) > "$tmp_dir/overlap/result.log" 2>&1
    result=$?
    set -e
    if [[ "$result" -ne 12 ]] ||
       ! grep -Fxq 'Error: Invariant NoConcurrentInstalledWriters is violated.' "$tmp_dir/overlap/result.log" ||
       ! grep -Fxq 'Error: The behavior up to this point is:' "$tmp_dir/overlap/result.log" ||
       ! grep -Eq '^State [1-9][0-9]*:' "$tmp_dir/overlap/result.log"; then
      echo "PostgreSQL two-writer negative control FAILED: no source-bound TLC overlap trace" >&2
      tail -35 "$tmp_dir/overlap/result.log" >&2
      exit 1
    fi
    echo "TLC PostgreSQL two-writer negative control PASS: leaked SQLite writer rejected"
    # The legal certified PG path must actually be reachable; otherwise
    # absence of an illegal promotion could be a vacuous proof.
    mkdir "$tmp_dir/reachable"
    python - "$ROOT/formal/RuntimePgCutoverR1.tla" "$tmp_dir/reachable/RuntimePgCutoverR1.tla" <<'PY_PG_REACH'
from pathlib import Path
import sys
source = Path(sys.argv[1]).read_text(encoding="utf-8")
marker = "Spec == Init"
assert source.count(marker) == 1, "PG reachability source drift"
predicate = 'QualifiedPgIsUnreachable == owner # "postgres"\n\n'
Path(sys.argv[2]).write_text(source.replace(marker, predicate + marker), encoding="utf-8")
PY_PG_REACH
    cp -- "$ROOT/formal/RuntimePgCutoverR1.cfg" "$tmp_dir/reachable/RuntimePgCutoverR1.cfg"
    printf '\nINVARIANT QualifiedPgIsUnreachable\n' >> "$tmp_dir/reachable/RuntimePgCutoverR1.cfg"
    set +e
    (cd "$tmp_dir/reachable"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
      -config RuntimePgCutoverR1.cfg RuntimePgCutoverR1.tla) > "$tmp_dir/reachable/result.log" 2>&1
    result=$?
    set -e
    if [[ "$result" -ne 12 ]] ||
       ! grep -Fxq 'Error: Invariant QualifiedPgIsUnreachable is violated.' "$tmp_dir/reachable/result.log" ||
       ! grep -Fq 'consumersQualified = TRUE' "$tmp_dir/reachable/result.log" ||
       ! grep -Eq '^State [1-9][0-9]*:' "$tmp_dir/reachable/result.log"; then
      echo "PostgreSQL qualified promotion reachability FAILED (vacuous path or parser issue)" >&2
      tail -35 "$tmp_dir/reachable/result.log" >&2
      exit 1
    fi
    echo "TLC PostgreSQL qualified promotion reachability PASS: certified consumer path exists"

    # CEGAR-inspired non-vacuity: copied rows are insufficient without a
    # separately qualified live-consumer cutover witness.
    mkdir "$tmp_dir/consumer"
    python - "$ROOT/formal/RuntimePgCutoverR1.tla" "$tmp_dir/consumer/RuntimePgCutoverR1.tla" <<'PY_PG_CONSUMER'
from pathlib import Path
import sys
source = Path(sys.argv[1]).read_text(encoding="utf-8")
guard = r"    /\ consumersQualified" + "\n"
assert source.count(guard) == 1, "PG consumer admission guard drift"
Path(sys.argv[2]).write_text(source.replace(guard, "", 1), encoding="utf-8")
PY_PG_CONSUMER
    cp -- "$ROOT/formal/RuntimePgCutoverR1.cfg" "$tmp_dir/consumer/RuntimePgCutoverR1.cfg"
    set +e
    (cd "$tmp_dir/consumer"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
      -config RuntimePgCutoverR1.cfg RuntimePgCutoverR1.tla) > "$tmp_dir/consumer/result.log" 2>&1
    result=$?
    set -e
    if [[ "$result" -ne 12 ]] ||
       ! grep -Fxq 'Error: Invariant PgWriterRequiresQualifiedConsumers is violated.' "$tmp_dir/consumer/result.log" ||
       ! grep -Fxq 'Error: The behavior up to this point is:' "$tmp_dir/consumer/result.log" ||
       ! grep -Eq '^State [1-9][0-9]*:' "$tmp_dir/consumer/result.log"; then
      echo "PostgreSQL consumer cutover negative control FAILED: missing named TLC state trace" >&2
      tail -35 "$tmp_dir/consumer/result.log" >&2
      exit 1
    fi
    echo "TLC PostgreSQL consumer cutover negative control PASS: unqualified writer cannot promote"

    # CEGAR: a self-labelled consumer qualification must be bound to an
    # independent receipt's source cut, content and issuer. Violating each
    # field must produce the named model invariant, not parser or tool failure.
    for label in revision content issuer; do
      mkdir "$tmp_dir/receipt-$label"
      python - "$ROOT/formal/RuntimePgCutoverR1.tla" \
        "$tmp_dir/receipt-$label/RuntimePgCutoverR1.tla" "$label" <<'PY_PG_RECEIPT'
from pathlib import Path
import sys
source=Path(sys.argv[1]).read_text(encoding="utf-8")
label=sys.argv[3]
assert label in ("revision","content","issuer")
value="sqliteRevision" if label=="revision" else "sqliteContent" if label=="content" else '"trusted"'
guard="    /\\ consumerReceipt."+label+" = "+value+"\n"
qualification=source.index("QualifyConsumers ==")
promotion=source.index("Promote ==")
segment=source[qualification:promotion]
assert segment.count(guard)==1, "consumer source-cut evidence guard drift"
source=source[:qualification]+segment.replace(guard,"",1)+source[promotion:]
Path(sys.argv[2]).write_text(source,encoding="utf-8")
PY_PG_RECEIPT
      cp -- "$ROOT/formal/RuntimePgCutoverR1.cfg" "$tmp_dir/receipt-$label/RuntimePgCutoverR1.cfg"
      set +e
      (cd "$tmp_dir/receipt-$label"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
        -config RuntimePgCutoverR1.cfg RuntimePgCutoverR1.tla) \
        > "$tmp_dir/receipt-$label/result.log" 2>&1
      result=$?
      set -e
      if [[ "$result" -ne 12 ]] ||
         ! grep -Fxq 'Error: Invariant QualifiedConsumersMatchSource is violated.' \
             "$tmp_dir/receipt-$label/result.log" ||
         ! grep -Fxq 'Error: The behavior up to this point is:' \
             "$tmp_dir/receipt-$label/result.log" ||
         ! grep -Eq '^State [1-9][0-9]*:' "$tmp_dir/receipt-$label/result.log"; then
        echo "PG source-bound consumer receipt $label falsification FAILED" >&2
        tail -40 "$tmp_dir/receipt-$label/result.log" >&2
        exit 1
      fi
      echo "PG source-bound consumer receipt negative control PASS ($label)"
    done

    # A failed candidate may abort while paused, but must not hand historical
    # PG consumer qualification back to the resumed SQLite writer. Exercise
    # the forbidden mutation against the same exact PG model and named law.
    mkdir "$tmp_dir/abort-stale"
    python - "$ROOT/formal/RuntimePgCutoverR1.tla" "$tmp_dir/abort-stale/RuntimePgCutoverR1.tla" <<'PY_PG_ABORT_STALE'
from pathlib import Path
import sys
source = Path(sys.argv[1]).read_text(encoding="utf-8")
marker = "Next ==\n"
unsafe = r"""UnsafeAbortRetainsQualification ==
    /\ owner = "paused"
    /\ consumersQualified
    /\ ~sqliteWriterActive
    /\ ~pgWriterActive
    /\ ~pgCommitted
    /\ owner' = "sqlite"
    /\ sqliteWriterActive' = TRUE
    /\ rolledBack' = TRUE
    /\ UNCHANGED <<sqliteRevision, pgRevision, sqliteContent, pgContent,
                   copied, parityVerified, cutoverCertified, pgCommitted,
                   pgWriterActive, consumersQualified, consumerReceipt>>

"""
assert source.count(marker) == 1, "PG failed-cutover abort mutation source drift"
Path(sys.argv[2]).write_text(
    source.replace(marker, unsafe + marker + r"    \/ UnsafeAbortRetainsQualification" + "\n"),
    encoding="utf-8",
)
PY_PG_ABORT_STALE
    cp -- "$ROOT/formal/RuntimePgCutoverR1.cfg" "$tmp_dir/abort-stale/RuntimePgCutoverR1.cfg"
    set +e
    (cd "$tmp_dir/abort-stale"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
      -config RuntimePgCutoverR1.cfg RuntimePgCutoverR1.tla) > "$tmp_dir/abort-stale/result.log" 2>&1
    result=$?
    set -e
    if [[ "$result" -ne 12 ]] ||
       ! grep -Fxq 'Error: Invariant NoRetainedQualificationOnSqlite is violated.' "$tmp_dir/abort-stale/result.log" ||
       ! grep -Fxq 'Error: The behavior up to this point is:' "$tmp_dir/abort-stale/result.log" ||
       ! grep -Eq '^State [1-9][0-9]*:' "$tmp_dir/abort-stale/result.log"; then
      echo "PostgreSQL failed-cutover stale-consumer negative control FAILED" >&2
      tail -35 "$tmp_dir/abort-stale/result.log" >&2
      exit 1
    fi
    echo "TLC PostgreSQL stale qualification negative control PASS: abort invalidates old consumer evidence"

    # Separate non-vacuity: a safe paused->SQLite abort must be reachable
    # without first obtaining PG writer authority. Normal safety PASS alone
    # would also hold in a permanently paused and unusable model.
    mkdir "$tmp_dir/abort-reachable"
    python - "$ROOT/formal/RuntimePgCutoverR1.tla" "$tmp_dir/abort-reachable/RuntimePgCutoverR1.tla" <<'PY_PG_ABORT_REACH'
from pathlib import Path
import sys
source = Path(sys.argv[1]).read_text(encoding="utf-8")
marker = "Spec == Init"
assert source.count(marker) == 1, "PG aborted-transition reachability source drift"
predicate = (
    'PrecommitAbortIsUnreachable == '
    '~(owner = "sqlite" /\\ rolledBack /\\ ~cutoverCertified)\n\n'
)
Path(sys.argv[2]).write_text(source.replace(marker, predicate + marker), encoding="utf-8")
PY_PG_ABORT_REACH
    cp -- "$ROOT/formal/RuntimePgCutoverR1.cfg" "$tmp_dir/abort-reachable/RuntimePgCutoverR1.cfg"
    printf '\nINVARIANT PrecommitAbortIsUnreachable\n' >> "$tmp_dir/abort-reachable/RuntimePgCutoverR1.cfg"
    set +e
    (cd "$tmp_dir/abort-reachable"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
      -config RuntimePgCutoverR1.cfg RuntimePgCutoverR1.tla) > "$tmp_dir/abort-reachable/result.log" 2>&1
    result=$?
    set -e
    if [[ "$result" -ne 12 ]] ||
       ! grep -Fxq 'Error: Invariant PrecommitAbortIsUnreachable is violated.' "$tmp_dir/abort-reachable/result.log" ||
       ! grep -Fq 'rolledBack = TRUE' "$tmp_dir/abort-reachable/result.log" ||
       ! grep -Fq 'cutoverCertified = FALSE' "$tmp_dir/abort-reachable/result.log" ||
       ! grep -Eq '^State [1-9][0-9]*:' "$tmp_dir/abort-reachable/result.log"; then
      echo "PostgreSQL paused abort reachability FAILED: no actual precommit recovery path" >&2
      tail -35 "$tmp_dir/abort-reachable/result.log" >&2
      exit 1
    fi
    echo "TLC PostgreSQL paused abort reachability PASS: SQLite recovery before PG writer is real"
  )
}

# Non-vacuity control for the existing scoped dispatch invariant: introduce one
# deliberately forbidden transition in an EPHEMERAL copy of the same source.
# TLC must return the *named* safety counterexample. Parse/tool/time failures
# are not counterexamples and MUST fail this gate.
check_runtime_counterexample() {
  verify_jar
  (
    tmp_dir=$(mktemp -d -t ordivon-tlc-falsifier-XXXXXX)
    trap 'rm -rf -- "$tmp_dir"' EXIT
    python - "$ROOT/formal/RuntimeDispatchR1.tla" "$tmp_dir/RuntimeDispatchR1.tla" <<'PY_CEX'
from pathlib import Path
import sys

source = Path(sys.argv[1]).read_text(encoding="utf-8")
unsafe = r'''
BlindRetryWithoutReconciliation ==
    /\ jobState = "ambiguous"
    /\ currentAttempt # NoAttempt
    /\ attemptState[currentAttempt] = "ambiguous"
    /\ \E a \in Attempts:
        /\ attemptState[a] = "unused"
        /\ attemptState' = [attemptState EXCEPT ![a] = "admitted"]
        /\ currentAttempt' = a
    /\ jobState' = "admitted"
    /\ reconcileState' = "none"
    /\ UNCHANGED <<dispatchCount, heldReservation, outputObserved, resultEvidence>>

'''
assert source.count("Next ==\n") == 1, "counterexample mutation source drift"
assert source.count("    \\/ AdmitExplicitRetry\n") == 1, "counterexample mutation transition drift"
mutant = source.replace("Next ==\n", unsafe + "Next ==\n")
mutant = mutant.replace(
    "    \\/ AdmitExplicitRetry\n",
    "    \\/ AdmitExplicitRetry\n    \\/ BlindRetryWithoutReconciliation\n",
)
Path(sys.argv[2]).write_text(mutant, encoding="utf-8")
PY_CEX
    cp -- "$ROOT/formal/RuntimeDispatchR1.cfg" "$tmp_dir/RuntimeDispatchR1.cfg"
    set +e
    (
      cd "$tmp_dir"
      java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
        -config RuntimeDispatchR1.cfg RuntimeDispatchR1.tla
    ) > "$tmp_dir/result.log" 2>&1
    result=$?
    set -e
    # TLC invariant violation has the defined nonzero status 12. A launcher
    # failure, a copied label, or a parse error is not a counterexample.
    if [[ "$result" -ne 12 ]] ||
        ! grep -Fxq "Error: Invariant NoCompetingLiveAttempts is violated." "$tmp_dir/result.log" ||
        ! grep -Fxq "Error: The behavior up to this point is:" "$tmp_dir/result.log" ||
        ! grep -Eq '^State [1-9][0-9]*:' "$tmp_dir/result.log"; then
      echo "TLC counterexample negative control FAILED: NoCompetingLiveAttempts did not identify the seeded unsafe retry" >&2
      tail -35 "$tmp_dir/result.log" >&2
      exit 1
    fi
    echo "TLC counterexample negative control PASS: unsafe retry violates NoCompetingLiveAttempts"
  )
}


# Native Registry clears jobs.current_attempt_id on terminal commit. Ensure
# the model is sensitive to a regression that retains a selected pointer.
# This test changes ONLY an ephemeral copy, and requires a named TLC trace.
check_terminal_pointer_counterexample() {
  verify_jar
  (
    tmp_dir=$(mktemp -d -t ordivon-tlc-terminal-pointer-XXXXXX)
    trap 'rm -rf -- "$tmp_dir"' EXIT
    python3 - "$ROOT/formal/RuntimeDispatchR1.tla" "$tmp_dir/RuntimeDispatchR1.tla" <<'PY_TERMINAL_POINTER_RED'
from pathlib import Path
import sys
source = Path(sys.argv[1]).read_text(encoding="utf-8")
old = r'''    /\ currentAttempt' = NoAttempt
    /\ UNCHANGED <<dispatchCount, heldReservation, outputObserved, resultEvidence>>'''
new = r'''    /\ UNCHANGED <<currentAttempt, dispatchCount, heldReservation, outputObserved, resultEvidence>>'''
assert source.count(old) == 1, "terminal pointer mutation target drift"
Path(sys.argv[2]).write_text(source.replace(old, new, 1), encoding="utf-8")
PY_TERMINAL_POINTER_RED
    cp -- "$ROOT/formal/RuntimeDispatchR1.cfg" "$tmp_dir/RuntimeDispatchR1.cfg"
    set +e
    (cd "$tmp_dir"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
      -config RuntimeDispatchR1.cfg RuntimeDispatchR1.tla) > "$tmp_dir/result.log" 2>&1
    result=$?
    set -e
    if [[ "$result" -ne 12 ]] ||
       ! grep -Fxq "Error: Invariant TerminalEvidenceIsCommitted is violated." "$tmp_dir/result.log" ||
       ! grep -Fxq "Error: The behavior up to this point is:" "$tmp_dir/result.log" ||
       ! grep -Eq '^State [1-9][0-9]*:' "$tmp_dir/result.log"; then
      echo "TLC terminal pointer negative control FAILED" >&2
      tail -45 "$tmp_dir/result.log" >&2
      exit 1
    fi
    echo "TLC terminal pointer mapping negative control PASS: stale selected pointer rejected"
  )
}

# Rejected foreign results must remain correctable by later matching evidence.
# Only pinned upstream TLC runs; all negative control files are ephemeral.
check_foreign_result_recovery_counterexample() {
  verify_jar
  (
    tmp_dir=$(mktemp -d -t ordivon-tlc-foreign-result-XXXXXX)
    trap 'rm -rf -- "$tmp_dir"' EXIT
    cp -- "$ROOT/formal/RuntimeDispatchR1.tla" "$tmp_dir/RuntimeDispatchR1.tla"
    cp -- "$ROOT/formal/RuntimeDispatchR1.cfg" "$tmp_dir/RuntimeDispatchR1.cfg"
    cp -- "$ROOT/formal/RuntimeDispatchR1.foreign-result-probe.cfg" "$tmp_dir/RuntimeDispatchR1.foreign-result-probe.cfg"
    set +e
    (cd "$tmp_dir"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
      -config RuntimeDispatchR1.foreign-result-probe.cfg RuntimeDispatchR1.tla) > "$tmp_dir/reachable.log" 2>&1
    reachable=$?
    set -e
    if [[ "$reachable" -eq 0 ]] ||
       ! grep -Fq "Error: Invariant ForeignResultIsUnreachable is violated." "$tmp_dir/reachable.log" ||
       ! grep -Fq '"foreign"' "$tmp_dir/reachable.log"; then
      echo "TLC foreign result reachability negative control FAILED" >&2
      tail -45 "$tmp_dir/reachable.log" >&2
      exit 1
    fi
    echo "TLC foreign result observation non-vacuity: PASS"
    python - "$tmp_dir/RuntimeDispatchR1.tla" <<'PY_FOREIGN_RECOVERY_RED'
from pathlib import Path
import sys
p = Path(sys.argv[1])
source = p.read_text(encoding="utf-8")
old = '''    /\\ resultEvidence[currentAttempt] = "foreign"
    /\\ resultEvidence' = [resultEvidence EXCEPT ![currentAttempt] = "matching"]'''
new = '''    /\\ resultEvidence[currentAttempt] = "none"
    /\\ resultEvidence' = [resultEvidence EXCEPT ![currentAttempt] = "matching"]'''
if source.count(old) != 1:
    raise SystemExit("Runtime matching recovery mutation target missing or ambiguous")
p.write_text(source.replace(old, new, 1), encoding="utf-8")
PY_FOREIGN_RECOVERY_RED
    set +e
    (cd "$tmp_dir"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
      -config RuntimeDispatchR1.cfg RuntimeDispatchR1.tla) > "$tmp_dir/mutated.log" 2>&1
    mutated=$?
    set -e
    if [[ "$mutated" -eq 0 ]] ||
       ! grep -Fq "Error: Invariant ForeignResultDoesNotDisableMatchingRecovery is violated." "$tmp_dir/mutated.log" ||
       ! grep -Fq '"foreign"' "$tmp_dir/mutated.log"; then
      echo "TLC foreign result recovery mutation negative control FAILED" >&2
      tail -45 "$tmp_dir/mutated.log" >&2
      exit 1
    fi
    echo "TLC foreign result recovery mutation negative control PASS"
  )
}

# Independently falsify the attempted promotion of stdout into terminal proof.
# Deliberately weakening one guard must produce an actual named TLC counterexample.
check_partial_output_counterexample() {
  verify_jar
  (
    tmp_dir=$(mktemp -d -t ordivon-tlc-stdout-falsifier-XXXXXX)
    trap 'rm -rf -- "$tmp_dir"' EXIT
    python - "$ROOT/formal/RuntimeDispatchR1.tla" "$tmp_dir/RuntimeDispatchR1.tla" <<'PY_PARTIAL_CEX'
from pathlib import Path
import sys
source = Path(sys.argv[1]).read_text(encoding="utf-8")
old = '    /\\ resultEvidence[currentAttempt] = "matching"\n    /\\ attemptState\' = [attemptState EXCEPT ![currentAttempt] = "terminal"]'
new = '    /\\ (resultEvidence[currentAttempt] = "matching" \\/ outputObserved[currentAttempt])\n    /\\ attemptState\' = [attemptState EXCEPT ![currentAttempt] = "terminal"]'
assert source.count(old) == 1, "stdout-as-success mutation target drift"
Path(sys.argv[2]).write_text(source.replace(old, new), encoding="utf-8")
PY_PARTIAL_CEX
    cp -- "$ROOT/formal/RuntimeDispatchR1.cfg" "$tmp_dir/RuntimeDispatchR1.cfg"
    set +e
    ( cd "$tmp_dir"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
      -config RuntimeDispatchR1.cfg RuntimeDispatchR1.tla ) > "$tmp_dir/result.log" 2>&1
    result=$?
    set -e
    if [[ "$result" -ne 12 ]] ||
       ! grep -Fxq "Error: Invariant MatchingResultRequiredForTerminal is violated." "$tmp_dir/result.log" ||
       ! grep -Fxq "Error: The behavior up to this point is:" "$tmp_dir/result.log" ||
       ! grep -Eq '^State [1-9][0-9]*:' "$tmp_dir/result.log"; then
      echo "TLC stdout negative control FAILED: no named counterexample" >&2
      tail -35 "$tmp_dir/result.log" >&2
      exit 1
    fi
    echo "TLC stdout negative control PASS: partial output cannot authorize terminal"
  )
}

check_workspace_consumer_close() {
  verify_jar
  java -XX:+UseParallelGC -cp "$JAR" tla2sany.SANY \
    "$ROOT/formal/WorkspaceConsumerCloseR1.tla"
  (cd "$ROOT/formal"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
    -config WorkspaceConsumerCloseR1.cfg WorkspaceConsumerCloseR1.tla)
}

workspace_close_expect_named_counterexample() {
  local folder="$1" config="$2" property="$3" label="$4"
  local output="$folder/result.log" result
  set +e
  (cd "$folder"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
    -config "$config" WorkspaceConsumerCloseR1.tla) > "$output" 2>&1
  result=$?
  set -e
  if [[ "$result" -ne 12 ]] ||
      ! grep -Fxq "Error: Invariant $property is violated." "$output" ||
      ! grep -Fxq 'Error: The behavior up to this point is:' "$output" ||
      ! grep -Eq '^State [1-9][0-9]*:' "$output"; then
    echo "Workspace consumer close $label negative control FAILED" >&2
    tail -45 "$output" >&2
    exit 1
  fi
  echo "Workspace consumer close $label negative control PASS: $property"
}

check_workspace_consumer_close_counterexamples() {
  verify_jar
  (
    tmp_dir=$(mktemp -d -t ordivon-workspace-close-XXXXXX)
    trap 'rm -rf -- "$tmp_dir"' EXIT
    for kind in reachability unguarded spoofed; do
      mkdir "$tmp_dir/$kind"
      cp "$ROOT/formal/WorkspaceConsumerCloseR1.tla" "$tmp_dir/$kind/"
      cp "$ROOT/formal/WorkspaceConsumerCloseR1.cfg" "$tmp_dir/$kind/"
    done
    cp "$ROOT/formal/WorkspaceConsumerCloseR1.reachability.cfg" "$tmp_dir/reachability/"
    workspace_close_expect_named_counterexample "$tmp_dir/reachability" \
      WorkspaceConsumerCloseR1.reachability.cfg ClosedUnreachable reachable

    python3 - "$tmp_dir" <<'PY_WORKSPACE_CLOSE'
from pathlib import Path
import sys

root = Path(sys.argv[1])
model = "WorkspaceConsumerCloseR1.tla"
source = (root / "unguarded" / model).read_text(encoding="utf-8")
guard = '    /\\ (released \\/ age = "expired")\n'
assert source.count(guard) == 1, "close guard drift"
(root / "unguarded" / model).write_text(
    source.replace(guard, "", 1), encoding="utf-8"
)

source = (root / "spoofed" / model).read_text(encoding="utf-8")
honest = '    /\\ consumer = "finished"\n    /\\ ~released'
spoof = '    /\\ consumer = "active"\n    /\\ ~released'
assert source.count(honest) == 1, "release transition drift"
(root / "spoofed" / model).write_text(
    source.replace(honest, spoof, 1), encoding="utf-8"
)
cfg = root / "spoofed" / "WorkspaceConsumerCloseR1.cfg"
content = cfg.read_text(encoding="utf-8")
qualification = "INVARIANT ReleasedAssumesConsumerFinished\n"
assert content.count(qualification) == 1
cfg.write_text(content.replace(qualification, "", 1), encoding="utf-8")
PY_WORKSPACE_CLOSE
    workspace_close_expect_named_counterexample "$tmp_dir/unguarded" \
      WorkspaceConsumerCloseR1.cfg FreshActiveConsumerCannotBeClosed unguarded
    # Scope counterexample: a claimed release is not authenticated consumer truth.
    workspace_close_expect_named_counterexample "$tmp_dir/spoofed" \
      WorkspaceConsumerCloseR1.cfg FreshActiveConsumerCannotBeClosed spoofed
  )
}

case "${1:-check}" in
  bootstrap) bootstrap ;;
  verify) verify_jar; echo "TLA+ toolchain digest verification PASS" ;;
  check) check_runtime_dispatch; check_runtime_pg_cutover; check_windows_first_pg_order; check_workspace_consumer_close ;;
  falsify) check_runtime_counterexample; check_terminal_pointer_counterexample; check_partial_output_counterexample; check_foreign_result_recovery_counterexample; check_pg_cutover_counterexample; check_windows_first_pg_falsifiers; check_workspace_consumer_close_counterexamples ;;
  *)
    echo "usage: scripts/tla-formal [bootstrap|verify|check|falsify]" >&2
    exit 2
    ;;
esac
