check_windows_pg_attempt_counterexample() {
  verify_jar
  (
    tmp_dir=$(mktemp -d -t ordivon-winpg-attempt-XXXXXX)
    trap 'rm -rf -- "$tmp_dir"' EXIT
    cp "$ROOT/formal/RuntimeWindowsPgAttemptR1.tla" "$tmp_dir/"
    cp "$ROOT/formal/RuntimeWindowsPgAttemptR1.cfg" "$tmp_dir/"
    printf '\nINVARIANT NeverTerminal\n' >> "$tmp_dir/RuntimeWindowsPgAttemptR1.cfg"
    set +e
    (cd "$tmp_dir"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
        -config RuntimeWindowsPgAttemptR1.cfg RuntimeWindowsPgAttemptR1.tla) > "$tmp_dir/negative.log" 2>&1
    code=$?
    set -e
    if [[ "$code" -ne 12 ]] || ! grep -Fq 'Invariant NeverTerminal is violated' "$tmp_dir/negative.log"; then
      echo 'WinPG attempt anti-vacuity counterexample FAILED' >&2
      tail -30 "$tmp_dir/negative.log" >&2
      exit 1
    fi
    echo 'WinPG attempt legal terminal reachable; no vacuous proof PASS'
    # Independent falsifier: deliberately remove the native OS exit guard.
    # The model MUST then reach a terminal while PID/owner is still alive or
    # ambiguous; otherwise the safe model is too weak to catch this bug.
    python3 - "$tmp_dir/RuntimeWindowsPgAttemptR1.tla" <<'PY_WINPG_UNGUARDED'
from pathlib import Path
import sys
path = Path(sys.argv[1])
src = path.read_text(encoding='utf-8')
guard = '    /\\ osOwner = "exited"\n'
assert src.count(guard) == 1, "formal Windows PG owner guard changed"
path.write_text(src.replace(guard, '', 1), encoding='utf-8')
PY_WINPG_UNGUARDED
    sed -i '/INVARIANT NeverTerminal/d' "$tmp_dir/RuntimeWindowsPgAttemptR1.cfg"
    set +e
    (cd "$tmp_dir"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
        -config RuntimeWindowsPgAttemptR1.cfg RuntimeWindowsPgAttemptR1.tla) > "$tmp_dir/unguarded.log" 2>&1
    code=$?
    set -e
    if [[ "$code" -ne 12 ]] || ! grep -Fq 'Invariant TerminalRequiresExactOsExit is violated' "$tmp_dir/unguarded.log"; then
      echo 'WinPG missing OS exit guard negative control FAILED' >&2
      tail -30 "$tmp_dir/unguarded.log" >&2
      exit 1
    fi
    echo 'WinPG missing OS exit guard counterexample PASS'
    # Second independent falsifier: an absent/unknown Job Object must NOT
    # satisfy the real process-tree-empty requirement. Reconstruct from the
    # pristine model; the previous mutation removed only the PID exit guard.
    cp "$ROOT/formal/RuntimeWindowsPgAttemptR1.tla" "$tmp_dir/RuntimeWindowsPgAttemptR1.tla"
    python3 - "$tmp_dir/RuntimeWindowsPgAttemptR1.tla" <<'PY_WINPG_NO_JOB_OBJECT'
from pathlib import Path
import sys
path = Path(sys.argv[1])
src = path.read_text(encoding='utf-8')
guard = '    /\\ jobObject = "empty"\n'
assert src.count(guard) == 1, "Windows PG Job Object guard drifted"
path.write_text(src.replace(guard, '', 1), encoding='utf-8')
PY_WINPG_NO_JOB_OBJECT
    set +e
    (cd "$tmp_dir"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
        -config RuntimeWindowsPgAttemptR1.cfg RuntimeWindowsPgAttemptR1.tla) > "$tmp_dir/unguarded-object.log" 2>&1
    code=$?
    set -e
    if [[ "$code" -ne 12 ]] || ! grep -Fq 'Invariant TerminalRequiresJobObjectEmpty is violated' "$tmp_dir/unguarded-object.log"; then
      echo 'WinPG missing Job Object empty guard negative control FAILED' >&2
      tail -30 "$tmp_dir/unguarded-object.log" >&2
      exit 1
    fi
    echo 'WinPG missing Job Object empty guard counterexample PASS'
  )
}


