# Design-only: current installed Harness and Runtime use distinct PG databases.
check_workspace_cross_database_claim() {
  verify_jar
  java -XX:+UseParallelGC -cp "$JAR" tla2sany.SANY "$ROOT/formal/WorkspaceCrossDatabaseClaimR1.tla"
  (cd "$ROOT/formal"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
    -config WorkspaceCrossDatabaseClaimR1.cfg WorkspaceCrossDatabaseClaimR1.tla)
}

falsify_workspace_cross_database_claim() {
  verify_jar
  local label cfg invariant result output
  for label in reachability original-reachability recipient-reachability legacy-unclaimed-close unsafe-close unsafe-late unsafe-grant unsafe-adoption unsafe-known-rebind unsafe-caller-release unsafe-caller-close unsafe-selfcert-release unsafe-selfcert-close manager-quiet-reachability unsafe-manager-release unsafe-manager-close unsafe-manager-late-birth; do
    cfg="WorkspaceCrossDatabaseClaimR1.$label.cfg"
    case "$label" in
      reachability) invariant=ClosedUnreachable ;;
      original-reachability) invariant=NoOriginalClaimEver ;;
      recipient-reachability) invariant=IndependentAcceptedReleaseUnreachable ;;
      unsafe-adoption) invariant=ClaimBoundToOriginal ;;
      unsafe-known-rebind) invariant=ClaimBoundToOriginal ;;
      unsafe-caller-release) invariant=ReleaseRequiresOriginalFinalization ;;
      unsafe-caller-close) invariant=ClosedHasNoPrematurelyReleasedConsumers ;;
      unsafe-selfcert-release) invariant=ReleaseRequiresIndependentRecipientAck ;;
      unsafe-selfcert-close) invariant=ClosedHasIndependentRecipientAcceptance ;;
      manager-quiet-reachability) invariant=ManagerHandoffDrainedCloseUnreachable ;;
      unsafe-manager-release) invariant=NativePendingHasOriginalPin ;;
      unsafe-manager-close) invariant=ClosedHasNoManagerQueue ;;
      unsafe-manager-late-birth) invariant=ClosedHasNoPhysicalDependencies ;;
      legacy-unclaimed-close) invariant=LegacyUnclaimedRunPreserved ;;
      unsafe-close|unsafe-late) invariant=ClosedHasNoOutstandingPins ;;
      unsafe-grant) invariant=UnreleasedGrantsHeld ;;
    esac
    set +e
    output=$(cd "$ROOT/formal" && java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC \
      -workers 1 -config "$cfg" WorkspaceCrossDatabaseClaimR1.tla 2>&1)
    result=$?
    set -e
    if [[ "$result" != 12 ]] ||
       ! printf '%s\n' "$output" | grep -Fxq "Error: Invariant $invariant is violated." ||
       ! printf '%s\n' "$output" | grep -Eq '^State [1-9][0-9]*:'; then
      echo "Workspace cross-DB $label counterexample FAILED" >&2
      printf '%s\n' "$output" >&2
      exit 1
    fi
    echo "Workspace cross-DB $label counterexample PASS"
  done
}


