  java -XX:+UseParallelGC -cp "$JAR" tla2sany.SANY "$ROOT/formal/WorkspaceMultiAgentReleaseR1.tla"
  (cd "$ROOT/formal"; java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -workers 1 \
