#!/usr/bin/env python3
"""Read-only planning for versioned Ordivon Runtime cold-history archival."""

from __future__ import annotations

import argparse
import json
import math
import os
import subprocess
import sys
import time
from pathlib import Path

SCHEMA_VERSION = 1
STABLE_TERMINAL_RESOLUTIONS = ("succeeded", "failed", "timed_out", "cancelled")
STABLE_TERMINAL_ATTEMPT_STATES = STABLE_TERMINAL_RESOLUTIONS
REPAIRABLE_TERMINALS = ("lost", "orphaned")
DEFAULT_MINIMUM_AGE_HOURS = 168.0
DEFAULT_SAMPLE_LIMIT = 20
MAX_SAMPLE_LIMIT = 100
TRUTH_ROLE = "archive-eligibility-observation-not-export-or-deletion-authority"


def absolute_path(value: str) -> Path:
    path = Path(value)
    if not path.is_absolute():
        raise argparse.ArgumentTypeError("path must be absolute")
    return path


def nonnegative_float(value: str) -> float:
    parsed = float(value)
    if not math.isfinite(parsed) or parsed < 0:
        raise argparse.ArgumentTypeError("hours must be finite and non-negative")
    return parsed


def positive_timeout(value: str) -> int:
    timeout = int(value)
    if not 1 <= timeout <= 2_147_483_647:
        raise argparse.ArgumentTypeError(
            "timeout must fit SQLite's signed 32-bit millisecond busy-timeout range"
        )
    return timeout


def sample_limit(value: str) -> int:
    parsed = int(value)
    if not 0 <= parsed <= MAX_SAMPLE_LIMIT:
        raise argparse.ArgumentTypeError(
            f"sample limit must be between 0 and {MAX_SAMPLE_LIMIT}"
        )
    return parsed


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="ordivon-runtime-archive",
        description=(
            "Inspect cold-history archival eligibility without exporting, deleting, "
            "vacuuming, or changing Runtime authority."
        ),
    )
    parser.add_argument("--database", type=absolute_path, required=True)
    parser.add_argument(
        "--minimum-age-hours",
        type=nonnegative_float,
        default=DEFAULT_MINIMUM_AGE_HOURS,
    )
    parser.add_argument(
        "--sample-limit", type=sample_limit, default=DEFAULT_SAMPLE_LIMIT
    )
    parser.add_argument("--busy-timeout-ms", type=positive_timeout, default=5_000)
    parser.add_argument("--now-ms", type=int, help=argparse.SUPPRESS)
    parser.add_argument("--pretty", action="store_true")
    return parser.parse_args()


def runtime_inspect_binary() -> Path:
    configured = os.environ.get("ORDIVON_RUNTIME_INSPECT")
    candidates: list[Path] = []
    if configured:
        candidate = Path(configured)
        if not candidate.is_absolute():
            raise RuntimeError("ORDIVON_RUNTIME_INSPECT must be an absolute path")
        candidates.append(candidate)
    candidates.extend(
        [
            Path(__file__).resolve().with_name("ordivon-runtime-inspect"),
            Path(__file__).resolve().parents[1] / "target/debug/ordivon-runtime-inspect",
        ]
    )
    for candidate in candidates:
        if candidate.is_file() and not candidate.is_symlink() and os.access(candidate, os.X_OK):
            return candidate
    raise RuntimeError(
        "ordivon-runtime-inspect is unavailable; install it beside this script or set "
        "ORDIVON_RUNTIME_INSPECT to an absolute executable path"
    )


def registry_archive_projection(
    database: Path, busy_timeout_ms: int, cutoff_ms: int, sample_limit: int
) -> dict[str, object]:
    if database.is_symlink() or not database.is_file():
        raise RuntimeError("Registry database must be an existing regular file")
    command = [
        str(runtime_inspect_binary()),
        "registry-archive",
        "--database",
        str(database),
        "--busy-timeout-ms",
        str(busy_timeout_ms),
        "--cutoff-ms",
        str(cutoff_ms),
        "--sample-limit",
        str(sample_limit),
    ]
    completed = subprocess.run(command, check=False, text=True, capture_output=True)
    if completed.returncode != 0:
        detail = completed.stderr.strip() or completed.stdout.strip() or f"exit {completed.returncode}"
        raise RuntimeError(f"Runtime archive Registry inspection failed: {detail}")
    try:
        value = json.loads(completed.stdout)
    except json.JSONDecodeError as error:
        raise RuntimeError("Runtime archive Registry inspection returned invalid JSON") from error
    if not isinstance(value, dict):
        raise RuntimeError("Runtime archive Registry inspection did not return an object")
    required = ("migrationVersion", "byClassification", "eligibleClosure", "eligibleSample")
    if any(key not in value for key in required):
        raise RuntimeError("Runtime archive Registry inspection omitted required fields")
    return value


def inspect_archive(args: argparse.Namespace) -> dict[str, object]:
    now_ms = args.now_ms if args.now_ms is not None else int(time.time() * 1000)
    if now_ms < 0:
        raise RuntimeError("now-ms must be non-negative")
    cutoff_ms = max(0, int(now_ms - args.minimum_age_hours * 3_600_000))
    projection = registry_archive_projection(
        args.database, args.busy_timeout_ms, cutoff_ms, args.sample_limit
    )
    migration_version = projection.get("migrationVersion")
    summary = projection.get("byClassification")
    closure = projection.get("eligibleClosure")
    sample = projection.get("eligibleSample")
    if (
        not isinstance(migration_version, int)
        or not isinstance(summary, list)
        or not isinstance(closure, dict)
        or not isinstance(sample, list)
    ):
        raise RuntimeError("Runtime archive Registry inspection returned invalid projection")
    classified_total = sum(
        int(item["jobs"])
        for item in summary
        if isinstance(item, dict) and isinstance(item.get("jobs"), int)
    )
    return {
        "schemaVersion": SCHEMA_VERSION,
        "truthRole": TRUTH_ROLE,
        "generatedAtMs": now_ms,
        "registryMigrationVersion": migration_version,
        "policy": {
            "minimumAgeHours": args.minimum_age_hours,
            "cutoffMs": cutoff_ms,
            "stableTerminalResolutions": list(STABLE_TERMINAL_RESOLUTIONS),
            "repairableTerminalsExcluded": list(REPAIRABLE_TERMINALS),
            "runtimeReleaseEffectsExcluded": True,
            "activeOrHeldReservationsExcluded": True,
            "supervisorOwnersExcluded": True,
        },
        "summary": {
            "classifiedJobs": classified_total,
            "byClassification": summary,
            "eligibleClosure": closure,
        },
        "eligibleSample": sample,
        "boundaries": {
            "mutatesRegistry": False,
            "exportsArchive": False,
            "deletesHotHistory": False,
            "measuresPhysicalBundleBytes": False,
            "logicalByteEstimatesArePhysicalReclaim": False,
            "exactApplyRequiresFreshFencedRevalidation": True,
        },
    }


def main() -> int:
    try:
        args = parse_args()
        result = inspect_archive(args)
        print(json.dumps(result, indent=2 if args.pretty else None, sort_keys=args.pretty))
        return 0
    except (OSError, RuntimeError, ValueError) as error:
        print(f"runtime archive inspection failed: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
