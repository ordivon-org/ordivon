import fcntl
import hashlib
import http.client
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from contextlib import contextmanager
from pathlib import Path
import urllib.error
from urllib.parse import quote

SCRIPT_DIR = Path(__file__).resolve().parent
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))
from mcp_probe import connect_compatible, load_bearer_token, load_environment_file

SCHEMA_VERSION = 1
SWEEP_CONFIRMATION = "APPLY_WORKSPACE_RETENTION_POLICY"
REPAIR_CONFIRMATION = "REPAIR_WORKSPACE_IDENTITIES"
QUARANTINE_CONFIRMATION = "QUARANTINE_BROKEN_WORKSPACES"
DIRTY_CHECKPOINT_CONFIRMATION = "CHECKPOINT_DIRTY_WORKSPACE_STATE"
MAX_DIRTY_PATHS = 10_000
SUBPROCESS_WALL_TIMEOUT_SECONDS = 120.0
RUNTIME_INSPECT_WALL_TIMEOUT_SECONDS = 15.0
MCP_EFFECT_TIMEOUT_SECONDS = 10.0
CANONICAL_HEAD_TIMEOUT_SECONDS = 5.0
TRUSTED_TMP_PRESENTATION_ROOT = Path("/tmp/ordivon-t")
DEFAULT_POLICY = {
    "schemaVersion": 1,
    "defaultClass": "ephemeral",
    "classes": {
        "ephemeral": {
            "retentionHours": 72.0,
            "maxLifetimeHours": 168.0,
            "forceCloseDirtyAfterRetention": True,
            "forceCloseUnintegratedAfterRetention": True,
            "forceCloseAfterMaxLifetime": True,
        },
        "review": {
            "retentionHours": 168.0,
            "maxLifetimeHours": 168.0,
            "forceCloseDirtyAfterRetention": True,
            "forceCloseUnintegratedAfterRetention": True,
            "forceCloseAfterMaxLifetime": True,
        },
        "pinned": {
            "retentionHours": None,
            "maxLifetimeHours": None,
            "forceCloseDirtyAfterRetention": False,
            "forceCloseUnintegratedAfterRetention": False,
            "forceCloseAfterMaxLifetime": False,
        },
    },
    "rules": [],
    "sourceRepoAliases": {},
}


def absolute_path(value: str) -> Path:
    path = Path(value)
    if not path.is_absolute():
        raise argparse.ArgumentTypeError("path must be absolute")
    return path


def workspace_id_from_reference(value: str) -> str:
    prefix = "runtime:workspace:"
    if not value.startswith(prefix):
        raise RuntimeError(
            "workspace reference must use runtime:workspace:<workspaceId>"
        )
    workspace_id = value[len(prefix):]
    if not workspace_id or len(workspace_id) > 96:
        raise RuntimeError("workspace reference contains an invalid Workspace id")
    first_allowed = set("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789")
    allowed = first_allowed | set("._-")
    if workspace_id[0] not in first_allowed or any(char not in allowed for char in workspace_id):
        raise RuntimeError("workspace reference contains an invalid Workspace id")
    return workspace_id


def selected_workspace_ids(args: argparse.Namespace) -> list[str]:
    selected: list[str] = []
    for workspace_id in getattr(args, "workspace_ids", None) or []:
        if workspace_id not in selected:
            selected.append(workspace_id)
    for reference in getattr(args, "workspace_refs", None) or []:
        workspace_id = workspace_id_from_reference(reference)
        if workspace_id not in selected:
            selected.append(workspace_id)
    return selected

def nonnegative_float(value: str) -> float:
    parsed = float(value)
    if not math.isfinite(parsed) or parsed < 0:
        raise argparse.ArgumentTypeError("hours must be finite and non-negative")
    return parsed


def positive_timeout(value: str) -> int:
    parsed = int(value)
    if not 1 <= parsed <= 2_147_483_647:
        raise argparse.ArgumentTypeError(
            "timeout must fit SQLite's signed 32-bit millisecond busy-timeout range"
        )
    return parsed


def add_common(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--database", type=absolute_path, required=True)
    parser.add_argument("--runtime-store-root", type=absolute_path, required=True)
    parser.add_argument("--workspace-root", type=absolute_path)
    parser.add_argument("--policy-file", type=absolute_path)
    parser.add_argument("--busy-timeout-ms", type=positive_timeout, default=5_000)
    parser.add_argument("--measure-bytes", action="store_true")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="ordivon-runtime-lifecycle")
    sub = parser.add_subparsers(dest="command", required=True)

    inspect = sub.add_parser("inspect", help="enrich reclaim evidence with retention policy")
    add_common(inspect)
    inspect.add_argument(
        "--workspace-id",
        action="append",
        dest="workspace_ids",
        help=(
            "inspect only this natural-owner-selected Workspace; repeat for a bounded "
            "completion cohort"
        ),
    )
    inspect.add_argument(
        "--workspace-ref",
        action="append",
        dest="workspace_refs",
        help=(
            "consume one Host/natural-owner navigation reference of the exact form "
            "runtime:workspace:<workspaceId>; repeat for a bounded completion cohort. "
            "The reference selects a carrier only and does not establish semantic completion."
        ),
    )
    inspect.add_argument("--pretty", action="store_true")

    sweep = sub.add_parser("sweep", help="release policy-expired clean Workspaces")
    add_common(sweep)
    sweep.add_argument("--env-file", type=absolute_path, required=True)
    sweep.add_argument("--receipt-root", type=absolute_path, required=True)
    sweep.add_argument("--lock-file", type=absolute_path, required=True)
    sweep.add_argument("--confirm-policy", required=True)
    sweep.add_argument("--pretty", action="store_true")

    repair = sub.add_parser("repair", help="repair renamed Git worktree identities")
    add_common(repair)
    repair.add_argument("--receipt-root", type=absolute_path, required=True)
    repair.add_argument("--lock-file", type=absolute_path, required=True)
    repair.add_argument("--workspace-id", action="append", dest="workspace_ids")
    repair.add_argument("--minimum-age-hours", type=nonnegative_float, default=0.0)
    repair.add_argument("--confirm-policy", required=True)
    repair.add_argument("--quarantine-unrepairable", action="store_true")
    repair.add_argument("--quarantine-root", type=absolute_path)
    repair.add_argument("--confirm-quarantine")
    repair.add_argument("--pretty", action="store_true")

    dirty_review = sub.add_parser("dirty-review", help="record exact dirty Workspace evidence and owner action guidance")
    add_common(dirty_review)
    dirty_review.add_argument("--receipt-root", type=absolute_path, required=True)
    dirty_review.add_argument("--lock-file", type=absolute_path, required=True)
    dirty_review.add_argument("--workspace-id", action="append", dest="workspace_ids", required=True)
    dirty_review.add_argument("--checkpoint-after-hours", type=nonnegative_float, default=24.0)
    dirty_review.add_argument("--review-after-hours", type=nonnegative_float, default=72.0)
    dirty_review.add_argument("--quarantine-review-after-hours", type=nonnegative_float, default=168.0)
    dirty_review.add_argument("--pretty", action="store_true")

    dirty_checkpoint = sub.add_parser(
        "dirty-checkpoint",
        help="preserve one dirty Workspace Git state as a recoverable source-repo bundle without closing it",
    )
    add_common(dirty_checkpoint)
    dirty_checkpoint.add_argument("--receipt-root", type=absolute_path, required=True)
    dirty_checkpoint.add_argument("--lock-file", type=absolute_path, required=True)
    dirty_checkpoint.add_argument("--workspace-id", action="append", dest="workspace_ids", required=True)
    dirty_checkpoint.add_argument("--confirm-policy", required=True)
    dirty_checkpoint.add_argument("--pretty", action="store_true")
    return parser.parse_args()


def reclaim_program() -> Path:
    configured = os.environ.get("ORDIVON_RUNTIME_RECLAIM")
    if configured:
        return Path(configured)
    sibling = Path(__file__).resolve().with_name("ordivon-runtime-reclaim")
    if sibling.is_file():
        return sibling
    repository = Path(__file__).resolve().parents[1] / "scripts/ordivon-runtime-reclaim"
    if repository.is_file():
        return repository
    raise RuntimeError("cannot locate ordivon-runtime-reclaim")


def run_json(command: list[str], *, accepted_codes: tuple[int, ...] = (0,)) -> dict[str, object]:
    try:
        result = subprocess.run(
            command,
            check=False,
            text=True,
            capture_output=True,
            timeout=SUBPROCESS_WALL_TIMEOUT_SECONDS,
        )
    except subprocess.TimeoutExpired as error:
        raise RuntimeError(
            f"subordinate Runtime tool exceeded {SUBPROCESS_WALL_TIMEOUT_SECONDS:.0f}s wall timeout"
        ) from error
    if result.returncode not in accepted_codes:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip() or "command failed")
    value = json.loads(result.stdout)
    if not isinstance(value, dict):
        raise RuntimeError("command did not return a JSON object")
    if value.get("schemaVersion") != SCHEMA_VERSION:
        raise RuntimeError("subordinate Runtime tool returned an unsupported schemaVersion")
    return value


def validate_reclaim_inspect(value: dict[str, object]) -> dict[str, object]:
    summary = value.get("summary")
    candidates = value.get("candidates")
    if not isinstance(summary, dict):
        raise RuntimeError("reclaim inspect result summary must be an object")
    if not isinstance(candidates, list):
        raise RuntimeError("reclaim inspect result candidates must be an array")
    seen: set[str] = set()
    for item in candidates:
        if not isinstance(item, dict):
            raise RuntimeError("reclaim inspect candidate must be an object")
        workspace_id = item.get("workspaceId")
        classification = item.get("classification")
        if not isinstance(workspace_id, str) or not workspace_id:
            raise RuntimeError("reclaim inspect candidate workspaceId must be a non-empty string")
        if workspace_id in seen:
            raise RuntimeError("reclaim inspect result contains duplicate workspaceId")
        seen.add(workspace_id)
        if not isinstance(classification, str) or not classification:
            raise RuntimeError("reclaim inspect candidate classification must be a non-empty string")
        created_ms = item.get("createdUnixMs")
        if created_ms is not None and not isinstance(created_ms, int):
            raise RuntimeError("reclaim inspect candidate createdUnixMs must be an integer when present")
        estimated_bytes = item.get("estimatedBytes")
        if estimated_bytes is not None and (
            not isinstance(estimated_bytes, int) or estimated_bytes < 0
        ):
            raise RuntimeError("reclaim inspect candidate estimatedBytes must be non-negative when present")
    return value


def validate_reclaim_apply(value: dict[str, object]) -> dict[str, object]:
    if value.get("status") not in {"completed", "partial"}:
        raise RuntimeError("reclaim apply result status is invalid")
    actions = value.get("actions")
    failures = value.get("failures")
    receipt = value.get("receipt")
    if not isinstance(actions, list) or any(not isinstance(item, dict) for item in actions):
        raise RuntimeError("reclaim apply result actions must be an array of objects")
    if not isinstance(failures, list) or any(not isinstance(item, dict) for item in failures):
        raise RuntimeError("reclaim apply result failures must be an array of objects")
    if not isinstance(receipt, str) or not receipt:
        raise RuntimeError("reclaim apply result receipt must be a non-empty string")
    for item in actions:
        if not isinstance(item.get("workspaceId"), str) or not isinstance(item.get("action"), str):
            raise RuntimeError("reclaim apply action requires string workspaceId and action")
    return value


def reclaim_inspect(args: argparse.Namespace) -> dict[str, object]:
    command = [
        sys.executable,
        str(reclaim_program()),
        "inspect",
        "--database",
        str(args.database),
        "--runtime-store-root",
        str(args.runtime_store_root),
        "--busy-timeout-ms",
        str(args.busy_timeout_ms),
    ]
    if args.workspace_root:
        command.extend(["--workspace-root", str(args.workspace_root)])
    if args.measure_bytes:
        command.append("--measure-bytes")
    for workspace_id in selected_workspace_ids(args):
        command.extend(["--workspace-id", workspace_id])
    return validate_reclaim_inspect(run_json(command))


def load_policy(path: Path | None) -> dict[str, object]:
    value = json.loads(json.dumps(DEFAULT_POLICY))
    if path is not None:
        loaded = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(loaded, dict):
            raise RuntimeError("retention policy must be a JSON object")
        for key, loaded_value in loaded.items():
            if key in {"classes", "sourceRepoAliases"} and isinstance(loaded_value, dict):
                current = value.get(key)
                if not isinstance(current, dict):
                    current = {}
                current.update(loaded_value)
                value[key] = current
            else:
                value[key] = loaded_value
    if value.get("schemaVersion") != SCHEMA_VERSION:
        raise RuntimeError("unsupported retention policy schemaVersion")
    classes = value.get("classes")
    if not isinstance(classes, dict) or not classes:
        raise RuntimeError("retention policy classes must be a non-empty object")
    for name, definition in classes.items():
        if not isinstance(name, str) or not isinstance(definition, dict):
            raise RuntimeError("retention policy class definitions are invalid")
        hours = definition.get("retentionHours")
        if hours is not None and (not isinstance(hours, (int, float)) or hours < 0):
            raise RuntimeError(f"retentionHours for {name} must be null or non-negative")
        max_lifetime = definition.get("maxLifetimeHours")
        if max_lifetime is not None and (
            not isinstance(max_lifetime, (int, float)) or max_lifetime < 0
        ):
            raise RuntimeError(
                f"maxLifetimeHours for {name} must be null or non-negative"
            )
        for field in (
            "forceCloseDirtyAfterRetention",
            "forceCloseUnintegratedAfterRetention",
            "forceCloseAfterMaxLifetime",
        ):
            flag_value = definition.get(field, False)
            if not isinstance(flag_value, bool):
                raise RuntimeError(f"{field} for {name} must be boolean")
    default_class = value.get("defaultClass")
    if default_class not in classes:
        raise RuntimeError("defaultClass must name a configured class")
    rules = value.get("rules", [])
    if not isinstance(rules, list):
        raise RuntimeError("retention policy rules must be an array")
    for rule in rules:
        if not isinstance(rule, dict) or rule.get("class") not in classes:
            raise RuntimeError("retention policy rule must name a configured class")
        selectors = [key for key in ("workspaceId", "prefix") if isinstance(rule.get(key), str)]
        if len(selectors) != 1:
            raise RuntimeError("each retention rule must contain exactly one workspaceId or prefix")
    aliases = value.get("sourceRepoAliases", {})
    if not isinstance(aliases, dict) or any(
        not isinstance(old, str) or not isinstance(new, str) for old, new in aliases.items()
    ):
        raise RuntimeError("sourceRepoAliases must map strings to strings")
    return value


def retention_class(
    policy: dict[str, object], workspace_id: str
) -> tuple[str, float | None, float | None, bool, bool, bool]:
    classes = policy["classes"]
    assert isinstance(classes, dict)
    selected = str(policy["defaultClass"])
    for rule in policy.get("rules", []):
        assert isinstance(rule, dict)
        if rule.get("workspaceId") == workspace_id:
            selected = str(rule["class"])
            break
        prefix = rule.get("prefix")
        if isinstance(prefix, str) and workspace_id.startswith(prefix):
            selected = str(rule["class"])
            break
    definition = classes[selected]
    assert isinstance(definition, dict)
    hours = definition.get("retentionHours")
    max_lifetime = definition.get("maxLifetimeHours")
    force_dirty = definition.get("forceCloseDirtyAfterRetention", False)
    force_unintegrated = definition.get(
        "forceCloseUnintegratedAfterRetention", False
    )
    force_max = definition.get("forceCloseAfterMaxLifetime", False)
    assert isinstance(force_dirty, bool)
    assert isinstance(force_unintegrated, bool)
    assert isinstance(force_max, bool)
    return (
        selected,
        float(hours) if isinstance(hours, (int, float)) else None,
        float(max_lifetime)
        if isinstance(max_lifetime, (int, float))
        else None,
        force_dirty,
        force_unintegrated,
        force_max,
    )


def carrier_projection(item: dict[str, object]) -> dict[str, object]:
    """Translate lifecycle evidence into a physical Agent next-step projection."""

    classification = str(item.get("classification", "unknown"))
    policy_eligible = item.get("policyEligible") is True
    retention_hours = item.get("retentionHours")
    max_lifetime_hours = item.get("maxLifetimeHours")
    hard_lifetime_expired = item.get("hardLifetimeExpired") is True
    retention_applies = (
        classification in {"closable", "stale_record"}
        or (
            classification == "blocked_dirty"
            and item.get("forceCloseDirtyAfterRetention") is True
        )
        or (
            classification == "blocked_unintegrated"
            and item.get("forceCloseUnintegratedAfterRetention") is True
        )
        or (
            hard_lifetime_expired
            and item.get("forceCloseAfterMaxLifetime") is True
            and classification
            in {"closable", "stale_record", "blocked_dirty", "blocked_unintegrated"}
        )
    )
    if retention_applies:
        if policy_eligible:
            retention_state = "ELIGIBLE"
        elif retention_hours is None and max_lifetime_hours is None:
            retention_state = "PINNED"
        else:
            retention_state = "WAITING"
    else:
        retention_state = "NOT_APPLICABLE"

    if classification == "closable":
        physical_state = "CLEAN_IDLE"
        next_step = "DECLARE_CLOSE_CLEAN_OR_RETAIN"
        clean_close_candidate = True
        dirty_handoff_required = False
        owner_disposition_required = True
    elif classification == "blocked_dirty":
        physical_state = "DIRTY_IDLE"
        if policy_eligible and (
            item.get("forceCloseDirtyAfterRetention") is True
            or (
                hard_lifetime_expired
                and item.get("forceCloseAfterMaxLifetime") is True
            )
        ):
            next_step = "POLICY_FORCE_CLOSE_DIRTY"
            dirty_handoff_required = False
            owner_disposition_required = False
        else:
            next_step = "DECLARE_DIRTY_HANDOFF_OR_CHECKPOINT"
            dirty_handoff_required = True
            owner_disposition_required = True
        clean_close_candidate = False
    elif classification == "blocked_unintegrated":
        physical_state = "CLEAN_IDLE_UNINTEGRATED"
        if policy_eligible and (
            item.get("forceCloseUnintegratedAfterRetention") is True
            or (
                hard_lifetime_expired
                and item.get("forceCloseAfterMaxLifetime") is True
            )
        ):
            next_step = "POLICY_FORCE_CLOSE_UNINTEGRATED"
            owner_disposition_required = False
        else:
            next_step = "INTEGRATE_OR_EXPLICITLY_DISPOSITION_SOURCE"
            owner_disposition_required = True
        clean_close_candidate = False
        dirty_handoff_required = False
    elif classification == "blocked_active":
        physical_state = "ACTIVE_DIRTY_STATE_UNINSPECTED"
        next_step = "OBSERVE_OR_RECONCILE_ACTIVE_JOB"
        clean_close_candidate = False
        dirty_handoff_required = False
        owner_disposition_required = False
    elif classification == "stale_record":
        physical_state = "MISSING_WITH_OPEN_RECORD"
        next_step = "RECONCILE_STALE_RECORD"
        clean_close_candidate = False
        dirty_handoff_required = False
        owner_disposition_required = False
    elif classification == "orphan_directory":
        physical_state = "ORPHAN_DIRECTORY_WITHOUT_IDENTITY"
        next_step = "EXPLICIT_QUARANTINE_OR_IDENTITY_RECOVERY"
        clean_close_candidate = False
        dirty_handoff_required = False
        owner_disposition_required = False
    else:
        physical_state = "UNPROVEN"
        next_step = "INSPECT_BEFORE_DISPOSITION"
        clean_close_candidate = False
        dirty_handoff_required = False
        owner_disposition_required = False

    return {
        "truthRole": "derived-runtime-physical-carrier-projection",
        "physicalState": physical_state,
        "nextProtocolStep": next_step,
        "cleanCloseCandidate": clean_close_candidate,
        "dirtyHandoffRequired": dirty_handoff_required,
        "ownerDispositionRequired": owner_disposition_required,
        "retentionPolicyState": retention_state,
        "policyClosureEligible": policy_eligible,
        "semanticCompletionEvaluated": False,
        "interpretation": (
            "Runtime physical state and operator retention policy only; Host/owner "
            "semantic disposition and current task standing are not evaluated"
        ),
    }


def runtime_inspect_binary() -> Path:
    configured = os.environ.get("ORDIVON_RUNTIME_INSPECT")
    candidates: list[Path] = []
    if configured:
        candidate = Path(configured)
        if not candidate.is_absolute():
            raise RuntimeError("ORDIVON_RUNTIME_INSPECT must be an absolute path")
        candidates.append(candidate)
    candidates.extend(
        [
            Path(__file__).resolve().with_name("ordivon-runtime-inspect"),
            Path(__file__).resolve().parents[1] / "target/debug/ordivon-runtime-inspect",
        ]
    )
    for candidate in candidates:
        if candidate.is_file() and not candidate.is_symlink() and os.access(candidate, os.X_OK):
            return candidate
    raise RuntimeError(
        "ordivon-runtime-inspect is unavailable; install it beside this script or set "
        "ORDIVON_RUNTIME_INSPECT to an absolute executable path"
    )


def runtime_inspection(
    database: Path,
    timeout_ms: int,
    command: str,
    *,
    workspace_id: str | None = None,
) -> dict[str, object]:
    arguments = [
        str(runtime_inspect_binary()),
        command,
        "--database",
        str(database),
        "--busy-timeout-ms",
        str(timeout_ms),
    ]
    if workspace_id is not None:
        arguments.extend(["--workspace-id", workspace_id])
    try:
        result = subprocess.run(
            arguments,
            check=False,
            text=True,
            capture_output=True,
            timeout=RUNTIME_INSPECT_WALL_TIMEOUT_SECONDS,
        )
    except subprocess.TimeoutExpired as error:
        raise RuntimeError(
            f"Runtime inspection exceeded {RUNTIME_INSPECT_WALL_TIMEOUT_SECONDS:.0f}s wall timeout"
        ) from error
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
        raise RuntimeError(f"Runtime inspection failed: {detail}")
    try:
        value = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise RuntimeError("Runtime inspection returned invalid JSON") from error
    if not isinstance(value, dict):
        raise RuntimeError("Runtime inspection did not return an object")
    return value


def registry_activity_by_workspace(database: Path, timeout_ms: int) -> dict[str, int | None]:
    value = runtime_inspection(database, timeout_ms, "registry-activity")
    workspaces = value.get("workspaces")
    if not isinstance(workspaces, list):
        raise RuntimeError("Runtime registry activity inspection omitted workspaces")
    projected: dict[str, int | None] = {}
    for raw in workspaces:
        if not isinstance(raw, dict):
            raise RuntimeError("Runtime registry activity inspection returned invalid Workspace state")
        workspace_id = raw.get("workspaceId")
        last_activity_ms = raw.get("lastActivityMs")
        if not isinstance(workspace_id, str) or (
            last_activity_ms is not None and not isinstance(last_activity_ms, int)
        ):
            raise RuntimeError("Runtime registry activity inspection returned invalid Workspace activity")
        projected[workspace_id] = last_activity_ms
    return projected


EMPTY_WORKSPACE_ACTIVITY_MARKER = "sha256:" + hashlib.sha256(b"").hexdigest()


def registry_activity_markers(
    database: Path,
    timeout_ms: int,
    *,
    workspace_id: str | None = None,
) -> dict[str, str]:
    value = runtime_inspection(
        database,
        timeout_ms,
        "registry-markers",
        workspace_id=workspace_id,
    )
    workspaces = value.get("workspaces")
    if not isinstance(workspaces, list):
        raise RuntimeError("Runtime registry marker inspection omitted workspaces")
    markers: dict[str, str] = {}
    for raw in workspaces:
        if not isinstance(raw, dict):
            raise RuntimeError("Runtime registry marker inspection returned invalid Workspace state")
        observed_id = raw.get("workspaceId")
        marker = raw.get("activityMarker")
        if (
            not isinstance(observed_id, str)
            or not isinstance(marker, str)
            or not marker.startswith("sha256:")
        ):
            raise RuntimeError("Runtime registry marker inspection returned invalid activity marker")
        markers[observed_id] = marker
    if workspace_id is not None and workspace_id not in markers:
        markers[workspace_id] = EMPTY_WORKSPACE_ACTIVITY_MARKER
    return markers


def registry_workspace(database: Path, timeout_ms: int, workspace_id: str) -> dict[str, object]:
    value = runtime_inspection(
        database, timeout_ms, "registry-workspace", workspace_id=workspace_id
    )
    workspace = value.get("workspace")
    if not isinstance(workspace, dict) or workspace.get("workspaceId") != workspace_id:
        raise RuntimeError("Runtime Workspace registry inspection returned mismatched identity")
    return workspace


def enrich_report(args: argparse.Namespace) -> dict[str, object]:
    report = reclaim_inspect(args)
    policy = load_policy(args.policy_file)
    now_ms = int(time.time() * 1000)
    activity_by_workspace = registry_activity_by_workspace(
        args.database, args.busy_timeout_ms
    )
    activity_markers = registry_activity_markers(
        args.database, args.busy_timeout_ms
    )
    enriched: list[dict[str, object]] = []
    eligible_count = 0
    eligible_bytes = 0
    for raw in report.get("candidates", []):
        if not isinstance(raw, dict):
            continue
        item = dict(raw)
        workspace_id = str(item["workspaceId"])
        (
            class_name,
            retention_hours,
            max_lifetime_hours,
            force_dirty,
            force_unintegrated,
            force_max,
        ) = retention_class(policy, workspace_id)
        created_ms = item.get("createdUnixMs")
        activity_ms = activity_by_workspace.get(workspace_id)
        activity_marker = activity_markers.get(
            workspace_id, EMPTY_WORKSPACE_ACTIVITY_MARKER
        )
        basis_values = [
            value for value in (created_ms, activity_ms) if isinstance(value, int)
        ]
        basis_ms = max(basis_values) if basis_values else None
        eligible_at = (
            int(basis_ms + retention_hours * 3_600_000)
            if basis_ms is not None and retention_hours is not None
            else None
        )
        hard_expires_at = (
            int(created_ms + max_lifetime_hours * 3_600_000)
            if isinstance(created_ms, int) and max_lifetime_hours is not None
            else None
        )
        idle_expired = eligible_at is not None and eligible_at <= now_ms
        hard_lifetime_expired = (
            hard_expires_at is not None and hard_expires_at <= now_ms
        )
        classification = item.get("classification")
        idle_eligible_class = (
            classification in {"closable", "stale_record"}
            or (classification == "blocked_dirty" and force_dirty)
            or (
                classification == "blocked_unintegrated"
                and force_unintegrated
            )
        )
        hard_eligible_class = (
            force_max
            and classification
            in {"closable", "stale_record", "blocked_dirty", "blocked_unintegrated"}
        )
        eligible = (
            (idle_eligible_class and idle_expired)
            or (hard_eligible_class and hard_lifetime_expired)
        )
        item.update(
            {
                "retentionClass": class_name,
                "retentionHours": retention_hours,
                "maxLifetimeHours": max_lifetime_hours,
                "forceCloseDirtyAfterRetention": force_dirty,
                "forceCloseUnintegratedAfterRetention": force_unintegrated,
                "forceCloseAfterMaxLifetime": force_max,
                "lastActivityUnixMs": activity_ms,
                "activityMarker": activity_marker,
                "retentionBasisUnixMs": basis_ms,
                "eligibleAtUnixMs": eligible_at,
                "hardExpiresAtUnixMs": hard_expires_at,
                "idleRetentionExpired": idle_expired,
                "hardLifetimeExpired": hard_lifetime_expired,
                "policyEligible": eligible,
            }
        )
        item["carrierProjection"] = carrier_projection(item)
        if eligible:
            eligible_count += 1
            if isinstance(item.get("estimatedBytes"), int):
                eligible_bytes += int(item["estimatedBytes"])
        enriched.append(item)
    report["policy"] = policy
    report["generatedAtMs"] = now_ms
    report["candidates"] = enriched
    summary = dict(report.get("summary", {}))
    summary["policyEligible"] = eligible_count
    summary["policyEligibleEstimatedBytes"] = eligible_bytes
    report["summary"] = summary
    return report


@contextmanager
def exclusive_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a+") as handle:
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RuntimeError(f"lifecycle lock is already held: {path}") from error
        yield


def admission_fence_path(database: Path) -> Path:
    registry_root = database.parent
    expected_database = registry_root / "registry.sqlite3"
    if registry_root.is_symlink() or not registry_root.is_dir():
        raise RuntimeError("Registry root is not a direct regular directory")
    if registry_root.resolve(strict=True) != registry_root:
        raise RuntimeError("Registry root resolves through an alias or symlink")
    if database != expected_database:
        raise RuntimeError("database path does not match Registry admission-fence authority")
    if database.is_symlink() or not database.is_file():
        raise RuntimeError("Registry database is not a direct regular file")
    if database.resolve(strict=True) != database:
        raise RuntimeError("Registry database resolves through an alias or symlink")
    if database.stat().st_nlink != 1:
        raise RuntimeError("Registry database has multiple hardlink names")
    return registry_root / "admission.lock"


def validate_runtime_authority_snapshot(
    database: Path,
    runtime_store_root: Path,
    environment: dict[str, str],
) -> Path:
    """Bind CLI Registry/store coordinates to one already-read Runtime env snapshot."""

    registry_value = environment.get("ORDIVON_REGISTRY_ROOT")
    store_value = environment.get("ORDIVON_STORE_ROOT")
    if not registry_value or not store_value:
        raise RuntimeError(
            "Runtime environment must define ORDIVON_REGISTRY_ROOT and ORDIVON_STORE_ROOT"
        )
    registry_root = Path(registry_value)
    store_root = Path(store_value)
    if not registry_root.is_absolute() or not store_root.is_absolute():
        raise RuntimeError("Runtime authority roots must be absolute paths")
    if database != registry_root / "registry.sqlite3":
        raise RuntimeError("CLI database does not match Runtime Registry authority")
    if runtime_store_root != store_root:
        raise RuntimeError("CLI runtime-store-root does not match Runtime store authority")
    if store_root.is_symlink() or not store_root.is_dir():
        raise RuntimeError("Runtime store root is not a direct regular directory")
    if store_root.resolve(strict=True) != store_root:
        raise RuntimeError("Runtime store root resolves through an alias or symlink")
    return admission_fence_path(database)


def validate_runtime_authority(
    database: Path,
    runtime_store_root: Path,
    env_file: Path,
) -> Path:
    return validate_runtime_authority_snapshot(
        database,
        runtime_store_root,
        load_environment_file(env_file),
    )


@contextmanager
def exclusive_admission_fence(database: Path):
    path = admission_fence_path(database)
    with path.open("a+", encoding="utf-8") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        yield


def receipt_path(root: Path, label: str) -> Path:
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    candidate = root / f"{stamp}-{label}"
    sequence = 1
    while candidate.exists():
        candidate = root / f"{stamp}-{label}-{sequence}"
        sequence += 1
    candidate.mkdir(parents=True)
    return candidate


def write_json_atomic(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + f".tmp-{os.getpid()}")
    try:
        temporary.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def bounded_revalidation_args(
    args: argparse.Namespace,
    workspace_id: str,
) -> argparse.Namespace:
    values = dict(vars(args))
    values["workspace_ids"] = [workspace_id]
    values["workspace_refs"] = []
    return argparse.Namespace(**values)


def retained_after_plan(
    planned_item: dict[str, object],
    *,
    reason: str,
    current_item: dict[str, object] | None = None,
    registry_state: dict[str, object] | None = None,
) -> dict[str, object]:
    value: dict[str, object] = {
        "workspaceId": str(planned_item["workspaceId"]),
        "classification": str(planned_item.get("classification", "unknown")),
        "action": "workspace_retention_skipped_stale_candidate",
        "reason": reason,
        "plannedActivityMarker": planned_item.get("activityMarker"),
        "plannedRetentionBasisUnixMs": planned_item.get("retentionBasisUnixMs"),
        "plannedHardLifetimeExpired": planned_item.get("hardLifetimeExpired") is True,
    }
    if current_item is not None:
        value.update(
            {
                "currentClassification": current_item.get("classification"),
                "currentActivityMarker": current_item.get("activityMarker"),
                "currentRetentionBasisUnixMs": current_item.get("retentionBasisUnixMs"),
                "currentHardLifetimeExpired": current_item.get("hardLifetimeExpired") is True,
                "currentPolicyEligible": current_item.get("policyEligible") is True,
            }
        )
    if registry_state is not None:
        value["currentActivityMarker"] = registry_state.get("activityMarker")
        value["currentLastActivityUnixMs"] = registry_state.get("lastActivityMs")
    return value


def runtime_client_from_environment(
    environment: dict[str, str],
    *,
    client_name: str,
):
    """Construct one MCP client from the exact env snapshot used for effect authority."""

    bind = environment.get("ORDIVON_BIND")
    if not bind:
        raise RuntimeError("environment file must define ORDIVON_BIND")
    return connect_compatible(
        f"http://{bind}/mcp",
        load_bearer_token(environment),
        client_name=client_name,
        timeout=MCP_EFFECT_TIMEOUT_SECONDS,
    )


def runtime_client(env_file: Path, *, client_name: str):
    return runtime_client_from_environment(
        load_environment_file(env_file),
        client_name=client_name,
    )


def workspace_state(env_file: Path, workspace_id: str) -> dict[str, object]:
    current = runtime_client(
        env_file, client_name="ordivon-runtime-lifecycle-currentness"
    ).call_tool(
        "workspace.get",
        {"schemaVersion": SCHEMA_VERSION, "workspaceId": workspace_id},
    )
    if current.get("workspaceId") != workspace_id:
        raise RuntimeError("workspace.get returned mismatched Workspace identity")
    return current


def prepare_selected_item(
    args: argparse.Namespace,
    planned_item: dict[str, object],
) -> tuple[dict[str, object] | None, dict[str, object] | None]:
    workspace_id = planned_item.get("workspaceId")
    if not isinstance(workspace_id, str) or not workspace_id:
        raise RuntimeError("lifecycle plan omitted workspaceId")

    current_report = enrich_report(bounded_revalidation_args(args, workspace_id))
    current_items = [
        item
        for item in current_report.get("candidates", [])
        if isinstance(item, dict) and item.get("workspaceId") == workspace_id
    ]
    if not current_items:
        return None, retained_after_plan(
            planned_item, reason="workspace_missing_after_plan"
        )
    if len(current_items) != 1:
        raise RuntimeError(
            f"pre-effect observation returned duplicate Workspace identity: {workspace_id}"
        )
    current = dict(current_items[0])

    if current.get("policyEligible") is not True:
        return None, retained_after_plan(
            planned_item,
            reason="workspace_policy_no_longer_eligible",
            current_item=current,
        )

    # The expensive classifier and policy view must still describe the same
    # candidate selected by the plan. Hard-max may override ordinary activity
    # renewal, but it does not override classification or policy drift.
    for field in (
        "classification",
        "retentionClass",
        "retentionHours",
        "maxLifetimeHours",
        "forceCloseDirtyAfterRetention",
        "forceCloseUnintegratedAfterRetention",
        "forceCloseAfterMaxLifetime",
        "recordDigest",
        "workspaceHeadRevision",
        "canonicalHeadRevision",
        "sourceRepo",
        "sourceRevision",
    ):
        planned = planned_item.get(field)
        if planned is not None and current.get(field) != planned:
            return None, retained_after_plan(
                planned_item,
                reason=f"{field}_changed_after_plan",
                current_item=current,
            )

    planned_marker = planned_item.get("activityMarker")
    current_marker = current.get("activityMarker")
    if (
        isinstance(planned_marker, str)
        and isinstance(current_marker, str)
        and planned_marker != current_marker
        and current.get("hardLifetimeExpired") is not True
    ):
        return None, retained_after_plan(
            planned_item,
            reason="workspace_activity_changed_after_plan",
            current_item=current,
        )

    if current.get("classification") == "stale_record":
        return current, None

    physical = workspace_state(args.env_file, workspace_id)
    source_state_digest = physical.get("sourceStateDigest")
    if not isinstance(source_state_digest, str) or not source_state_digest.startswith(
        "sha256:"
    ):
        raise RuntimeError("workspace.get omitted sourceStateDigest")
    current_head = physical.get("currentHeadRevision")
    expected_head = current.get("workspaceHeadRevision")
    if isinstance(expected_head, str) and current_head != expected_head:
        return None, retained_after_plan(
            planned_item,
            reason="workspaceHeadRevision_changed_after_classification",
            current_item=current,
        )

    current["expectedSourceStateDigest"] = source_state_digest
    current["expectedCurrentHeadRevision"] = current_head
    return current, None


def _policy_standing_from_registry(
    prepared_item: dict[str, object],
    registry_state: dict[str, object],
) -> dict[str, object]:
    classification = prepared_item.get("classification")
    created_ms = prepared_item.get("createdUnixMs")
    activity_ms = registry_state.get("lastActivityMs")
    if activity_ms is not None and not isinstance(activity_ms, int):
        raise RuntimeError("Runtime Workspace registry projection returned invalid lastActivityMs")

    retention_hours = prepared_item.get("retentionHours")
    max_lifetime_hours = prepared_item.get("maxLifetimeHours")
    basis_values = [
        value for value in (created_ms, activity_ms) if isinstance(value, int)
    ]
    basis_ms = max(basis_values) if basis_values else None
    now_ms = int(time.time() * 1000)
    eligible_at = (
        int(basis_ms + float(retention_hours) * 3_600_000)
        if basis_ms is not None and isinstance(retention_hours, (int, float))
        else None
    )
    hard_expires_at = (
        int(created_ms + float(max_lifetime_hours) * 3_600_000)
        if isinstance(created_ms, int) and isinstance(max_lifetime_hours, (int, float))
        else None
    )
    idle_expired = eligible_at is not None and eligible_at <= now_ms
    hard_expired = hard_expires_at is not None and hard_expires_at <= now_ms

    idle_eligible_class = (
        classification in {"closable", "stale_record"}
        or (
            classification == "blocked_dirty"
            and prepared_item.get("forceCloseDirtyAfterRetention") is True
        )
        or (
            classification == "blocked_unintegrated"
            and prepared_item.get("forceCloseUnintegratedAfterRetention") is True
        )
    )
    hard_eligible_class = (
        prepared_item.get("forceCloseAfterMaxLifetime") is True
        and classification
        in {"closable", "stale_record", "blocked_dirty", "blocked_unintegrated"}
    )
    return {
        "lastActivityUnixMs": activity_ms,
        "retentionBasisUnixMs": basis_ms,
        "idleRetentionExpired": idle_expired,
        "hardLifetimeExpired": hard_expired,
        "policyEligible": (idle_eligible_class and idle_expired)
        or (hard_eligible_class and hard_expired),
    }


def canonical_head_revision(prepared_item: dict[str, object]) -> str | None:
    expected = prepared_item.get("canonicalHeadRevision")
    if expected is None:
        return None
    source_repo = prepared_item.get("sourceRepo")
    if not isinstance(expected, str) or not isinstance(source_repo, str):
        raise RuntimeError("prepared candidate omitted canonical source identity")
    try:
        result = subprocess.run(
            ["git", "-C", source_repo, "rev-parse", "HEAD"],
            check=False,
            text=True,
            capture_output=True,
            timeout=CANONICAL_HEAD_TIMEOUT_SECONDS,
        )
    except subprocess.TimeoutExpired as error:
        raise RuntimeError("canonical HEAD read exceeded bounded timeout") from error
    if result.returncode != 0:
        raise RuntimeError(
            result.stderr.strip()
            or result.stdout.strip()
            or "canonical HEAD read failed"
        )
    observed = result.stdout.strip()
    if not observed:
        raise RuntimeError("canonical HEAD read returned empty revision")
    return observed


def revalidate_prepared_item_under_fence(
    args: argparse.Namespace,
    prepared_item: dict[str, object],
) -> tuple[dict[str, object] | None, dict[str, object]]:
    workspace_id = str(prepared_item["workspaceId"])
    registry_state = registry_workspace(
        args.database, args.busy_timeout_ms, workspace_id
    )
    active = registry_state.get("activeJobIds")
    if not isinstance(active, list) or any(not isinstance(job_id, str) for job_id in active):
        raise RuntimeError("Runtime Workspace registry projection omitted activeJobIds")
    if active:
        return retained_after_plan(
            prepared_item,
            reason="workspace_active_after_plan",
            current_item=prepared_item,
            registry_state=registry_state,
        ), registry_state

    activity_marker = registry_state.get("activityMarker")
    if not isinstance(activity_marker, str) or not activity_marker.startswith("sha256:"):
        raise RuntimeError("Runtime Workspace registry projection omitted activityMarker")

    standing = _policy_standing_from_registry(prepared_item, registry_state)
    planned_activity = prepared_item.get("lastActivityUnixMs")
    planned_marker = prepared_item.get("activityMarker")
    activity_changed = (
        registry_state.get("lastActivityMs") != planned_activity
        or activity_marker != planned_marker
    )
    if activity_changed and standing["hardLifetimeExpired"] is not True:
        return retained_after_plan(
            prepared_item,
            reason="workspace_activity_changed_after_plan",
            current_item={**prepared_item, **standing},
            registry_state=registry_state,
        ), registry_state

    if standing["policyEligible"] is not True:
        return retained_after_plan(
            prepared_item,
            reason="workspace_policy_no_longer_eligible",
            current_item={**prepared_item, **standing},
            registry_state=registry_state,
        ), registry_state

    expected_canonical = prepared_item.get("canonicalHeadRevision")
    if expected_canonical is not None:
        observed_canonical = canonical_head_revision(prepared_item)
        if observed_canonical != expected_canonical:
            return retained_after_plan(
                prepared_item,
                reason="canonicalHeadRevision_changed_after_plan",
                current_item={**prepared_item, **standing},
                registry_state=registry_state,
            ), registry_state

    currentness = {
        "plannedActivityMarker": prepared_item.get("activityMarker"),
        "currentActivityMarker": activity_marker,
        "plannedLastActivityUnixMs": prepared_item.get("lastActivityUnixMs"),
        "currentLastActivityUnixMs": registry_state.get("lastActivityMs"),
        "hardLifetimeExpired": standing["hardLifetimeExpired"],
        "expectedSourceStateDigest": prepared_item.get("expectedSourceStateDigest"),
        "canonicalHeadRevision": expected_canonical,
    }
    return None, currentness


class WorkspaceCloseDeliveryUncertain(RuntimeError):
    def __init__(
        self,
        workspace_id: str,
        expected_source_state_digest: str,
        cause: Exception,
    ):
        super().__init__(
            f"workspace.close delivery remained uncertain for {workspace_id}: {cause}"
        )
        self.workspace_id = workspace_id
        self.expected_source_state_digest = expected_source_state_digest


def _validate_close_result(
    workspace_id: str,
    expected_source_state_digest: str,
    structured: dict[str, object],
) -> dict[str, object]:
    disposition = structured.get("closureDisposition")
    if disposition == "removed":
        if structured.get("removed") is not True:
            raise RuntimeError(
                f"workspace.close reported removed without removal for {workspace_id}: {structured}"
            )
    elif disposition == "already_closed":
        if structured.get("sourceStateDigest") != expected_source_state_digest:
            raise RuntimeError(
                f"workspace.close returned mismatched closed tombstone for {workspace_id}: {structured}"
            )
    else:
        raise RuntimeError(
            f"workspace.close did not prove exact closure for {workspace_id}: {structured}"
        )
    return structured


def close_workspace_once(
    env_file: Path,
    workspace_id: str,
    *,
    force: bool,
    expected_source_state_digest: str,
    client=None,
) -> dict[str, object]:
    close_arguments = {
        "schemaVersion": SCHEMA_VERSION,
        "workspaceId": workspace_id,
        "force": force,
        "expectedSourceStateDigest": expected_source_state_digest,
    }
    effect_client = client or runtime_client(
        env_file, client_name="ordivon-runtime-lifecycle-close"
    )
    try:
        structured = effect_client.call_tool("workspace.close", close_arguments)
    except (
        TimeoutError,
        ConnectionError,
        urllib.error.URLError,
        http.client.HTTPException,
    ) as error:
        raise WorkspaceCloseDeliveryUncertain(
            workspace_id, expected_source_state_digest, error
        ) from error
    return _validate_close_result(
        workspace_id, expected_source_state_digest, structured
    )


def closed_workspace_tombstone(
    runtime_store_root: Path,
    workspace_id: str,
    *,
    expected_source_state_digest: str,
) -> dict[str, object] | None:
    record = runtime_store_root / "workspace-records" / f"{workspace_id}.json"
    try:
        metadata = record.lstat()
    except FileNotFoundError:
        return None
    if record.is_symlink() or not record.is_file() or metadata.st_nlink != 1:
        return None
    try:
        value = json.loads(record.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    if not isinstance(value, dict) or value.get("state") != "closed":
        return None
    if value.get("sourceStateDigest") != expected_source_state_digest:
        return None
    return value


def _close_action(
    prepared_item: dict[str, object],
    close_result: dict[str, object],
    currentness: dict[str, object],
    *,
    delivery_reconciled: bool,
) -> dict[str, object]:
    classification = str(prepared_item.get("classification"))
    return {
        "workspaceId": str(prepared_item["workspaceId"]),
        "classification": classification,
        "action": (
            "workspace_force_closed_by_retention_policy"
            if classification in {"blocked_dirty", "blocked_unintegrated"}
            else "workspace_closed_by_retention_policy"
        ),
        "closureDisposition": close_result.get("closureDisposition"),
        "removed": close_result.get("removed"),
        "sourceStateDigest": prepared_item.get("expectedSourceStateDigest"),
        "deliveryReconciled": delivery_reconciled,
        "lifecycleCurrentness": currentness,
    }


def _attempt_prepared_close(
    args: argparse.Namespace,
    prepared_item: dict[str, object],
) -> tuple[str, dict[str, object] | WorkspaceCloseDeliveryUncertain]:
    classification = str(prepared_item.get("classification"))
    force = classification in {"blocked_dirty", "blocked_unintegrated"}
    expected_digest = prepared_item.get("expectedSourceStateDigest")
    if not isinstance(expected_digest, str) or not expected_digest.startswith("sha256:"):
        raise RuntimeError("prepared candidate omitted expectedSourceStateDigest")

    with exclusive_admission_fence(args.database):
        # Bind the destructive cut to one environment snapshot.  A concurrent
        # installation/operator replacement of the env file must not let us hold
        # Registry A's admission fence while addressing Runtime B through a later
        # reread of ORDIVON_BIND/credentials.
        environment = load_environment_file(args.env_file)
        validate_runtime_authority_snapshot(
            args.database,
            args.runtime_store_root,
            environment,
        )
        effect_client = runtime_client_from_environment(
            environment,
            client_name="ordivon-runtime-lifecycle-close",
        )

        retained, currentness = revalidate_prepared_item_under_fence(
            args, prepared_item
        )
        if retained is not None:
            return "retained", retained
        try:
            result = close_workspace_once(
                args.env_file,
                str(prepared_item["workspaceId"]),
                force=force,
                expected_source_state_digest=expected_digest,
                client=effect_client,
            )
        except WorkspaceCloseDeliveryUncertain as error:
            return "uncertain", error
        return "closed", _close_action(
            prepared_item,
            result,
            currentness,
            delivery_reconciled=False,
        )


def apply_prepared_candidate(
    args: argparse.Namespace,
    prepared_item: dict[str, object],
) -> dict[str, object]:
    status, value = _attempt_prepared_close(args, prepared_item)
    if status in {"closed", "retained"}:
        assert isinstance(value, dict)
        return value

    assert isinstance(value, WorkspaceCloseDeliveryUncertain)
    workspace_id = str(prepared_item["workspaceId"])
    expected_digest = value.expected_source_state_digest
    tombstone = closed_workspace_tombstone(
        args.runtime_store_root,
        workspace_id,
        expected_source_state_digest=expected_digest,
    )
    if tombstone is not None:
        return _close_action(
            prepared_item,
            {
                "closureDisposition": "already_closed",
                "removed": False,
                "sourceStateDigest": expected_digest,
            },
            {"responseLossReconciledBy": "matching_closed_tombstone"},
            delivery_reconciled=True,
        )

    replay_status, replay_value = _attempt_prepared_close(args, prepared_item)
    if replay_status == "retained":
        raise RuntimeError(
            f"workspace.close delivery is UNKNOWN for {workspace_id}; "
            "fresh bounded currentness changed before exact replay"
        )
    if replay_status == "closed":
        assert isinstance(replay_value, dict)
        replay_value["deliveryReconciled"] = True
        replay_value["responseLossReconciledBy"] = "same_identity_replay"
        return replay_value

    assert isinstance(replay_value, WorkspaceCloseDeliveryUncertain)
    tombstone = closed_workspace_tombstone(
        args.runtime_store_root,
        workspace_id,
        expected_source_state_digest=expected_digest,
    )
    if tombstone is not None:
        return _close_action(
            prepared_item,
            {
                "closureDisposition": "already_closed",
                "removed": False,
                "sourceStateDigest": expected_digest,
            },
            {"responseLossReconciledBy": "matching_closed_tombstone_after_replay"},
            delivery_reconciled=True,
        )
    raise replay_value


def reclaim_apply_selected(
    args: argparse.Namespace,
    workspace_ids: list[str],
    receipt: Path,
) -> dict[str, object]:
    command = [
        sys.executable,
        str(reclaim_program()),
        "apply",
        "--database",
        str(args.database),
        "--runtime-store-root",
        str(args.runtime_store_root),
        "--busy-timeout-ms",
        str(args.busy_timeout_ms),
        "--env-file",
        str(args.env_file),
        "--receipt-root",
        str(receipt / "reclaim"),
        "--lock-file",
        str(receipt / "reclaim.lock"),
        "--minimum-age-hours",
        "0",
        "--confirm-policy",
        "RECLAIM_ELIGIBLE_WORKSPACES",
    ]
    if args.workspace_root:
        command.extend(["--workspace-root", str(args.workspace_root)])
    for workspace_id in workspace_ids:
        command.extend(["--workspace-id", workspace_id])
    return validate_reclaim_apply(run_json(command, accepted_codes=(0, 2)))


def sweep(args: argparse.Namespace) -> dict[str, object]:
    if args.confirm_policy != SWEEP_CONFIRMATION:
        raise RuntimeError(f"confirm-policy must equal {SWEEP_CONFIRMATION}")
    validate_runtime_authority(args.database, args.runtime_store_root, args.env_file)

    with exclusive_lock(args.lock_file):
        before = enrich_report(args)
        selected_items = [
            item
            for item in before.get("candidates", [])
            if isinstance(item, dict) and item.get("policyEligible") is True
        ]
        selected = [str(item["workspaceId"]) for item in selected_items]
        planned_dirty = [
            str(item["workspaceId"])
            for item in selected_items
            if item.get("classification") == "blocked_dirty"
        ]
        planned_unintegrated = [
            str(item["workspaceId"])
            for item in selected_items
            if item.get("classification") == "blocked_unintegrated"
        ]
        receipt = receipt_path(args.receipt_root, "workspace-lifecycle")
        write_json_atomic(receipt / "before.json", before)
        actions: list[dict[str, object]] = []
        failures: list[dict[str, object]] = []
        effect_eligible: list[str] = []
        stale_candidates: list[str] = []
        reclaim_receipt: object = None

        for planned_item in selected_items:
            workspace_id = str(planned_item["workspaceId"])
            classification = str(planned_item.get("classification"))

            # stale_record is a Registry-record reconciliation class, not a
            # physical Workspace close. Keep it on the mature reclaim owner
            # path and outside the global admission critical section.
            if classification == "stale_record":
                try:
                    subordinate = reclaim_apply_selected(
                        args, [workspace_id], receipt
                    )
                    actions.extend(
                        raw
                        for raw in subordinate.get("actions", [])
                        if isinstance(raw, dict)
                    )
                    failures.extend(
                        raw
                        for raw in subordinate.get("failures", [])
                        if isinstance(raw, dict)
                    )
                    reclaim_receipt = subordinate.get("receipt")
                    effect_eligible.append(workspace_id)
                except Exception as error:
                    failures.append(
                        {
                            "workspaceId": workspace_id,
                            "classification": classification,
                            "error": str(error),
                        }
                    )
                continue

            try:
                prepared, retained = prepare_selected_item(args, planned_item)
                if retained is not None:
                    stale_candidates.append(workspace_id)
                    actions.append(retained)
                    continue
                assert prepared is not None
                effect_eligible.append(workspace_id)
                action = apply_prepared_candidate(args, prepared)
                if action.get("action") == "workspace_retention_skipped_stale_candidate":
                    stale_candidates.append(workspace_id)
                actions.append(action)
            except Exception as error:
                failures.append(
                    {
                        "workspaceId": workspace_id,
                        "classification": classification,
                        "error": str(error),
                    }
                )

        after = enrich_report(args)
        write_json_atomic(receipt / "after.json", after)
        result = {
            "schemaVersion": SCHEMA_VERSION,
            "status": "completed" if not failures else "partial",
            "selectedWorkspaceIds": selected,
            "forceDirtyWorkspaceIds": planned_dirty,
            "forceUnintegratedWorkspaceIds": planned_unintegrated,
            "effectEligibleWorkspaceIds": effect_eligible,
            "staleCandidateWorkspaceIds": stale_candidates,
            "actions": actions,
            "failures": failures,
            "reclaimReceipt": reclaim_receipt,
            "receipt": str(receipt),
        }
        write_json_atomic(receipt / "result.json", result)
        return result

def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return "sha256:" + digest.hexdigest()


def git(repository: Path, arguments: list[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        ["git", "-C", str(repository), *arguments],
        check=False,
        text=True,
        capture_output=True,
    )
    if check and result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip() or "git failed")
    return result


def active_jobs(database: Path, timeout_ms: int, workspace_id: str) -> list[str]:
    workspace = registry_workspace(database, timeout_ms, workspace_id)
    active = workspace.get("activeJobIds")
    if not isinstance(active, list) or any(not isinstance(job_id, str) for job_id in active):
        raise RuntimeError("Runtime Workspace registry inspection omitted activeJobIds")
    return list(active)


def load_open_record(record_path: Path, workspace_id: str, workspace_path: Path) -> dict[str, object]:
    if record_path.is_symlink() or not record_path.is_file():
        raise RuntimeError("workspace record is not a regular file")
    value = json.loads(record_path.read_text(encoding="utf-8"))
    if not isinstance(value, dict):
        raise RuntimeError("workspace record is not an object")
    if value.get("state") == "closed":
        raise RuntimeError("workspace is already closed")
    if value.get("schemaVersion") != SCHEMA_VERSION:
        raise RuntimeError("workspace record identity mismatch")
    legacy_workspace_id = value.get("workspaceId")
    if legacy_workspace_id is not None and legacy_workspace_id != workspace_id:
        raise RuntimeError("workspace record identity mismatch")
    legacy_workspace_path = value.get("workspacePath")
    if legacy_workspace_path is not None:
        if not isinstance(legacy_workspace_path, str) or not Path(legacy_workspace_path).is_absolute():
            raise RuntimeError("workspace record identity mismatch")
        recorded_path = Path(legacy_workspace_path)
        if recorded_path.exists() and workspace_path.exists():
            if recorded_path.resolve() != workspace_path.resolve():
                raise RuntimeError("workspace record identity mismatch")
        elif recorded_path != workspace_path:
            raise RuntimeError("workspace record identity mismatch")
    return value


def verify_revision(repository: Path, revision: str) -> None:
    resolved = git(repository, ["rev-parse", "--verify", f"{revision}^{{commit}}"])
    if resolved.stdout.strip() != revision:
        raise RuntimeError("mapped source repository does not contain the recorded revision")


def repair_one(
    args: argparse.Namespace,
    policy: dict[str, object],
    item: dict[str, object],
    receipt: Path,
) -> dict[str, object]:
    workspace_id = str(item["workspaceId"])
    workspace_root = args.workspace_root or args.runtime_store_root / "workspaces"
    workspace_path = workspace_root / workspace_id
    record_path = args.runtime_store_root / "workspace-records" / f"{workspace_id}.json"
    before_digest = sha256_file(record_path)
    record = load_open_record(record_path, workspace_id, workspace_path)
    if active_jobs(args.database, args.busy_timeout_ms, workspace_id):
        raise RuntimeError("workspace acquired an active or held Job")
    aliases = policy.get("sourceRepoAliases", {})
    assert isinstance(aliases, dict)
    old_repo = str(record["sourceRepo"])
    mapped = Path(str(aliases.get(old_repo, old_repo))).resolve()
    if not mapped.is_dir():
        raise RuntimeError(f"mapped source repository is unavailable: {mapped}")
    verify_revision(mapped, str(record["sourceRevision"]))
    git(mapped, ["worktree", "repair", str(workspace_path)])
    probe = git(workspace_path, ["rev-parse", "HEAD"], check=False)
    if probe.returncode != 0 or probe.stdout.strip() != str(record["sourceRevision"]):
        raise RuntimeError("git worktree repair did not restore the recorded Workspace identity")
    if sha256_file(record_path) != before_digest:
        raise RuntimeError("workspace record changed during repair")
    updated = dict(record)
    updated["sourceRepo"] = str(mapped)
    write_json_atomic(record_path, updated)
    return {
        "workspaceId": workspace_id,
        "action": "worktree_repaired",
        "sourceRepoBefore": old_repo,
        "sourceRepoAfter": str(mapped),
        "recordDigestBefore": before_digest,
        "recordDigestAfter": sha256_file(record_path),
    }


def canonical_runtime_store_root(runtime_store_root: Path) -> Path:
    try:
        return runtime_store_root.resolve(strict=True)
    except OSError as error:
        raise RuntimeError(
            f"cannot canonicalize Runtime store root {runtime_store_root}: {error}"
        ) from error


def trusted_tmp_presentation_path(runtime_store_root: Path, workspace_id: str) -> Path:
    canonical_store = canonical_runtime_store_root(runtime_store_root)
    identity = os.fsencode(canonical_store) + b"\0" + workspace_id.encode("utf-8")
    digest = hashlib.sha256(identity).hexdigest()[:20]
    return TRUSTED_TMP_PRESENTATION_ROOT / digest


def remove_trusted_tmp_presentation(runtime_store_root: Path, workspace_id: str) -> Path | None:
    presentation = trusted_tmp_presentation_path(runtime_store_root, workspace_id)
    backing = canonical_runtime_store_root(runtime_store_root) / "cache" / "tmp" / workspace_id
    try:
        presentation.lstat()
    except FileNotFoundError:
        return None
    if not presentation.is_symlink():
        raise RuntimeError(f"trusted temporary presentation is not a symlink: {presentation}")
    target = Path(os.readlink(presentation))
    if target != backing:
        raise RuntimeError(
            f"trusted temporary presentation {presentation} points at {target}, expected {backing}"
        )
    presentation.unlink()
    return presentation


def orphan_git_evidence(workspace_path: Path) -> dict[str, object]:
    def run(arguments: list[str]) -> subprocess.CompletedProcess[str]:
        return subprocess.run(
            ["git", "-C", str(workspace_path), *arguments],
            check=False,
            text=True,
            capture_output=True,
        )

    inside = run(["rev-parse", "--is-inside-work-tree"])
    if inside.returncode != 0 or inside.stdout.strip() != "true":
        return {"available": False, "reason": "not-a-readable-git-worktree"}
    head = run(["rev-parse", "HEAD"])
    common = run(["rev-parse", "--path-format=absolute", "--git-common-dir"])
    branch = run(["symbolic-ref", "--quiet", "--short", "HEAD"])
    status = subprocess.run(
        ["git", "-C", str(workspace_path), "status", "--porcelain=v1", "-z", "--untracked-files=all"],
        check=False,
        capture_output=True,
    )
    if head.returncode != 0 or common.returncode != 0 or status.returncode != 0:
        return {"available": False, "reason": "git-evidence-incomplete"}
    common_path = Path(common.stdout.strip())
    if not common_path.is_absolute():
        common_path = (workspace_path / common_path).resolve()
    return {
        "available": True,
        "observedHead": head.stdout.strip(),
        "observedBranch": branch.stdout.strip() if branch.returncode == 0 else None,
        "observedGitCommonDir": str(common_path),
        "dirty": bool(status.stdout),
        "statusDigest": "sha256:" + hashlib.sha256(status.stdout).hexdigest(),
    }


def repair_quarantined_git_registration(
    target: Path, git_evidence: dict[str, object]
) -> dict[str, object]:
    common = git_evidence.get("observedGitCommonDir")
    expected_head = git_evidence.get("observedHead")
    if git_evidence.get("available") is not True or not isinstance(common, str):
        return {"attempted": False, "standing": "NOT_APPLICABLE"}
    result = subprocess.run(
        ["git", "--git-dir", common, "worktree", "repair", str(target)],
        check=False,
        text=True,
        capture_output=True,
    )
    observed = subprocess.run(
        ["git", "-C", str(target), "rev-parse", "HEAD"],
        check=False,
        text=True,
        capture_output=True,
    )
    head = observed.stdout.strip() if observed.returncode == 0 else None
    standing = (
        "REPAIRED"
        if result.returncode == 0 and isinstance(expected_head, str) and head == expected_head
        else "UNRESOLVED"
    )
    return {
        "attempted": True,
        "standing": standing,
        "returnCode": result.returncode,
        "observedHeadAfter": head,
        "stderr": result.stderr.strip()[:1000],
    }


def quarantine_orphan_directory(
    args: argparse.Namespace,
    item: dict[str, object],
    receipt: Path,
) -> dict[str, object]:
    if item.get("classification") != "orphan_directory":
        raise RuntimeError("Workspace is not orphan_directory")
    if not args.quarantine_root:
        raise RuntimeError("quarantine-root is required for orphan quarantine")
    workspace_id = str(item["workspaceId"])
    workspace_root = (args.workspace_root or args.runtime_store_root / "workspaces").resolve()
    workspace_path = workspace_root / workspace_id
    record_path = args.runtime_store_root / "workspace-records" / f"{workspace_id}.json"
    if record_path.exists() or record_path.is_symlink():
        raise RuntimeError("orphan Workspace acquired an identity record")
    try:
        metadata = workspace_path.lstat()
    except FileNotFoundError as error:
        raise RuntimeError("orphan Workspace directory disappeared") from error
    if workspace_path.is_symlink() or not workspace_path.is_dir():
        raise RuntimeError("orphan Workspace target is not a non-symlink directory")
    if active_jobs(args.database, args.busy_timeout_ms, workspace_id):
        raise RuntimeError("orphan Workspace acquired an active or held Job")

    args.quarantine_root.mkdir(parents=True, exist_ok=True)
    quarantine_root = args.quarantine_root.resolve()
    if quarantine_root == workspace_root or quarantine_root.is_relative_to(workspace_root):
        raise RuntimeError("quarantine-root must be outside the Runtime Workspace root")
    target = quarantine_root / f"{int(time.time() * 1000)}-{workspace_id}"
    if target.exists() or target.is_symlink():
        raise RuntimeError("quarantine target already exists")

    git_evidence = orphan_git_evidence(workspace_path)
    observed_head = git_evidence.get("observedHead")
    tombstone = {
        "schemaVersion": SCHEMA_VERSION,
        "state": "closed",
    }
    # The tombstone is committed before the move so another Runtime process cannot
    # reuse this identity in the rename window. sourceRepo/sourceRevision are
    # intentionally absent: no Runtime opening record survived to prove them.
    record_path.parent.mkdir(parents=True, exist_ok=True)
    write_json_atomic(record_path, tombstone)
    try:
        # Recheck the physical inode after publishing the identity fence.
        after = workspace_path.lstat()
        if (metadata.st_dev, metadata.st_ino) != (after.st_dev, after.st_ino):
            raise RuntimeError("orphan Workspace directory changed before quarantine")
        os.replace(workspace_path, target)
    except Exception:
        try:
            if workspace_path.exists() and not target.exists():
                record_path.unlink(missing_ok=True)
        finally:
            pass
        raise

    git_repair = repair_quarantined_git_registration(target, git_evidence)
    warnings: list[str] = []
    if git_repair.get("standing") == "UNRESOLVED":
        warnings.append("Git linked-worktree registration could not be fully repaired")
    try:
        removed_tmp_presentation = remove_trusted_tmp_presentation(
            args.runtime_store_root, workspace_id
        )
    except Exception as error:
        removed_tmp_presentation = None
        warnings.append(f"trusted tmp presentation cleanup requires review: {error}")

    action = {
        "workspaceId": workspace_id,
        "classification": "orphan_directory",
        "action": "orphan_workspace_quarantined",
        "quarantinePath": str(target),
        "closedRecord": str(record_path),
        "closedRecordDigest": sha256_file(record_path),
        "sourceIdentityStanding": "UNKNOWN_NO_RUNTIME_RECORD",
        "gitEvidence": git_evidence,
        "gitRegistrationRepair": git_repair,
        "removedTmpPresentation": (
            str(removed_tmp_presentation) if removed_tmp_presentation is not None else None
        ),
        "warnings": warnings,
    }
    write_json_atomic(receipt / f"orphan-{workspace_id}.json", action)
    return action


def quarantine_one(
    args: argparse.Namespace,
    item: dict[str, object],
    receipt: Path,
) -> dict[str, object]:
    if not args.quarantine_root:
        raise RuntimeError("quarantine-root is required for quarantine")
    workspace_id = str(item["workspaceId"])
    workspace_root = args.workspace_root or args.runtime_store_root / "workspaces"
    workspace_path = workspace_root / workspace_id
    record_path = args.runtime_store_root / "workspace-records" / f"{workspace_id}.json"
    record = load_open_record(record_path, workspace_id, workspace_path)
    if active_jobs(args.database, args.busy_timeout_ms, workspace_id):
        raise RuntimeError("workspace acquired an active or held Job")
    args.quarantine_root.mkdir(parents=True, exist_ok=True)
    target = args.quarantine_root / f"{int(time.time() * 1000)}-{workspace_id}"
    if target.exists():
        raise RuntimeError("quarantine target already exists")
    backup = receipt / "records" / record_path.name
    backup.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(record_path, backup)
    removed_tmp_presentation = remove_trusted_tmp_presentation(
        args.runtime_store_root, workspace_id
    )
    os.replace(workspace_path, target)
    closed = {
        "schemaVersion": SCHEMA_VERSION,
        "state": "closed",
    }
    write_json_atomic(record_path, closed)
    return {
        "workspaceId": workspace_id,
        "action": "workspace_quarantined",
        "quarantinePath": str(target),
        "recordBackup": str(backup),
        "removedTmpPresentation": (
            str(removed_tmp_presentation) if removed_tmp_presentation is not None else None
        ),
    }


def dirty_action(age_hours: float | None, args: argparse.Namespace) -> str:
    if age_hours is None:
        return "identity_review"
    if age_hours >= args.quarantine_review_after_hours:
        return "quarantine_review"
    if age_hours >= args.review_after_hours:
        return "owner_review"
    if age_hours >= args.checkpoint_after_hours:
        return "checkpoint_or_export"
    return "recent_dirty"


def untracked_manifest(workspace: Path) -> list[dict[str, object]]:
    result = git(workspace, ["ls-files", "--others", "--exclude-standard", "-z"])
    names = [name for name in result.stdout.split("\0") if name]
    if len(names) > MAX_DIRTY_PATHS:
        raise RuntimeError(f"dirty Workspace has more than {MAX_DIRTY_PATHS} untracked paths")
    manifest: list[dict[str, object]] = []
    for name in names:
        path = workspace / name
        if path.is_symlink():
            target = os.readlink(path)
            manifest.append({"path": name, "kind": "symlink", "byteLength": len(target.encode()), "digest": "sha256:" + hashlib.sha256(target.encode()).hexdigest()})
        elif path.is_file():
            manifest.append({"path": name, "kind": "file", "byteLength": path.stat().st_size, "digest": sha256_file(path)})
        else:
            manifest.append({"path": name, "kind": "other", "byteLength": None, "digest": None})
    return manifest


def dirty_review_one(args: argparse.Namespace, item: dict[str, object], now_ms: int) -> dict[str, object]:
    workspace_id = str(item["workspaceId"])
    workspace_root = args.workspace_root or args.runtime_store_root / "workspaces"
    workspace = workspace_root / workspace_id
    record_path = args.runtime_store_root / "workspace-records" / f"{workspace_id}.json"
    if item.get("classification") != "blocked_dirty":
        raise RuntimeError(f"Workspace is not blocked_dirty: {item.get('classification')}")
    if active_jobs(args.database, args.busy_timeout_ms, workspace_id):
        raise RuntimeError("workspace acquired an active or held Job")
    record_digest = sha256_file(record_path)
    record = load_open_record(record_path, workspace_id, workspace)
    head = git(workspace, ["rev-parse", "HEAD"]).stdout.strip()
    status = git(workspace, ["status", "--porcelain=v1", "--untracked-files=all"]).stdout
    if not status.strip():
        raise RuntimeError("Workspace is no longer dirty")
    diff = git(workspace, ["diff", "--binary", "HEAD"]).stdout.encode()
    untracked = untracked_manifest(workspace)
    basis = item.get("lastActivityUnixMs") or item.get("createdUnixMs")
    age_hours = max(0.0, (now_ms - int(basis)) / 3_600_000) if isinstance(basis, int) else None
    if sha256_file(record_path) != record_digest:
        raise RuntimeError("workspace record changed during dirty review")
    return {
        "workspaceId": workspace_id,
        "sourceRepo": record.get("sourceRepo"),
        "sourceRevision": record.get("sourceRevision"),
        "currentHeadRevision": head,
        "recordDigest": record_digest,
        "ageHours": age_hours,
        "recommendedOwnerAction": dirty_action(age_hours, args),
        "automaticDeletionAllowed": False,
        "statusDigest": "sha256:" + hashlib.sha256(status.encode()).hexdigest(),
        "trackedDiffDigest": "sha256:" + hashlib.sha256(diff).hexdigest(),
        "trackedDiffBytes": len(diff),
        "untracked": untracked,
    }


def dirty_review(args: argparse.Namespace) -> dict[str, object]:
    requested = list(dict.fromkeys(args.workspace_ids or []))
    if not (args.checkpoint_after_hours <= args.review_after_hours <= args.quarantine_review_after_hours):
        raise RuntimeError("dirty aging thresholds must be monotonic")
    with exclusive_lock(args.lock_file):
        report = enrich_report(args)
        by_id = {str(item["workspaceId"]): item for item in report.get("candidates", []) if isinstance(item, dict)}
        now_ms = int(time.time() * 1000)
        receipt = receipt_path(args.receipt_root, "dirty-review")
        actions: list[dict[str, object]] = []
        failures: list[dict[str, object]] = []
        for workspace_id in requested:
            item = by_id.get(workspace_id)
            if item is None:
                failures.append({"workspaceId": workspace_id, "error": "Workspace is absent from current lifecycle candidates"})
                continue
            try:
                actions.append(dirty_review_one(args, item, now_ms))
            except Exception as error:
                failures.append({"workspaceId": workspace_id, "error": str(error)})
        result = {
            "schemaVersion": SCHEMA_VERSION,
            "status": "completed" if not failures else "partial",
            "truthRole": "evidence-only-owner-review",
            "automaticDeletionAllowed": False,
            "actions": actions,
            "failures": failures,
            "receipt": str(receipt),
        }
        write_json_atomic(receipt / "result.json", result)
        return result



def _git_bytes(repository: Path, arguments: list[str], *, input_bytes: bytes | None = None) -> subprocess.CompletedProcess[bytes]:
    result = subprocess.run(
        ["git", "-C", str(repository), *arguments],
        input=input_bytes,
        check=False,
        capture_output=True,
    )
    if result.returncode != 0:
        raise RuntimeError(
            result.stderr.decode("utf-8", "replace").strip()
            or result.stdout.decode("utf-8", "replace").strip()
            or "git failed"
        )
    return result


def _git_temp_index(repository: Path, *, copy_from: Path | None = None) -> tuple[dict[str, str], Path]:
    descriptor, raw = tempfile.mkstemp(prefix="ordivon-workspace-state-", dir="/tmp")
    os.close(descriptor)
    temporary = Path(raw)
    if copy_from is None:
        temporary.unlink()
    else:
        shutil.copy2(copy_from, temporary)
    environment = os.environ.copy()
    environment["GIT_INDEX_FILE"] = str(temporary)
    return environment, temporary


def _run_git_with_environment(
    repository: Path,
    arguments: list[str],
    environment: dict[str, str],
    *,
    check: bool = True,
) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        ["git", "-C", str(repository), *arguments],
        env=environment,
        check=False,
        text=True,
        capture_output=True,
    )
    if check and result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip() or "git failed")
    return result


def _workspace_index_path(workspace: Path) -> Path:
    raw = git(workspace, ["rev-parse", "--git-path", "index"]).stdout.strip()
    path = Path(raw)
    return path if path.is_absolute() else (workspace / path).resolve()


def _workspace_common_source(workspace: Path) -> Path:
    raw = git(workspace, ["rev-parse", "--path-format=absolute", "--git-common-dir"]).stdout.strip()
    common = Path(raw).resolve()
    return common.parent if common.name == ".git" else common


def _sha256_bytes(value: bytes) -> str:
    return "sha256:" + hashlib.sha256(value).hexdigest()


def _canonical_digest(value: object) -> str:
    encoded = json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
    return _sha256_bytes(encoded)


def _hash_object(repository: Path, value: bytes) -> str:
    return _git_bytes(repository, ["hash-object", "-w", "--stdin"], input_bytes=value).stdout.decode().strip()


def _workspace_has_sparse_checkout(workspace: Path) -> bool:
    for key in ("core.sparseCheckout", "index.sparse"):
        result = git(workspace, ["config", "--bool", key], check=False)
        if result.returncode == 0 and result.stdout.strip().lower() == "true":
            return True
    return False


def _workspace_has_gitlinks(workspace: Path) -> bool:
    output = git(workspace, ["ls-files", "-s"]).stdout
    return any(line.startswith("160000 ") for line in output.splitlines())


def _workspace_has_split_index(workspace: Path) -> bool:
    result = git(workspace, ["rev-parse", "--shared-index-path"], check=False)
    return result.returncode == 0 and bool(result.stdout.strip())


def _workspace_git_operation_markers(workspace: Path) -> list[str]:
    markers = [
        "MERGE_HEAD",
        "CHERRY_PICK_HEAD",
        "REVERT_HEAD",
        "REBASE_HEAD",
        "BISECT_LOG",
        "rebase-merge",
        "rebase-apply",
        "sequencer",
    ]
    present: list[str] = []
    for marker in markers:
        raw = git(workspace, ["rev-parse", "--git-path", marker]).stdout.strip()
        path = Path(raw)
        resolved = path if path.is_absolute() else (workspace / path).resolve()
        if resolved.exists():
            present.append(marker)
    return present


def _build_worktree_tree(workspace: Path) -> str:
    environment, temporary = _git_temp_index(workspace)
    try:
        _run_git_with_environment(workspace, ["read-tree", "HEAD"], environment)
        _run_git_with_environment(workspace, ["add", "-A", "--", "."], environment)
        return _run_git_with_environment(workspace, ["write-tree"], environment).stdout.strip()
    finally:
        temporary.unlink(missing_ok=True)


def _build_index_tree(workspace: Path, index_path: Path, has_unmerged: bool) -> str | None:
    environment, temporary = _git_temp_index(workspace, copy_from=index_path)
    try:
        result = _run_git_with_environment(workspace, ["write-tree"], environment, check=False)
        if result.returncode == 0:
            return result.stdout.strip()
        if has_unmerged:
            return None
        raise RuntimeError(result.stderr.strip() or result.stdout.strip() or "cannot materialize index tree")
    finally:
        temporary.unlink(missing_ok=True)


def dirty_checkpoint_one(
    args: argparse.Namespace,
    item: dict[str, object],
) -> dict[str, object]:
    workspace_id = str(item["workspaceId"])
    workspace_root = args.workspace_root or args.runtime_store_root / "workspaces"
    workspace = workspace_root / workspace_id
    record_path = args.runtime_store_root / "workspace-records" / f"{workspace_id}.json"
    if item.get("classification") != "blocked_dirty":
        raise RuntimeError(f"Workspace is not blocked_dirty: {item.get('classification')}")
    if active_jobs(args.database, args.busy_timeout_ms, workspace_id):
        raise RuntimeError("workspace acquired an active or held Job")
    record_digest = sha256_file(record_path)
    record = load_open_record(record_path, workspace_id, workspace)
    source_repo = Path(str(record.get("sourceRepo"))).resolve()
    if not source_repo.is_dir():
        raise RuntimeError(f"source repository is unavailable: {source_repo}")
    if _workspace_common_source(workspace) != source_repo:
        raise RuntimeError("Workspace Git authority differs from recorded sourceRepo")
    if _workspace_has_sparse_checkout(workspace):
        raise RuntimeError("dirty checkpoint does not support sparse Workspaces")
    if _workspace_has_gitlinks(workspace):
        raise RuntimeError("dirty checkpoint does not support submodule/gitlink Workspaces")
    if _workspace_has_split_index(workspace):
        raise RuntimeError("dirty checkpoint does not support split-index Workspaces")
    operation_markers = _workspace_git_operation_markers(workspace)
    if operation_markers:
        raise RuntimeError("dirty checkpoint does not support in-progress Git operations: " + ",".join(operation_markers))
    if git(workspace, ["ls-files", "-u"]).stdout:
        raise RuntimeError("dirty checkpoint does not support unmerged index state")
    unsupported = [entry for entry in untracked_manifest(workspace) if entry.get("kind") == "other"]
    if unsupported:
        raise RuntimeError("dirty checkpoint does not support non-file/non-symlink untracked paths")

    head = git(workspace, ["rev-parse", "HEAD"]).stdout.strip()
    status = git(workspace, ["status", "--porcelain=v1", "--untracked-files=all"]).stdout
    if not status.strip():
        raise RuntimeError("Workspace is no longer dirty")
    index_path = _workspace_index_path(workspace)
    raw_index = index_path.read_bytes()
    raw_index_digest = _sha256_bytes(raw_index)
    stage_projection = git(workspace, ["ls-files", "-s"]).stdout.encode("utf-8")
    index_flag_projection = git(workspace, ["ls-files", "-v", "-z"]).stdout.encode("utf-8")
    unmerged_projection = git(workspace, ["ls-files", "-u"]).stdout.encode("utf-8")
    worktree_tree = _build_worktree_tree(workspace)
    index_tree = _build_index_tree(workspace, index_path, bool(unmerged_projection))
    state_basis = {
        "schemaVersion": SCHEMA_VERSION,
        "kind": "ordivon.workspace-git-state-basis",
        "workspaceId": workspace_id,
        "sourceRepo": str(record.get("sourceRepo")),
        "sourceRevision": record.get("sourceRevision"),
        "currentHeadRevision": head,
        "statusDigest": _sha256_bytes(status.encode("utf-8")),
        "stageProjectionDigest": _sha256_bytes(stage_projection),
        "indexFlagProjectionDigest": _sha256_bytes(index_flag_projection),
        "unmergedProjectionDigest": _sha256_bytes(unmerged_projection),
        "indexTree": index_tree,
        "worktreeTree": worktree_tree,
    }
    state_digest = _canonical_digest(state_basis)
    state_hex = state_digest.split(":", 1)[1]
    workspace_ref_id = quote(workspace_id, safe="-._")
    checkpoint_ref = f"refs/ordivon/checkpoints/{workspace_ref_id}/{state_hex}"
    existing = git(source_repo, ["rev-parse", "--verify", "--quiet", checkpoint_ref], check=False)
    if existing.returncode == 0:
        manifest_raw = git(source_repo, ["show", f"{checkpoint_ref}:manifest.json"]).stdout
        manifest = json.loads(manifest_raw)
        if not isinstance(manifest, dict) or manifest.get("stateDigest") != state_digest:
            raise RuntimeError("existing dirty checkpoint ref does not match current state digest")
        checkpoint_commit = existing.stdout.strip()
        disposition = "existing"
    else:
        raw_index_blob = _hash_object(source_repo, raw_index)
        stage_blob = _hash_object(source_repo, stage_projection)
        index_flags_blob = _hash_object(source_repo, index_flag_projection)
        unmerged_blob = _hash_object(source_repo, unmerged_projection)
        manifest = {
            **state_basis,
            "kind": "ordivon.workspace-state-bundle",
            "stateDigest": state_digest,
            "rawIndexBlob": raw_index_blob,
            "rawIndexDigest": raw_index_digest,
            "worktreeCarrier": "worktree/",
            "indexCarrier": "index/" if index_tree is not None else None,
            "truthRole": "physical-recovery-carrier-not-semantic-standing",
            "automaticDeletionAllowed": False,
        }
        manifest_bytes = (json.dumps(manifest, sort_keys=True, indent=2) + "\n").encode("utf-8")
        manifest_blob = _hash_object(source_repo, manifest_bytes)
        entries = [
            f"100644 blob {index_flags_blob}\tindex-flags.txt",
            f"100644 blob {stage_blob}\tindex-stages.txt",
            f"100644 blob {raw_index_blob}\tindex.raw",
            f"100644 blob {manifest_blob}\tmanifest.json",
            f"100644 blob {unmerged_blob}\tunmerged-stages.txt",
            f"040000 tree {worktree_tree}\tworktree",
        ]
        if index_tree is not None:
            entries.append(f"040000 tree {index_tree}\tindex")
        tree_result = subprocess.run(
            ["git", "-C", str(source_repo), "mktree"],
            input="\n".join(entries) + "\n",
            check=False,
            text=True,
            capture_output=True,
        )
        if tree_result.returncode != 0:
            raise RuntimeError(tree_result.stderr.strip() or tree_result.stdout.strip() or "git mktree failed")
        bundle_tree_id = tree_result.stdout.strip()
        message = (
            f"Ordivon dirty Workspace checkpoint: {workspace_id}\n\n"
            f"Physical recovery carrier {state_digest}. "
            "This does not assert semantic currentness, admission, owner standing, or deletion authority.\n"
        )
        commit_result = subprocess.run(
            ["git", "-C", str(source_repo), "commit-tree", bundle_tree_id, "-p", head],
            input=message,
            check=False,
            text=True,
            capture_output=True,
        )
        if commit_result.returncode != 0:
            raise RuntimeError(commit_result.stderr.strip() or commit_result.stdout.strip() or "git commit-tree failed")
        checkpoint_commit = commit_result.stdout.strip()
        update = subprocess.run(
            ["git", "-C", str(source_repo), "update-ref", checkpoint_ref, checkpoint_commit, "0" * 40],
            check=False,
            text=True,
            capture_output=True,
        )
        if update.returncode != 0:
            replay = git(source_repo, ["rev-parse", "--verify", "--quiet", checkpoint_ref], check=False)
            if replay.returncode != 0:
                raise RuntimeError(update.stderr.strip() or update.stdout.strip() or "git update-ref failed")
            manifest_raw = git(source_repo, ["show", f"{checkpoint_ref}:manifest.json"]).stdout
            replay_manifest = json.loads(manifest_raw)
            if not isinstance(replay_manifest, dict) or replay_manifest.get("stateDigest") != state_digest:
                raise RuntimeError("dirty checkpoint ref race resolved to different state")
            checkpoint_commit = replay.stdout.strip()
            manifest = replay_manifest
            disposition = "existing"
        else:
            disposition = "created"

    if sha256_file(record_path) != record_digest:
        raise RuntimeError("workspace record changed during dirty checkpoint")
    if active_jobs(args.database, args.busy_timeout_ms, workspace_id):
        raise RuntimeError("workspace acquired an active or held Job during dirty checkpoint")
    if _sha256_bytes(index_path.read_bytes()) != raw_index_digest:
        raise RuntimeError("Workspace index changed during dirty checkpoint")
    if _build_worktree_tree(workspace) != worktree_tree:
        raise RuntimeError("Workspace worktree changed during dirty checkpoint")
    return {
        "workspaceId": workspace_id,
        "sourceRepo": str(record.get("sourceRepo")),
        "sourceRevision": record.get("sourceRevision"),
        "currentHeadRevision": head,
        "recordDigest": record_digest,
        "stateDigest": state_digest,
        "checkpointRef": checkpoint_ref,
        "checkpointCommit": checkpoint_commit,
        "checkpointDisposition": disposition,
        "indexTree": index_tree,
        "worktreeTree": worktree_tree,
        "rawIndexDigest": raw_index_digest,
        "hasUnmergedIndex": bool(unmerged_projection),
        "truthRole": "physical-recovery-carrier-not-semantic-standing",
        "automaticDeletionAllowed": False,
        "recommendedNextAction": "owner_disposition_then_runtime_exact_compare_close",
    }


def dirty_checkpoint(args: argparse.Namespace) -> dict[str, object]:
    if args.confirm_policy != DIRTY_CHECKPOINT_CONFIRMATION:
        raise RuntimeError(f"confirm-policy must equal {DIRTY_CHECKPOINT_CONFIRMATION}")
    requested = list(dict.fromkeys(args.workspace_ids or []))
    with exclusive_lock(args.lock_file):
        report = enrich_report(args)
        by_id = {str(item["workspaceId"]): item for item in report.get("candidates", []) if isinstance(item, dict)}
        receipt = receipt_path(args.receipt_root, "dirty-checkpoint")
        actions: list[dict[str, object]] = []
        failures: list[dict[str, object]] = []
        for workspace_id in requested:
            item = by_id.get(workspace_id)
            if item is None:
                failures.append({"workspaceId": workspace_id, "error": "Workspace is absent from current lifecycle candidates"})
                continue
            try:
                actions.append(dirty_checkpoint_one(args, item))
            except Exception as error:
                failures.append({"workspaceId": workspace_id, "error": str(error)})
        result = {
            "schemaVersion": SCHEMA_VERSION,
            "status": "completed" if not failures else "partial",
            "truthRole": "physical-recovery-carrier-not-semantic-standing",
            "automaticDeletionAllowed": False,
            "actions": actions,
            "failures": failures,
            "receipt": str(receipt),
        }
        write_json_atomic(receipt / "result.json", result)
        return result

def repair(args: argparse.Namespace) -> dict[str, object]:
    if args.confirm_policy != REPAIR_CONFIRMATION:
        raise RuntimeError(f"confirm-policy must equal {REPAIR_CONFIRMATION}")
    if args.quarantine_unrepairable and args.confirm_quarantine != QUARANTINE_CONFIRMATION:
        raise RuntimeError(f"confirm-quarantine must equal {QUARANTINE_CONFIRMATION}")
    policy = load_policy(args.policy_file)
    requested = set(args.workspace_ids or [])
    cutoff_ms = int((time.time() - args.minimum_age_hours * 3600) * 1000)
    with exclusive_lock(args.lock_file):
        before = enrich_report(args)
        receipt = receipt_path(args.receipt_root, "workspace-repair")
        write_json_atomic(receipt / "before.json", before)
        actions: list[dict[str, object]] = []
        failures: list[dict[str, object]] = []
        for raw in before.get("candidates", []):
            if not isinstance(raw, dict):
                continue
            workspace_id = str(raw["workspaceId"])
            if requested and workspace_id not in requested:
                continue
            classification = raw.get("classification")
            if classification == "orphan_directory":
                # True orphans never participate in bulk repair/quarantine. An exact
                # workspace-id plus both quarantine confirmations are required.
                if workspace_id not in requested:
                    continue
                if not args.quarantine_unrepairable:
                    failures.append({
                        "workspaceId": workspace_id,
                        "error": "true orphan requires explicit --quarantine-unrepairable",
                    })
                    continue
                try:
                    actions.append(quarantine_orphan_directory(args, raw, receipt))
                except Exception as orphan_error:
                    failures.append({"workspaceId": workspace_id, "error": str(orphan_error)})
                continue
            if classification != "unknown":
                continue
            created = raw.get("createdUnixMs")
            if not isinstance(created, int) or created > cutoff_ms:
                continue
            try:
                actions.append(repair_one(args, policy, raw, receipt))
            except Exception as repair_error:
                if args.quarantine_unrepairable:
                    try:
                        action = quarantine_one(args, raw, receipt)
                        action["repairError"] = str(repair_error)
                        actions.append(action)
                    except Exception as quarantine_error:
                        failures.append(
                            {
                                "workspaceId": workspace_id,
                                "repairError": str(repair_error),
                                "quarantineError": str(quarantine_error),
                            }
                        )
                else:
                    failures.append({"workspaceId": workspace_id, "error": str(repair_error)})
        after = enrich_report(args)
        write_json_atomic(receipt / "after.json", after)
        result = {
            "schemaVersion": SCHEMA_VERSION,
            "status": "completed" if not failures else "partial",
            "actions": actions,
            "failures": failures,
            "receipt": str(receipt),
        }
        write_json_atomic(receipt / "result.json", result)
        return result


def main() -> int:
    try:
        args = parse_args()
        if args.command == "inspect":
            value = enrich_report(args)
        elif args.command == "sweep":
            value = sweep(args)
        elif args.command == "repair":
            value = repair(args)
        elif args.command == "dirty-review":
            value = dirty_review(args)
        elif args.command == "dirty-checkpoint":
            value = dirty_checkpoint(args)
        else:
            raise RuntimeError(f"unsupported command: {args.command}")
        print(json.dumps(value, indent=2 if args.pretty else None, sort_keys=args.pretty))
        return 0 if value.get("status") != "partial" else 2
    except (OSError, RuntimeError, json.JSONDecodeError) as error:
        print(f"workspace lifecycle failed: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
