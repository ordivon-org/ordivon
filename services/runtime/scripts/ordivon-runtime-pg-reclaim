#!/usr/bin/env python3
"""PG Runtime workspace lifecycle adapter: systemd schedules, Runtime closes.

Use the already deployed Runtime workspace.get/workspace.close contract. Never
delete physical Workspace files directly or infer domain acceptance from Job exit.
"""
from __future__ import annotations

import argparse
import re
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
from urllib.parse import quote
import time

from mcp_probe import connect_compatible, load_environment_file

# This is the *installed* PG Workspace carrier, not the retired SQLite
# registry. The existing operator-owned retention policy is read-only input:
# no implicit enablement of unintegrated deletion if it is absent or disabled.
WORKSPACE_ROOT = Path("/var/lib/ordivon/pg-candidate/workspaces")
RETAINED_HEAD_REF = re.compile(r"^sha256:([0-9a-f]{64})$")


def _retention_policy(path: Path | None) -> dict | None:
    if path is None:
        return None
    if not path.is_absolute() or not path.is_file() or path.is_symlink():
        raise ValueError("retention policy must be an installed absolute regular file")
    policy = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(policy, dict) or type(policy.get("schemaVersion")) is not int or policy["schemaVersion"] != 1:
        raise ValueError("unsupported retention policy schema")
    classes = policy.get("classes")
    if not isinstance(classes, dict) or policy.get("defaultClass") not in classes:
        raise ValueError("retention policy has no valid default class")
    for value in classes.values():
        if not isinstance(value, dict):
            raise ValueError("invalid retention class")
        hours = value.get("retentionHours")
        if hours is not None and (type(hours) not in (float, int) or not 0 <= hours <= 8760):
            raise ValueError("invalid retention class hours")
        if type(value.get("forceCloseUnintegratedAfterRetention", False)) is not bool:
            raise ValueError("invalid unintegrated retention authority")
    rules = policy.get("rules", [])
    if not isinstance(rules, list):
        raise ValueError("invalid retention policy rules")
    for rule in rules:
        if not isinstance(rule, dict) or rule.get("class") not in classes:
            raise ValueError("invalid retention policy rule class")
        if sum(isinstance(rule.get(k), str) for k in ("workspaceId", "prefix")) != 1:
            raise ValueError("retention rule requires exactly one selector")
    return policy


def _workspace_retention(
    policy: dict | None, workspace_id: str, cli_min_age_hours: float
) -> tuple[int | None, bool]:
    # Existing PG behavior stays fail-closed when no explicit policy is bound.
    if policy is None:
        return int(cli_min_age_hours * 3600 * 1000), False
    name = policy["defaultClass"]
    for rule in policy.get("rules", []):
        if rule.get("workspaceId") == workspace_id or (
            isinstance(rule.get("prefix"), str) and workspace_id.startswith(rule["prefix"])
        ):
            name = rule["class"]
            break
    value = policy["classes"][name]
    hours = value.get("retentionHours")
    if hours is None:
        return None, False  # pinned is not a deletion candidate
    return int(max(cli_min_age_hours, float(hours)) * 3600 * 1000), (
        value.get("forceCloseUnintegratedAfterRetention") is True
    )


def _preserve_unintegrated_head(
    repo: Path, workspace_id: str, head: str, source_digest: str
) -> dict[str, str]:
    # Reuse the existing lifecycle Git reference namespace, rather than
    # inventing a backup database or relying on a detached worktree HEAD.
    match = RETAINED_HEAD_REF.fullmatch(source_digest)
    if match is None or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,95}", workspace_id):
        raise RuntimeError("unintegrated Workspace has invalid source identity")
    if not re.fullmatch(r"[0-9a-f]{40}", head):
        raise RuntimeError("unintegrated Workspace HEAD is not a commit OID")
    found = _git(repo, "rev-parse", "--verify", f"{head}^{{commit}}")
    if found.returncode or found.stdout.strip() != head:
        raise RuntimeError("unintegrated Workspace HEAD is unavailable")
    ref = f"refs/ordivon/retention/{quote(workspace_id, safe='-._')}/{match.group(1)}"
    prior = _git(repo, "rev-parse", "--verify", "--quiet", ref)
    if prior.returncode == 0:
        if prior.stdout.strip() != head:
            raise RuntimeError("retained Workspace ref collides with a different commit")
        disposition = "existing"
    else:
        write = _git(repo, "update-ref", ref, head, "0" * 40)
        if write.returncode:
            replay = _git(repo, "rev-parse", "--verify", "--quiet", ref)
            if replay.returncode or replay.stdout.strip() != head:
                raise RuntimeError("could not preserve unintegrated Git HEAD")
            disposition = "existing"
        else:
            disposition = "created"
    readback = _git(repo, "rev-parse", "--verify", f"{ref}^{{commit}}")
    if readback.returncode or readback.stdout.strip() != head:
        raise RuntimeError("unintegrated retention ref was not durably readable")
    return {"workspaceId": workspace_id, "retentionRef": ref,
            "retentionCommit": head, "disposition": disposition,
            "truthRole": "physical-recovery-ref-not-semantic-completion"}

def _git(repo: Path, *args: str, timeout: float = 10) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(repo), *args],
        capture_output=True, text=True, timeout=timeout, check=False,
    )

def _worktrees(repo: Path, root: Path) -> list[tuple[Path, str]]:
    output = _git(repo, "worktree", "list", "--porcelain", timeout=30)
    if output.returncode:
        raise RuntimeError("Git worktree inventory failed")
    worktrees = []
    for part in output.stdout.strip().split("\n\n"):
        entries = part.splitlines()
        location = next((line[9:] for line in entries if line.startswith("worktree ")), "")
        head = next((line[5:] for line in entries if line.startswith("HEAD ")), "")
        if not location or not head or "locked" in entries:
            continue
        path = Path(location)
        if path.parent == root and path.is_dir() and not path.is_symlink():
            worktrees.append((path, head))
    return worktrees

def _jobs(environment: dict[str, str]) -> dict[str, tuple[int, str | None, int]]:
    """Read a small PG projection; native close rechecks physical authority."""
    import psycopg
    from psycopg import sql
    schema = environment["ORDIVON_PG_SCHEMA"]
    query = sql.SQL("""
        WITH activity AS (
            SELECT j.workspace_id, j.job_id, j.created_at_ms, j.resolution,
                   GREATEST(
                       j.created_at_ms,
                       COALESCE(events.last_event_ms, 0),
                       COALESCE(attempts.last_finished_ms, 0)
                   ) AS last_activity_ms
              FROM {schema}.jobs j
              LEFT JOIN (
                   SELECT job_id, MAX(observed_at_ms) AS last_event_ms
                     FROM {schema}.job_events GROUP BY job_id
              ) events ON events.job_id = j.job_id
              LEFT JOIN (
                   SELECT job_id, MAX(finished_at_ms) AS last_finished_ms
                     FROM {schema}.attempts GROUP BY job_id
              ) attempts ON attempts.job_id = j.job_id
        )
        SELECT workspace_id, MAX(last_activity_ms) AS last_ms,
               (ARRAY_AGG(resolution ORDER BY created_at_ms DESC, job_id DESC))[1]
                   AS last_resolution,
               COUNT(*) FILTER (WHERE resolution IS NULL) AS nonterminal
          FROM activity GROUP BY workspace_id
    """).format(schema=sql.Identifier(schema))
    with psycopg.connect(environment["ORDIVON_PG_DSN"], connect_timeout=8) as connection:
        with connection.transaction():
            connection.execute("SET LOCAL statement_timeout = '15000ms'")
            rows = connection.execute(query).fetchall()
    return {row[0]: (row[1], row[2], row[3]) for row in rows}

def _unintegrated_head(repo: Path, head: str) -> bool | None:
    """0 is integrated, 1 is unintegrated, 128/timeout is UNKNOWN, not FALSE."""
    observed = _git(repo, "merge-base", "--is-ancestor", head, "origin/main")
    if observed.returncode == 0:
        return False
    if observed.returncode == 1:
        return True
    return None


def eligible(
    *,
    now_ms: int,
    created_ms: int,
    latest_job_ms: int | None,
    latest_resolution: str | None,
    unresolved: int,
    min_age_ms: int,
) -> bool:
    """Reclaim only old, quiet, successfully executed Workspaces."""
    return (
        type(created_ms) is int and created_ms >= 0
        and type(latest_job_ms) is int and latest_job_ms >= created_ms
        and latest_resolution == "succeeded"
        and unresolved == 0
        and max(created_ms, latest_job_ms) <= now_ms - min_age_ms
    )

def _active_process_cwds(root: Path) -> list[str]:
    result = []
    for process in Path("/proc").glob("[0-9]*/cwd"):
        try:
            cwd = os.readlink(process)
            if cwd.startswith(str(root) + "/"):
                result.append(cwd)
        except (OSError, PermissionError):
            continue
    return result

def _store_receipt(root: Path, data: dict) -> str:
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(root, 0o700)
    target = root / ("pg-reclaim-" + str(data["observedAtMs"]) + ".json")
    fd, temp = tempfile.mkstemp(prefix=".reclaim-", dir=root)
    try:
        with os.fdopen(fd, "w", encoding="utf8") as stream:
            json.dump(data, stream, indent=2, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temp, 0o600)
        os.replace(temp, target)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)
    return str(target)

def run(args: argparse.Namespace) -> dict:
    env = load_environment_file(args.env_file)
    repo, root = args.source_repo.resolve(), args.workspace_root.resolve()
    if root != WORKSPACE_ROOT:
        raise ValueError("PG Runtime must own the exact Workspace root")
    if not (repo / ".git").exists() and not (repo / ".git").is_file():
        raise ValueError("sourceRepo is not a Git authority")
    if args.min_age_hours < 1 or args.min_age_hours > 168:
        raise ValueError("retention hours must be between 1 and 168")
    policy = _retention_policy(args.policy_file)
    recent = _jobs(env)
    now = int(time.time() * 1000)
    cwd = _active_process_cwds(root)
    results = {
        "checked": 0, "eligible": 0, "closed": [], "preserved": [],
        "skipped": {}, "errors": [], "retentionPolicy": (
            "operator-installed" if policy is not None else "legacy-merged-only"
        ),
        "semanticCompletionEvaluated": False,
    }
    def skip(why: str) -> None:
        results["skipped"][why] = results["skipped"].get(why, 0) + 1
    worktrees = _worktrees(repo, root)
    registered_ids = {path.name for path, _ in worktrees}
    # Directories without a Git worktree identity are NOT deletion candidates.
    # Report their cardinality so persistent orphans cannot disappear from
    # resource-cost accounting just because this adapter cannot close them.
    unregistered = sorted(
        path.name for path in root.iterdir()
        if path.is_dir() and not path.is_symlink()
        and path.name not in registered_ids
    )
    results["unregisteredDirectoryCount"] = len(unregistered)
    results["unregisteredDirectorySample"] = unregistered[:10]
    results["unregisteredDirectoryTruthBoundary"] = (
        "outside this sourceRepo Git worktree inventory, not proven orphan; never auto-delete"
    )
    candidates = []
    for path, head in worktrees:
        results["checked"] += 1
        if any(item == str(path) or item.startswith(str(path)+"/") for item in cwd):
            skip("process_cwd_active");continue
        retention_ms, unintegrated_allowed = _workspace_retention(
            policy, path.name, args.min_age_hours
        )
        if retention_ms is None:
            skip("policy_pinned");continue
        # Linux ctime is used only as a cheap filter; Runtime record and
        # last durable PG Job ultimately qualify any physical Workspace close.
        if path.stat().st_ctime * 1000 > now - retention_ms:
            skip("directory_recently_changed");continue
        info = recent.get(path.name)
        if info is None:
            skip("no_terminal_job_evidence");continue
        last_ms,resolution,nonterminal = info
        if nonterminal or resolution != "succeeded" or last_ms > now - retention_ms:
            skip("job_not_old_and_terminal_success");continue
        unintegrated = _unintegrated_head(repo, head)
        if unintegrated is None:
            skip("git_membership_unknown");continue
        if unintegrated and not unintegrated_allowed:
            skip("head_not_in_main");continue
        status = _git(path, "status", "--porcelain=v1", "--untracked-files=normal")
        if status.returncode or status.stdout.strip():
            skip("dirty_or_git_error");continue
        candidates.append((path, head, info, retention_ms, unintegrated))
    results["unregisteredDirectoryDeletionEnabled"] = False
    if not args.apply:
        results["eligible"] = len(candidates)
        results["eligibleUnintegrated"] = sum(item[4] for item in candidates)
        results["candidates"] = [p.name for p,_,_,_,_ in candidates[:args.limit]]
        return results
    os.environ["no_proxy"] = "127.0.0.1,localhost"
    client = connect_compatible(
        "http://" + env["ORDIVON_PG_BIND"] + "/mcp",
        env["ORDIVON_PG_TOKEN"],
        client_name="ordivon-runtime-pg-reclaim",
        timeout=20.0,
    )
    for path, head, info, retention_ms, unintegrated in candidates[:args.limit]:
        try:
            workspace = client.call_tool("workspace.get", {"workspaceId":path.name,"schemaVersion":1})
            if (workspace.get("workspaceId") != path.name or workspace.get("dirty") is not False
                or workspace.get("activeJobIds") != []
                or workspace.get("sourceRepo") != str(repo)
                or workspace.get("currentHeadRevision") != head
                or not eligible(
                    now_ms=now,created_ms=workspace.get("createdAtMs"),
                    latest_job_ms=info[0], latest_resolution=info[1],
                    unresolved=info[2], min_age_ms=retention_ms,
                )):
                skip("runtime_authority_not_eligible");continue
            digest=workspace.get("sourceStateDigest")
            if not isinstance(digest,str) or not digest.startswith("sha256:"):
                skip("missing_source_digest");continue
            # Recheck Git and never force. Runtime checks held Jobs/dependents.
            currently_unintegrated = _unintegrated_head(repo, head)
            if currently_unintegrated is None:
                skip("git_membership_unknown");continue
            if currently_unintegrated and not unintegrated:
                skip("git_changed_at_close");continue
            # An operator can revoke/extend retention permission while this
            # bounded sweep runs. Consume the installed file again before
            # the first irreversible preservation/close effect.
            current_policy = _retention_policy(args.policy_file)
            current_age, current_unintegrated_allowed = _workspace_retention(
                current_policy, path.name, args.min_age_hours
            )
            if (current_age is None or current_age > retention_ms
                    or (currently_unintegrated and not current_unintegrated_allowed)):
                skip("retention_policy_changed");continue
            current_git_status = _git(path,"status","--porcelain=v1","--untracked-files=normal")
            if current_git_status.returncode or current_git_status.stdout.strip():
                skip("git_changed_at_close");continue
            # An unmerged HEAD is valuable source. Preserve it in the
            # existing Git retention namespace BEFORE any native close effect.
            if currently_unintegrated:
                result = _preserve_unintegrated_head(
                    repo, path.name, head, digest
                )
                results["preserved"].append(result)
            closed = client.call_tool(
                "workspace.close",
                {"schemaVersion":1,"workspaceId":path.name,"force":False,
                 # A quiet successful Job is NOT evidence of a semantic
                 # consumer release. After the >=4h continuation grace the
                 # Runtime can close without asserting consumerReleased=true.
                 "consumerReleased":False,
                 "expectedSourceStateDigest":digest},
            )
            if closed.get("closureDisposition") not in ("removed","already_closed"):
                raise RuntimeError("Runtime did not confirm closed disposition")
            results["closed"].append(path.name)
        except Exception as error:
            results["errors"].append({"workspaceId":path.name,"errorType":type(error).__name__})
    results["eligible"] = len(candidates)
    results["eligibleUnintegrated"] = sum(item[4] for item in candidates)
    return results

def main() -> int:
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--env-file",required=True,type=Path)
    parser.add_argument("--source-repo",required=True,type=Path)
    parser.add_argument("--workspace-root",required=True,type=Path)
    parser.add_argument("--receipt-root",required=True,type=Path)
    parser.add_argument("--lock-file",required=True,type=Path)
    parser.add_argument("--min-age-hours",type=float,default=24)
    parser.add_argument(
        "--policy-file", type=Path, default=None,
        help="Existing operator-controlled Workspace retention JSON; absent means merged-only",
    )
    parser.add_argument("--limit",type=int,default=25)
    parser.add_argument("--apply",action="store_true")
    args=parser.parse_args()
    if not 1<=args.limit<=100:
        parser.error("limit must be 1..100")
    args.lock_file.parent.mkdir(mode=0o700,parents=True,exist_ok=True)
    with args.lock_file.open("a+") as lock:
        try:
            fcntl.flock(lock.fileno(),fcntl.LOCK_EX|fcntl.LOCK_NB)
        except BlockingIOError:
            print(json.dumps({"status":"already_running"}))
            return 0
        try:
            report=run(args)
            report.update({"schemaVersion":1,"kind":"ordivon.pg-native-workspace-reclaim",
                           "observedAtMs":int(time.time()*1000),"applied":args.apply})
            if args.apply:
                report["receipt"]=_store_receipt(args.receipt_root,report)
            print(json.dumps(report,sort_keys=True))
            return 0 if not report["errors"] else 2
        except Exception as error:
            print(json.dumps({"status":"failed","errorType":type(error).__name__,
                              "detail":str(error)[:300]}),file=sys.stderr)
            return 1

if __name__ == "__main__":
    raise SystemExit(main())
