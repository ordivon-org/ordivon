#!/usr/bin/env python3
"""PG Runtime workspace lifecycle adapter: systemd schedules, Runtime closes.

Use the already deployed Runtime workspace.get/workspace.close contract. Never
delete physical Workspace files directly or infer domain acceptance from Job exit.

All automatic close candidates require an exact
operator-owned retention-policy rule on workspaceId with
"operatorConsumerReleased": true and an exact operatorReleaseBinding. This
is an explicit disposition for the observed generation, source and Job
activity, not inferred from elapsed time or a successful Job.
"""
from __future__ import annotations

import argparse
import re
import fcntl
import json
import os
import stat
from pathlib import Path
import subprocess
import sys
import tempfile
from urllib.parse import quote
import time

from mcp_probe import connect_compatible, load_environment_file

# This is the *installed* PG Workspace carrier, not the retired SQLite
# registry. The existing operator-owned retention policy is read-only input:
# no implicit enablement of unintegrated deletion if it is absent or disabled.
WORKSPACE_ROOT = Path("/var/lib/ordivon/pg-candidate/workspaces")
RETAINED_HEAD_REF = re.compile(r"^sha256:([0-9a-f]{64})$")


def _retention_policy(path: Path | None) -> dict | None:
    if path is None:
        return None
    if not path.is_absolute() or not path.is_file() or path.is_symlink():
        raise ValueError("retention policy must be an installed absolute regular file")
    # The policy can authorize removing irreplaceable unmerged Workspace output.
    # Reuse OS DAC: only the executing operator may own/write it. A root-owned
    # sticky ancestor (e.g. /tmp in native tests) cannot be used to replace a
    # root-owned child; ordinary writable ancestors cannot be trusted.
    operator_uid = os.geteuid()
    for component in (path, *path.parents):
        entry = component.lstat()
        is_file = component == path
        if is_file:
            if not stat.S_ISREG(entry.st_mode) or entry.st_uid != operator_uid:
                raise ValueError("retention policy must be owned by its executor")
            if entry.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
                raise ValueError("retention policy must not be writable by others")
        else:
            if not stat.S_ISDIR(entry.st_mode) or entry.st_uid not in (0, operator_uid):
                raise ValueError("retention policy directory has foreign ownership")
            writable = entry.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
            root_sticky = entry.st_uid == 0 and entry.st_mode & stat.S_ISVTX
            if writable and not root_sticky:
                raise ValueError("retention policy directory is writable by others")
    policy = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(policy, dict) or type(policy.get("schemaVersion")) is not int or policy["schemaVersion"] != 1:
        raise ValueError("unsupported retention policy schema")
    classes = policy.get("classes")
    if not isinstance(classes, dict) or policy.get("defaultClass") not in classes:
        raise ValueError("retention policy has no valid default class")
    for value in classes.values():
        if not isinstance(value, dict):
            raise ValueError("invalid retention class")
        hours = value.get("retentionHours")
        if hours is not None and (type(hours) not in (float, int) or not 0 <= hours <= 8760):
            raise ValueError("invalid retention class hours")
        if type(value.get("forceCloseUnintegratedAfterRetention", False)) is not bool:
            raise ValueError("invalid unintegrated retention authority")
    rules = policy.get("rules", [])
    if not isinstance(rules, list):
        raise ValueError("invalid retention policy rules")
    explicit_releases = set()
    for rule in rules:
        if not isinstance(rule, dict) or rule.get("class") not in classes:
            raise ValueError("invalid retention policy rule class")
        if sum(isinstance(rule.get(k), str) for k in ("workspaceId", "prefix")) != 1:
            raise ValueError("retention rule requires exactly one selector")
        if "operatorConsumerReleased" in rule:
            # No blanket/prefix/age-only grant: a real operator is asserting
            # the exact Workspace owner no longer has a pending consumer.
            if (not isinstance(rule.get("workspaceId"), str)
                    or type(rule["operatorConsumerReleased"]) is not bool):
                raise ValueError("owner release must be a boolean on exact workspaceId")
            if rule["workspaceId"] in explicit_releases:
                raise ValueError("ambiguous duplicate exact owner release")
            explicit_releases.add(rule["workspaceId"])
        if "operatorReleaseBinding" in rule:
            binding = rule["operatorReleaseBinding"]
            if ("operatorConsumerReleased" not in rule
                    or not _valid_release_binding(binding)):
                raise ValueError("invalid exact owner release binding")
    return policy


def _workspace_retention(
    policy: dict | None, workspace_id: str, cli_min_age_hours: float
) -> tuple[int | None, bool]:
    # Existing PG behavior stays fail-closed when no explicit policy is bound.
    if policy is None:
        return int(cli_min_age_hours * 3600 * 1000), False
    name = policy["defaultClass"]
    for rule in policy.get("rules", []):
        if rule.get("workspaceId") == workspace_id or (
            isinstance(rule.get("prefix"), str) and workspace_id.startswith(rule["prefix"])
        ):
            name = rule["class"]
            break
    value = policy["classes"][name]
    hours = value.get("retentionHours")
    if hours is None:
        return None, False  # pinned is not a deletion candidate
    return int(max(cli_min_age_hours, float(hours)) * 3600 * 1000), (
        value.get("forceCloseUnintegratedAfterRetention") is True
    )


def _valid_release_binding(binding: object) -> bool:
    if not isinstance(binding, dict) or set(binding) != {
        "createdAtMs", "sourceStateDigest", "latestJobActivityMs",
    }:
        return False
    created, digest, activity = (
        binding["createdAtMs"], binding["sourceStateDigest"],
        binding["latestJobActivityMs"],
    )
    return (
        type(created) is int and created >= 0
        and isinstance(digest, str) and RETAINED_HEAD_REF.fullmatch(digest) is not None
        and (activity is None or (type(activity) is int and activity >= created))
    )


def _operator_release_binding(
    policy: dict | None, workspace_id: str
) -> dict | None:
    # An old unbound boolean remains readable but grants no automatic close.
    if policy is not None:
        for rule in policy.get("rules", []):
            binding = rule.get("operatorReleaseBinding")
            if (rule.get("workspaceId") == workspace_id
                    and rule.get("operatorConsumerReleased") is True
                    and _valid_release_binding(binding)):
                return binding
    return None


def _release_matches(
    binding: dict | None, workspace: dict, latest_job_ms: int | None,
) -> bool:
    """An observed release is specific to this source and generation.

    This is an advisory currentness check, not an atomic independent
    consumer acknowledgement. Native close still owns PG/Claim/CAS fences.
    """
    created = workspace.get("createdAtMs")
    digest = workspace.get("sourceStateDigest")
    return (
        binding is not None
        and type(created) is int and created == binding["createdAtMs"]
        and digest == binding["sourceStateDigest"]
        and (latest_job_ms is None or type(latest_job_ms) is int)
        and latest_job_ms == binding["latestJobActivityMs"]
    )


def _preserve_unintegrated_head(
    repo: Path, workspace_id: str, head: str, source_digest: str
) -> dict[str, str]:
    # Reuse the existing lifecycle Git reference namespace, rather than
    # inventing a backup database or relying on a detached worktree HEAD.
    match = RETAINED_HEAD_REF.fullmatch(source_digest)
    if match is None or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,95}", workspace_id):
        raise RuntimeError("unintegrated Workspace has invalid source identity")
    if not re.fullmatch(r"[0-9a-f]{40}", head):
        raise RuntimeError("unintegrated Workspace HEAD is not a commit OID")
    found = _git(repo, "rev-parse", "--verify", f"{head}^{{commit}}")
    if found.returncode or found.stdout.strip() != head:
        raise RuntimeError("unintegrated Workspace HEAD is unavailable")
    ref = f"refs/ordivon/retention/{quote(workspace_id, safe='-._')}/{match.group(1)}"
    prior = _git(repo, "rev-parse", "--verify", "--quiet", ref)
    if prior.returncode == 0:
        if prior.stdout.strip() != head:
            raise RuntimeError("retained Workspace ref collides with a different commit")
        disposition = "existing"
    else:
        write = _git(repo, "update-ref", ref, head, "0" * 40)
        if write.returncode:
            replay = _git(repo, "rev-parse", "--verify", "--quiet", ref)
            if replay.returncode or replay.stdout.strip() != head:
                raise RuntimeError("could not preserve unintegrated Git HEAD")
            disposition = "existing"
        else:
            disposition = "created"
    readback = _git(repo, "rev-parse", "--verify", f"{ref}^{{commit}}")
    if readback.returncode or readback.stdout.strip() != head:
        raise RuntimeError("unintegrated retention ref was not durably readable")
    return {"workspaceId": workspace_id, "retentionRef": ref,
            "retentionCommit": head, "disposition": disposition,
            "truthRole": "physical-recovery-ref-not-semantic-completion"}

def _git(repo: Path, *args: str, timeout: float = 10) -> subprocess.CompletedProcess[str]:
    # Explicit sourceRepo is the Git authority for retirement. -C alone
    # does not override inherited GIT_DIR / GIT_OBJECT_DIRECTORY and friends.
    clean_env = {key: value for key, value in os.environ.items()
                 if not key.startswith("GIT_")}
    # Local replacement refs and grafts must not redefine the committed DAG.
    clean_env["GIT_GRAFT_FILE"] = os.devnull
    return subprocess.run(
        ["git", "--no-replace-objects", "-C", str(repo), *args],
        capture_output=True, text=True, errors="surrogateescape",
        timeout=timeout, check=False, env=clean_env,
    )

def _worktrees(repo: Path, root: Path) -> list[tuple[Path, str]]:
    output = _git(repo, "worktree", "list", "--porcelain", "-z", timeout=30)
    if output.returncode:
        raise RuntimeError("Git worktree inventory failed")
    worktrees = []
    for part in output.stdout.split("\0\0"):
        entries = part.split("\0")
        location = next((line[9:] for line in entries if line.startswith("worktree ")), "")
        head = next((line[5:] for line in entries if line.startswith("HEAD ")), "")
        locked = any(line == "locked" or line.startswith("locked ") for line in entries)
        if not location or not head or locked:
            continue
        path = Path(location)
        if path.parent == root and path.is_dir() and not path.is_symlink():
            worktrees.append((path, head))
    return worktrees


def _other_repo_managed_workspaces(
    source_repo: Path, root: Path, unregistered_ids: list[str]
) -> list[str]:
    """Classify only physically proven *other-repository* Runtime Workspaces.

    A per-sourceRepo Git worktree listing is not the global Runtime inventory.
    A sibling directory can be a fully valid Workspace of another Git authority.
    Cross-repo proofs are advisory: neither these nor unknown directories may
    be deleted by this per-repository lifecycle adapter.
    """
    records = root.parent / "workspace-records"
    by_repo: dict[Path, set[Path] | None] = {}
    found: list[str] = []
    for workspace_id in unregistered_ids:
        if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,95}", workspace_id) is None:
            continue
        record_file = records / (workspace_id + ".json")
        if record_file.is_symlink() or not record_file.is_file():
            continue
        try:
            record = json.loads(record_file.read_text(encoding="utf-8"))
            if not isinstance(record, dict) or record.get("workspaceId") not in (
                workspace_id, "",
            ):
                continue
            source = record.get("sourceRepo")
            claimed_workspace = record.get("workspacePath")
            if not isinstance(source, str) or not Path(source).is_absolute():
                continue
            if claimed_workspace != str(root / workspace_id):
                continue
            foreign_repo = Path(source).resolve(strict=True)
            if foreign_repo == source_repo or not foreign_repo.is_dir():
                continue
            if foreign_repo not in by_repo:
                # A record is not a proof of registration. Git must independently
                # attest the exact directory as one of this source's worktrees.
                by_repo[foreign_repo] = {
                    path for path, _ in _worktrees(foreign_repo, root)
                }
            if root / workspace_id in (by_repo[foreign_repo] or set()):
                found.append(workspace_id)
        except (OSError, ValueError, RuntimeError, subprocess.SubprocessError):
            # Invalid/unknown foreign evidence must not make the main collector
            # fail or cause this directory to be considered disposable.
            continue
    return found


def effective_environment(base: Path, overlays: tuple[Path, ...]) -> dict[str, str]:
    """Use the existing bounded parser; later declared files override earlier ones.
    Missing or unreadable required input is an error, not an empty overlay.
    """
    environment = load_environment_file(base)
    for path in overlays:
        environment.update(load_environment_file(path))
    return environment


def native_environment_files(value: object, base: Path) -> tuple[Path, ...]:
    """Accept only the ordered, required, exact-path systemd property subset."""
    if not isinstance(value, dict) or value.get("type") != "a(sb)":
        raise ValueError("Runtime EnvironmentFiles property is not typed a(sb)")
    entries = value.get("data")
    if not isinstance(entries, list) or not entries:
        raise ValueError("Runtime EnvironmentFiles property is empty")
    paths = []
    for entry in entries:
        if (not isinstance(entry, list) or len(entry) != 2
                or not isinstance(entry[0], str) or entry[1] is not False):
            raise ValueError("Runtime EnvironmentFiles requires exact mandatory paths")
        path = Path(entry[0])
        if (not path.is_absolute() or any(char in entry[0] for char in "*?[]")
                or ".." in path.parts or path in paths):
            raise ValueError("Runtime EnvironmentFiles contains an unsupported path")
        paths.append(path)
    if paths[0] != base:
        raise ValueError("Runtime EnvironmentFiles does not start with the expected PG base")
    return tuple(paths)


def installed_environment_files(base: Path) -> tuple[Path, ...]:
    """Resolve the existing systemd authority without a parallel file list."""
    prefix = ["/usr/bin/busctl", "--json=short"]
    service = "org.freedesktop.systemd1"
    def query(*args: str) -> object:
        result = subprocess.run(prefix + list(args), check=True, capture_output=True,
                                text=True, timeout=10)
        return json.loads(result.stdout)
    unit = query("call", service, "/org/freedesktop/systemd1",
                 service + ".Manager", "GetUnit", "s", "ordivon-runtime.service")
    if (not isinstance(unit, dict) or unit.get("type") != "o"
            or unit.get("data") != ["/org/freedesktop/systemd1/unit/ordivon_2druntime_2eservice"]):
        raise ValueError("native Runtime unit identity unavailable")
    return native_environment_files(
        query("get-property", service, unit["data"][0], service + ".Service", "EnvironmentFiles"),
        base,
    )


def qualified_writer(row: object, source: object) -> bool:
    """No observation from a different writer SourceCut may qualify deletion."""
    return (isinstance(source, str) and len(source) == 64
            and all(c in "0123456789abcdef" for c in source)
            and isinstance(row, tuple) and len(row) == 3
            and row[0] == "QUALIFIED_WRITER" and row[1] == source and row[2] is True)


def _jobs(
    environment: dict[str, str], workspace_id: str | None = None,
) -> dict[str, tuple[int, str | None, int]]:
    """Read a small PG projection; native close rechecks physical authority."""
    import psycopg
    from psycopg import sql
    schema = environment["ORDIVON_PG_SCHEMA"]
    query = sql.SQL("""
        WITH activity AS (
            SELECT j.workspace_id, j.job_id, j.created_at_ms, j.resolution,
                   GREATEST(
                       j.created_at_ms,
                       COALESCE(events.last_event_ms, 0),
                       COALESCE(attempts.last_finished_ms, 0)
                   ) AS last_activity_ms
              FROM {schema}.jobs j
              LEFT JOIN (
                   SELECT job_id, MAX(observed_at_ms) AS last_event_ms
                     FROM {schema}.job_events GROUP BY job_id
              ) events ON events.job_id = j.job_id
              LEFT JOIN (
                   SELECT job_id, MAX(finished_at_ms) AS last_finished_ms
                     FROM {schema}.attempts GROUP BY job_id
              ) attempts ON attempts.job_id = j.job_id
              WHERE (%s::text IS NULL OR j.workspace_id = %s)
        )
        SELECT workspace_id, MAX(last_activity_ms) AS last_ms,
               (ARRAY_AGG(resolution ORDER BY created_at_ms DESC, job_id DESC))[1]
                   AS last_resolution,
               COUNT(*) FILTER (WHERE resolution IS NULL) AS nonterminal
          FROM activity GROUP BY workspace_id
    """).format(schema=sql.Identifier(schema))
    with psycopg.connect(environment["ORDIVON_PG_DSN"], connect_timeout=8) as connection:
        with connection.transaction():
            # Writer qualification and the Job projection must share one
            # read-only PG snapshot. Native close still owns effect-time checks.
            connection.execute("SET TRANSACTION ISOLATION LEVEL REPEATABLE READ READ ONLY")
            connection.execute("SET LOCAL statement_timeout = '15000ms'")
            writer = connection.execute(sql.SQL(
                "SELECT state,source_sha256,promotion_allowed FROM {}._stage_control WHERE id='source'"
            ).format(sql.Identifier(schema))).fetchone()
            if not qualified_writer(writer, environment.get("ORDIVON_PG_SOURCE_SHA256")):
                raise RuntimeError("PG writer SourceCut is not currently qualified")
            rows = connection.execute(query, (workspace_id, workspace_id)).fetchall()
    return {row[0]: (row[1], row[2], row[3]) for row in rows}

def _unintegrated_head(
    repo: Path, head: str, integration_ref: str = "refs/remotes/origin/main"
) -> bool | None:
    """Only an explicit canonical Git ref can prove HEAD integration."""
    observed = _git(repo, "merge-base", "--is-ancestor", head, integration_ref)
    if observed.returncode == 0:
        return False
    if observed.returncode == 1:
        return True
    return None


# A terminal failure says nothing about semantic completion, just as success
# does not prove downstream acceptance. Native Runtime Close must still prove
# no active/held PG owner, the current source digest and dependent Workspaces.
# LOST/ORPHANED/unknown states are NOT a negative process/consumer proof.
QUIET_TERMINAL_RESOLUTIONS = frozenset({
    "succeeded", "failed", "timed_out", "cancelled",
})


def eligible(
    *,
    now_ms: int,
    created_ms: int,
    latest_job_ms: int | None,
    latest_resolution: str | None,
    unresolved: int,
    min_age_ms: int,
) -> bool:
    """Age only qualifies a candidate, never a source/value/consumer release.

    A no-Job Workspace has no Job resolution to invent. Physical identity,
    integration, ignored outputs and actual NativeClose are separate gates.
    """
    if (
        type(now_ms) is not int or type(created_ms) is not int
        or type(min_age_ms) is not int or type(unresolved) is not int
        or now_ms < 0 or created_ms < 0 or min_age_ms <= 0 or unresolved != 0
    ):
        return False
    if latest_job_ms is None:
        return latest_resolution is None and created_ms <= now_ms - min_age_ms
    return (
        type(latest_job_ms) is int and latest_job_ms >= created_ms
        and latest_resolution in QUIET_TERMINAL_RESOLUTIONS
        and latest_job_ms <= now_ms - min_age_ms
    )

def _active_process_paths(root: Path) -> list[str]:
    """Advisory native consumer observation, not proof of semantic release.

    External consumers can keep a Workspace file open while running outside
    that Workspace. Inspect cwd, executable and open descriptors. Denied
    observation is UNKNOWN and aborts the sweep; exited processes are normal.
    """
    prefix = str(root) + os.sep
    result = set()
    for process in Path("/proc").glob("[0-9]*"):
        links = [process / "cwd", process / "exe"]
        try:
            links.extend((process / "fd").iterdir())
        except (FileNotFoundError, ProcessLookupError):
            continue
        for link in links:
            try:
                location = os.readlink(link)
            except (FileNotFoundError, ProcessLookupError):
                continue
            location = location.removesuffix(" (deleted)")
            if location == str(root) or location.startswith(prefix):
                result.add(location)
    return sorted(result)

def _store_receipt(root: Path, data: dict) -> str:
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(root, 0o700)
    target = root / ("pg-reclaim-" + str(data["observedAtMs"]) + ".json")
    fd, temp = tempfile.mkstemp(prefix=".reclaim-", dir=root)
    try:
        with os.fdopen(fd, "w", encoding="utf8") as stream:
            json.dump(data, stream, indent=2, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temp, 0o600)
        os.replace(temp, target)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)
    return str(target)

def _workspace_matches_candidate(
    workspace: dict, path: Path, head: str, repo: Path, info: tuple,
    retention_ms: int, now: int,
) -> bool:
    return (
        workspace.get("workspaceId") == path.name
        and workspace.get("dirty") is False
        and workspace.get("activeJobIds") == []
        and workspace.get("sourceRepo") == str(repo)
        and workspace.get("currentHeadRevision") == head
        and eligible(
            now_ms=now, created_ms=workspace.get("createdAtMs"),
            latest_job_ms=info[0], latest_resolution=info[1],
            unresolved=info[2], min_age_ms=retention_ms,
        )
    )


def _reclaim_client(env: dict[str, str]):
    os.environ["no_proxy"] = "127.0.0.1,localhost"
    return connect_compatible(
        "http://" + env["ORDIVON_PG_BIND"] + "/mcp", env["ORDIVON_PG_TOKEN"],
        client_name="ordivon-runtime-pg-reclaim", timeout=20.0,
    )


def _observe_release_subjects(
    env: dict[str, str], repo: Path, policy: dict | None, now: int,
    targets: list[tuple], results: dict,
) -> None:
    """Read bounded native subject coordinates; never authorize or close."""
    results["observedReleaseSubjects"] = []
    if not targets:
        return
    client = _reclaim_client(env)
    for path, head, info, retention_ms, _ in targets:
        try:
            workspace = client.call_tool(
                "workspace.get", {"workspaceId": path.name, "schemaVersion": 1},
            )
            latest = _jobs(env, path.name).get(path.name, (None, None, 0))
            binding = {
                "createdAtMs": workspace.get("createdAtMs"),
                "sourceStateDigest": workspace.get("sourceStateDigest"),
                "latestJobActivityMs": latest[0],
            }
            if (latest != info
                    or not _workspace_matches_candidate(workspace, path, head, repo, latest, retention_ms, now)
                    or not _valid_release_binding(binding)):
                results["skipped"]["release_subject_changed"] = (
                    results["skipped"].get("release_subject_changed", 0) + 1
                )
                continue
            results["observedReleaseSubjects"].append({
                "workspaceId": path.name, "sourceRepo": str(repo),
                "currentHeadRevision": head, "operatorReleaseBinding": binding,
                "existingPolicyMatches": _release_matches(
                    _operator_release_binding(policy, path.name), workspace, latest[0],
                ),
                "standing": "OBSERVED_SUBJECT_NOT_CONSUMER_RELEASE",
            })
        except Exception as error:
            results["errors"].append({
                "workspaceId": path.name, "errorType": type(error).__name__,
                "nativeCloseRequested": False, "physicalCloseStanding": "NOT_REQUESTED",
                "recoveryRequired": False, "nextProtocolStep": "RECHECK_RELEASE_SUBJECT",
            })


def run(args: argparse.Namespace) -> dict:
    if getattr(args, "installed_runtime_environment", False):
        files = installed_environment_files(args.env_file)
        env = effective_environment(files[0], files[1:])
    else:
        env = effective_environment(args.env_file, tuple(getattr(args, "env_overlay", ())))
    repo, root = args.source_repo.resolve(), args.workspace_root.resolve()
    integration_ref = args.integration_ref
    if integration_ref == "refs/heads/main":
        # Local-only Research repositories have no origin/main; never trust
        # local main as a deletion boundary for a configured remote.
        remotes = _git(repo, "remote")
        if remotes.returncode or remotes.stdout.strip():
            raise ValueError("local main GC requires a repository without remotes")
    resolved = _git(repo, "rev-parse", "--verify", integration_ref)
    if resolved.returncode:
        raise ValueError("configured GC integration ref is unavailable")
    if root != WORKSPACE_ROOT:
        raise ValueError("PG Runtime must own the exact Workspace root")
    if not (repo / ".git").exists() and not (repo / ".git").is_file():
        raise ValueError("sourceRepo is not a Git authority")
    if args.min_age_hours < 1 or args.min_age_hours > 168:
        raise ValueError("retention hours must be between 1 and 168")
    policy = _retention_policy(args.policy_file)
    recent = _jobs(env)
    now = int(time.time() * 1000)
    process_paths = _active_process_paths(root)
    results = {
        "checked": 0, "eligible": 0, "closed": [], "preserved": [],
        "skipped": {}, "errors": [], "retentionPolicy": (
            "operator-installed" if policy is not None else "legacy-merged-only"
        ),
        "semanticCompletionEvaluated": False,
        # Old no-Job/failed carriers may be source-clean but still owned by a
        # paused Run. Surface bounded, actionable release questions instead
        # of silently accumulating them or granting deletion by age.
        "needsOwnerDisposition": [],
    }
    def skip(why: str) -> None:
        results["skipped"][why] = results["skipped"].get(why, 0) + 1
    worktrees = _worktrees(repo, root)
    registered_ids = {path.name for path, _ in worktrees}
    # Directories without a Git worktree identity are NOT deletion candidates.
    # Report their cardinality so persistent orphans cannot disappear from
    # resource-cost accounting just because this adapter cannot close them.
    unregistered = sorted(
        path.name for path in root.iterdir()
        if path.is_dir() and not path.is_symlink()
        and path.name not in registered_ids
    )
    other_managed = _other_repo_managed_workspaces(repo, root, unregistered)
    other_ids = set(other_managed)
    unknown = [workspace_id for workspace_id in unregistered
               if workspace_id not in other_ids]
    # Preserve the existing per-sourceRepo inventory contract. Its "outside
    # this repo" count includes other valid Git authorities, not just unknowns.
    results["unregisteredDirectoryCount"] = len(unregistered)
    results["unregisteredDirectorySample"] = unregistered[:10]
    results["otherSourceRepoManagedWorkspaceCount"] = len(other_managed)
    results["otherSourceRepoManagedWorkspaceSample"] = other_managed[:10]
    results["unclassifiedDirectoryCount"] = len(unknown)
    results["unclassifiedDirectorySample"] = unknown[:10]
    results["unregisteredDirectoryTruthBoundary"] = (
        "outside this sourceRepo Git worktree inventory; other managed repos "
        "classified separately; unclassified is UNKNOWN, not proven orphan; "
        "never auto-delete"
    )
    candidates = []
    inspect_targets = []
    for path, head in worktrees:
        results["checked"] += 1
        if any(item == str(path) or item.startswith(str(path)+"/") for item in process_paths):
            skip("process_path_active");continue
        retention_ms, unintegrated_allowed = _workspace_retention(
            policy, path.name, args.min_age_hours
        )
        if retention_ms is None:
            skip("policy_pinned");continue
        # Linux ctime is only a cheap age filter. A no-Job Workspace has no
        # Job outcome to infer; Runtime OPEN record, source, outputs, and
        # native close decide the actual physical effect after this scan.
        if path.stat().st_ctime * 1000 > now - retention_ms:
            skip("directory_recently_changed");continue
        # No Job and definite failed/timed-out/cancelled Jobs should not leak
        # forever purely because "succeeded" was never written. This scan
        # never grants deletion: the Git, output, process and NativeClose gates
        # below remain mandatory. Unknown runner outcomes are still retained.
        info = recent.get(path.name, (None, None, 0))
        last_ms,resolution,nonterminal = info
        if nonterminal or (
            last_ms is None and resolution is not None
        ) or (
            last_ms is not None and (
                type(last_ms) is not int or last_ms > now - retention_ms
                or resolution not in QUIET_TERMINAL_RESOLUTIONS
            )
        ):
            skip("job_not_quiet_or_terminal_known");continue
        unintegrated = _unintegrated_head(repo, head, integration_ref)
        if unintegrated is None:
            skip("git_membership_unknown");continue
        if unintegrated and not unintegrated_allowed:
            skip("head_not_in_main");continue
        if unintegrated and resolution != "succeeded":
            # Without successful execution, even a policy allowing unmerged
            # HEAD retirement cannot assume non-successful source was delivered.
            skip("non_success_head_not_in_main");continue
        status = _git(path, "status", "--porcelain=v1", "--untracked-files=normal")
        if status.returncode or status.stdout.strip():
            skip("dirty_or_git_error");continue
        # A non-forced Git worktree removal can delete ignored files too.
        # Do not infer that generated-looking files are disposable.
        ignored = _git(
            path, "ls-files", "--others", "--ignored",
            "--exclude-standard", "--directory", "-z",
        )
        if ignored.returncode or ignored.stdout:
            skip("ignored_files_or_git_error");continue
        if getattr(args, "inspect_release_subjects", False) and len(inspect_targets) < args.limit:
            inspect_targets.append((path, head, info, retention_ms, unintegrated))
        binding = _operator_release_binding(policy, path.name)
        if binding is None or binding["latestJobActivityMs"] != last_ms:
            # Even a successful, integrated Job can belong to a paused Agent.
            # Neither elapsed time nor Job resolution proves relinquishment.
            if len(results["needsOwnerDisposition"]) < args.limit:
                results["needsOwnerDisposition"].append(path.name)
            skip("needs_owner_disposition");continue
        candidates.append((path, head, info, retention_ms, unintegrated))
    results["unregisteredDirectoryDeletionEnabled"] = False
    if not args.apply:
        # No native source digest or generation was read in dry-run mode.
        results["releaseBindingVerifiedAtNativeGet"] = False
        results["eligible"] = len(candidates)
        results["eligibleUnintegrated"] = sum(item[4] for item in candidates)
        results["candidates"] = [p.name for p,_,_,_,_ in candidates[:args.limit]]
        if getattr(args, "inspect_release_subjects", False):
            _observe_release_subjects(env, repo, policy, now, inspect_targets, results)
        return results
    client = _reclaim_client(env)
    for path, head, info, retention_ms, unintegrated in candidates[:args.limit]:
        close_requested = False
        try:
            workspace = client.call_tool("workspace.get", {"workspaceId":path.name,"schemaVersion":1})
            if not _workspace_matches_candidate(workspace, path, head, repo, info, retention_ms, now):
                skip("runtime_authority_not_eligible");continue
            digest=workspace.get("sourceStateDigest")
            if not isinstance(digest,str) or RETAINED_HEAD_REF.fullmatch(digest) is None:
                skip("missing_source_digest");continue
            # Recheck Git and never force. Runtime checks held Jobs/dependents.
            currently_unintegrated = _unintegrated_head(repo, head, integration_ref)
            if currently_unintegrated is None:
                skip("git_membership_unknown");continue
            if currently_unintegrated and not unintegrated:
                skip("git_changed_at_close");continue
            # An operator can revoke/extend retention permission while this
            # bounded sweep runs. Consume the installed file again before
            # the first irreversible preservation/close effect.
            current_policy = _retention_policy(args.policy_file)
            current_age, current_unintegrated_allowed = _workspace_retention(
                current_policy, path.name, args.min_age_hours
            )
            if (current_age is None or current_age > retention_ms
                    or (currently_unintegrated and not current_unintegrated_allowed)):
                skip("retention_policy_changed");continue
            current_binding = _operator_release_binding(current_policy, path.name)
            if current_binding is None:
                skip("owner_disposition_revoked");continue
            if not _release_matches(current_binding, workspace, info[0]):
                skip("owner_disposition_stale");continue
            current_git_status = _git(path,"status","--porcelain=v1","--untracked-files=normal")
            if current_git_status.returncode or current_git_status.stdout.strip():
                skip("git_changed_at_close");continue
            current_ignored = _git(
                path, "ls-files", "--others", "--ignored",
                "--exclude-standard", "--directory", "-z",
            )
            if current_ignored.returncode or current_ignored.stdout:
                skip("ignored_files_at_close");continue
            # A process can enter a Workspace after the initial sweep path
            # census. Refresh this bounded Linux readset before any close.
            # This remains an advisory guard: native PG/systemd owns the
            # stronger physical consumer and active-lease checks.
            if any(
                item == str(path) or item.startswith(str(path) + "/")
                for item in _active_process_paths(root)
            ):
                skip("process_path_active_at_close");continue
            # Refresh only this candidate's activity before any preservation
            # or close. A later terminal Job invalidates the old disposition
            # even after the native four-hour continuation window.
            latest = _jobs(env, path.name).get(path.name, (None, None, 0))
            if latest != info or not _release_matches(current_binding, workspace, latest[0]):
                skip("owner_disposition_stale");continue
            if (path, head) not in _worktrees(repo, root):
                skip("git_worktree_not_currently_unlocked");continue
            # An unmerged HEAD is valuable source. Preserve it in the
            # existing Git retention namespace BEFORE any native close effect.
            if currently_unintegrated:
                result = _preserve_unintegrated_head(
                    repo, path.name, head, digest
                )
                results["preserved"].append(result)
            close_requested = True
            closed = client.call_tool(
                "workspace.close",
                {"schemaVersion":1,"workspaceId":path.name,"force":False,
                 # Keep the native latest-Job activity fence even when the
                 # operator has explicitly released this sweep candidate.
                 "consumerReleased":False,
                 "expectedSourceStateDigest":digest},
            )
            if closed.get("closureDisposition") not in ("removed","already_closed"):
                raise RuntimeError("Runtime did not confirm closed disposition")
            results["closed"].append(path.name)
        except Exception as error:
            # Source preservation may have succeeded even when transport
            # fails. A post-request error cannot prove native removal did
            # NOT happen. Publish an actionable truthful receipt; never
            # blindly reissue close or announce physical deletion.
            results["errors"].append({
                "workspaceId": path.name,
                "errorType": type(error).__name__,
                "nativeCloseRequested": close_requested,
                "physicalCloseStanding": "UNKNOWN" if close_requested else "NOT_REQUESTED",
                "recoveryRequired": close_requested,
                "nextProtocolStep": (
                    "RECONCILE_NATIVE_WORKSPACE_GET_OR_CLOSED_TOMBSTONE"
                    if close_requested else "RECHECK_SOURCE_AND_POLICY"
                ),
            })
    results["eligible"] = len(candidates)
    results["eligibleUnintegrated"] = sum(item[4] for item in candidates)
    return results

def main() -> int:
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--env-file",required=True,type=Path)
    environment_mode = parser.add_mutually_exclusive_group()
    environment_mode.add_argument("--env-overlay", action="append", type=Path, default=[],
                                  help="Ordered explicit required overlays for a manual operator")
    environment_mode.add_argument("--installed-runtime-environment", action="store_true",
                                  help="Use native systemd Runtime EnvironmentFiles in exact order")
    parser.add_argument("--source-repo",required=True,type=Path)
    parser.add_argument(
        "--integration-ref",
        choices=("refs/remotes/origin/main", "refs/heads/main"),
        default="refs/remotes/origin/main",
        help="canonical Git main ref; local main only for repositories without remotes",
    )
    parser.add_argument("--workspace-root",required=True,type=Path)
    parser.add_argument("--receipt-root",required=True,type=Path)
    parser.add_argument("--lock-file",required=True,type=Path)
    parser.add_argument("--min-age-hours",type=float,default=24)
    parser.add_argument(
        "--policy-file", type=Path, default=None,
        help="Existing operator-controlled Workspace retention JSON; absent means no release grant",
    )
    parser.add_argument("--limit",type=int,default=25)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--apply", action="store_true")
    mode.add_argument("--inspect-release-subjects", action="store_true",
                      help="Read bounded native source/activity subjects without granting release")
    args=parser.parse_args()
    if not 1<=args.limit<=100:
        parser.error("limit must be 1..100")
    args.lock_file.parent.mkdir(mode=0o700,parents=True,exist_ok=True)
    with args.lock_file.open("a+") as lock:
        try:
            fcntl.flock(lock.fileno(),fcntl.LOCK_EX|fcntl.LOCK_NB)
        except BlockingIOError:
            print(json.dumps({"status":"already_running"}))
            return 0
        try:
            report=run(args)
            report.update({"schemaVersion":1,"kind":"ordivon.pg-native-workspace-reclaim",
                           "observedAtMs":int(time.time()*1000),"applied":args.apply})
            if args.apply:
                report["receipt"]=_store_receipt(args.receipt_root,report)
            print(json.dumps(report,sort_keys=True))
            return 0 if not report["errors"] else 2
        except Exception as error:
            print(json.dumps({"status":"failed","errorType":type(error).__name__,
                              "detail":str(error)[:300]}),file=sys.stderr)
            return 1

if __name__ == "__main__":
    raise SystemExit(main())
