[Unit]
Description=Ordivon Gateway stable northbound MCP adapter
After=network-online.target ordivon-runtime.service ordivon-host-v2.service
Wants=network-online.target
Requires=ordivon-runtime.service ordivon-host-v2.service

[Service]
Type=simple
DynamicUser=true
WorkingDirectory=/opt/ordivon/gateway/current
LoadCredential=linux-runtime-bearer:/etc/ordivon/runtime-mcp.token
Environment=ORDIVON_GATEWAY_TRANSPORT=streamable-http
Environment=ORDIVON_GATEWAY_HOST=127.0.0.1
Environment=ORDIVON_GATEWAY_PORT=8899
Environment=ORDIVON_GATEWAY_PATH=/mcp
Environment=ORDIVON_GATEWAY_LINUX_RUNTIME_URL=http://127.0.0.1:8897/mcp
Environment=ORDIVON_GATEWAY_LINUX_RUNTIME_BEARER_TOKEN_FILE=%d/linux-runtime-bearer
Environment=ORDIVON_GATEWAY_HOST_URL=http://127.0.0.1:8898/mcp
ExecStart=/opt/ordivon/gateway/current-env/bin/ordivon-gateway
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
