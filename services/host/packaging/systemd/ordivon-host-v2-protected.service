[Unit]
Description=Ordivon Host v2 protected candidate (loopback M2M; read-only PG)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=ordivon-host-v2-protected
Group=ordivon-host-v2-protected
DynamicUser=yes
WorkingDirectory=/opt/ordivon/host-v2/current
EnvironmentFile=/etc/ordivon/host-v2.env
Environment="PGOPTIONS=-c default_transaction_read_only=on -c statement_timeout=10000"
LoadCredentialEncrypted=host-owner-token:/etc/ordivon/host-v2-protected-owner.cred
ExecStart=/usr/bin/env -u ORDIVON_HOST_V2_PUBLIC_ORIGIN ORDIVON_HOST_V2_TRANSPORT=streamable-http ORDIVON_HOST_V2_HOST=127.0.0.1 ORDIVON_HOST_V2_PORT=19008 ORDIVON_HOST_V2_PATH=/mcp ORDIVON_HOST_V2_OWNER_BEARER_TOKEN_FILE=/run/credentials/ordivon-host-v2-protected.service/host-owner-token ORDIVON_HOST_V2_PG_POOL_MAX_SIZE=2 /opt/ordivon/host-v2/current/.venv/bin/ordivon-host-v2-mcp
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
