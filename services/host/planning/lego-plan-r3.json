  "externalOwners": [
    {
      "capability": "transactional persistence / MVCC / FK / indexing",
      "owner": "PostgreSQL"
    },
    {
      "capability": "schema evolution",
      "owner": "Alembic"
    },
    {
      "capability": "validation / JSON Schema generation",
      "owner": "Pydantic"
    },
    {
      "capability": "canonical JSON bytes",
      "owner": "RFC 8785 implementation"
    },
    {
      "capability": "MCP protocol / HTTP transport / tool discovery (tools/list)",
      "owner": "official MCP Python SDK"
    },
    {
      "capability": "Python version acquisition / environment sync",
      "owner": "uv + project .python-version / uv.lock"
    },
    {
      "capability": "service lifecycle / sandboxing",
      "owner": "systemd"
    },
    {
      "capability": "quality verification",
      "owner": "pytest + Hypothesis + Ruff + GitHub Actions"
    },
    {
      "capability": "PostgreSQL JSONB adaptation",
      "owner": "Psycopg Jsonb adapter"
    },
    {
      "capability": "Agent Tool-call lifecycle observations",
      "owner": "Harness event model"
    },
    {
      "capability": "cross-process telemetry / causal context",
      "owner": "OpenTelemetry + W3C Trace Context"
    },
    {
      "capability": "client Tool-catalog freshness",
      "owner": "MCP connector/client"
    }
  ],
  "retired": [
    "NewsPublication",
    "SyntheticTaskRouteAnchor",
    "RouteDepthAndStanding",
    "WorkStandingOntology",
    "CheckpointPatchLanguage",
    "HandoffCapsule",
    "GenericExtensionState",
    "GenericActivityLog",
    "HydratedTaskListDuplicatePath",
    "OSPathPinnedPythonInterpreter",
    "StatusInterfaceCatalog",
    "StatusDeploymentPlaceholder",
    "StatusContinuityDuplicate",
    "StatusRecentActivityProjection",
    "StatusLeasePlaceholder",
    "ManualJsonbSerialization",
    "DeadHostStatusModel"
  ],
  "nonSubstitutions": [
    {
      "candidate": "MCP Tasks extension",
      "reason": "MCP Tasks model asynchronous request execution handles; Host Tasks model cross-agent semantic continuity, so semantic substitution would collapse bounded contexts."
    }
  ],
  "nextBoundaries": [
    {
      "name": "client tool-catalog freshness",
      "targetOwner": "MCP connector/client",
      "rule": "live tools/list is authoritative; do not restore a Host surfaceVersion or parallel Tool catalog"
    },
    {
      "name": "cross-call friction telemetry",
      "targetOwner": "Harness event model + OpenTelemetry",
      "rule": "measure Agent Tool-call lifecycle outside Host persistence; Host Doctor remains Host-local invariant checking only"
    },
    {
      "name": "semantic stale/duplicate work judgement",
      "targetOwner": "Goal/domain owner",
      "rule": "Task age and Goal parallelism are observations, not automatic abandonment or duplicate-work proof"
    }
  ],
  "doNotOwn": [
    "priority",
    "assignee",
    "scheduler",
    "execution",
    "Runtime currentness",
    "Git currentness",
    "deployment control",
    "external-world truth",
    "domain completion"
  ],
  "freezeRule": {
    "default": "FROZEN",
    "evidence": "planning/host-friction-observatory-r1.json",
    "reopenOnlyFor": [
      "Host-owned durable invariant failure",
      "material re-entry cost not reducible by preserving a more specific caller-owned coordinate",
      "reproducible Host-owned stale/concurrency failure",
      "mature external owner with lower total coupling"
    ],
    "currentDisposition": "NO_KERNEL_REOPEN"
  }
}
