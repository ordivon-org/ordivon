      "name": "CheckpointHistory",
      "owner": "Host",
      "standing": "IRREDUCIBLE_SEMANTIC_RESIDUE"
    },
    {
      "id": "K03",
      "name": "MutationReplayContract",
      "owner": "Host+PostgreSQL",
      "standing": "THIN_DOMAIN_CONTRACT"
    },
    {
      "id": "C01",
      "name": "BoardJournal",
      "owner": "Host+PostgreSQL",
      "standing": "THIN_DOMAIN_CONTRACT"
    },
    {
      "id": "P01",
      "name": "AttentionDelta",
      "owner": "Host projection",
      "standing": "REPLACEABLE_PROJECTION"
    },
    {
      "id": "P02",
