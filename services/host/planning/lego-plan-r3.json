{
  "schemaVersion": 3,
  "kind": "ordivon.project-lego-plan",
  "truthRole": "source-current-owner-map-not-runtime-truth",
  "project": {
    "id": "ordivon-host-v2",
    "purpose": "Durable semantic re-entry and collaboration persistence; remember claims without promoting them into foreign truth."
  },
  "kernelLaws": [
    "Host owns Host-local identity/revision/persisted bytes, not foreign truth.",
    "Discovery and attention are projections, never priority or execution admission.",
    "Prefer external substrate owners; retain custom code only for irreducible continuity semantics."
  ],
  "retained": [
