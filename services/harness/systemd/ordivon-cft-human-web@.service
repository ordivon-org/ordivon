[Unit]
Description=Loopback noVNC for durable CfT human session slot %i
Requires=ordivon-cft-human-vnc@%i.service
After=ordivon-cft-human-vnc@%i.service
PartOf=ordivon-cft-human-session@%i.target

[Service]
Type=simple
User=ordivon
Group=ordivon
ExecStart=@WEBSOCKIFY_EXECUTABLE@ --web /opt/ordivon/external/novnc/1.7.0 --file-only 127.0.0.1:194%i 127.0.0.1:193%i
Restart=on-failure
RestartSec=1s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET
