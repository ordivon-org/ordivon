#!/usr/bin/env bash
set -euo pipefail
repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
mode=${1:-}
mise_bin=${MISE_BIN:-$(command -v mise || true)}
uv_bin=${UV_BIN:-}
env_dir=${ORDIVON_OWNER_ENV_DIR:-"$repo/.venv"}
python_bin="$env_dir/bin/python"

usage() {
  cat <<'TXT'
usage: scripts/owner-environment bootstrap|doctor|test|cold-start

bootstrap   materialize the locked Harness base + dev profile
doctor      verify installed Harness, local canonical-compatibility shim, jsonschema, and dev tooling
test        bootstrap, doctor, lint, and run the deterministic unit suite
cold-start  prove the same test profile from a fresh temporary environment
TXT
}
require_uv() {
  [[ -n "$mise_bin" && -x "$mise_bin" ]] || {
    echo 'Harness owner environment requires owner-selected mise' >&2; return 1;
  }
  local selected
  selected=$(cd "$repo" && "$mise_bin" which uv) || {
    echo 'Harness owner environment cannot resolve pinned uv' >&2; return 1;
  }
  [[ -n "$selected" && -x "$selected" ]] || {
    echo 'Harness owner environment selected uv is not executable' >&2; return 1;
  }
  if [[ -n "$uv_bin" && "$(readlink -f "$uv_bin")" != "$(readlink -f "$selected")" ]]; then
    echo 'Harness owner environment refuses non-owner UV_BIN override' >&2
    return 1
  fi
  uv_bin=$selected
}
bootstrap() {
  require_uv
  (cd "$repo" && UV_PROJECT_ENVIRONMENT="$env_dir" "$mise_bin" exec -- "$uv_bin" sync --locked --group dev --group test)
}
doctor() {
  [[ -x "$python_bin" ]] || { echo "Harness owner environment is not materialized: $python_bin" >&2; exit 1; }
  "$python_bin" - "$repo/mise.toml" "$repo/pyproject.toml" <<'PY'
import importlib.metadata as md
import sys
import tomllib
from pathlib import Path

for module in ("ordivon_harness", "anc_canonical", "jsonschema", "pytest", "ruff"):
    __import__(module)

mise = tomllib.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
project = tomllib.loads(Path(sys.argv[2]).read_text(encoding="utf-8"))
expected_python = mise["tools"]["python"]
if tuple(sys.version_info[:3]) != tuple(int(part) for part in expected_python.split(".")):
    raise SystemExit(
        f"Harness requires Python {expected_python}, got {sys.version.split()[0]}"
    )

def declared_pin(group: str, name: str) -> str:
    matches = [
        dependency.removeprefix(name + "==")
        for dependency in project["dependency-groups"][group]
        if dependency.startswith(name + "==")
    ]
    if len(matches) != 1:
        raise SystemExit(f"Harness requires exactly one pinned {name} in {group}")
    return matches[0]

for group, name in (("test", "pytest"), ("dev", "ruff")):
    if md.version(name) != declared_pin(group, name):
        label = "Ruff" if name == "ruff" else name
        raise SystemExit(f"unexpected {label} version")
print("owner environment doctor: valid profile=test")
PY
  (cd "$repo" && "$python_bin" scripts/check_dependencies.py)
}
run_tests() {
  bootstrap
  doctor
  cd "$repo"
  "$python_bin" -m ruff check src tests scripts
  "$python_bin" -W error::ResourceWarning -m pytest -q tests
}
case "$mode" in
  bootstrap) bootstrap ;;
  doctor) doctor ;;
  test) run_tests ;;
  cold-start)
    tmp=$(mktemp -d -t ordivon-harness-owner-env-XXXXXX)
    trap 'rm -rf "$tmp"' EXIT
    ORDIVON_OWNER_ENV_DIR="$tmp/.venv" "$0" test
    ;;
  --help|-h) usage ;;
  *) usage >&2; exit 2 ;;
esac
