{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.dev/profiles/research/mechanical-components/research-mechanical-component-r1.schema.json",
  "title": "Research Mechanical Component R1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "componentKind",
    "schemaVersion",
    "componentId",
    "mechanicalKind",
    "ownerRef",
    "truthRole",
    "inputRefs",
    "outputRefs",
    "nonClaims"
  ],
  "properties": {
    "componentKind": {
      "const": "research-mechanical-component"
    },
    "schemaVersion": {
      "const": "r1"
    },
    "componentId": {
      "type": "string",
      "minLength": 1
    },
    "mechanicalKind": {
      "enum": [
        "Probe",
        "Normalize",
        "Extract",
        "Verify",
        "Compare",
        "Package",
        "Effect Adapter"
      ]
    },
    "ownerRef": {
      "type": "string",
      "minLength": 1
    },
    "truthRole": {
      "const": "static-mechanical-definition"
    },
    "implementationRef": {
      "type": "string",
      "minLength": 1
    },
    "inputRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "outputRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "dependencyRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "verifierRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "effectAuthorizationOwnerRef": {
      "type": "string",
      "minLength": 1
    },
    "replaySemantics": {
      "type": "string",
      "minLength": 1
    },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mechanicalKind": {
            "const": "Effect Adapter"
          }
        },
        "required": [
          "mechanicalKind"
        ]
      },
      "then": {
        "required": [
          "effectAuthorizationOwnerRef",
          "replaySemantics"
        ]
      }
    }
  ]
}
