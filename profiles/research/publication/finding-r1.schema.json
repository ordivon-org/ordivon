{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.local/schemas/research/publication/finding-r1.schema.json",
  "title": "Publication Perceptual Finding R1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "predicate", "severity"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "page": {"type": "integer", "minimum": 1},
    "region": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 4,
      "maxItems": 4
    },
    "objectType": {"type": "string"},
    "predicate": {"type": "string", "minLength": 1},
    "severity": {
      "enum": ["BLOCKER", "MAJOR", "MINOR", "INFO", "UNCERTAIN"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "object"},
    "expected": {},
    "observed": {},
    "remediationClass": {"type": "string"}
  }
}
