{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ordivon:research:scholarly-intelligence-profile:v1",
  "title": "Ordivon Scholarly Intelligence Profile v1",
  "description": "Non-authoritative projection over Study-owned scholarly state. Object semantics and verdicts remain with their natural owners.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "truthRole",
    "profileId",
    "studyAuthority",
    "standardNativeBinding",
    "semanticRefs",
    "stateAxes",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "ordivon.research.scholarly-intelligence-profile" },
    "truthRole": { "const": "non-authoritative-study-projection" },
    "profileId": { "type": "string", "minLength": 1 },
    "studyAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "sourceRepo", "sourceRevision"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "sourceRepo": { "type": "string", "minLength": 1 },
        "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "subjectRef": { "type": ["string", "null"] }
      }
    },
    "standardNativeBinding": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["sourcePath", "sourceDigest", "caseId"],
      "properties": {
        "sourcePath": { "type": "string", "minLength": 1 },
        "sourceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "caseId": { "type": "string", "minLength": 1 }
      }
    },
    "semanticRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "claims", "evidence", "concerns", "resolutions"],
      "properties": {
        "requirements": { "$ref": "#/$defs/refList" },
        "claims": { "$ref": "#/$defs/refList" },
        "evidence": { "$ref": "#/$defs/refList" },
        "concerns": { "$ref": "#/$defs/refList" },
        "resolutions": { "$ref": "#/$defs/refList" }
      }
    },
    "stateAxes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements",
        "evidence",
        "inference",
        "claims",
        "argument",
        "venue",
        "review",
        "publication",
        "learning"
      ],
      "properties": {
        "requirements": { "$ref": "#/$defs/stateAxis" },
        "evidence": { "$ref": "#/$defs/stateAxis" },
        "inference": { "$ref": "#/$defs/stateAxis" },
        "claims": { "$ref": "#/$defs/stateAxis" },
        "argument": { "$ref": "#/$defs/stateAxis" },
        "venue": { "$ref": "#/$defs/stateAxis" },
        "review": { "$ref": "#/$defs/stateAxis" },
        "publication": { "$ref": "#/$defs/stateAxis" },
        "learning": { "$ref": "#/$defs/stateAxis" }
      }
    },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "opaqueRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "id"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "location": { "type": ["string", "null"] },
        "digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "refList": {
      "type": "array",
      "items": { "$ref": "#/$defs/opaqueRef" }
    },
    "stateAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "state", "evidenceRefs"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
