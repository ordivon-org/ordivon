{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ordivon:schema:experimental-evaluation-record:r1",
  "title": "Ordivon Experimental Evaluation Record R1",
  "description": "Append-only derived evaluation claim over exact experimental Episode/Fork bindings. It records the metric, inputs, provider, claim evidence level and uncertainty without modifying any owner-native truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "evaluationId", "experimentId", "metricSpec", "subjects", "value", "claimEvidenceLevel", "evidenceInputs", "providerBinding", "limitations", "nonClaims", "recordDigest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "ordivon.experimental-evaluation-record"},
    "evaluationId": {"type": "string", "minLength": 1, "maxLength": 512},
    "experimentId": {"type": "string", "minLength": 1, "maxLength": 512},
    "metricSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metricId", "specDigest"],
      "properties": {
        "metricId": {"type": "string", "minLength": 1, "maxLength": 512},
        "specDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["episodeId", "projectionDigest"],
        "properties": {
          "episodeId": {"type": "string", "minLength": 1, "maxLength": 512},
          "projectionDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "forkRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["forkId", "manifestDigest"],
        "properties": {
          "forkId": {"type": "string", "minLength": 1, "maxLength": 512},
          "manifestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "assessmentDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "value": {},
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": {"type": "string", "minLength": 1, "maxLength": 512},
        "level": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "lower": {"type": "number"},
        "upper": {"type": "number"},
        "sampleSize": {"type": "integer", "minimum": 1},
        "details": {"type": "string", "minLength": 1}
      }
    },
    "claimEvidenceLevel": {"enum": ["owner-ground-truth", "deterministic-observation", "deterministic-derived", "statistical-inference", "semantic-inference", "latent-intent"]},
    "evidenceInputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceLevel", "binding"],
        "properties": {
          "evidenceLevel": {"enum": ["owner-ground-truth", "deterministic-observation", "deterministic-derived", "statistical-inference", "semantic-inference", "latent-intent"]},
          "binding": {"$ref": "#/$defs/bindingRef"}
        }
      }
    },
    "providerBinding": {"$ref": "#/$defs/bindingRef"},
    "computedAt": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "nonClaims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "recordDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "bindingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerId", "objectKind", "objectId", "digest"],
      "properties": {
        "ownerId": {"type": "string", "minLength": 1, "maxLength": 512},
        "objectKind": {"type": "string", "minLength": 1, "maxLength": 512},
        "objectId": {"type": "string", "minLength": 1, "maxLength": 512},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
