{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ordivon:schema:experimental-metric-spec:r1",
  "title": "Ordivon Experimental Metric Spec R1",
  "description": "Study-owned metric definition that classifies what is measured, the unit that is measured, the independent replication unit, and the minimum input evidence class required. It does not alter owner truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "metricId", "metricClass", "construct", "computationMode", "evidenceMinimum", "valueShape", "unitOfAnalysis", "replicationUnit", "aggregationPolicy", "missingDataPolicy", "ownerInputs", "knownLimitations", "nonClaims", "specDigest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "ordivon.experimental-metric-spec"},
    "metricId": {"type": "string", "minLength": 1, "maxLength": 512},
    "metricClass": {"enum": ["outcome", "process", "behavior", "robustness"]},
    "construct": {"type": "string", "minLength": 1},
    "computationMode": {"enum": ["deterministic", "statistical", "causal", "semantic-judge", "human", "hybrid"]},
    "evidenceMinimum": {"enum": ["owner-ground-truth", "deterministic-observation", "deterministic-derived", "statistical-inference", "semantic-inference", "latent-intent"]},
    "valueShape": {"enum": ["binary", "scalar", "categorical", "distribution", "structured"]},
    "unitOfAnalysis": {"type": "string", "minLength": 1, "maxLength": 512},
    "replicationUnit": {"type": "string", "minLength": 1, "maxLength": 512},
    "aggregationPolicy": {"type": "string", "minLength": 1},
    "missingDataPolicy": {"enum": ["fail-closed", "explicit-null", "exclude-with-reason", "model-based"]},
    "ownerInputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bindingRef"}},
    "knownLimitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "nonClaims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "specDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "bindingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerId", "objectKind", "objectId", "digest"],
      "properties": {
        "ownerId": {"type": "string", "minLength": 1, "maxLength": 512},
        "objectKind": {"type": "string", "minLength": 1, "maxLength": 512},
        "objectId": {"type": "string", "minLength": 1, "maxLength": 512},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
