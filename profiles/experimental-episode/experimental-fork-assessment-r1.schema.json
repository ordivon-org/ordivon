{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ordivon:schema:experimental-fork-assessment:r1",
  "title": "Ordivon Experimental Fork Assessment R1",
  "description": "Derived assessment comparing a declared fork manifest with observed owner-bound bindings. It may mark contamination but cannot modify owner truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "forkId", "manifestDigest", "standing", "observedFrozenBindings", "observedChangedBindings", "undeclaredDifferences", "nonClaims", "assessmentDigest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "ordivon.experimental-fork-assessment"},
    "forkId": {"type": "string", "minLength": 1, "maxLength": 512},
    "manifestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "standing": {"enum": ["PASS_DECLARED_DIFFERENCE", "CONTAMINATED", "NON_REPRODUCIBLE", "NOT_ASSESSED"]},
    "observedFrozenBindings": {"type": "array", "items": {"$ref": "#/$defs/namedBinding"}},
    "observedChangedBindings": {"type": "array", "items": {"$ref": "#/$defs/difference"}},
    "undeclaredDifferences": {"type": "array", "items": {"$ref": "#/$defs/difference"}},
    "nonClaims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "assessmentDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "bindingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerId", "objectKind", "objectId", "digest"],
      "properties": {
        "ownerId": {"type": "string", "minLength": 1, "maxLength": 512},
        "objectKind": {"type": "string", "minLength": 1, "maxLength": 512},
        "objectId": {"type": "string", "minLength": 1, "maxLength": 512},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "namedBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "binding"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 512},
        "binding": {"$ref": "#/$defs/bindingRef"}
      }
    },
    "difference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "beforeDigest", "afterDigest"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 512},
        "beforeDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "afterDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
