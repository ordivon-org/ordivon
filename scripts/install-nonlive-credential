#!/usr/bin/env python3
from __future__ import annotations
import getpass,json,os,sys
from pathlib import Path

ROOT=Path('/root/.config/ordivon/secrets')

def secret(label:str)->str:
    value=getpass.getpass(label+': ').strip()
    if not value or '\n' in value or '\r' in value:
        raise ValueError(f'invalid {label}')
    return value

def atomic_write(path:Path, content:str)->None:
    path.parent.mkdir(parents=True,exist_ok=True,mode=0o700)
    os.chmod(path.parent,0o700)
    tmp=path.with_name(path.name+'.tmp')
    fd=os.open(tmp,os.O_WRONLY|os.O_CREAT|os.O_TRUNC,0o600)
    try:
        with os.fdopen(fd,'w',encoding='utf-8') as f:
            f.write(content); f.flush(); os.fsync(f.fileno())
        os.replace(tmp,path); os.chmod(path,0o600)
    finally:
        if tmp.exists(): tmp.unlink()

def okx_demo()->None:
    api=secret('OKX Demo API Key')
    sec=secret('OKX Demo Secret Key')
    phrase=secret('OKX Demo Passphrase')
    p=ROOT/'okx/demo/config.toml'
    content=(
      'default_profile = "okx-demo"\n\n'
      '[profiles."okx-demo"]\n'
      f'api_key = {json.dumps(api)}\n'
      f'secret_key = {json.dumps(sec)}\n'
      f'passphrase = {json.dumps(phrase)}\n'
      'demo = true\n'
      'site = "global"\n'
      'timeout_ms = 15000\n'
    )
    atomic_write(p,content)
    print(f'Installed OKX Demo credential at {p} (0600); values were not echoed.')

def binance_testnet()->None:
    api=secret('Binance Spot Testnet server-issued API Key')
    p=ROOT/'binance/testnet/api_key'
    key=ROOT/'binance/testnet/private.pem'
    pub=ROOT/'binance/testnet/public.pem'
    if not key.is_file() or not pub.is_file():
        raise RuntimeError('local Binance Testnet Ed25519 keypair is missing')
    atomic_write(p,api+'\n')
    print(f'Installed Binance Spot Testnet API key at {p} (0600); private key remains local.')

if __name__=='__main__':
    if len(sys.argv)!=2 or sys.argv[1] not in {'okx-demo','binance-testnet'}:
        print('usage: install-nonlive-credential {okx-demo|binance-testnet}',file=sys.stderr); raise SystemExit(2)
    try:
        {'okx-demo':okx_demo,'binance-testnet':binance_testnet}[sys.argv[1]]()
    except (EOFError,KeyboardInterrupt):
        print('\ncancelled',file=sys.stderr); raise SystemExit(130)
    except Exception as e:
        print(f'failed: {e}',file=sys.stderr); raise SystemExit(1)
