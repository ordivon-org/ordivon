#!/usr/bin/env bash
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
"$repo/scripts/check-language-baseline" >/dev/null
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
PYTHONPATH="$repo/src" DB="$tmp/nonlive-accounting.sqlite3" \
  "$repo/.venv/bin/python" - <<'PY'
import json
import os
from pathlib import Path

from ordivon_capital.accounting.durable import (
    CapitalAccountNamespace,
    CapitalAccountRole,
    DurableReservationHistory,
    LedgerReconciliationStanding,
    LedgerTransferObservation,
    ReservationStanding,
    binding_for_namespace,
    reconcile_durable_history,
)
from ordivon_capital.accounting.sqlite_ledger import LedgerApplyStatus, SQLiteAccountingLedger
from ordivon_capital.accounting.substrate import (
    AccountingAccount,
    AccountingOperation,
    reservation_instruction,
    resolution_instruction,
    stable_accounting_id,
)

expected={
    "FILL":"POST_PENDING_TRANSFER",
    "PARTIAL_FILL_SLICES":"POST_PENDING_TRANSFER",
    "CANCEL":"VOID_PENDING_TRANSFER",
    "DENY":"VOID_PENDING_TRANSFER",
    "UNKNOWN_AFTER_SUBMISSION":"NO_MUTATION",
}
path=Path(os.environ["DB"])
fund=AccountingAccount(stable_accounting_id("ordivon-capital:nonlive-effect","funding"))
namespaces={}
bindings={}

with SQLiteAccountingLedger(path) as ledger:
    assert ledger.create_account(fund) is LedgerApplyStatus.CREATED
    for scenario in expected:
        ns=CapitalAccountNamespace("owner:qualification",f"parcel:nonlive:{scenario.lower()}")
        namespaces[scenario]=ns
        assert ledger.create_account(ns.account(CapitalAccountRole.AVAILABLE)) is LedgerApplyStatus.CREATED
        assert ledger.create_account(ns.account(CapitalAccountRole.ENCUMBRANCE)) is LedgerApplyStatus.CREATED
        assert ledger.apply_immediate_transfer(
            transfer_id=stable_accounting_id("ordivon-capital:nonlive-effect:fund",scenario),
            debit_account_id=fund.account_id,
            credit_account_id=ns.available_account_id,
            amount=100,
        ) is LedgerApplyStatus.CREATED
        binding=binding_for_namespace(
            namespace=ns,
            reservation_ref=f"reservation:nonlive:{scenario.lower()}",
            amount=100,
        )
        bindings[scenario]=binding
        assert ledger.apply_instruction(reservation_instruction(binding)) is LedgerApplyStatus.CREATED

    for scenario,resolution_name in expected.items():
        if resolution_name=="NO_MUTATION":
            continue
        operation=AccountingOperation(resolution_name)
        instruction=resolution_instruction(
            binding=bindings[scenario],
            operation=operation,
            resolution_ref=f"effect:nonlive:{scenario.lower()}",
        )
        assert instruction is not None
        assert ledger.apply_instruction(instruction) is LedgerApplyStatus.CREATED

# Reopen the same SQLite database and reconcile exact durable state.
results={}
with SQLiteAccountingLedger(path) as ledger:
    for scenario,resolution_name in expected.items():
        ns=namespaces[scenario]
        binding=bindings[scenario]
        p=ledger.transfer(binding.pending_transfer_id)
        assert p is not None
        pending=LedgerTransferObservation(
            transfer_id=p.transfer_id,
            operation=AccountingOperation.PENDING,
            amount=p.amount,
            pending_id=0,
        )
        if resolution_name=="NO_MUTATION":
            history=DurableReservationHistory(binding,ReservationStanding.RESERVED)
            resolution=None
            operation=None
        else:
            operation=AccountingOperation(resolution_name)
            resolution_ref=f"effect:nonlive:{scenario.lower()}"
            instruction=resolution_instruction(
                binding=binding,
                operation=operation,
                resolution_ref=resolution_ref,
            )
            assert instruction is not None
            r=ledger.transfer(instruction.transfer_id)
            assert r is not None
            resolution=LedgerTransferObservation(
                transfer_id=r.transfer_id,
                operation=operation,
                amount=r.amount,
                pending_id=r.pending_id,
            )
            standing=(
                ReservationStanding.CONSUMED
                if operation is AccountingOperation.POST_PENDING_TRANSFER
                else ReservationStanding.RELEASED
            )
            history=DurableReservationHistory(binding,standing,resolution_ref)

        rec=reconcile_durable_history(
            history=history,
            pending=pending,
            resolution=resolution,
        )
        assert rec.standing is LedgerReconciliationStanding.MATCH
        available=ledger.account(ns.available_account_id)
        enc=ledger.account(ns.encumbrance_account_id)
        if operation is AccountingOperation.POST_PENDING_TRANSFER:
            assert available.debits_posted==100 and available.debits_pending==0
            assert enc.credits_posted==100 and enc.credits_pending==0
        elif operation is AccountingOperation.VOID_PENDING_TRANSFER:
            assert available.debits_posted==0 and available.debits_pending==0
            assert enc.credits_posted==0 and enc.credits_pending==0
        else:
            assert available.debits_posted==0 and available.debits_pending==100
            assert enc.credits_posted==0 and enc.credits_pending==100

        results[scenario]={
            "reservationResolution":resolution_name,
            "reservationStanding":history.standing.value,
            "ledgerReconciliation":rec.standing.value,
            "ledgerRepairAllowed":rec.ledger_repair_allowed,
            "debitsPosted":available.debits_posted,
            "debitsPending":available.debits_pending,
            "creditsPosted":enc.credits_posted,
            "creditsPending":enc.credits_pending,
        }

    fill_binding=bindings["FILL"]
    replay=resolution_instruction(
        binding=fill_binding,
        operation=AccountingOperation.POST_PENDING_TRANSFER,
        resolution_ref="effect:nonlive:fill",
    )
    assert replay is not None
    replay_status=ledger.apply_instruction(replay)
    assert replay_status is LedgerApplyStatus.EXISTS

print(json.dumps({
    "schemaVersion":2,
    "kind":"ordivon.capital.trading.nonlive-capital-effect-matrix",
    "standing":"PASS_NONLIVE_EFFECT_TO_CAPITAL_RESTART_MATRIX",
    "sourceEffectContract":"CURRENT_RECONCILIATION_DISPOSITION_CONTRACT",
    "accountingProvider":"SQLite",
    "sqliteVersion":"3.53.1",
    "python":"3.14.7",
    "restartCount":1,
    "scenarios":results,
    "exactConsumeReplayStatus":replay_status.value,
    "localAccountingMutationAttempted":True,
    "externalFinancialWriteAttempted":False,
    "realMoney":False,
    "liveEndpoint":False,
},sort_keys=True))
PY
