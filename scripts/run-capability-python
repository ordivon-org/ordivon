#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mise_bin="${ORDIVON_CAPITAL_MISE:-$(command -v mise || true)}"
python_bin="$root/.venv/bin/python"

if [[ -z "$mise_bin" || ! -x "$mise_bin" ]]; then
  echo "mise unavailable; Ordivon Capital toolchain authority requires mise" >&2
  exit 2
fi

cd "$root"
"$mise_bin" exec -- uv sync --frozen --group research --group test >/dev/null
"$root/scripts/check-language-baseline" >/dev/null
export PYTHONPATH="$root/src${PYTHONPATH:+:$PYTHONPATH}"

if [[ ! -x "$python_bin" ]]; then
  echo "Ordivon Capital Python environment unavailable after uv sync: $python_bin" >&2
  exit 3
fi

exec "$python_bin" "$@"
