#!/usr/bin/env bash
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
python3 - "$repo/config/private_reality_policy.json" <<'PY'
from pathlib import Path
import json,sys
x=json.load(open(sys.argv[1]))
assert x['standing']=='CREDENTIALS_LOCATED_PENDING_FRESH_PERMISSION_VERIFICATION'
okx=Path(x['credentialBindings']['OKX']['binding'])
binance=Path(x['credentialBindings']['BINANCE']['binding'])
executor=Path(x['credentialBindings']['BINANCE']['executorBindingExplicitlyExcluded'])
assert okx.is_file() and (okx.stat().st_mode & 0o077)==0
assert binance.is_dir() and executor.is_dir()
for name in ('api_key','private.pem','public.pem'):
 p=binance/name
 assert p.is_file() and (p.stat().st_mode & 0o077)==0
print(json.dumps({
 'standing':x['standing'],
 'okxObserverBindingPresent':True,
 'binanceObserverBindingPresent':True,
 'binanceExecutorExcluded':True,
 'secretBytesRead':False,
 'privateAccountDataAllowed':x['privateAccountDataAllowed'],
 'externalFinancialWritesAllowed':x['externalFinancialWritesAllowed'],
},sort_keys=True))
PY
