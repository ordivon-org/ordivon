#!/usr/bin/env bash
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
out="$repo/.artifacts/crypto-public-shadow-r1"
mkdir -p "$out"
"$repo/scripts/check-capital-authority" --mode non-live >/dev/null
"$repo/scripts/check-nautilus-candidate" >/dev/null
"$repo/scripts/check-crypto-execution-lane" >/dev/null

/root/tools/bin/surfpath discover \
  --nodes sg-sng \
  --protocols openvpn-tcp \
  --target okx=https://www.okx.com \
  --target binance=https://api.binance.com \
  --compact --store-only >"$out/discovery.json"

readarray -t bind < <(python3 - "$out/discovery.json" <<'PY'
import json,sys
x=json.load(open(sys.argv[1]))
if set(x.get('requiredTargets',[])) != {'okx','binance'}: raise SystemExit('dual venue discovery did not qualify both targets')
print(x['observationDigest'])
print(x['recommendedPathDigest'])
PY
)
obs="${bind[0]}"
path="${bind[1]}"
/root/tools/bin/surfpath run --expect "$obs" --path "$path" -- \
  "$repo/scripts/capture-crypto-public-rest" "$out/raw-capture.json" >/dev/null

PYTHONPATH="$repo/src" python3 -m market_capital.crypto_public_shadow \
  --capture "$out/raw-capture.json" \
  --discovery "$out/discovery.json" \
  --output "$out/observation.json"
