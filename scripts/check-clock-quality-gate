#!/usr/bin/env bash
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
python3 - "$repo/config/clock_quality_gate.json" "$repo" <<'PY'
import json,sys
from pathlib import Path
cfg_path=Path(sys.argv[1]); repo=Path(sys.argv[2])
cfg=json.loads(cfg_path.read_text())
ev_path=repo/cfg['latestEvidence']
ev=json.loads(ev_path.read_text())
assert cfg['standing']=='BLOCK_PRIVATE_EXECUTION'
assert cfg['privateExecutionMaxAbsOffsetMs']==1000
assert cfg['wslIndependentNtpDaemonAllowed'] is False
assert cfg['applicationClockForgeryAllowed'] is False
assert ev['standing']=='FAIL_PRIVATE_EXECUTION_CLOCK_GATE'
assert ev['multiSourceAgreement'] is True
assert ev['observedAbsOffsetMsMax'] > cfg['privateExecutionMaxAbsOffsetMs']
assert ev['consequence']['demoExecutionAdmission'] is False
assert ev['consequence']['liveExecutionAdmission'] is False
print(json.dumps({
  'standing':'CLOCK_GATE_BLOCKING_PRIVATE_EXECUTION',
  'evidence':cfg['latestEvidence'],
  'observedAbsOffsetMsMax':ev['observedAbsOffsetMsMax'],
  'direction':ev.get('direction'),
  'directionStableAcrossAudits':ev.get('directionStableAcrossAudits'),
  'adminRemediationRequired':ev.get('rootCause',{}).get('adminRemediationRequired',False),
  'limitMs':cfg['privateExecutionMaxAbsOffsetMs'],
  'publicShadowAllowed':True,
  'privateExecutionAllowed':False,
  'wslNtpDaemonAllowed':False
},sort_keys=True))
PY
