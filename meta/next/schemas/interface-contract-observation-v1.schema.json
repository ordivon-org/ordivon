{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ordivon:schema:interface-contract-observation:v1",
  "title": "Interface Contract Observation v1",
  "description": "An immutable task-local observation of one owner/client interface surface. It is bound to one exact Cognitive Circuit and records what was observed and where; it does not create interface authority, durable freshness, compatibility, or domain success by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "observationId",
    "circuitRef",
    "producerOwnerId",
    "sourceKind",
    "sourceRef",
    "sourceDigest",
    "interfaceRef",
    "projectedAuthorityVersionRef",
    "liveAuthorityVersionRef",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "ordivon.interface-contract-observation" },
    "observationId": { "$ref": "#/$defs/identifier" },
    "circuitRef": { "$ref": "#/$defs/boundRef" },
    "producerOwnerId": { "$ref": "#/$defs/identifier" },
    "sourceKind": {
      "enum": [
        "direct-owner-observation",
        "client-effective-surface",
        "retained-projection"
      ]
    },
    "sourceRef": { "$ref": "#/$defs/identifier" },
    "sourceDigest": { "$ref": "#/$defs/sha256" },
    "interfaceRef": { "$ref": "#/$defs/boundRef" },
    "projectedAuthorityVersionRef": {
      "anyOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "liveAuthorityVersionRef": {
      "anyOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sourceKind": { "const": "retained-projection" }
        }
      },
      "then": {
        "properties": {
          "projectedAuthorityVersionRef": { "$ref": "#/$defs/sha256" }
        }
      },
      "else": {
        "properties": {
          "projectedAuthorityVersionRef": { "type": "null" },
          "liveAuthorityVersionRef": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "boundRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
