{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.local/schemas/project-lego-plan-r1.schema.json",
  "title": "Ordivon Project LEGO Plan R1",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "truthRole",
    "project",
    "nodes",
    "edges",
    "slices",
    "gaps",
    "doNotOwn",
    "review"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "ordivon.project-lego-plan"
    },
    "truthRole": {
      "const": "planning-projection-not-project-truth"
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "purpose",
        "sourceEvidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "sourceEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "sharedCatalog": {
      "type": "object",
      "properties": {
        "catalogId": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "kind",
          "responsibility",
          "authority",
          "state",
          "sharedRefs",
          "evidence",
          "mustNotOwn",
          "acceptance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "DISCOVERED",
              "DESIGNED",
              "IMPLEMENTING",
              "IMPLEMENTED",
              "VERIFIED",
              "DEFERRED",
              "REJECTED"
            ]
          },
          "sharedRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^L[0-9]{2}$"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "replacementContract": {
            "type": "string"
          },
          "mustNotOwn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "nextAction": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "type",
          "label"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "slices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "objective",
          "status",
          "nodeIds",
          "acceptance",
          "evidence",
          "blockers"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PROPOSED",
              "ACTIVE",
              "BLOCKED",
              "COMPLETE",
              "DEFERRED"
            ]
          },
          "nodeIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "nextAction": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "doNotOwn": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review": {
      "type": "object",
      "required": [
        "sourceRevision",
        "updatedAt",
        "standing"
      ],
      "properties": {
        "sourceRevision": {
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "type": "string",
          "minLength": 1
        },
        "standing": {
          "enum": [
            "INITIAL",
            "ACTIVE",
            "STABLE",
            "DEFERRED"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
