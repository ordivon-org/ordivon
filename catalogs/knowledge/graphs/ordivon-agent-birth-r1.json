  "notPrimarily": "a browser script, a generic workflow engine, an Agent semantic registry, or a model loop",
  "oneSentence": "Agent Birth deterministically compiles one campaign role into one stable provider-effect identity, durably fences that identity before any non-idempotent SEND, uses Temporal to orchestrate execution and recovery, and binds observed provider conversation evidence back to that same identity without blind resend.",
  "schemaVersion": 1,
  "stateMachine": {
    "birthEffectStanding": [
      "UNRECORDED",
      "PREPARED",
      "UNKNOWN",
      "PRE_EFFECT_FAILED",
      "HUMAN_REQUIRED",
      "SUBMIT_OBSERVED",
      "BOUND",
      "READY_CONFIRMED"
    ],
    "providerBoundaryRoutingRules": [
      "carrier/transport-local pre-SEND unavailability may fail over to the next deterministic carrier candidate",
      "READY preserves the selected carrier and may continue materialization",
      "CHALLENGE_GATED, AUTH_REQUIRED, and PROVIDER_RATE_LIMITED do not authorize carrier rotation or infrastructure mutation",
      "CHALLENGE_GATED and AUTH_REQUIRED remain eligible for the existing bounded human-verification handoff",
      "provider-boundary observations alone forbid automatic carrier restart, profile clearing, launcher mutation, and network-authority mutation",
      "browser-security-r9 constrains repair policy as a reference-only knowledge artifact and is not a live preflight assertion"
    ],
    "providerBoundaryStanding": [
      "CARRIER_PRE_EFFECT_UNAVAILABLE",
      "PROVIDER_ADMISSIBLE",
      "SUBSTRATE_HEALTHY_PROVIDER_NOT_ADMISSIBLE",
      "PROVIDER_NOT_ADMISSIBLE_SUBSTRATE_UNKNOWN",
      "PROVIDER_NOT_ADMISSIBLE_SUBSTRATE_UNHEALTHY",
      "PROVIDER_UI_OR_CONTROL_UNRESOLVED",
      "PREFLIGHT_UNRESOLVED"
    ],
    "safeRetryRules": [
      "PRE_EFFECT_FAILED may explicitly re-enter the same effectId because SEND is proven not crossed",
      "HUMAN_REQUIRED may re-enter only through human-resume after the handoff/liveness contract",
      "UNKNOWN and SUBMIT_OBSERVED may reconcile only; blind resend is forbidden",
      "BOUND and READY_CONFIRMED are terminal immutable provider-effect standings"
    ]
  },
