[Unit]
Description=Ordivon Agent workstation recovery snapshot
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecCondition=/usr/bin/mountpoint -q /mnt/d
ExecStart=/opt/ordivon-workstation-recovery/current/bin/workstation-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
