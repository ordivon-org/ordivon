{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["base_currency", "investment_horizon", "objective", "allowed_instruments", "allow_short", "max_position_weight", "min_cash_weight", "max_gross_exposure", "construction_method"],
  "properties": {
    "base_currency": {"type": "string", "minLength": 3, "maxLength": 3},
    "investment_horizon": {"type": "string"},
    "objective": {"type": "string"},
    "allowed_instruments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "allow_short": {"type": "boolean"},
    "max_position_weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "min_cash_weight": {"type": "number", "minimum": 0, "maximum": 1},
    "max_gross_exposure": {"type": "number", "exclusiveMinimum": 0},
    "construction_method": {"enum": ["equal_weight_validation"]}
  },
  "additionalProperties": false
}
