{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["method", "base_currency", "positions", "cash_weight", "gross_exposure", "inputs"],
  "properties": {
    "method": {"enum": ["equal_weight_validation", "equal_weight_validation_research_gated"]},
    "base_currency": {"type": "string"},
    "positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["symbol", "lei", "target_weight"],
        "properties": {
          "symbol": {"type": "string"},
          "lei": {"type": "string"},
          "target_weight": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "cash_weight": {"type": "number", "minimum": 0, "maximum": 1},
    "gross_exposure": {"type": "number", "minimum": 0},
    "inputs": {"type": "object"}
  },
  "additionalProperties": false
}
