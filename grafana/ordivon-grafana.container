[Unit]
Description=Ordivon Operations Grafana visualization
Wants=prometheus.service loki.service
After=prometheus.service loki.service network-online.target

[Container]
Image=docker.io/grafana/grafana@sha256:1dec240d14e232597dce9bfa56dae55f4397b138cdc91e3ee92ac6b157e2fc49
ContainerName=ordivon-grafana
Pull=never
Network=host
User=472
Group=0
Volume=/var/lib/ordivon-operations/grafana:/var/lib/grafana
Volume=/etc/ordivon-grafana/provisioning:/etc/grafana/provisioning:ro
EnvironmentFile=/etc/ordivon-grafana/grafana.env
ReadOnly=true
ReadOnlyTmpfs=true
Tmpfs=/tmp:rw,mode=1777
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=on-failure
RestartSec=3s
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
