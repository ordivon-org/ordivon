{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.invalid/distribution-preflight.schema.json",
  "title": "Distribution local preflight profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "target", "entrypoint", "launch", "steam", "policy"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "distribution-local-preflight-profile"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "packageModel"],
      "properties": {
        "os": {"const": "linux"},
        "architecture": {"const": "x86_64"},
        "packageModel": {"const": "directory"}
      }
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["args", "successMarker"],
      "properties": {
        "args": {"type": "array", "items": {"type": "string"}, "maxItems": 32},
        "successMarker": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "steam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appIdToken", "depotIdToken", "description", "mapping", "exclusions"],
      "properties": {
        "appIdToken": {"type": "string", "minLength": 1},
        "depotIdToken": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1, "maxLength": 256},
        "mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": ["localPath", "depotPath", "recursive"],
          "properties": {
            "localPath": {"const": "*"},
            "depotPath": {"const": "."},
            "recursive": {"const": true}
          }
        },
        "exclusions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forbiddenPaths"],
      "properties": {
        "forbiddenPaths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  }
}
