{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.local/schemas/presentation-semantic-svg-source-v1.json",
  "title": "Presentation Semantic SVG Source v1",
  "description": "Presentation-specific source package for an external SVG-to-native-PowerPoint authoring provider. It binds exact semantic SVG pages and supporting material bytes without defining a universal scene or document AST.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "presentationId", "profileId", "locale", "transition", "nativeChartsAndTables", "pages"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "presentation-semantic-svg-source"},
    "presentationId": {"type": "string", "minLength": 1},
    "profileId": {"type": "string", "minLength": 1},
    "locale": {"type": "string", "minLength": 2},
    "transition": {"const": "none", "description": "R1 keeps transition emission disabled because Artifact's strict OpenXML gate remains authoritative."},
    "nativeChartsAndTables": {"type": "boolean"},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/pageRef"}
    },
    "materials": {
      "type": "array",
      "items": {"$ref": "#/$defs/materialRef"},
      "uniqueItems": true
    },
    "notes": {"type": "string"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safeRelativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "pageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "materialRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "projectRelativePath"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "projectRelativePath": {"$ref": "#/$defs/safeRelativePath"},
        "purpose": {"type": "string"}
      }
    }
  }
}
