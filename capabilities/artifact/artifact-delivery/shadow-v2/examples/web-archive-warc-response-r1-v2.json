        "WARC-Block-Digest"
      ],
      "revisitRecords": false,
      "standard": "ISO 28500:2017 WARC",
      "warcVersion": "WARC/1.1",
      "warcinfoRecords": false
    }
  },
  "profileVersion": 2,
  "requiredEvidence": {
    "contractSchema": {
      "claim": "web-archive object contract validates",
      "required": true
    },
    "jsRecordView": {
      "claim": "warcio.js independently exposes the same response facts and payload bytes",
      "required": true
    },
    "payloadIdentity": {
      "claim": "both parser views produce the exact contract payload SHA-256",
      "required": true
    },
    "pythonRecordView": {
      "claim": "warcio Python parser exposes exactly one WARC/1.1 response matching capture facts",
      "required": true
    },
    "warcIntegrity": {
      "claim": "warcio digest checker accepts the exact WARC",
      "required": true
    }
  },
  "targetAuthorities": [
    {
      "authorityClass": "independent-implementation-matrix",
      "minimumIndependentImplementations": 2,
      "name": "independent-parser-matrix",
      "required": true
    }
  ]
