{
  "classification": {
    "conformanceProfile": "ISO 28500:2017 bounded single HTTP response capture",
    "family": "web-archive",
    "format": {
      "mediaType": "application/warc",
      "name": "WARC/1.1"
    },
    "purposes": [
      "preservation",
      "evidence"
    ],
    "representation": "capture-container"
  },
  "id": "web-archive-warc-response-r1",
  "nonClaims": [
    "complete website capture",
    "browser-executed DOM state",
    "JavaScript/network dependency completeness",
    "replay fidelity",
    "robots/policy/legal compliance",
    "semantic truth of captured content",
    "WACZ packaging or CDX index correctness"
  ],
  "notes": "Mapped from standards-first shadow profile; remains non-production until profile-v2 graduation.",
  "objectContract": {
    "binding": "request-digest",
    "kind": "web-archive-warc-response-contract-v1",
    "required": true,
    "schemaReference": "shadow-contracts/web-archive-warc-response-contract-v1.schema.json"
  },
  "outputs": [
    {
      "format": {
        "mediaType": "application/warc",
        "name": "WARC/1.1"
      },
      "purpose": "preservation",
      "required": true,
      "role": "primary"
    }
  ],
  "profilePolicy": {
    "formatPolicy": {
      "compressedContainer": false,
      "externalResources": false,
      "httpVersion": "HTTP/1.1",
      "metadataRecords": false,
      "recordCount": 1,
      "recordType": "response",
      "requestRecords": false,
      "requiredDigests": [
