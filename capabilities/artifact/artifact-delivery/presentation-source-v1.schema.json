{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.local/schemas/presentation-source-v1.json",
  "title": "Presentation Source v1",
  "description": "Format-specific presentation authoring source. It is intentionally not a universal document AST and does not encode workflow/release standing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "presentationId",
    "profileId",
    "sourceMode",
    "locale",
    "aspectRatio",
    "slideSizeInches",
    "slides"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "presentation-source"
    },
    "presentationId": {
      "type": "string",
      "minLength": 1
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "sourceMode": {
      "enum": [
        "native-composition",
        "reference-map"
      ]
    },
    "locale": {
      "type": "string",
      "minLength": 2
    },
    "aspectRatio": {
      "enum": [
        "34:10",
        "16:9",
        "4:3",
        "9:16",
        "custom"
      ]
    },
    "slideSizeInches": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slide"
      }
    },
    "notes": {
      "type": "string"
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "path",
        "sha256"
      ],
      "properties": {
        "format": {
          "const": "pptx"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "description": "Exact slide-free PPTX authoring authority whose native theme/master/layout/placeholder semantics are inherited by the current python-pptx adapter. True POTX ingestion is not claimed by this adapter."
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "textElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "text"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "box": {
          "$ref": "#/$defs/box"
        },
        "fontFamily": {
          "type": "string",
          "minLength": 1
        },
        "fontSizePt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "colorHex": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right",
            "justify"
          ]
        },
        "placeholderIdx": {
          "type": "integer",
          "minimum": 0,
          "description": "Native OOXML placeholder idx on the selected slide layout. When present, geometry and typography may inherit from the template/layout unless explicitly overridden."
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Text opacity expressed as a normalized presentation visual property. 0 is fully transparent and 1 is fully opaque; the builder maps this to standard DrawingML alpha."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "placeholderIdx"
            ]
          },
          "then": {},
          "else": {
            "required": [
              "box",
              "fontFamily",
              "fontSizePt"
            ]
          }
        }
      ]
    },
    "legacySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactName",
        "sha256",
        "slideIndex"
      ],
      "properties": {
        "artifactName": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "slideIndex": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string"
        },
        "layoutId": {
          "type": "string",
          "description": "Case-insensitive native PowerPoint slide-layout name within the selected template/master set. A template-bound slide must provide it."
        },
        "elements": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/textElement"
              },
              {
                "$ref": "#/$defs/imageElement"
              }
            ]
          }
        },
        "legacySource": {
          "$ref": "#/$defs/legacySource"
        },
        "speakerNotes": {
          "type": "string"
        }
      }
    },
    "imageElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "path",
        "sha256",
        "box",
        "decorative"
      ],
      "properties": {
        "kind": {
          "const": "image"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "box": {
          "$ref": "#/$defs/box"
        },
        "decorative": {
          "type": "boolean"
        },
        "altText": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decorative": {
                "const": false
              }
            },
            "required": [
              "decorative"
            ]
          },
          "then": {
            "required": [
              "altText"
            ]
          }
        }
      ],
      "description": "Presentation-specific raster image element. The exact image bytes are SHA-256 bound and become build/provenance materials. Element order is native slide shape order; place a full-slide image first when using it as a hybrid visual reference/background."
    }
  }
}
