{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact Knowledge-to-Action Donor Manifest R1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "standing", "baseRevision", "sourceReferences", "principles", "migrationClasses", "coverage", "knownGaps", "profiles", "excludedInfrastructure"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "artifact-knowledge-to-action-donor"},
    "id": {"const": "artifact-k2a-donor-r1"},
    "standing": {"const": "DONOR_REFERENCE_NOT_CORE_ONTOLOGY"},
    "baseRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sourceReferences": {
      "type": "object", "additionalProperties": false,
      "required": ["taxonomy", "profileV2MappingManifest"],
      "properties": {
        "taxonomy": {"$ref": "#/$defs/fileRef"},
        "profileV2MappingManifest": {"$ref": "#/$defs/fileRef"}
      }
    },
    "principles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "migrationClasses": {
      "type": "object", "additionalProperties": false,
      "required": ["DIRECT_REFERENCE", "SEMANTIC_MAPPING", "DO_NOT_PROMOTE"],
      "properties": {
        "DIRECT_REFERENCE": {"type": "string", "minLength": 1},
        "SEMANTIC_MAPPING": {"type": "string", "minLength": 1},
        "DO_NOT_PROMOTE": {"type": "string", "minLength": 1}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["taxonomyFamilies", "representedFamilies", "normalizedProfiles", "liveProvenShadowBindings", "isolatedValidatorImplementations"],
      "properties": {
        "taxonomyFamilies": {"type": "integer", "minimum": 1},
        "representedFamilies": {"type": "integer", "minimum": 1},
        "normalizedProfiles": {"type": "integer", "minimum": 1},
        "liveProvenShadowBindings": {"type": "integer", "minimum": 0},
        "isolatedValidatorImplementations": {"type": "integer", "minimum": 0}
      }
    },
    "knownGaps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "standing", "observation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "standing": {"const": "PRESERVE_GAP_DO_NOT_INVENT"},
          "observation": {"type": "object"}
        }
      }
    },
    "profiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profileDonor"}},
    "excludedInfrastructure": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/excluded"}}
  },
  "$defs": {
    "fileRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "classification": {
      "type": "object", "additionalProperties": true,
      "required": ["family", "representation", "format", "purposes"],
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "representation": {"type": "string", "minLength": 1},
        "format": {"type": "object"},
        "purposes": {"type": "array", "minItems": 1}
      }
    },
    "profileDonor": {
      "type": "object", "additionalProperties": false,
      "required": ["profileId", "candidateProblemKey", "classification", "sourceProfile", "standards", "targetAuthorities", "objectContract", "capabilityBinding", "validatorImplementation", "validationMapping", "compositionCandidate", "resultBoundary", "migrationDisposition"],
      "properties": {
        "profileId": {"type": "string", "minLength": 1},
        "candidateProblemKey": {"type": "string", "pattern": "^artifact/[^/]+/[^/]+$"},
        "classification": {"$ref": "#/$defs/classification"},
        "sourceProfile": {"$ref": "#/$defs/fileRef"},
        "standards": {"type": "array", "items": {"type": "string"}},
        "targetAuthorities": {"type": "array", "items": {"type": "object"}},
        "objectContract": {
          "anyOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["declaration", "schema"], "properties": {"declaration": {"type": "object"}, "schema": {"$ref": "#/$defs/fileRef"}}}
          ]
        },
        "capabilityBinding": {
          "anyOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["standing", "bindingKeys", "reference"], "properties": {"standing": {"type": "string"}, "bindingKeys": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "proofKeys": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "reference": {"$ref": "#/$defs/fileRef"}}}
          ]
        },
        "validatorImplementation": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/fileRef"}]},
        "validationMapping": {"type": "object", "minProperties": 1},
        "compositionCandidate": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "capabilitySignals", "requiredEvidence", "sequencing"],
          "properties": {
            "status": {"const": "DECLARATIVE_PROFILE_CANDIDATE"},
            "capabilitySignals": {"type": "array", "items": {"type": "string"}},
            "requiredEvidence": {"type": "array", "items": {"type": "string"}},
            "sequencing": {"const": "NOT_ENCODED_DO_NOT_INFER"}
          }
        },
        "resultBoundary": {"type": "object", "additionalProperties": false, "required": ["nonClaims"], "properties": {"nonClaims": {"type": "array", "items": {"type": "string"}}}},
        "migrationDisposition": {
          "type": "object", "additionalProperties": false,
          "required": ["classification", "standards", "objectContract", "capabilityBinding", "validationMapping", "evidenceRequirements", "resultBoundary", "executionWiring"],
          "properties": {
            "classification": {"const": "DIRECT_REFERENCE"},
            "standards": {"const": "DIRECT_REFERENCE"},
            "objectContract": {"const": "SEMANTIC_MAPPING"},
            "capabilityBinding": {"const": "SEMANTIC_MAPPING"},
            "validationMapping": {"const": "SEMANTIC_MAPPING"},
            "evidenceRequirements": {"const": "DIRECT_REFERENCE"},
            "resultBoundary": {"const": "DIRECT_REFERENCE"},
            "executionWiring": {"const": "DO_NOT_PROMOTE"}
          }
        }
      }
    },
    "excluded": {
      "type": "object", "additionalProperties": false,
      "required": ["concept", "disposition", "reason"],
      "properties": {
        "concept": {"type": "string", "minLength": 1},
        "reference": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/fileRef"}]},
        "disposition": {"const": "DO_NOT_PROMOTE"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
