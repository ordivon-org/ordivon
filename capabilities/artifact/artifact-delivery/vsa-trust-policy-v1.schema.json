{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact VSA Trust Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["policyVersion", "id", "acceptedBundleMediaTypes", "signers"],
  "properties": {
    "policyVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "acceptedBundleMediaTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"const": "application/vnd.dev.sigstore.bundle.v0.3+json"}
    },
    "signers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/signer"}
    },
    "notes": {"type": "string"}
  },
  "$defs": {
    "publicKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "allowedVerifierIds", "requireTransparencyLog"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "mode": {"enum": ["public-key", "keyless"]},
        "allowedVerifierIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "format": "uri"}
        },
        "requireTransparencyLog": {"type": "boolean"},
        "publicKey": {"$ref": "#/$defs/publicKey"},
        "certificateIdentity": {"type": "string", "minLength": 1},
        "certificateOidcIssuer": {"type": "string", "format": "uri"},
        "trustedRoot": {"$ref": "#/$defs/publicKey"}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "public-key"}}, "required": ["mode"]},
          "then": {"required": ["publicKey"]}
        },
        {
          "if": {"properties": {"mode": {"const": "keyless"}}, "required": ["mode"]},
          "then": {
            "required": ["certificateIdentity", "certificateOidcIssuer"],
            "properties": {"requireTransparencyLog": {"const": true}}
          }
        }
      ]
    }
  }
}
