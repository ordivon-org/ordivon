{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact Profile v2 Shadow R1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profileVersion", "id", "classification", "outputs", "requiredEvidence"],
  "properties": {
    "profileVersion": {"const": 2},
    "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "representation", "format", "purposes"],
      "properties": {
        "family": {
          "enum": [
            "text-document", "fixed-document", "presentation", "spreadsheet", "dataset",
            "still-image", "audio", "moving-image", "web", "geospatial", "design-3d",
            "software-release", "web-archive", "message"
          ]
        },
        "representation": {"type": "string", "minLength": 1},
        "format": {"$ref": "#/$defs/format"},
        "conformanceProfile": {"type": "string", "minLength": 1},
        "purposes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "construction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authorityMode": {"enum": ["generated-managed", "office-authored", "source-authored"]},
        "locale": {"type": "string", "minLength": 2}
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/output"}
    },
    "targetAuthorities": {
      "type": "array",
      "items": {"$ref": "#/$defs/targetAuthority"}
    },
    "objectContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "kind"],
      "properties": {
        "required": {"type": "boolean"},
        "kind": {"type": "string", "minLength": 1},
        "schemaReference": {"type": "string", "minLength": 1},
        "binding": {"enum": ["request-digest", "artifact-embedded", "profile-fixed", "external-authority"]}
      }
    },
    "requiredEvidence": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9._-]*$"},
      "additionalProperties": {"$ref": "#/$defs/evidenceRequirement"}
    },
    "profilePolicy": {"type": "object"},
    "deliveryDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "nonClaims": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "notes": {"type": "string"}
  },
  "$defs": {
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "mediaType": {"type": "string", "pattern": "^[^/\\s]+/[^\\s]+$"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "format", "purpose", "required"],
      "properties": {
        "role": {"enum": ["primary", "companion"]},
        "format": {"$ref": "#/$defs/format"},
        "purpose": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "editable": {"type": "boolean"}
      }
    },
    "targetAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityClass", "name", "required"],
      "properties": {
        "authorityClass": {"enum": ["native-consumer", "independent-implementation-matrix", "standard-validator"]},
        "name": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "minimumIndependentImplementations": {"type": "integer", "minimum": 2}
      }
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "claim"],
      "properties": {
        "required": {"type": "boolean"},
        "claim": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"}
      }
    }
  }
}
