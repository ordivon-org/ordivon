{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact OCI Software Release Contract v1 (shadow)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "id", "profileId", "image", "runtime", "security", "sbom"],
  "properties": {
    "contractVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "profileId": {"const": "software-release-oci-image-r1"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestDigest", "os", "architecture", "entrypoint", "workingDir", "expectedFiles"],
      "properties": {
        "manifestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "os": {"const": "linux"},
        "architecture": {"const": "amd64"},
        "entrypoint": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "workingDir": {"type": "string"},
        "expectedFiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "pattern": "^/[^\\0]*$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "exitCode", "stdoutExact", "stderrExact"],
      "properties": {
        "network": {"const": "none"},
        "exitCode": {"type": "integer"},
        "stdoutExact": {"type": "string"},
        "stderrExact": {"type": "string"}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trivyDbSnapshot", "maximumVulnerabilities", "maximumSecrets"],
      "properties": {
        "trivyDbSnapshot": {"const": "20260912-r1"},
        "maximumVulnerabilities": {"type": "integer", "minimum": 0},
        "maximumSecrets": {"type": "integer", "minimum": 0}
      }
    },
    "sbom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "requiredPackages"],
      "properties": {
        "format": {"const": "SPDX-2.3-json"},
        "requiredPackages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "notes": {"type": "string"}
  }
}
