{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact FLAC Audio Contract v1 (shadow)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "id", "profileId", "audio"],
  "properties": {
    "contractVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "profileId": {"const": "audio-flac-pcm16-r1"},
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleRateHz", "channels", "bitsPerSample", "totalSamples"],
      "properties": {
        "sampleRateHz": {"type": "integer", "minimum": 1, "maximum": 1048575},
        "channels": {"enum": [1, 2]},
        "bitsPerSample": {"const": 16},
        "totalSamples": {"type": "integer", "minimum": 1},
        "expectedPcmSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "notes": {"type": "string"}
  }
}
