{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ordivon:artifact:eda-kicad-pcb-contract-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "board", "drc", "manufacturingOutputs"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "eda-kicad-pcb-contract-v1"},
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hasOutline", "widthMm", "heightMm", "throughHolePads", "minDrillDiameterMm"],
      "properties": {
        "hasOutline": {"type": "boolean"},
        "widthMm": {"type": "number", "exclusiveMinimum": 0},
        "heightMm": {"type": "number", "exclusiveMinimum": 0},
        "throughHolePads": {"type": "integer", "minimum": 0},
        "minDrillDiameterMm": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "drc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "requireZeroViolations"],
      "properties": {
        "severity": {"const": "error"},
        "requireZeroViolations": {"const": true}
      }
    },
    "manufacturingOutputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gerberLayers", "excellon"],
      "properties": {
        "gerberLayers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "excellon": {"const": true}
      }
    }
  }
}
