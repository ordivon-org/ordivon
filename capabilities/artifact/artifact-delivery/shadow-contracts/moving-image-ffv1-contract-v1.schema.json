{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact Matroska FFV1 Moving Image Contract v1 (shadow)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "id", "profileId", "video"],
  "properties": {
    "contractVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "profileId": {"const": "moving-image-matroska-ffv1-v3-r1"},
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "frameRate", "frameCount", "pixelFormat", "bitDepth", "chromaSubsampling", "scanType"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "frameRate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["numerator", "denominator"],
          "properties": {
            "numerator": {"type": "integer", "minimum": 1},
            "denominator": {"type": "integer", "minimum": 1}
          }
        },
        "frameCount": {"type": "integer", "minimum": 1},
        "pixelFormat": {"const": "yuv422p"},
        "bitDepth": {"const": 8},
        "chromaSubsampling": {"const": "4:2:2"},
        "scanType": {"const": "Progressive"},
        "expectedRawVideoSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "notes": {"type": "string"}
  }
}
