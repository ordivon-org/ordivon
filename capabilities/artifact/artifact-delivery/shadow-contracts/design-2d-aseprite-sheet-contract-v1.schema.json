{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact Aseprite Horizontal Sheet Export Contract v1 (shadow)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "id", "profileId", "export"],
  "properties": {
    "contractVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "profileId": {"const": "design-2d-aseprite-horizontal-sheet-r1"},
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sheetType", "dataFormat", "listTags", "sheetBasename", "dataBasename", "width", "height", "frameCount", "expectedPngSha256", "expectedNativeMetadataSha256"],
      "properties": {
        "sheetType": {"const": "horizontal"},
        "dataFormat": {"const": "json-array"},
        "listTags": {"const": true},
        "sheetBasename": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.png$"},
        "dataBasename": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.json$"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "frameCount": {"type": "integer", "minimum": 1},
        "expectedPngSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "expectedNativeMetadataSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "notes": {"type": "string"}
  }
}
