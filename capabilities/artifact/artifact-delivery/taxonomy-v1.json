{
  "schemaVersion": 1,
  "kind": "artifact-standards-first-taxonomy",
  "id": "artifact-taxonomy-r1",
  "capturedOn": "2026-09-12",
  "status": "SHADOW_MODEL_NO_RUNTIME_CUTOVER",
  "principles": [
    "artifact family is not a file format",
    "file format is not a conformance profile",
    "accessibility and preservation are profile purposes, not artifact families",
    "target acceptance is independent from structural conformance",
    "delivery/read-back is independent from artifact construction",
    "OCI packaging is cross-cutting release infrastructure, not an artifact family",
    "no universal artifact AST is introduced"
  ],
  "externalClassificationAnchors": [
    {
      "authority": "IANA",
      "reference": "Media Types Registry / RFC 6838",
      "role": "registered serialization/media-type identity"
    },
    {
      "authority": "Library of Congress",
      "reference": "Recommended Formats Statement 2025-2026",
      "role": "real-world content-family and preservation-oriented format taxonomy"
    }
  ],
  "classificationAxes": [
    {
      "id": "family",
      "meaning": "Operational artifact semantics that determine the native standard/tool/target verification ecosystem."
    },
    {
      "id": "representation",
      "meaning": "Structural representation such as structured-markup, fixed-layout, raster, vector, database, columnar, audiovisual-container, scene, executable-package or capture-container."
    },
    {
      "id": "format",
      "meaning": "Concrete format and registered media type when one exists."
    },
    {
      "id": "conformanceProfile",
      "meaning": "Optional industry profile layered on the format, such as PDF/A-4, PDF/UA-2, EPUB 3.3 or WCAG 2.2 AA."
    },
    {
      "id": "targetAuthority",
      "meaning": "Native consumer/runtime/viewer/editor whose behavior is authoritative for profile-specific target acceptance."
    },
    {
      "id": "purpose",
      "meaning": "Use intent such as editable-authoring, exchange, portable-view, accessibility, preservation, publication or software-distribution."
    }
  ],
