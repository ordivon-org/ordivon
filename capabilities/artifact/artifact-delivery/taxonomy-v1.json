{
  "schemaVersion": 1,
  "kind": "artifact-standards-first-taxonomy",
  "id": "artifact-taxonomy-r1",
  "capturedOn": "2026-09-12",
  "status": "SHADOW_MODEL_NO_RUNTIME_CUTOVER",
  "principles": [
    "artifact family is not a file format",
    "file format is not a conformance profile",
    "accessibility and preservation are profile purposes, not artifact families",
    "target acceptance is independent from structural conformance",
    "delivery/read-back is independent from artifact construction",
    "OCI packaging is cross-cutting release infrastructure, not an artifact family",
    "no universal artifact AST is introduced"
  ],
  "externalClassificationAnchors": [
    {
      "authority": "IANA",
      "reference": "Media Types Registry / RFC 6838",
      "role": "registered serialization/media-type identity"
    },
    {
      "authority": "Library of Congress",
      "reference": "Recommended Formats Statement 2025-2026",
      "role": "real-world content-family and preservation-oriented format taxonomy"
    }
  ],
  "classificationAxes": [
    {
      "id": "family",
      "meaning": "Operational artifact semantics that determine the native standard/tool/target verification ecosystem."
    },
    {
      "id": "representation",
      "meaning": "Structural representation such as structured-markup, fixed-layout, raster, vector, database, columnar, audiovisual-container, scene, executable-package or capture-container."
    },
    {
      "id": "format",
      "meaning": "Concrete format and registered media type when one exists."
    },
    {
      "id": "conformanceProfile",
      "meaning": "Optional industry profile layered on the format, such as PDF/A-4, PDF/UA-2, EPUB 3.3 or WCAG 2.2 AA."
    },
    {
      "id": "targetAuthority",
      "meaning": "Native consumer/runtime/viewer/editor whose behavior is authoritative for profile-specific target acceptance."
    },
    {
      "id": "purpose",
      "meaning": "Use intent such as editable-authoring, exchange, portable-view, accessibility, preservation, publication or software-distribution."
    }
  ],
  "families": [
    {
      "id": "text-document",
      "externalAlignment": ["Library of Congress: Textual Works"],
      "representations": ["structured-markup", "office-package", "ebook-package"],
      "standards": ["ECMA-376 / ISO/IEC 29500 OOXML", "ISO/IEC 26300 ODF", "W3C EPUB 3.3"],
      "exampleFormats": ["docx", "odt", "epub", "xml", "markdown"],
      "currentCoverage": "PROFILE_PRESENT",
      "currentProfiles": ["document-r1"],
      "localToolStanding": "PARTIAL_STRONG"
    },
    {
      "id": "fixed-document",
      "externalAlignment": ["Library of Congress: Textual Works / page-layout formats"],
      "representations": ["fixed-layout"],
      "standards": ["ISO 32000-2 PDF 2.0", "ISO 19005-4 PDF/A-4", "ISO 14289-2:2024 PDF/UA-2"],
      "exampleFormats": ["pdf", "pdf-a-4", "pdf-ua-2"],
      "currentCoverage": "PROFILE_PRESENT",
      "currentProfiles": ["pdf-fixed-r1", "pdf-accessible-r1"],
      "localToolStanding": "STRONG"
    },
    {
      "id": "presentation",
      "externalAlignment": ["ECMA-376 PresentationML", "Library of Congress: Textual/visual publication formats"],
      "representations": ["office-package", "slide-runtime"],
      "standards": ["ECMA-376 / ISO/IEC 29500 PresentationML and OPC"],
      "exampleFormats": ["pptx", "odp", "html-slides"],
      "currentCoverage": "PROFILE_PRESENT",
      "currentProfiles": ["pdu-sdu-presentation-r1", "presentation-local-development-r1", "presentation-ultrawide-34x10-r1"],
      "localToolStanding": "STRONG_WITH_EXTERNAL_TARGET"
    },
    {
      "id": "spreadsheet",
      "externalAlignment": ["ECMA-376 SpreadsheetML", "Library of Congress: Datasets / de-facto professional formats"],
      "representations": ["office-package", "formula-workbook"],
      "standards": ["ECMA-376 / ISO/IEC 29500 SpreadsheetML and OPC", "ISO/IEC 26300 ODF"],
      "exampleFormats": ["xlsx", "ods"],
      "currentCoverage": "PROFILE_PRESENT",
      "currentProfiles": ["spreadsheet-r1"],
      "localToolStanding": "PARTIAL_STRONG"
    },
    {
      "id": "dataset",
      "externalAlignment": ["Library of Congress: Datasets"],
      "representations": ["delimited-text", "structured-text", "columnar", "database", "scientific-array"],
      "standards": ["RFC 8259 JSON", "text/csv family", "Apache Parquet specification", "Apache Arrow specification", "HDF5/netCDF domain standards where applicable"],
      "exampleFormats": ["csv", "tsv", "json", "parquet", "arrow", "sqlite", "hdf5", "netcdf"],
      "currentCoverage": "SHADOW_PROFILE_LIVE_PROVEN",
      "currentProfiles": ["dataset-parquet-flat-r1"],
      "localToolStanding": "PARQUET_CONTRACT_AND_DUCKDB_PYARROW_READER_MATRIX_PROVEN"
    },
    {
      "id": "still-image",
      "externalAlignment": ["IANA image/*", "Library of Congress: Still Image Works"],
      "representations": ["raster", "vector"],
      "standards": ["W3C PNG Third Edition", "W3C SVG 2", "ISO/IEC JPEG-family standards", "TIFF family where profile-selected"],
      "exampleFormats": ["png", "jpeg", "tiff", "avif", "svg"],
      "currentCoverage": "SHADOW_PROFILE_LIVE_PROVEN",
      "currentProfiles": ["still-image-png-srgb-r1"],
      "localToolStanding": "PNG_VALIDITY_METADATA_AND_TWO_DECODER_MATRIX_PROVEN"
    },
    {
      "id": "audio",
      "externalAlignment": ["IANA audio/*", "Library of Congress: Audio Works"],
      "representations": ["elementary-stream", "audio-container"],
      "standards": ["format/profile-selected codec and container standards", "BWF/WAVE or professional preservation profiles where required"],
      "exampleFormats": ["wav", "flac", "aac", "mp3", "opus"],
      "currentCoverage": "NO_PROFILE",
      "currentProfiles": [],
      "localToolStanding": "FFMPEG_PRESENT_SPECIALIST_CONFORMANCE_MISSING"
    },
    {
      "id": "moving-image",
      "externalAlignment": ["IANA video/*", "Library of Congress: Moving Image Works"],
      "representations": ["audiovisual-container", "master-package"],
      "standards": ["SMPTE ST 2067 IMF for professional master workflows", "profile-selected container/codec standards"],
      "exampleFormats": ["mp4", "mkv", "mov", "mxf", "imf-package"],
      "currentCoverage": "NO_PROFILE",
      "currentProfiles": [],
      "localToolStanding": "FFMPEG_PRESENT_SPECIALIST_CONFORMANCE_MISSING"
    },
    {
      "id": "web",
      "externalAlignment": ["IANA text/html and related web media types", "Library of Congress: web content / Web Archives boundary"],
      "representations": ["html-css-js-runtime"],
      "standards": ["WHATWG HTML Living Standard", "W3C CSS snapshots/modules", "WCAG 2.2"],
      "exampleFormats": ["html", "css", "javascript", "svg"],
      "currentCoverage": "PROFILE_PRESENT",
      "currentProfiles": ["web-r1"],
      "localToolStanding": "STRONG_WITH_SUPPORTED_RUNNER_BOUNDARY"
    },
    {
      "id": "geospatial",
      "externalAlignment": ["Library of Congress: GIS, Geospatial and Cartographic", "OGC standards"],
      "representations": ["geospatial-database", "vector-features", "georeferenced-raster", "tiles"],
      "standards": ["OGC GeoPackage 1.4", "GeoTIFF", "GeoJSON RFC 7946", "OGC APIs where delivery profile requires them"],
      "exampleFormats": ["gpkg", "geotiff", "geojson", "shapefile", "kml", "gml"],
      "currentCoverage": "SHADOW_PROFILE_LIVE_PROVEN",
      "currentProfiles": ["geospatial-geopackage-point-r1"],
      "localToolStanding": "OGC_GPKG_VALIDATOR_SQLITE_CONTAINER_AND_OGR_CONTRACT_PROVEN"
    },
    {
      "id": "design-3d",
      "externalAlignment": ["IANA model/*", "Library of Congress: Design and 3D"],
      "representations": ["scene", "mesh", "cad", "bim", "manufacturing-model"],
      "standards": ["ISO/IEC 12113:2022 Khronos glTF 2.0", "STEP/IFC/3MF profile-selected for CAD/BIM/manufacturing"],
      "exampleFormats": ["gltf", "glb", "step", "ifc", "3mf", "obj", "stl"],
      "currentCoverage": "NO_PROFILE",
      "currentProfiles": [],
      "localToolStanding": "BLENDER_PRESENT_OFFICIAL_GLTF_VALIDATOR_MISSING"
    },
    {
      "id": "software-release",
      "externalAlignment": ["Library of Congress: Software and Video Games", "software supply-chain standards"],
      "representations": ["binary", "package", "container", "source-release"],
      "standards": ["OCI Image/Distribution 1.1", "SLSA 1.2", "in-toto", "Sigstore", "SPDX 3.0 / ISO/IEC 5962:2021", "CycloneDX where selected"],
      "exampleFormats": ["oci-artifact", "container-image", "deb", "rpm", "apk", "ipa", "exe", "tarball"],
      "currentCoverage": "NO_ARTIFACT_PROFILE_BUT_RELEASE_SUBSTRATE_PRESENT",
      "currentProfiles": [],
      "localToolStanding": "STRONG_RELEASE_TOOLS_PRESENT"
    },
    {
      "id": "web-archive",
      "externalAlignment": ["Library of Congress: Web Archives"],
      "representations": ["capture-container", "capture-bundle"],
      "standards": ["ISO 28500 WARC", "WACZ ecosystem where profile-selected"],
      "exampleFormats": ["warc", "warc.gz", "wacz"],
      "currentCoverage": "NO_PROFILE",
      "currentProfiles": [],
      "localToolStanding": "SPECIALIST_TOOLS_MISSING"
    },
    {
      "id": "message",
      "externalAlignment": ["IANA message/*", "Library of Congress: Email"],
      "representations": ["internet-message", "mailbox-container"],
      "standards": ["RFC 5322 Internet Message Format", "MIME RFC 2045-2049 family"],
      "exampleFormats": ["eml", "mbox", "msg", "pst"],
      "currentCoverage": "NO_PROFILE",
      "currentProfiles": [],
      "localToolStanding": "NO_DEDICATED_PROFILE_OR_VALIDATOR"
    }
  ],
  "specialistExtensionsDeferred": [
    "musical-score / notation",
    "medical-imaging / DICOM",
    "computational-notebook",
    "scientific-domain arrays beyond the generic dataset family"
  ],
  "legacyProfileMapping": {
    "document": {"family": "text-document"},
    "presentation": {"family": "presentation"},
    "spreadsheet": {"family": "spreadsheet"},
    "web": {"family": "web"},
    "fixed-view": {"family": "fixed-document", "representation": "fixed-layout"},
    "accessible": {"family": "fixed-document", "purpose": "accessibility", "conformanceProfile": "PDF/UA-2"},
    "archive": {"family": "fixed-document", "purpose": "preservation", "conformanceProfile": "PDF/A-4", "note": "Legacy enum value was a purpose/profile, not an artifact family."}
  },
  "migrationRule": "Do not extend profile-v1 artifactClass. Introduce a v2 profile only after family/format/profile/target/purpose axes are proven by at least two additional non-Office families. Until then this taxonomy is a shadow model and current production profiles remain authoritative."
}
