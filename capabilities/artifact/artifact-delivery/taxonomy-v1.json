  "legacyProfileMapping": {
    "document": {
      "family": "text-document"
    },
    "presentation": {
      "family": "presentation"
    },
    "spreadsheet": {
      "family": "spreadsheet"
    },
    "web": {
      "family": "web"
    },
    "fixed-view": {
      "family": "fixed-document",
      "representation": "fixed-layout"
    },
    "accessible": {
      "family": "fixed-document",
      "purpose": "accessibility",
      "conformanceProfile": "PDF/UA-2"
    },
    "archive": {
      "family": "fixed-document",
      "purpose": "preservation",
      "conformanceProfile": "PDF/A-4",
      "note": "Legacy enum value was a purpose/profile, not an artifact family."
    }
  },
  "migrationRule": "Do not extend profile-v1 artifactClass. Introduce a v2 profile only after family/format/profile/target/purpose axes are proven by at least two additional non-Office families. Until then this taxonomy is a shadow model and current production profiles remain authoritative."
