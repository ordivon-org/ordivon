{
  "$id": "https://ordivon.local/schemas/artifact-verifier-plugin-result-r2-candidate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilityRef": {
      "additionalProperties": false,
      "properties": {
        "bindingSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "capabilityId": {
          "minLength": 1,
          "type": "string"
        },
        "entrypoint": {
          "type": "object"
        },
        "standing": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "capabilityId",
        "standing"
      ],
      "type": "object"
    },
    "claimResults": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "evidenceRefs": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "nativePointers": {
            "items": {
              "pattern": "^/",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "nonClaims": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "observationIds": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_EVALUATED"
            ]
          }
        },
        "required": [
          "status",
          "observationIds",
          "evidenceRefs",
          "nativePointers",
          "nonClaims"
        ],
        "type": "object"
      },
      "minProperties": 1,
      "type": "object"
    },
    "kind": {
      "const": "artifact-verifier-plugin-result"
    },
    "nativeResult": {
      "type": "object"
    },
    "nativeResultCanonicalSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "pluginBoundary": {
      "minLength": 1,
      "type": "string"
    },
    "profileRef": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "enum": [
            "PRODUCTION",
            "SHADOW",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": 1
    },
    "subjectRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size"
      ],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "profileRef",
    "subjectRef",
    "capabilityRef",
    "claimResults",
    "nativeResult",
    "nativeResultCanonicalSha256",
    "pluginBoundary"
  ],
  "title": "Artifact Verifier Plugin Result R2 Candidate",
  "type": "object"
}
