[Unit]
Description=Temporal worker for Ordivon Artifact operations
Requires=temporal.service
After=temporal.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/projects/ordivon/capabilities/artifact
ExecStart=/root/.local/share/ordivon-workstation/artifact-python-v1/current/bin/python /root/projects/ordivon/capabilities/artifact/scripts/artifact_temporal_worker.py --address 127.0.0.1:17233 --namespace default --task-queue ordivon-artifact --state-root /root/.local/state/ordivon-workstation/artifact-temporal
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=/root/.local/state/ordivon-workstation/artifact-temporal
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=false
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
