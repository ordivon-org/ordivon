{
  "schemaVersion": 1,
  "id": "studio.equipment-world",
  "principle": "Equipment earns persistence through capability gain, friction reduction, quality/ceiling gain, observability/recoverability, or a justified combination; fame and GUI richness are not authority.",
  "ownership": {
    "studio": [
      "medium-aware selection",
      "production intent",
      "equipment capability model",
      "artifact inspection expectation",
      "equipment ROI evidence"
    ],
    "runtime": [
      "exact executable",
      "environment",
      "Windows authority",
      "immutable input materialization",
      "process lifecycle",
      "execution artifacts",
      "recovery semantics"
    ],
    "host": [
      "machine/device presence",
      "version/capability projection",
      "license/configuration state when safely observable"
    ],
    "web": [
      "browser/publication runtime",
      "Web-specific interaction and accessibility",
      "real browser encounter evidence"
    ]
  },
  "retentionClasses": [
    "core-equipment",
    "specialist-on-demand",
    "external-workstation",
    "candidate",
    "challenger",
    "reject"
  ],
  "evaluationAxes": {
    "capabilityGain": [
      "new output class",
      "new editable master",
      "new observer relation",
      "new domain operation"
    ],
    "frictionReduction": [
      "fewer commands",
      "fewer manual handoffs",
      "lower wall time",
      "fewer environment assumptions",
      "better batchability",
      "better recovery",
      "better deterministic replay"
    ],
    "qualityCeilingGain": [
      "domain-native editability",
      "professional finishing",
      "higher fidelity",
      "specialized inspection/control"
    ],
    "cost": [
      "install footprint",
      "dependency footprint",
      "license",
      "authentication",
      "GUI/state coupling",
      "version volatility",
      "maintenance",
      "failure surface"
    ]
  },
  "equipment": [
    {
      "id": "ffmpeg",
      "family": "deterministic-cli",
      "media": [
        "audio",
        "motion-video",
        "still-visual",
        "live-realtime"
      ],
      "capabilities": [
        "media.probe",
        "media.transcode",
        "video.encode",
        "audio.transform",
        "image.extract",
        "timeline.compose-basic",
        "stream.capture-basic"
      ],
      "discovery": [
        {
          "platform": "linux",
          "path": "/usr/bin/ffmpeg",
          "versionArgs": [
            "-version"
          ]
        }
      ],
      "retention": "core-equipment",
      "reason": "Already-proven exact CLI substrate for transform, QC, experiments and delivery."
    },
    {
      "id": "ffprobe",
      "family": "deterministic-cli",
      "media": [
        "audio",
        "motion-video",
        "still-visual"
      ],
      "capabilities": [
        "media.probe",
        "stream.inspect",
        "duration.inspect",
        "codec.inspect"
      ],
      "discovery": [
        {
          "platform": "linux",
          "path": "/usr/bin/ffprobe",
          "versionArgs": [
            "-version"
          ]
        }
      ],
      "retention": "core-equipment",
      "reason": "Low-cost structural truth boundary used throughout Studio."
    },
    {
      "id": "rsvg-convert",
      "family": "deterministic-cli",
      "media": [
        "still-visual"
      ],
      "capabilities": [
        "svg.rasterize"
      ],
      "discovery": [
        {
          "platform": "linux",
          "path": "/usr/bin/rsvg-convert",
          "versionArgs": [
            "--version"
          ]
        }
      ],
      "retention": "core-equipment",
      "reason": "Tiny focused SVG rasterizer and strong baseline for larger vector tools."
    },
    {
      "id": "typst",
      "family": "deterministic-cli",
      "media": [
        "writing",
        "still-visual"
      ],
      "capabilities": [
        "document.compile.pdf",
        "document.compile.png",
        "document.compile.svg",
        "document.query",
        "document.template"
      ],
      "discovery": [
        {
          "platform": "linux",
          "path": "/usr/bin/typst",
          "versionArgs": [
            "--version"
          ]
        }
      ],
      "retention": "core-equipment",
      "reason": "E6 produced a tagged one-page PDF in ~21 ms; E7 retained Typst for Studio-local deterministic publishing, batchability and low persistent cost."
    },
    {
      "id": "imagemagick",
      "family": "deterministic-cli",
      "media": [
        "still-visual"
      ],
      "capabilities": [
        "image.resize",
        "image.crop",
        "image.convert",
        "image.compose",
        "image.inspect",
        "image.batch"
      ],
      "discovery": [
        {
          "platform": "linux",
          "path": "/usr/bin/magick",
          "versionArgs": [
            "-version"
          ]
        }
      ],
      "retention": "core-equipment",
      "reason": "E7 found no speed gain over FFmpeg for resize, but the same operation used 4 arguments versus 10 and the image-specific batch surface materially reduces friction at low cost."
    },
    {
      "id": "inkscape",
      "family": "deterministic-cli-plus-gui",
