{
  "schemaVersion": 1,
  "id": "studio.equipment-world",
  "principle": "Equipment earns persistence through capability gain, friction reduction, quality/ceiling gain, observability/recoverability, or a justified combination; fame and GUI richness are not authority.",
  "ownership": {
    "studio": [
      "medium-aware selection",
      "production intent",
      "equipment capability model",
      "artifact inspection expectation",
      "equipment ROI evidence"
    ],
    "runtime": [
      "exact executable",
      "environment",
      "Windows authority",
      "immutable input materialization",
      "process lifecycle",
      "execution artifacts",
      "recovery semantics"
    ],
    "host": [
      "machine/device presence",
      "version/capability projection",
      "license/configuration state when safely observable"
    ],
    "web": [
      "browser/publication runtime",
      "Web-specific interaction and accessibility",
      "real browser encounter evidence"
    ]
  },
  "retentionClasses": [
    "core-equipment",
    "specialist-on-demand",
    "external-workstation",
    "candidate",
    "challenger",
    "reject"
  ],
  "evaluationAxes": {
    "capabilityGain": [
      "new output class",
      "new editable master",
      "new observer relation",
      "new domain operation"
    ],
    "frictionReduction": [
      "fewer commands",
      "fewer manual handoffs",
      "lower wall time",
      "fewer environment assumptions",
      "better batchability",
      "better recovery",
      "better deterministic replay"
    ],
    "qualityCeilingGain": [
      "domain-native editability",
      "professional finishing",
      "higher fidelity",
      "specialized inspection/control"
    ],
    "cost": [
      "install footprint",
      "dependency footprint",
      "license",
      "authentication",
      "GUI/state coupling",
      "version volatility",
      "maintenance",
      "failure surface"
    ]
  },
