#!/usr/bin/env bash
set -euo pipefail
repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
mode=${1:-}
mise_bin=${MISE_BIN:-$(command -v mise || true)}

usage() {
  cat <<'TXT'
usage: scripts/owner-environment bootstrap|doctor|test|cold-start|bootstrap-resolve|doctor-resolve|test-resolve

bootstrap          materialize pinned Node and core Python dependency planes
doctor             verify mise/Node/pnpm plus exact JS and Python materialization
test               bootstrap, doctor, and run Studio's default check surface
cold-start         copy the current source fence and prove test without warmed node_modules/.venv
bootstrap-resolve  materialize core plus optional OpenTimelineIO resolve equipment
doctor-resolve     verify the resolve equipment profile
test-resolve       run default checks plus resolve adapter tests

External media binaries, GPU/browser execution and provider credentials remain capability-specific.
TXT
}
require_tools() {
  [[ -n "$mise_bin" ]] || { echo 'Studio owner environment requires mise' >&2; exit 1; }
}
mise_run() { (cd "$repo" && "$mise_bin" exec -- "$@"); }
pnpm_mise() { (cd "$repo" && CI=true "$mise_bin" exec -- pnpm "$@"); }
bootstrap() {
  require_tools
  (cd "$repo" && "$mise_bin" install)
  pnpm_mise install --frozen-lockfile
  mise_run python3 scripts/materialize-python.py
}
bootstrap_resolve() {
  bootstrap
  mise_run python3 scripts/materialize-python.py --extra resolve
}
doctor() {
  require_tools
  (cd "$repo" && "$mise_bin" exec -- node - <<'JS'
const fs=require('node:fs');
const pkg=JSON.parse(fs.readFileSync('package.json','utf8'));
if (process.version !== 'v26.9.0') throw new Error(`Studio expects Node 26.9.0 via mise, got ${process.version}`);
if (pkg.packageManager !== 'pnpm@12.4.2') throw new Error(`unexpected packageManager ${pkg.packageManager}`);
console.log(`studio node=${process.version} packageManager=${pkg.packageManager}`);
JS
  )
  (cd "$repo" && "$mise_bin" exec -- pnpm --version | grep -Fx '12.4.2')
  pnpm_mise deps:js:check
  mise_run python3 scripts/require-python-deps.py
  echo 'owner environment doctor: valid profile=test'
}
doctor_resolve() {
  doctor
  mise_run python3 scripts/require-python-deps.py --extra resolve
  echo 'owner environment doctor: valid profile=capability:resolve'
}
run_tests() {
  bootstrap
  doctor
  pnpm_mise check
}
run_resolve_tests() {
  bootstrap_resolve
  doctor_resolve
  pnpm_mise check:all
}
case "$mode" in
  bootstrap) bootstrap ;;
  doctor) doctor ;;
  test) run_tests ;;
  cold-start)
    tmp=$(mktemp -d -t ordivon-media-owner-env-XXXXXX)
    trap 'rm -rf "$tmp"' EXIT
    mkdir -p "$tmp/repo"
    (cd "$repo" && tar --exclude=.git --exclude=.venv --exclude=node_modules --exclude=out --exclude=dist --exclude='*/__pycache__' -cf - .) | tar -xf - -C "$tmp/repo"
    "$tmp/repo/scripts/owner-environment" test
    ;;
  bootstrap-resolve) bootstrap_resolve ;;
  doctor-resolve) doctor_resolve ;;
  test-resolve) run_resolve_tests ;;
  --help|-h) usage ;;
  *) usage >&2; exit 2 ;;
esac
