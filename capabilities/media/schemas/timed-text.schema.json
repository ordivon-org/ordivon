{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.com/studio/schemas/timed-text-v1.json",
  "title": "Ordivon Studio TimedText v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "language", "timeBase", "cues"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "timeBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticksPerSecond"],
      "properties": {
        "ticksPerSecond": {"type": "integer", "minimum": 1},
        "frameRate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["numerator", "denominator"],
          "properties": {
            "numerator": {"type": "integer", "minimum": 1},
            "denominator": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "startTick", "endTick", "text", "status", "kind"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "startTick": {"type": "integer", "minimum": 0},
          "endTick": {"type": "integer", "minimum": 1},
          "text": {"type": "string"},
          "status": {"enum": ["provisional", "locked"]},
          "kind": {"enum": ["dialogue", "caption", "chapter", "metadata"]},
          "speaker": {"type": "string"},
          "sourceCueId": {"type": "string"}
        }
      }
    }
  }
}
