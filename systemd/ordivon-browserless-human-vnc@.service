[Unit]
Description=Bounded loopback VNC transport for Browserless carrier %i
Requires=ordivon-browserless-display@%i.service
After=ordivon-browserless-display@%i.service
BindsTo=ordivon-browserless@%i.service
After=ordivon-browserless@%i.service

[Service]
Type=simple
ExecStart=/usr/bin/x11vnc -display :1%i -auth /run/ordivon/browserless-xauth/%i -rfbport 159%i -listen 127.0.0.1 -no6 -forever -shared -nopw -quiet
Restart=on-failure
RestartSec=1s
RuntimeMaxSec=600

[Install]
WantedBy=multi-user.target
