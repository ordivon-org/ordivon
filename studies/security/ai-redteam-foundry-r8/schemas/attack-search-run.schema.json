{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "searchId", "provider", "providerVersion", "providerEngine", "providerRunId", "targetId", "threatClass", "environmentDigest", "worldSpecDigest", "observerBindingDigest", "seedArtifactDigest", "providerConfigDigest", "budget", "control"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "ordivon.ai-redteam-attack-search-run"},
    "searchId": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "providerVersion": {"type": "string", "minLength": 1},
    "providerEngine": {"type": "string", "minLength": 1},
    "providerRunId": {"type": "string", "minLength": 1},
    "targetId": {"type": "string", "minLength": 1},
    "threatClass": {"enum": ["semantic_only", "synthetic_agent", "hostile_code"]},
    "environmentDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "worldSpecDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "observerBindingDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "seedArtifactDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "providerConfigDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "budget": {"type": "object"},
    "control": {"type": "object"}
  }
}
