{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "candidate", "judgeId", "providerOutcome", "providerPositive", "score", "observationDigest", "observedEffectId", "observedEffectRequestDigest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "ordivon.ai-redteam-search-result-ref"},
    "candidate": {"type": "object"},
    "judgeId": {"type": "string", "minLength": 1},
    "providerOutcome": {"type": "string", "minLength": 1},
    "providerPositive": {"type": ["boolean", "null"]},
    "score": {"type": ["number", "null"]},
    "observationDigest": {"type": ["string", "null"]},
    "observedEffectId": {"type": ["string", "null"]},
    "observedEffectRequestDigest": {"type": ["string", "null"]}
  }
}
