{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ordivon:schema:verifier-binding-set:v1",
  "title": "Task-local Verifier Binding Set v1",
  "description": "Caller-authored exact bindings from task-local verification obligations to natural verifier owners/providers. This is not a registry, ranker, discovery result, or authority grant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "circuitRef",
    "obligationSetDigest",
    "bindings",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "ordivon.task-local-verifier-binding-set" },
    "circuitRef": { "$ref": "#/$defs/boundRef" },
    "obligationSetDigest": { "$ref": "#/$defs/sha256" },
    "bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/binding" }
    },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "boundRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateId",
        "obligationDigest",
        "verifierOwnerId",
        "verifierRef",
        "verifierClass",
        "nativeSpecificationRef",
        "supportScope",
        "nonClaims"
      ],
      "properties": {
        "gateId": { "$ref": "#/$defs/identifier" },
        "obligationDigest": { "$ref": "#/$defs/sha256" },
        "verifierOwnerId": { "$ref": "#/$defs/identifier" },
        "verifierRef": { "$ref": "#/$defs/boundRef" },
        "verifierClass": { "$ref": "#/$defs/identifier" },
        "nativeSpecificationRef": {
          "anyOf": [
            { "$ref": "#/$defs/boundRef" },
            { "type": "null" }
          ]
        },
        "supportScope": { "type": "string", "minLength": 1 },
        "nonClaims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
