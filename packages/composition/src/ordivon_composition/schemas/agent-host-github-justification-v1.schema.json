{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.org/schemas/agent-host-github-justification-v1.schema.json",
  "title": "Non-authoritative Host Agent GitHub Owner workflow justification",
  "description": "GitHub workflow completion at exact SHA, not domain correctness, verified proof of full dependencies or installed-state authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "truthRole",
    "repo",
    "targetSourceCut",
    "workRef",
    "expectedRevision",
    "basisDigest",
    "evidence",
    "claims",
    "summary",
    "proposedWorkSnapshot",
    "proposedHostCommitEligible",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "ordivon.agent-host-github-justification-projection"
    },
    "truthRole": {
      "const": "owner-live-workflow-status-not-program-or-domain-correctness"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?![\\s\\S])"
    },
    "targetSourceCut": {
      "$ref": "#/$defs/gitSha"
    },
    "workRef": {
      "type": "string",
      "pattern": "^work:[^\\s]+(?![\\s\\S])"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 1
    },
    "basisDigest": {
      "$ref": "#/$defs/sha"
    },
    "evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactWorkflowRequirementsSatisfied",
        "unknownOrNotMatching",
        "newVerificationJobsCreated"
      ],
      "properties": {
        "exactWorkflowRequirementsSatisfied": {
          "type": "integer",
          "minimum": 0
        },
        "unknownOrNotMatching": {
          "type": "integer",
          "minimum": 0
        },
        "newVerificationJobsCreated": {
          "const": 0
        }
      }
    },
    "proposedWorkSnapshot": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/workSnapshot"
        }
      ]
    },
    "proposedHostCommitEligible": {
      "type": "boolean"
    },
    "nonClaims": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "proposedHostCommitEligible": {
            "const": true
          }
        },
        "required": [
          "proposedHostCommitEligible"
        ]
      },
      "then": {
        "properties": {
          "proposedWorkSnapshot": {
            "$ref": "#/$defs/workSnapshot"
          }
        }
      },
      "else": {
        "properties": {
          "proposedWorkSnapshot": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})(?![\\s\\S])"
    },
    "runRef": {
      "type": "string",
      "pattern": "^github:run:[1-9][0-9]{0,18}(?![\\s\\S])"
    },
    "optionalText": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceRef",
        "requiredWorkflow",
        "ownerReadStanding",
        "qualification",
        "observedHeadSha",
        "observedWorkflow",
        "observedRunStatus",
        "observedConclusion",
        "ownerUrl"
      ],
      "properties": {
        "evidenceRef": {
          "$ref": "#/$defs/runRef"
        },
        "requiredWorkflow": {
          "type": "string",
          "minLength": 1
        },
        "ownerReadStanding": {
          "enum": [
            "GITHUB_OWNER_READ_SUCCESS",
            "OWNER_UNAVAILABLE_OR_IDENTITY_MISMATCH"
          ]
        },
        "qualification": {
          "enum": [
            "OWNER_UNKNOWN",
            "SOURCE_MISMATCH",
            "WORKFLOW_MISMATCH",
            "MATCHED_CHECK_SUCCESS",
            "CHECK_NOT_SUCCESSFUL",
            "CHECK_NOT_COMPLETE"
          ]
        },
        "observedHeadSha": {
          "$ref": "#/$defs/optionalText"
        },
        "observedWorkflow": {
          "$ref": "#/$defs/optionalText"
        },
        "observedRunStatus": {
          "$ref": "#/$defs/optionalText"
        },
        "observedConclusion": {
          "$ref": "#/$defs/optionalText"
        },
        "ownerUrl": {
          "$ref": "#/$defs/optionalText"
        }
      }
    },
    "justification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "justificationId",
        "standing",
        "evidenceRefs",
        "qualifications"
      ],
      "properties": {
        "justificationId": {
          "type": "string",
          "minLength": 1
        },
        "standing": {
          "enum": [
            "ALL_OWNER_CHECKS_MATCHED",
            "NOT_ALL_OWNER_CHECKS_MATCHED"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/runRef"
          }
        },
        "qualifications": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "consumerRef",
        "supportStanding",
        "agentDecision",
        "justifications",
        "domainClaimVerified",
        "automaticVerifierExecution"
      ],
      "properties": {
        "claimId": {
          "type": "string",
          "minLength": 1
        },
        "consumerRef": {
          "type": "string",
          "pattern": "^work:[^\\s]+(?![\\s\\S])"
        },
        "supportStanding": {
          "enum": [
            "EVIDENCE_REQUIREMENTS_SATISFIED",
            "UNKNOWN"
          ]
        },
        "agentDecision": {
          "enum": [
            "CONSUME_EXISTING_EXACT_GITHUB_CHECK_RESULT",
            "QUALIFY_OWNER_CHECK_NOT_AUTOMATIC_RERUN"
          ]
        },
        "justifications": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/justification"
          }
        },
        "domainClaimVerified": {
          "const": false
        },
        "automaticVerifierExecution": {
          "const": false
        }
      },
      "oneOf": [
        {
          "properties": {
            "supportStanding": {
              "const": "EVIDENCE_REQUIREMENTS_SATISFIED"
            },
            "agentDecision": {
              "const": "CONSUME_EXISTING_EXACT_GITHUB_CHECK_RESULT"
            }
          }
        },
        {
          "properties": {
            "supportStanding": {
              "const": "UNKNOWN"
            },
            "agentDecision": {
              "const": "QUALIFY_OWNER_CHECK_NOT_AUTOMATIC_RERUN"
            }
          }
        }
      ]
    },
    "workSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "frontier",
        "established",
        "unresolved",
        "rejected",
        "constraints",
        "nextActions",
        "referenceRefs"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "frontier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "established": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unresolved": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rejected": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "constraints": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "nextActions": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "referenceRefs": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
