{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ordivon:schema:successor-gate-result:v1",
  "title": "Ordivon Successor Gate Result v1",
  "description": "A verifier-owned result for one exact successor contract gate. The result binds evidence to a narrow support scope and exact evaluation anchors; it does not grant promotion authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "contractId",
    "contractDigest",
    "gateId",
    "verifierOwnerId",
    "standing",
    "anchorRefIds",
    "evidenceRefs",
    "supportScope",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "ordivon.successor-gate-result" },
    "contractId": { "$ref": "#/$defs/identifier" },
    "contractDigest": { "$ref": "#/$defs/sha256" },
    "gateId": { "$ref": "#/$defs/identifier" },
    "verifierOwnerId": { "$ref": "#/$defs/identifier" },
    "standing": {
      "enum": ["SATISFIED", "UNSATISFIED", "UNKNOWN"]
    },
    "anchorRefIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "supportScope": { "type": "string", "minLength": 1 },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "standing": { "enum": ["SATISFIED", "UNSATISFIED"] }
        },
        "required": ["standing"]
      },
      "then": {
        "properties": {
          "evidenceRefs": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    }
  }
}
