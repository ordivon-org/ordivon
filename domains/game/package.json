{
  "name": "ordivon-game",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Game LEGO source-bound research and retrieval; no bundled first-party games",
  "engines": {
    "node": "26.12.1"
  },
  "scripts": {
    "bootstrap": "pnpm install --offline --frozen-lockfile",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "pnpm typecheck && pnpm test",
    "knowledge:external": "node scripts/external-knowledge-query.ts",
    "knowledge:mechanisms": "node scripts/mechanism-experience-query.ts",
    "knowledge:relationships": "node scripts/mechanism-relationship-query.ts",
    "knowledge:counterexamples": "node scripts/design-counterexample-query.ts",
    "knowledge:counterexample-themes": "node scripts/counterexample-synthesis-query.ts",
    "build:relationship-graph": "node scripts/build-mechanism-relationship-graph.ts"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.15.0"
}
