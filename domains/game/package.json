{
  "name": "ordivon-game",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Intervention-driven multi-Agent mission game with deterministic world state and verified replay.",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "start": "node src/server.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "webcheck": "for file in web/*.js web-v3/*.js; do node --check \"$file\"; done",
    "check": "pnpm typecheck && pnpm webcheck && pnpm test",
    "e2e": "node scripts/e2e-first-playable.ts",
    "e2e:v3": "node scripts/e2e-station-zero-v3.ts",
    "e2e:v3:g5": "node scripts/e2e-station-zero-v3-second-slice.ts",
    "eval:v3:fixture-strategies": "node scripts/eval-station-zero-v3-fixture-strategies.ts",
    "eval:v3:g4": "node scripts/eval-station-zero-v3-g4-calibration.ts",
    "eval:v3:product-value": "node scripts/eval-station-zero-v3-product-value.ts",
    "eval:v3:g5-topology": "node scripts/eval-station-zero-v3-topology-axis.ts",
    "eval:v3:g5-doctrine": "node scripts/eval-station-zero-v3-enemy-doctrine-axis.ts",
    "eval:v3:g5-placement": "node scripts/eval-station-zero-v3-placement-axis.ts"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "fast-check": "^4.9.0",
    "typescript": "^7.0.2",
    "playwright": "1.62.0"
  },
  "packageManager": "pnpm@10.33.2"
}
