{
  "name": "ordivon-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-native game experiments built on deterministic world state and Ordivon semantics.",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "start": "node src/server.ts",
    "demo": "node scripts/demo.ts",
    "test": "node --test test/*.test.ts",
    "check": "pnpm typecheck && pnpm webcheck && pnpm coverage",
    "webcheck": "for file in web/*.js; do node --check \"$file\"; done && node scripts/check-m4-web.mjs && node scripts/check-m5-web.mjs",
    "m4:evaluate": "node scripts/m4-evaluation.ts --write",
    "receipt": "node scripts/receipt.ts",
    "release:inputs": "node scripts/release-inputs.ts",
    "typecheck": "tsc --noEmit",
    "fixture:generate": "node scripts/generate-m1-fixture.ts",
    "coverage": "node --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 --test test/*.test.ts",
    "measure": "node scripts/measure.ts",
    "measure:replay": "node scripts/measure-replay.ts",
    "measure:write": "node scripts/measure.ts --write",
    "m2:evaluate": "node scripts/m2-live-evaluation.ts",
    "m21:evaluate": "node scripts/m2-live-evaluation.ts",
    "m3:evaluate": "node scripts/m3-live-evaluation.ts",
    "e2e": "node scripts/e2e-first-playable.ts"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "fast-check": "^4.9.0",
    "typescript": "^7.0.2",
    "playwright": "1.62.0"
  },
  "packageManager": "pnpm@10.33.2"
}
