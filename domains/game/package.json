{
  "name": "ordivon-game",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Research-engineering owner for game semantics, development-core evidence, authoritative interactive worlds, and retained playable experiments.",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "bootstrap": "pnpm install --offline --frozen-lockfile",
    "start": "node products/station-zero-v2/src/server.ts",
    "start:research": "ORDIVON_GAME_RESEARCH_SURFACES=1 node experiments/research-preview/server.ts",
    "test": "node --test test/*.test.ts products/station-zero-v2/test/*.test.ts experiments/station-zero-v3/test/*.test.ts experiments/casefile/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "webcheck": "for file in products/station-zero-v2/web/*.js experiments/station-zero-v3/web/*.js experiments/concept-lab/web/*.js experiments/casefile/web/*.js experiments/pre-g0/web/*.js experiments/pc03-f0/web/*.js experiments/product-composition-r1/pc01-e03-playable-r1/web/*.js; do node --check \"$file\"; done",
    "check": "pnpm typecheck && pnpm webcheck && pnpm test",
    "e2e": "node products/station-zero-v2/scripts/e2e-first-playable.ts",
    "e2e:lab": "node experiments/concept-lab/scripts/e2e-game-core-concept-lab.ts",
    "e2e:pre-g0": "node experiments/pre-g0/scripts/e2e-pre-g0-playable.ts",
    "e2e:pc03-f0": "node experiments/pc03-f0/scripts/e2e-pc03-f0.ts",
    "e2e:casefile": "node experiments/casefile/scripts/e2e-casefile.ts",
    "e2e:production-smoke": "node experiments/production-smoke-r1/run.ts",
    "e2e:v3": "node experiments/station-zero-v3/scripts/e2e-station-zero-v3.ts",
    "e2e:v3:g5": "node experiments/station-zero-v3/scripts/e2e-station-zero-v3-second-slice.ts",
    "eval:v3:fixture-strategies": "node experiments/station-zero-v3/scripts/eval-station-zero-v3-fixture-strategies.ts",
    "eval:v3:g4": "node experiments/station-zero-v3/scripts/eval-station-zero-v3-g4-calibration.ts",
    "eval:v3:product-value": "node experiments/station-zero-v3/scripts/eval-station-zero-v3-product-value.ts",
    "eval:v3:g5-topology": "node experiments/station-zero-v3/scripts/eval-station-zero-v3-topology-axis.ts",
    "eval:v3:g5-doctrine": "node experiments/station-zero-v3/scripts/eval-station-zero-v3-enemy-doctrine-axis.ts",
    "eval:v3:g5-placement": "node experiments/station-zero-v3/scripts/eval-station-zero-v3-placement-axis.ts",
    "eval:pre-g0:ds1": "node scripts/pre-g0/ds1-battery.ts",
    "eval:recomposition:r1": "node experiments/whole-product-recomposition-r1/run.ts",
    "eval:v3:product-value:targeted-controls": "node experiments/station-zero-v3/scripts/eval-station-zero-v3-product-value.ts --lane targeted-controls",
    "eval:v3:product-value:information": "node experiments/station-zero-v3/scripts/eval-station-zero-v3-product-value.ts --lane information",
    "context:current-direction": "node scripts/current-direction-context.ts",
    "explore:composition": "node scripts/composition-explorer.ts",
    "knowledge:external": "node scripts/external-knowledge-query.ts",
    "knowledge:mechanisms": "node scripts/mechanism-experience-query.ts",
    "knowledge:relationships": "node scripts/mechanism-relationship-query.ts",
    "knowledge:counterexamples": "node scripts/design-counterexample-query.ts",
    "knowledge:counterexample-themes": "node scripts/counterexample-synthesis-query.ts",
    "build:relationship-graph": "node scripts/build-mechanism-relationship-graph.ts",
    "context:v3:product-value": "node experiments/station-zero-v3/scripts/product-value-context.ts",
    "eval:v3:external-provider": "node experiments/station-zero-v3/scripts/eval-station-zero-v3-external-provider.ts",
    "e2e:pc01-e03:r1": "node experiments/product-composition-r1/pc01-e03-playable-r1/scripts/e2e-pc01-e03-playable.ts",
    "eval:pc01-e03:r1": "node experiments/product-composition-r1/pc01-e03-playable-r1/scripts/mechanical-acceptance.ts"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "fast-check": "^4.9.0",
    "typescript": "^7.0.2",
    "playwright": "1.62.0"
  },
  "packageManager": "pnpm@10.33.2"
}
