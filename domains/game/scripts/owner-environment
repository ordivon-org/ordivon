#!/usr/bin/env bash
set -euo pipefail
repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
mode=${1:-}
mise_bin=${MISE_BIN:-$(command -v mise || true)}

usage() {
  cat <<'TXT'
usage: scripts/owner-environment bootstrap|doctor|test|cold-start

bootstrap   materialize the exact pnpm lockfile dependency graph through the repository toolchain
doctor      verify exact Node/pnpm authority and required local dependency surfaces
test        bootstrap, doctor, then run typecheck + web syntax + deterministic tests
cold-start  copy the current source fence and prove test without warmed node_modules

Browser/E2E and model-backed evaluation remain explicit capability/evaluation gates.
TXT
}

require_tools() {
  [[ -n "$mise_bin" ]] || { echo 'Game owner environment requires mise' >&2; exit 1; }
}

mise_run() {
  (cd "$repo" && "$mise_bin" exec -- "$@")
}

pnpm_mise() {
  (cd "$repo" && CI=true "$mise_bin" exec -- pnpm "$@")
}

bootstrap() {
  require_tools
  (cd "$repo" && "$mise_bin" install)
  pnpm_mise install --frozen-lockfile
}

doctor() {
  require_tools
  (cd "$repo" && "$mise_bin" exec -- node - <<'JS'
const fs=require('node:fs');
const pkg=JSON.parse(fs.readFileSync('package.json','utf8'));
if (process.version !== 'v26.9.0') throw new Error(`Game expects Node 26.9.0 via mise, got ${process.version}`);
if (pkg.packageManager !== 'pnpm@12.4.2') throw new Error(`unexpected packageManager ${pkg.packageManager}`);
for (const path of ['node_modules/.bin/tsc','node_modules/.modules.yaml']) {
  if (!fs.existsSync(path)) throw new Error(`missing materialized dependency surface: ${path}`);
}
console.log(`owner environment doctor: valid profile=test node=${process.version}`);
JS
  )
  (cd "$repo" && "$mise_bin" exec -- pnpm --version | grep -Fx '12.4.2')
}

run_tests() {
  bootstrap
  doctor
  pnpm_mise check
}

case "$mode" in
  bootstrap) bootstrap ;;
  doctor) doctor ;;
  test) run_tests ;;
  cold-start)
    tmp=$(mktemp -d -t ordivon-game-owner-env-XXXXXX)
    trap 'rm -rf "$tmp"' EXIT
    mkdir -p "$tmp/repo"
    (cd "$repo" && tar --exclude=.git --exclude=node_modules --exclude=dist --exclude=build --exclude=coverage --exclude=artifacts --exclude=replays -cf - .) | tar -xf - -C "$tmp/repo"
    "$tmp/repo/scripts/owner-environment" test
    ;;
  --help|-h) usage ;;
  *) usage >&2; exit 2 ;;
esac
