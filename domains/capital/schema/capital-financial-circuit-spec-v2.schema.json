{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ordivon:capital:schema:financial-circuit-spec:v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "circuitId",
    "goalClass",
    "requestedUse",
    "terminalClaim",
    "stages",
    "authorityBindings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "kind": {
      "const": "ordivon.capital.financial-circuit-spec"
    },
    "circuitId": {
      "type": "string",
      "minLength": 1
    },
    "goalClass": {
      "type": "string",
      "minLength": 1
    },
    "requestedUse": {
      "type": "string",
      "minLength": 1
    },
    "terminalClaim": {
      "type": "string",
      "minLength": 1
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "authorityBindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/authorityBinding"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "legoId",
        "operation",
        "dependsOn",
        "inputs",
        "outputs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "legoId": {
          "$ref": "#/$defs/identifier"
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "operation": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "authorityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityClass",
        "authorityOwnerId",
        "contractPath"
      ],
      "properties": {
        "authorityClass": {
          "$ref": "#/$defs/identifier"
        },
        "authorityOwnerId": {
          "$ref": "#/$defs/identifier"
        },
        "contractPath": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
