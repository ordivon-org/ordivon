{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ordivon:capital:schema:office-role:v1",
  "title": "Capital OfficeRole v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "roleId",
    "line",
    "mandate",
    "allowedDelegationLevels",
    "vetoClasses",
    "prohibitedAuthorities",
    "incompatibleSameDecisionRoles",
    "independenceRequired"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "ordivon.capital.office-role"
    },
    "roleId": {
      "enum": [
        "GOVERNING_BODY",
        "CAPITAL_ALLOCATION_COMMITTEE",
        "CHIEF_CAPITAL_OFFICE",
        "RESEARCH_OFFICE",
        "ALLOCATION_OFFICE",
        "RISK_OFFICE",
        "TREASURY_OFFICE",
        "EFFECT_OFFICE",
        "CONTROLLER",
        "PERFORMANCE_ATTRIBUTION",
        "MODEL_DATA_GOVERNANCE",
        "EXTERNAL_PROFESSIONAL_LIAISON",
        "INDEPENDENT_ASSURANCE"
      ]
    },
    "line": {
      "enum": [
        "GOVERNING_BODY",
        "FIRST_LINE",
        "SECOND_LINE",
        "THIRD_LINE"
      ]
    },
    "mandate": {
      "type": "string",
      "minLength": 1
    },
    "allowedDelegationLevels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "L0_OBSERVE",
          "L1_ANALYZE",
          "L2_RECOMMEND",
          "L3_PREPARE",
          "L4_EXECUTE_BOUNDED",
          "L5_CHANGE_CONSTITUTION"
        ]
      }
    },
    "vetoClasses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prohibitedAuthorities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "incompatibleSameDecisionRoles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "GOVERNING_BODY",
          "CAPITAL_ALLOCATION_COMMITTEE",
          "CHIEF_CAPITAL_OFFICE",
          "RESEARCH_OFFICE",
          "ALLOCATION_OFFICE",
          "RISK_OFFICE",
          "TREASURY_OFFICE",
          "EFFECT_OFFICE",
          "CONTROLLER",
          "PERFORMANCE_ATTRIBUTION",
          "MODEL_DATA_GOVERNANCE",
          "EXTERNAL_PROFESSIONAL_LIAISON",
          "INDEPENDENT_ASSURANCE"
        ]
      }
    },
    "independenceRequired": {
      "type": "boolean"
    }
  }
}
