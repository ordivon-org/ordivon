{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["source", "features"],
  "properties": {
    "source": {"const": "SEC Company Facts API"},
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["symbol", "cik", "entity_name", "fiscal_year", "period_end", "accession", "net_income", "assets", "stockholders_equity", "roa_proxy", "roe_proxy", "equity_to_assets"],
        "properties": {
          "symbol": {"type": "string"},
          "cik": {"type": "string", "pattern": "^[0-9]{10}$"},
          "entity_name": {"type": "string"},
          "fiscal_year": {"type": "integer"},
          "period_end": {"type": "string"},
          "accession": {"type": "string"},
          "net_income": {"type": "number"},
          "assets": {"type": "number"},
          "stockholders_equity": {"type": "number"},
          "roa_proxy": {"type": "number"},
          "roe_proxy": {"type": "number"},
          "equity_to_assets": {"type": "number"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
