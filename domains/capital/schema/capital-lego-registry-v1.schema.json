{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ordivon.capital.schema.capital-lego-registry-v1",
  "title": "Ordivon Capital LEGO Registry v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "truthRole",
    "schemaIdentity",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "ordivon.capital.lego-registry"
    },
    "truthRole": {
      "const": "REBUILDABLE_REGISTRY_PROJECTION_NOT_AUTHORITY"
    },
    "schemaIdentity": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "const": "schema/capital-lego-registry-v1.schema.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "legoId",
          "ownerDomain",
          "sourceClass",
          "status",
          "functionalRoles",
          "implementation",
          "authorityRequirement",
          "effectClass",
          "sideEffects",
          "replayClass",
          "currentnessRequirement",
          "riskTier",
          "inputContracts",
          "outputContracts",
          "evidenceObligations",
          "permittedUses",
          "prohibitedUses"
        ],
        "additionalProperties": false,
        "properties": {
          "legoId": {
            "type": "string",
            "pattern": "^capital\\.[a-z0-9_.-]+$"
          },
          "ownerDomain": {
            "enum": [
              "markets",
              "trading",
              "portfolio",
              "risk",
              "research",
              "governance",
              "accounting"
            ]
          },
          "sourceClass": {
            "enum": [
              "CANONICAL",
              "CANDIDATE",
              "HISTORICAL_RETIRED"
            ]
          },
          "status": {
            "enum": [
              "ACTIVE",
              "VALIDATION_REQUIRED",
              "BLOCKED_BY_AUTHORITY",
              "CHALLENGER",
              "RETIRED"
            ]
          },
          "functionalRoles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "Observe",
                "Normalize",
                "Validate",
                "Measure",
                "Model",
                "Counterfactual",
                "Decide",
                "Authorize",
                "Reserve",
                "Effect",
                "Reconcile",
                "Account"
              ]
            }
          },
          "implementation": {
            "type": "object",
            "required": [
              "path",
              "symbol"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "authorityRequirement": {
            "enum": [
              "NONE",
              "PUBLIC_READ",
              "PRIVATE_READ",
              "LOCAL_STATE",
              "SIMULATED_EFFECT",
              "DEMO_WRITE",
              "LIVE_QUALIFICATION_WRITE",
              "PRODUCTION_WRITE"
            ]
          },
          "effectClass": {
            "enum": [
              "NONE",
              "LOCAL_STATE",
              "SIMULATED_EXCHANGE_ORDER_EFFECT",
              "DEMO_EXTERNAL_WRITE",
              "LIVE_QUALIFICATION_WRITE",
              "PRODUCTION_FINANCIAL_WRITE"
            ]
          },
          "sideEffects": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "NETWORK_READ",
                "LOCAL_FILE_WRITE",
                "LOCAL_DB_WRITE",
                "PROVIDER_WRITE"
              ]
            }
          },
          "replayClass": {
            "enum": [
              "PURE_DETERMINISTIC",
              "OBSERVATION",
              "LOCAL_IDEMPOTENT",
              "EXTERNAL_RECONCILE_REQUIRED",
              "HISTORICAL_ONLY"
            ]
          },
          "currentnessRequirement": {
            "enum": [
              "NONE",
              "IMMUTABLE_INPUT",
              "FRESH_PROVIDER",
              "EPISODE_BOUND"
            ]
          },
          "riskTier": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "inputContracts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outputContracts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidenceObligations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "permittedUses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "prohibitedUses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
