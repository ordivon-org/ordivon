{
  "schemaVersion": 1,
  "kind": "ordivon.capital.functional-lego-map",
  "truthRole": "COMPOSITION_LENS_NOT_SOURCE_OWNER_TAXONOMY",
  "asOfDate": "2026-09-23",
  "sourceOwnerTaxonomy": "config/capital_domain_taxonomy.json",
  "principle": "Seven domains own source/business responsibility. Functional LEGOs describe composable computation/effect roles and must not rename or replace those owners.",
  "functionalLegos": {
    "Observe": {
      "primaryDomains": [
        "markets",
        "trading",
        "research"
      ],
      "responsibility": "Acquire bounded public/private/provider observations without inventing provider truth."
    },
    "Normalize": {
      "primaryDomains": [
        "markets",
        "trading"
      ],
      "responsibility": "Map provider/native representations into bounded domain documents without changing authority."
    },
    "Validate": {
      "primaryDomains": [
        "markets",
        "trading",
        "risk",
        "research",
        "governance"
      ],
      "responsibility": "Check contracts, currentness, completeness, model-use and policy preconditions; validation does not create external truth."
    },
    "Measure": {
      "primaryDomains": [
        "markets",
        "risk",
        "research"
      ],
      "responsibility": "Compute descriptive/statistical quantities from admitted inputs."
    },
    "Model": {
      "primaryDomains": [
        "risk",
        "research"
      ],
      "responsibility": "Run registered quantitative models under explicit validation standing and use restrictions."
    },
    "Counterfactual": {
      "primaryDomains": [
        "portfolio"
      ],
      "responsibility": "Project caller-supplied what-if portfolio transformations without ranking or recommending them."
    },
    "Decide": {
      "primaryDomains": [
        "portfolio",
        "research"
      ],
      "responsibility": "Represent a frozen caller/agent decision boundary; there is no general autonomous decision engine in current Capital.",
      "standing": "BOUNDARY_NO_GENERAL_IMPLEMENTATION_OWNER"
    },
    "Authorize": {
      "primaryDomains": [
        "governance"
      ],
      "responsibility": "Evaluate bounded policy/mandate/risk/effect admission without inventing owner or provider grants."
    },
    "Reserve": {
      "primaryDomains": [
        "accounting"
      ],
      "responsibility": "Establish durable local capital reservation identity before admitted effects."
    },
    "Effect": {
      "primaryDomains": [
        "trading"
      ],
      "responsibility": "Realize an already-authorized provider effect; current canonical production/live implementation is intentionally absent.",
      "standing": "NONLIVE_ONLY_NO_CANONICAL_PRODUCTION_IMPLEMENTATION"
    },
    "Reconcile": {
      "primaryDomains": [
        "trading",
        "markets",
        "accounting"
      ],
      "responsibility": "Compare expected/effect identity with authoritative observations and fail closed on ambiguity."
    },
    "Account": {
      "primaryDomains": [
        "accounting"
      ],
      "responsibility": "Apply durable local reservation/post/void accounting instructions; not settlement or venue truth."
    }
  },
