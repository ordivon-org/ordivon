{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ordivon:capital:r3:draft:schema:capital-constitution:v1",
  "title": "Draft Capital Constitution v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "constitutionId", "principalAuthorityId", "purpose", "goals", "protectedResourceRules", "preferences", "prohibitions", "riskAppetite", "delegationPolicy", "effectClassPolicy", "reviewPolicy", "evidenceDigest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "ordivon.capital.constitution"},
    "constitutionId": {"$ref": "#/$defs/identifier"},
    "principalAuthorityId": {"$ref": "#/$defs/identifier"},
    "purpose": {"type": "string", "minLength": 1},
    "goals": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "protectedResourceRules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
    "preferences": {"type": "array", "items": {"$ref": "#/$defs/explicitPreference"}},
    "prohibitions": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
    "riskAppetite": {"type": "array", "items": {"$ref": "#/$defs/explicitPreference"}},
    "delegationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultMaximumLevel", "l5RequiresExplicitConstitutionalGrant"],
      "properties": {
        "defaultMaximumLevel": {"enum": ["L0_OBSERVE", "L1_ANALYZE", "L2_RECOMMEND", "L3_PREPARE", "L4_EXECUTE_BOUNDED"]},
        "l5RequiresExplicitConstitutionalGrant": {"const": true}
      }
    },
    "effectClassPolicy": {"type": "array", "items": {"$ref": "#/$defs/effectPolicy"}},
    "reviewPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cadence", "eventDrivenReviewRequired"],
      "properties": {
        "cadence": {"type": "string", "minLength": 1},
        "eventDrivenReviewRequired": {"type": "boolean"}
      }
    },
    "continuityPolicyRef": {"type": ["string", "null"]},
    "evidenceDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "scope", "statement"],
      "properties": {
        "ruleId": {"$ref": "#/$defs/identifier"},
        "scope": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "explicitPreference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preferenceId", "scope", "statement", "preferenceSource"],
      "properties": {
        "preferenceId": {"$ref": "#/$defs/identifier"},
        "scope": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "preferenceSource": {"const": "EXPLICIT_PRINCIPAL"}
      }
    },
    "effectPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effectClass", "standing", "maxDelegationLevel"],
      "properties": {
        "effectClass": {"type": "string", "minLength": 1},
        "standing": {"enum": ["BLOCKED", "NON_LIVE_ONLY", "BOUNDED", "SEPARATE_APPROVAL_REQUIRED"]},
        "maxDelegationLevel": {"enum": ["L0_OBSERVE", "L1_ANALYZE", "L2_RECOMMEND", "L3_PREPARE", "L4_EXECUTE_BOUNDED"]}
      }
    }
  }
}
