#!/usr/bin/env bash
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
python3 - "$repo/config/nonlive_credential_provisioning.json" <<'PY'
from pathlib import Path
import json,sys,os
def require(condition, label):
    if not condition:
        raise SystemExit("Capital policy rejected: " + str(label))

x=json.load(open(sys.argv[1]))
require(x['userAuthorization']=='DEMO_TESTNET_EXTERNAL_WRITES_AUTHORIZED', "x['userAuthorization']=='DEMO_TESTNET_EXTERNAL_WRITES_AUTHORIZED'")
require(x['liveWriteAuthorization']=='NOT_GRANTED', "x['liveWriteAuthorization']=='NOT_GRANTED'")
require(x['externalFinancialWritesAllowed'] is False, "x['externalFinancialWritesAllowed'] is False")
b=Path(x['venues']['BINANCE']['secretRoot'])
o=Path(x['venues']['OKX']['secretRoot'])
checks={
 'binanceTestnetRoot':b.is_dir(),
 'binancePrivateKeyPresent':(b/'private.pem').is_file(),
 'binancePublicKeyPresent':(b/'public.pem').is_file(),
 'binanceServerApiKeyPresent':(b/'api_key').is_file(),
 'okxDemoRoot':o.is_dir(),
 'okxDemoConfigPresent':(o/'config.toml').is_file(),
}
if (b/'private.pem').is_file(): require(((b/'private.pem').stat().st_mode & 0o077)==0, "((b/'private.pem').stat().st_mode & 0o077)==0")
if (b/'api_key').is_file(): require(((b/'api_key').stat().st_mode & 0o077)==0, "((b/'api_key').stat().st_mode & 0o077)==0")
if (o/'config.toml').is_file(): require(((o/'config.toml').stat().st_mode & 0o077)==0, "((o/'config.toml').stat().st_mode & 0o077)==0")
ready=checks['binanceServerApiKeyPresent'] or checks['okxDemoConfigPresent']
standing='NONLIVE_CREDENTIAL_PRESENT_PENDING_QUALIFICATION' if ready else 'BLOCKED_SERVER_SIDE_NONLIVE_API_KEYS_NOT_PROVISIONED'
print(json.dumps({'standing':standing,**checks,'liveCredentialReuseForbidden':True,'externalFinancialWritesAllowed':False},sort_keys=True))
PY
