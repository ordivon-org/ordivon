#!/usr/bin/env bash
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
out="${1:-$repo/.artifacts/fred-energy-r1/latest.json}"
binding="$("$repo/scripts/check-network-v2-public-data")"
proxy="$(printf '%s' "$binding" | /usr/bin/jq -r '.authorities.fredPublicCsv.proxy')"
if [[ -z "$proxy" || "$proxy" == "null" ]]; then
  echo "FRED Network v2 public CSV proxy missing" >&2
  exit 3
fi
readiness="$(printf '%s' "$binding" | /usr/bin/jq -r '.readinessCommand')"
"$readiness" fred 45 >/dev/null
PYTHONPATH="$repo/src" /usr/bin/python3 -m ordivon_capital.markets.fred_energy --proxy "$proxy" --output "$out"
