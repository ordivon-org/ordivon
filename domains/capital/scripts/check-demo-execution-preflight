#!/usr/bin/env bash
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
python3 - "$repo/config/demo_execution_policy.json" <<'PY'
import json,sys
x=json.load(open(sys.argv[1]))
assert x['standing']=='PREPARED_NOT_ADMITTED'
assert x['demoWriteAdmission']=='NOT_ADMITTED'
assert x['liveWriteAdmission']=='NOT_ADMITTED'
assert x['externalFinancialWritesAllowed'] is False
assert x['venues']['OKX']['environment']=='DEMO'
assert x['venues']['BINANCE']['environment']=='TESTNET'
assert x['venues']['BINANCE']['productType']=='SPOT'
assert x['venues']['OKX']['orderSubmissionAllowed'] is False
assert x['venues']['BINANCE']['orderSubmissionAllowed'] is False
print(json.dumps({'policyStanding':x['standing'],'demoWriteAdmission':x['demoWriteAdmission'],'externalFinancialWritesAllowed':False},sort_keys=True))
PY
