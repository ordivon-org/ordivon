#!/usr/bin/env bash
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
if [[ $# -lt 1 || $# -gt 4 ]]; then
  echo "usage: run-okx-instrument-sensors-r1 INSTRUMENT [OUTPUT_JSON] [ROUNDS] [INTERVAL_SECONDS]" >&2
  exit 2
fi
instrument="$1"
out="${2:-$repo/.artifacts/okx-public-sensors-r1/${instrument}.json}"
rounds="${3:-5}"
interval="${4:-1.0}"

binding="$("$repo/scripts/check-network-v2-public-data")"
proxy="$(printf '%s' "$binding" | /usr/bin/jq -r '.authorities.okxRest.proxy')"
if [[ -z "$proxy" || "$proxy" == "null" ]]; then
  echo "OKX Network v2 public REST proxy missing" >&2
  exit 3
fi

readiness="$(printf '%s' "$binding" | /usr/bin/jq -r '.readinessCommand')"
"$readiness" okx 30 >/dev/null
PYTHONPATH="$repo/src" /usr/bin/python3 -m ordivon_capital.markets.okx_sensor_capture \
  --instrument "$instrument" \
  --proxy "$proxy" \
  --output "$out" \
  --rounds "$rounds" \
  --interval-seconds "$interval"
