#!/usr/bin/env bash
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
tb=/usr/local/bin/tigerbeetle
tb_py=/opt/ordivon/external/tigerbeetle/0.17.9/python-client/bin/python

tmp="$(mktemp -d)"
data="$tmp/0_0.tigerbeetle"
matrix="$tmp/nonlive-effect-matrix.json"
pid=""
cleanup(){
  if [[ -n "$pid" ]]; then kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; fi
  rm -rf "$tmp"
}
trap cleanup EXIT

"$repo/scripts/run-nautilus-nonlive-effect-matrix" > "$matrix"

port="$($tb_py - <<'PY'
import socket
s=socket.socket(); s.bind(('127.0.0.1',0)); print(s.getsockname()[1]); s.close()
PY
)"
wait_ready(){
  TB_PORT="$port" "$tb_py" - <<'PY'
import os,socket,time
p=int(os.environ['TB_PORT']); deadline=time.time()+10
while time.time()<deadline:
    try:
        with socket.create_connection(('127.0.0.1',p),0.2): raise SystemExit(0)
    except OSError: time.sleep(0.05)
raise SystemExit('TigerBeetle did not become reachable')
PY
}
start_tb(){ "$tb" start --addresses="127.0.0.1:$port" --development "$data" >"$tmp/server.log" 2>&1 & pid=$!; wait_ready; }
stop_tb(){ kill "$pid"; wait "$pid" 2>/dev/null || true; pid=""; }

"$tb" format --cluster=0 --replica=0 --replica-count=1 --development "$data" >"$tmp/format.log" 2>&1
start_tb

PYTHONPATH="$repo/src" TB_PORT="$port" MATRIX="$matrix" "$tb_py" - <<'PY'
import json, os
import tigerbeetle as tb

from market_capital.semantic import EffectDisposition
from market_capital.tigerbeetle_durable import CapitalAccountNamespace, CapitalAccountRole, binding_for_namespace
from market_capital.tigerbeetle_substrate import reservation_instruction, resolution_instruction, stable_provider_id

port=os.environ['TB_PORT']
matrix=json.load(open(os.environ['MATRIX']))
expected={
    'FILL':'CONSUME',
    'PARTIAL_FILL_SLICES':'CONSUME',
    'CANCEL':'RELEASE',
    'DENY':'RELEASE',
    'UNKNOWN_AFTER_SUBMISSION':'RETAIN',
}
assert matrix['standing']=='PASS_NAUTILUS_NONLIVE_EFFECT_RECONCILIATION_MATRIX'
assert matrix['observedDispositions']==expected

ledger=41; account_code=718; transfer_code=720; reservation_amount=100
funding_id=stable_provider_id('market-capital:nonlive-effect:funding','qualification-v1')

def account_wire(a):
    flags=tb.AccountFlags.HISTORY
    if a.debits_must_not_exceed_credits: flags |= tb.AccountFlags.DEBITS_MUST_NOT_EXCEED_CREDITS
    return tb.Account(id=a.account_id,ledger=a.ledger,code=a.code,flags=flags)

def transfer_wire(i):
    w=dict(i.as_wire_record()); w['flags']=getattr(tb.TransferFlags,w.pop('flag_name')); return tb.Transfer(**w)

namespaces={}
bindings={}
accounts=[tb.Account(id=funding_id,ledger=ledger,code=account_code,flags=tb.AccountFlags.HISTORY)]
for scenario in expected:
    ns=CapitalAccountNamespace('owner:qualification',f'parcel:nonlive:{scenario.lower()}',ledger,account_code)
    namespaces[scenario]=ns
    accounts.extend([account_wire(ns.account(CapitalAccountRole.AVAILABLE)),account_wire(ns.account(CapitalAccountRole.ENCUMBRANCE))])
    bindings[scenario]=binding_for_namespace(
        namespace=ns,
        reservation_ref=f'reservation:nonlive:{scenario.lower()}',
        amount=reservation_amount,
        transfer_code=transfer_code,
    )

with tb.ClientSync(cluster_id=0,replica_addresses=f'127.0.0.1:{port}') as c:
    rs=c.create_accounts(accounts)
    assert all(r.status == tb.CreateAccountStatus.CREATED for r in rs), [r.status.name for r in rs]
    funds=[]
    for scenario,ns in namespaces.items():
        funds.append(tb.Transfer(
            id=stable_provider_id('market-capital:nonlive-effect:fund',scenario),
            debit_account_id=funding_id,
            credit_account_id=ns.available_account_id,
            amount=reservation_amount,
            ledger=ledger,
            code=transfer_code,
        ))
    fr=c.create_transfers(funds)
    assert all(r.status == tb.CreateTransferStatus.CREATED for r in fr), [r.status.name for r in fr]

    pending=[transfer_wire(reservation_instruction(bindings[s])) for s in expected]
    pr=c.create_transfers(pending)
    assert all(r.status == tb.CreateTransferStatus.CREATED for r in pr), [r.status.name for r in pr]

    for scenario, disposition_name in expected.items():
        disposition=EffectDisposition(disposition_name)
        instruction=resolution_instruction(
            binding=bindings[scenario],
            disposition=disposition,
            resolution_ref=f'effect:nonlive:{scenario.lower()}',
        )
        if disposition is EffectDisposition.RETAIN:
            assert instruction is None
            continue
        status=c.create_transfers([transfer_wire(instruction)])[0].status
        assert status == tb.CreateTransferStatus.CREATED, (scenario,status.name)
PY

stop_tb
start_tb

PYTHONPATH="$repo/src" TB_PORT="$port" MATRIX="$matrix" "$tb_py" - <<'PY'
import json, os
import tigerbeetle as tb

from market_capital.semantic import EffectDisposition
from market_capital.tigerbeetle_durable import (
    CapitalAccountNamespace,
    DurableProviderStanding,
    DurableReservationHistory,
    ProviderTransferObservation,
    SemanticReservationStanding,
    binding_for_namespace,
    reconcile_durable_history,
)
from market_capital.tigerbeetle_substrate import TigerBeetleOperation, reservation_instruction, resolution_instruction

port=os.environ['TB_PORT']
matrix=json.load(open(os.environ['MATRIX']))
dispositions=matrix['observedDispositions']
ledger=41; account_code=718; transfer_code=720; reservation_amount=100
results={}

with tb.ClientSync(cluster_id=0,replica_addresses=f'127.0.0.1:{port}') as c:
    for scenario, disposition_name in dispositions.items():
        ns=CapitalAccountNamespace('owner:qualification',f'parcel:nonlive:{scenario.lower()}',ledger,account_code)
        binding=binding_for_namespace(
            namespace=ns,
            reservation_ref=f'reservation:nonlive:{scenario.lower()}',
            amount=reservation_amount,
            transfer_code=transfer_code,
        )
        pending_rows=c.lookup_transfers([binding.pending_transfer_id])
        assert len(pending_rows)==1, scenario
        p=pending_rows[0]
        assert int(p.flags) & int(tb.TransferFlags.PENDING), scenario
        pending=ProviderTransferObservation(p.id,TigerBeetleOperation.PENDING,p.amount,p.pending_id)

        disposition=EffectDisposition(disposition_name)
        if disposition is EffectDisposition.RETAIN:
            history=DurableReservationHistory(binding,SemanticReservationStanding.RESERVED)
            resolution=None
        else:
            resolution_ref=f'effect:nonlive:{scenario.lower()}'
            expected_resolution=resolution_instruction(binding=binding,disposition=disposition,resolution_ref=resolution_ref)
            assert expected_resolution is not None
            rows=c.lookup_transfers([expected_resolution.transfer_id])
            assert len(rows)==1, scenario
            r=rows[0]
            operation=(TigerBeetleOperation.POST_PENDING_TRANSFER if disposition is EffectDisposition.CONSUME else TigerBeetleOperation.VOID_PENDING_TRANSFER)
            required_flag=(tb.TransferFlags.POST_PENDING_TRANSFER if disposition is EffectDisposition.CONSUME else tb.TransferFlags.VOID_PENDING_TRANSFER)
            assert int(r.flags) & int(required_flag), (scenario,int(r.flags),int(required_flag))
            resolution=ProviderTransferObservation(r.id,operation,r.amount,r.pending_id)
            standing=(SemanticReservationStanding.CONSUMED if disposition is EffectDisposition.CONSUME else SemanticReservationStanding.RELEASED)
            history=DurableReservationHistory(binding,standing,resolution_ref)

        rec=reconcile_durable_history(history=history,pending=pending,resolution=resolution)
        assert rec.standing is DurableProviderStanding.MATCH, (scenario,rec)
        accounts={a.id:a for a in c.lookup_accounts([ns.available_account_id,ns.encumbrance_account_id])}
        available=accounts[ns.available_account_id]
        enc=accounts[ns.encumbrance_account_id]
        if disposition is EffectDisposition.CONSUME:
            assert available.debits_posted == reservation_amount and available.debits_pending == 0
            assert enc.credits_posted == reservation_amount and enc.credits_pending == 0
        elif disposition is EffectDisposition.RELEASE:
            assert available.debits_posted == 0 and available.debits_pending == 0
            assert enc.credits_posted == 0 and enc.credits_pending == 0
        else:
            assert available.debits_posted == 0 and available.debits_pending == reservation_amount
            assert enc.credits_posted == 0 and enc.credits_pending == reservation_amount

        results[scenario]={
            'effectDisposition':disposition.value,
            'semanticStanding':history.standing.value,
            'providerReconciliation':rec.standing.value,
            'providerRepairAllowed':rec.provider_repair_allowed,
            'debitsPosted':available.debits_posted,
            'debitsPending':available.debits_pending,
            'creditsPosted':enc.credits_posted,
            'creditsPending':enc.credits_pending,
        }

    # Exact replay of one consumed resolution must be idempotent after restart.
    scenario='FILL'
    ns=CapitalAccountNamespace('owner:qualification',f'parcel:nonlive:{scenario.lower()}',ledger,account_code)
    binding=binding_for_namespace(namespace=ns,reservation_ref='reservation:nonlive:fill',amount=reservation_amount,transfer_code=transfer_code)
    instruction=resolution_instruction(binding=binding,disposition=EffectDisposition.CONSUME,resolution_ref='effect:nonlive:fill')
    w=dict(instruction.as_wire_record()); w['flags']=getattr(tb.TransferFlags,w.pop('flag_name'))
    replay=c.create_transfers([tb.Transfer(**w)])[0].status
    assert replay == tb.CreateTransferStatus.EXISTS

print(json.dumps({
    'schemaVersion':1,
    'kind':'ordivon.market-capital.nonlive-capital-effect-matrix',
    'standing':'PASS_NONLIVE_EFFECT_TO_CAPITAL_RESTART_MATRIX',
    'sourceEffectMatrixStanding':matrix['standing'],
    'providerVersion':'0.17.9',
    'restartCount':1,
    'scenarios':results,
    'exactConsumeReplayStatus':replay.name,
    'nonLiveProviderWriteAttempted':True,
    'tigerBeetleMutationAttempted':True,
    'externalFinancialWriteAttempted':False,
    'realMoney':False,
    'liveEndpoint':False,
},sort_keys=True,allow_nan=False))
PY
