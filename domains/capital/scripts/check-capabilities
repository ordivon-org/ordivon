#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mise_bin="${ORDIVON_CAPITAL_MISE:-$(command -v mise || true)}"
market_python="$root/.venv/bin/python"

cd "$root"
if [[ -z "$mise_bin" || ! -x "$mise_bin" ]]; then
  echo "mise unavailable; Ordivon Capital toolchain authority requires mise" >&2
  exit 2
fi
"$mise_bin" exec -- uv sync --frozen --group research --group test >/dev/null

"$market_python" - <<'PY'
import importlib.metadata as metadata
import importlib.util
import json
import sqlite3
import sys

expected = {
    "numpy": "2.5.3",
    "scipy": "1.18.1",
    "scikit-learn": "1.9.1",
    "pyarrow": "25.0.1",
    "pytest": "9.1.1",
    "websockets": "17.1",
}
modules = {
    "numpy": "numpy",
    "scipy": "scipy",
    "scikit-learn": "sklearn",
    "pyarrow": "pyarrow",
    "pytest": "pytest",
    "websockets": "websockets",
}
missing = [dist for dist, mod in modules.items() if importlib.util.find_spec(mod) is None]
versions = {dist: metadata.version(dist) for dist in expected if dist not in missing}
print(json.dumps({
    "python": sys.version.split()[0],
    "marketOwnedPythonModules": {dist: dist not in missing for dist in modules},
    "versions": versions,
}, sort_keys=True))
if sys.version.split()[0] != "3.14.7":
    raise SystemExit(f"unexpected Market Python version: {sys.version.split()[0]}")
if sqlite3.sqlite_version != "3.53.1":
    raise SystemExit(f"unexpected SQLite version: {sqlite3.sqlite_version}")
print(json.dumps({"sqlite": sqlite3.sqlite_version, "sqliteBinding": "stdlib sqlite3"}, sort_keys=True))
if missing:
    raise SystemExit("missing Market-owned modules: " + ", ".join(missing))
drift = {dist: (expected[dist], versions[dist]) for dist in expected if versions[dist] != expected[dist]}
if drift:
    raise SystemExit("Market dependency version drift: " + repr(drift))
PY
