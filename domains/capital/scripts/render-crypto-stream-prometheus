#!/usr/bin/env python3
from __future__ import annotations
import argparse,json
from pathlib import Path

ROOT=Path(__file__).resolve().parents[1]

def load(path: Path): return json.loads(path.read_text())

def b(v): return 1 if bool(v) else 0

def main():
    ap=argparse.ArgumentParser(); ap.add_argument('--output',type=Path); args=ap.parse_args()
    r2=load(ROOT/'evidence/crypto-public-shadow-r2-20260914.json')
    r3=load(ROOT/'evidence/crypto-stream-resilience-r3-20260914.json')
    clock=load(ROOT/'evidence/clock-quality-audit-20260913.json')
    authority=load(ROOT/'config/execution_authority.json')
    r2_ok=r2['standing']=='PASS_STREAMING_REPEATED_PUBLIC_SHADOW_WITH_WORKLOAD_FAILOVER'
    authority_write_admitted=(
        authority.get('currentLane') != 'NON_LIVE'
        and authority.get('externalFinancialWriteAdmission') == 'ADMITTED'
        and authority.get('liveGrantMechanism') != 'NOT_IMPLEMENTED'
    )
    clock_private_admitted=bool(
        clock['consequence']['demoExecutionAdmission']
        and clock['consequence']['liveExecutionAdmission']
    )
    private_allowed=authority_write_admitted and clock_private_admitted
    lines=[
      '# HELP ordivon_market_capital_crypto_public_stream_r2_qualified Whether repeated public streaming R2 is qualified.',
      '# TYPE ordivon_market_capital_crypto_public_stream_r2_qualified gauge',
      f'ordivon_market_capital_crypto_public_stream_r2_qualified {b(r2_ok)}',
      '# HELP ordivon_market_capital_crypto_stream_source_span_max_ms Maximum accepted measured exchange source-time span in R2.',
      '# TYPE ordivon_market_capital_crypto_stream_source_span_max_ms gauge',
      f"ordivon_market_capital_crypto_stream_source_span_max_ms {float(r2['summary']['maxMeasuredSourceTimeSpanMs'])}",
      '# HELP ordivon_market_capital_crypto_stream_receive_span_max_ms Maximum accepted measured local monotonic receive-time span in R2.',
      '# TYPE ordivon_market_capital_crypto_stream_receive_span_max_ms gauge',
      f"ordivon_market_capital_crypto_stream_receive_span_max_ms {float(r2['summary']['maxMeasuredReceiveTimeSpanMs'])}",
      '# HELP ordivon_market_capital_crypto_stream_resilience_local_fault_model_qualified Whether deterministic public-stream fault semantics are qualified.',
      '# TYPE ordivon_market_capital_crypto_stream_resilience_local_fault_model_qualified gauge',
      f"ordivon_market_capital_crypto_stream_resilience_local_fault_model_qualified {b(r3['localFaultModelQualified'])}",
      '# HELP ordivon_market_capital_crypto_stream_reconnect_live_qualified Whether live public-stream reconnect fault injection has graduated.',
      '# TYPE ordivon_market_capital_crypto_stream_reconnect_live_qualified gauge',
      f"ordivon_market_capital_crypto_stream_reconnect_live_qualified {b(r3['liveReconnectQualified'])}",
      '# HELP ordivon_market_capital_crypto_stream_reconnect_latency_ms Observed injected-disconnect reconnect latency in the graduated R3 public stream test.',
      '# TYPE ordivon_market_capital_crypto_stream_reconnect_latency_ms gauge',
      f"ordivon_market_capital_crypto_stream_reconnect_latency_ms{{venue=\"okx\"}} {float(r3.get('venues',{}).get('okx',{}).get('reconnectLatencyMs',0.0))}",
      f"ordivon_market_capital_crypto_stream_reconnect_latency_ms{{venue=\"binance\"}} {float(r3.get('venues',{}).get('binance',{}).get('reconnectLatencyMs',0.0))}",
      '# HELP ordivon_market_capital_crypto_surfpath_control_plane_blocked Whether R3 is currently blocked before workload by Surfpath control-plane serialization.',
      '# TYPE ordivon_market_capital_crypto_surfpath_control_plane_blocked gauge',
      f"ordivon_market_capital_crypto_surfpath_control_plane_blocked {b(r3['standing']=='BLOCKED_SURFPATH_CONTROL_PLANE_CONTENTION')}",
      '# HELP ordivon_market_capital_crypto_clock_offset_abs_ms Maximum observed absolute host clock offset in the current clock audit.',
      '# TYPE ordivon_market_capital_crypto_clock_offset_abs_ms gauge',
      f"ordivon_market_capital_crypto_clock_offset_abs_ms {float(clock['observedAbsOffsetMsMax'])}",
      '# HELP ordivon_market_capital_crypto_execution_authority_write_admitted Whether execution authority currently admits external financial writes.',
      '# TYPE ordivon_market_capital_crypto_execution_authority_write_admitted gauge',
      f'ordivon_market_capital_crypto_execution_authority_write_admitted {b(authority_write_admitted)}',
      '# HELP ordivon_market_capital_crypto_clock_private_gate_passed Whether the clock audit admits private/demo/live timing.',
      '# TYPE ordivon_market_capital_crypto_clock_private_gate_passed gauge',
      f'ordivon_market_capital_crypto_clock_private_gate_passed {b(clock_private_admitted)}',
      '# HELP ordivon_market_capital_crypto_private_execution_allowed Whether both execution authority and clock state admit private/demo/live execution.',
      '# TYPE ordivon_market_capital_crypto_private_execution_allowed gauge',
      f'ordivon_market_capital_crypto_private_execution_allowed {b(private_allowed)}',
      '# HELP ordivon_market_capital_crypto_external_financial_writes_attempted Whether current Market Capital crypto qualification attempted external financial writes.',
      '# TYPE ordivon_market_capital_crypto_external_financial_writes_attempted gauge',
      f"ordivon_market_capital_crypto_external_financial_writes_attempted {b(r2['externalFinancialWritesAttempted'] or r3['externalFinancialWritesAttempted'])}",
    ]
    text='\n'.join(lines)+'\n'
    if args.output:
        args.output.parent.mkdir(parents=True,exist_ok=True)
        tmp=args.output.with_suffix(args.output.suffix+'.tmp')
        tmp.write_text(text); tmp.replace(args.output)
    else: print(text,end='')

if __name__=='__main__': main()
