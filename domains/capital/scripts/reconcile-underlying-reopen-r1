#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from ordivon_capital.markets.market_sensors import reconcile_underlying_reopen


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--instrument", required=True)
    ap.add_argument("--weekend-perp-price", required=True)
    ap.add_argument("--weekend-observed-at-ms", required=True, type=int)
    ap.add_argument("--tolerance-bps")
    ap.add_argument("--underlying-reopen-price")
    ap.add_argument("--underlying-observed-at-ms", type=int)
    ap.add_argument("--post-open-perp-price")
    ap.add_argument("--post-open-perp-observed-at-ms", type=int)
    ap.add_argument("--output", required=True, type=Path)
    args = ap.parse_args()

    result = reconcile_underlying_reopen(
        instrument_id=args.instrument,
        weekend_perp_price=args.weekend_perp_price,
        weekend_observed_at_ms=args.weekend_observed_at_ms,
        validation_tolerance_bps=args.tolerance_bps,
        underlying_reopen_price=args.underlying_reopen_price,
        underlying_observed_at_ms=args.underlying_observed_at_ms,
        post_open_perp_price=args.post_open_perp_price,
        post_open_perp_observed_at_ms=args.post_open_perp_observed_at_ms,
    )
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
    print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
