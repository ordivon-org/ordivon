#!/usr/bin/env bash
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
python3 - "$repo/config/private_reality_policy.json" <<'PY'
from pathlib import Path
import json,sys
def require(condition, label):
    if not condition:
        raise SystemExit("Capital owner policy rejected: " + str(label))

x=json.load(open(sys.argv[1]))
require(x['standing']=='OWNER_MANDATE_PRESENT_PERMISSION_NOT_CURRENT', "x['standing']=='OWNER_MANDATE_PRESENT_PERMISSION_NOT_CURRENT'")
require(x['ownerCredentialUseMandate']=='AUTHORIZED_READ_ONLY_PRIVATE_REALITY_OBSERVATION', "x['ownerCredentialUseMandate']=='AUTHORIZED_READ_ONLY_PRIVATE_REALITY_OBSERVATION'")
require(x['credentialPermissionStanding']=='PENDING_FRESH_PROVIDER_VERIFICATION', "x['credentialPermissionStanding']=='PENDING_FRESH_PROVIDER_VERIFICATION'")
require(x['privateAccountDataAdmission']=='NOT_ADMITTED', "x['privateAccountDataAdmission']=='NOT_ADMITTED'")
for field in ("privateAccountDataAllowed", "externalFinancialWritesAllowed", "orderCapableCredentialsAllowed"):
    require(x[field] is False, field)
okx=Path(x['credentialBindings']['OKX']['binding'])
binance=Path(x['credentialBindings']['BINANCE']['binding'])
binance_usdm=Path(x['credentialBindings']['BINANCE_USDM']['binding'])
executor=Path(x['credentialBindings']['BINANCE']['executorBindingExplicitlyExcluded'])
require(okx.is_file() and (okx.stat().st_mode & 0o077)==0, "okx.is_file() and (okx.stat().st_mode & 0o077)==0")
require(binance.is_dir() and binance_usdm.is_dir() and executor.is_dir(), "binance.is_dir() and binance_usdm.is_dir() and executor.is_dir()")
require(binance_usdm == binance, "binance_usdm == binance")
require(x['credentialBindings']['BINANCE_USDM']['permissionStanding']=='PENDING_FRESH_PROVIDER_VERIFICATION', "x['credentialBindings']['BINANCE_USDM']['permissionStanding']=='PENDING_FRESH_PROVIDER_VERIFICATION'")
for name in ('api_key','private.pem','public.pem'):
 p=binance/name
 require(p.is_file() and (p.stat().st_mode & 0o077)==0, "p.is_file() and (p.stat().st_mode & 0o077)==0")
print(json.dumps({
 'standing':x['standing'],
 'ownerCredentialUseMandate':x['ownerCredentialUseMandate'],
 'credentialPermissionStanding':x['credentialPermissionStanding'],
 'privateAccountDataAdmission':x['privateAccountDataAdmission'],
 'okxObserverBindingPresent':True,
 'binanceObserverBindingPresent':True,
 'binanceUsdmObserverCandidateBindingPresent':True,
 'binanceExecutorExcluded':True,
 'secretBytesRead':False,
 'privateAccountDataAllowed':x['privateAccountDataAllowed'],
 'externalFinancialWritesAllowed':x['externalFinancialWritesAllowed'],
},sort_keys=True))
PY
