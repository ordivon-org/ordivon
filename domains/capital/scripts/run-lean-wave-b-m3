#!/usr/bin/env bash
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
lean="${MARKET_CAPITAL_LEAN_ROOT:-/root/external/quantconnect-lean/18074}"
out="$repo/.artifacts/wave-b-m3/results"
mkdir -p "$repo/.artifacts/wave-b-m3"
"$repo/scripts/check-lean-runtime"
"$repo/scripts/check-capital-authority" --mode non-live >/dev/null
"$repo/scripts/fetch-nasdaq-wave-b-m3" > "$repo/.artifacts/wave-b-m3/fetch-manifest-output.json"
DOTNET_CLI_TELEMETRY_OPTOUT=1 dotnet build "$repo/wave_b/algorithm/MarketCapitalValidationAlgorithm.csproj" -c Release --nologo -p:LeanReleaseRoot="$lean/Launcher/bin/Release"
rm -rf "$out" && mkdir -p "$out"
export MARKET_CAPITAL_TARGET_PORTFOLIO="$repo/wave_b/fixtures/wave_a_target_portfolio.json"
export MARKET_CAPITAL_EXECUTION_CASH_BUFFER_WEIGHT="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["executionCashBufferWeight"])' "$repo/config/execution_feasibility.json")"
export MARKET_CAPITAL_BACKTEST_START="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["startDate"])' "$repo/config/market_data_admission.json")"
export MARKET_CAPITAL_BACKTEST_END="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["endDate"])' "$repo/config/market_data_admission.json")"
(
 cd "$lean/Launcher/bin/Release"
 ./QuantConnect.Lean.Launcher --config "$lean/Launcher/config.json" --environment backtesting \
  --algorithm-type-name OrdivonMarketCapital.MarketCapitalValidationAlgorithm --algorithm-language CSharp \
  --algorithm-location "$repo/wave_b/algorithm/bin/Release/net10.0/Ordivon.MarketCapital.LeanValidation.dll" \
  --data-folder "$repo/.artifacts/wave-b-m3/data" --results-destination-folder "$out" \
  --transaction-log "$out/transactions.csv" --close-automatically true > "$out/lean-console.log" 2>&1
)
python3 - "$repo" "$out" <<'PY'
from pathlib import Path
import hashlib,json,re,sys
repo=Path(sys.argv[1]); out=Path(sys.argv[2]); log=(out/'lean-console.log').read_text(); manifest=json.loads((repo/'.artifacts/wave-b-m3/manifest.json').read_text())
errors=[x for x in log.splitlines() if ' ERROR::' in x]
failed=re.search(r'DATA USAGE:: Failed data requests (\d+)',log); fills=[x for x in log.splitlines() if 'MC_ORDER_EVENT' in x and 'status=Filled' in x]
if errors: raise SystemExit(f'LEAN errors present: {errors}')
if not failed or int(failed.group(1)) != 0: raise SystemExit('failed data requests are nonzero')
if len(fills)!=3: raise SystemExit(f'expected 3 fills, got {len(fills)}')
if any(x['rowCount'] != 8 for x in manifest['series']): raise SystemExit('unexpected Nasdaq row count')
final=re.search(r'MC_FINAL_PORTFOLIO\|totalValue=([^|]+)\|cash=([^|]+)\|marginUsed=([^\n]+)',log)
if not final: raise SystemExit('final portfolio missing')
if float(final.group(2)) < 0: raise SystemExit('negative final cash')
summary={
 'standing':'PASS_BOUNDED_PROVIDER_ORIGIN_DATA_NON_CAUSAL',
 'provider':'Nasdaq',
 'causalStanding':manifest['causalStanding'],
 'brokerCredentialsUsed':False,
 'externalFinancialWritesAttempted':False,
 'fills':len(fills),
 'finalPortfolio':final.group(0).split('|',1)[1],
 'marketDataManifestSha256':hashlib.sha256((repo/'.artifacts/wave-b-m3/manifest.json').read_bytes()).hexdigest(),
 'rawSeries':[{k:x[k] for k in ('symbol','rawSha256','normalizedCsvSha256','rowCount','firstDate','lastDate')} for x in manifest['series']],
 'consoleLogSha256':hashlib.sha256((out/'lean-console.log').read_bytes()).hexdigest()
}
(out/'acceptance.json').write_text(json.dumps(summary,indent=2,sort_keys=True)+'\n'); print(json.dumps(summary,sort_keys=True))
PY
