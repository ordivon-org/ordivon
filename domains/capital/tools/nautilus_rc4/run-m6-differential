fi
out="$repo/.artifacts/wave-b-m6-2-nautilus"
mkdir -p "$out"
PYTHONPATH="$repo/src" "$candidate" "$repo/tools/nautilus_rc4/nautilus_qualification.py" \
  --precommit "$precommit" \
  --output "$out/qualification.json"
