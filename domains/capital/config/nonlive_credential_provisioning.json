{
  "schemaVersion": 2,
  "kind": "ordivon.capital.trading.nonlive-credential-provisioning",
  "standing": "BLOCKED_SERVER_SIDE_NONLIVE_API_KEYS_NOT_PROVISIONED",
  "userAuthorization": "DEMO_TESTNET_EXTERNAL_WRITES_AUTHORIZED",
  "liveWriteAuthorization": "NOT_GRANTED",
  "externalFinancialWritesAllowed": false,
  "venues": {
    "OKX": {
      "environment": "DEMO",
      "secretRoot": "/root/.config/ordivon/secrets/okx/demo",
      "requiredFile": "config.toml",
      "serverSideAction": "create Demo Trading API key in OKX Demo Trading UI",
      "liveCredentialReuseForbidden": true
    },
    "BINANCE": {
      "environment": "TESTNET",
      "secretRoot": "/root/.config/ordivon/secrets/binance/testnet",
      "localKeyType": "Ed25519",
      "privateKey": "private.pem",
      "publicKey": "public.pem",
      "requiredServerIssuedFile": "api_key",
      "serverSideAction": "register public.pem on Binance Spot Test Network and store issued API key",
      "liveCredentialReuseForbidden": true
    }
  }
}
