  "principles": [
    "Observe at natural owners; the observatory never becomes provider truth.",
    "Re-enter only the smallest affected research layer when material evidence is newer than the bound state.",
    "A matched gap is permission to re-evaluate a measurement, not proof that the gap is closed or headroom is admitted.",
    "A graph trigger requests jurisdiction-frontier recomputation; it never mutates the graph automatically.",
    "P0/P1/P2 priority is evidence-acquisition attention, not investment ranking or scheduler authority.",
    "Preserve UNKNOWN when a candidate does not close the relevant scope/unit/time/qualification boundary."
  ],
  "effectBoundary": {
    "networkFetchIncluded": false,
    "schedulerAuthority": false,
    "providerTruthAuthority": false,
