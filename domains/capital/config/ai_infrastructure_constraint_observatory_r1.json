    "ownerRiskBudgetInferred": false,
    "externalFinancialWritesAllowed": false
  },
  "sourceQualificationContract": {
    "requiredStanding": "CALLER_QUALIFIED",
    "observatoryMayQualifySource": false,
    "reason": "Source/currentness qualification belongs to the caller and the natural external owner; this control only routes an already-qualified candidate."
