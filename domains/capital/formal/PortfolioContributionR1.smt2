; Portfolio: three-instrument, unbounded-integer model of the shipped
; TARGET_DEFICIT_LARGEST_REMAINDER allocation algorithm. Symbol identities
; are already ordered; ties favor the lower index, matching Python sorting.
; This is a model proof, NOT yet a proof of Python implementation refinement.
(set-logic QF_NIA)
(set-option :timeout 25000)
(declare-const contribution Int)
(declare-const gap0 Int)
(declare-const gap1 Int)
(declare-const gap2 Int)
(declare-const cash Int)
(declare-const reserve Int)
(declare-const holding0 Int)
(declare-const holding1 Int)
(declare-const holding2 Int)
(assert (and (>= contribution 0) (>= gap0 0) (>= gap1 0) (>= gap2 0)))
(assert (and (>= holding0 0) (>= holding1 0) (>= holding2 0)))
(assert (and (>= reserve 0) (>= cash (+ reserve contribution))))
(define-fun d () Int (+ gap0 gap1 gap2))
(assert (> d 0))
(define-fun q0 () Int (div (* contribution gap0) d))
(define-fun q1 () Int (div (* contribution gap1) d))
(define-fun q2 () Int (div (* contribution gap2) d))
(define-fun r0 () Int (mod (* contribution gap0) d))
(define-fun r1 () Int (mod (* contribution gap1) d))
(define-fun r2 () Int (mod (* contribution gap2) d))
(define-fun leftover () Int (- contribution q0 q1 q2))
; For equal remainders the lexically earlier asset has higher priority.
(define-fun rank0 () Int (+ (ite (> r1 r0) 1 0) (ite (> r2 r0) 1 0)))
(define-fun rank1 () Int (+ (ite (>= r0 r1) 1 0) (ite (> r2 r1) 1 0)))
(define-fun rank2 () Int (+ (ite (>= r0 r2) 1 0) (ite (>= r1 r2) 1 0)))
(define-fun extra0 () Int (ite (< rank0 leftover) 1 0))
(define-fun extra1 () Int (ite (< rank1 leftover) 1 0))
(define-fun extra2 () Int (ite (< rank2 leftover) 1 0))
(define-fun a0 () Int (+ q0 extra0))
(define-fun a1 () Int (+ q1 extra1))
(define-fun a2 () Int (+ q2 extra2))
; Invariants: 0 <= leftover < number_of_assets; exact cent conservation;
; no sell; reserved cash survives; stable lexical tie break.
(push 1)
(assert (or (< leftover 0) (> leftover 2)))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (+ a0 a1 a2) contribution)))
(check-sat)
(pop 1)
(push 1)
(assert (or (< a0 0) (< a1 0) (< a2 0)
            (< (+ holding0 a0) holding0)
            (< (+ holding1 a1) holding1)
            (< (+ holding2 a2) holding2)
            (< (- cash contribution) reserve)))
(check-sat)
(pop 1)
(push 1)
(assert (and (= r0 r1) (= r1 r2) (= leftover 1) (not (= extra0 1))))
(check-sat)
(pop 1)
; Anti-vacuity: a three-way tie with one residual cent IS reachable.
(push 1)
(assert (and (= r0 r1) (= r1 r2) (= leftover 1)))
(check-sat)
(pop 1)
