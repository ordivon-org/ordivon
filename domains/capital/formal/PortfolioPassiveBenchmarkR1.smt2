; Exact real-arithmetic TRANSITION MODEL for portfolio/passive_benchmark.py.
; Period convention: start capital + shared deposit, subtract proportional and
; fixed fees at start, then apply the gross return. No price/vintage claims.
; QF_NRA, mathematical Reals: decimal contexts, Python parsing, and implementation
; refinement are not proven; two concrete periods represent composable steps.
(set-logic QF_NRA)
(set-option :timeout 25000)
(declare-const opening Real)
(declare-const deposit0 Real)
(declare-const deposit1 Real)
(declare-const strategyExpense0 Real)
(declare-const strategyExpense1 Real)
(declare-const benchmarkExpense0 Real)
(declare-const benchmarkExpense1 Real)
(declare-const strategyFee0 Real)
(declare-const strategyFee1 Real)
(declare-const benchmarkFee0 Real)
(declare-const benchmarkFee1 Real)
(declare-const strategyReturn0 Real)
(declare-const strategyReturn1 Real)
(declare-const benchmarkReturn0 Real)
(declare-const benchmarkReturn1 Real)
(assert (and (>= opening 0) (>= deposit0 0) (>= deposit1 0)))
(assert (and (<= 0 strategyExpense0 1) (<= 0 strategyExpense1 1)
             (<= 0 benchmarkExpense0 1) (<= 0 benchmarkExpense1 1)))
(assert (and (>= strategyFee0 0) (>= strategyFee1 0)
             (>= benchmarkFee0 0) (>= benchmarkFee1 0)))
(assert (and (>= strategyReturn0 (- 1)) (>= strategyReturn1 (- 1))
             (>= benchmarkReturn0 (- 1)) (>= benchmarkReturn1 (- 1))))
(define-fun contributed () Real (+ opening deposit0 deposit1))
(define-fun strategyStart0 () Real (+ opening deposit0))
(define-fun benchmarkStart0 () Real (+ opening deposit0))
(define-fun strategyAfterFee0 () Real (- (* strategyStart0 (- 1 strategyExpense0)) strategyFee0))
(define-fun benchmarkAfterFee0 () Real (- (* benchmarkStart0 (- 1 benchmarkExpense0)) benchmarkFee0))
(assert (and (>= strategyAfterFee0 0) (>= benchmarkAfterFee0 0)))
(define-fun strategyWealth1 () Real (* strategyAfterFee0 (+ 1 strategyReturn0)))
(define-fun benchmarkWealth1 () Real (* benchmarkAfterFee0 (+ 1 benchmarkReturn0)))
(define-fun strategyStart1 () Real (+ strategyWealth1 deposit1))
(define-fun benchmarkStart1 () Real (+ benchmarkWealth1 deposit1))
(define-fun strategyAfterFee1 () Real (- (* strategyStart1 (- 1 strategyExpense1)) strategyFee1))
(define-fun benchmarkAfterFee1 () Real (- (* benchmarkStart1 (- 1 benchmarkExpense1)) benchmarkFee1))
(assert (and (>= strategyAfterFee1 0) (>= benchmarkAfterFee1 0)))
(define-fun strategyTerminal () Real (* strategyAfterFee1 (+ 1 strategyReturn1)))
(define-fun benchmarkTerminal () Real (* benchmarkAfterFee1 (+ 1 benchmarkReturn1)))
(define-fun relativeWealth () Real (- strategyTerminal benchmarkTerminal))
(define-fun relativeNetGain () Real (- (- strategyTerminal contributed)
                                       (- benchmarkTerminal contributed)))
; Negate cashflow-adjusted difference algebra; both paths share deposits.
(push 1)
(assert (not (= relativeNetGain relativeWealth)))
(check-sat)
(pop 1)
; Both paths and both periods preserve nonnegative terminal wealth when fees
; cannot exceed the amount available before returns.
(push 1)
(assert (or (< strategyWealth1 0) (< benchmarkWealth1 0)
            (< strategyTerminal 0) (< benchmarkTerminal 0)))
(check-sat)
(pop 1)
; Zero expense, zero fee, zero market return: ALL wealth increase is deposits.
(push 1)
(assert (and (= strategyExpense0 0) (= strategyExpense1 0)
             (= strategyFee0 0) (= strategyFee1 0)
             (= strategyReturn0 0) (= strategyReturn1 0)))
(assert (not (= strategyTerminal contributed)))
(check-sat)
(pop 1)
; Matched path prices and cost input imply exactly zero relative terminal wealth.
(push 1)
(assert (and (= strategyExpense0 benchmarkExpense0)
             (= strategyExpense1 benchmarkExpense1)
             (= strategyFee0 benchmarkFee0) (= strategyFee1 benchmarkFee1)
             (= strategyReturn0 benchmarkReturn0)
             (= strategyReturn1 benchmarkReturn1)))
(assert (not (= relativeWealth 0)))
(check-sat)
(pop 1)
; Start-of-period fee drag is nonpositive against the fee-free return in each
; path, for the same starting capital and return (growth factor >= 0).
(push 1)
(assert (> strategyWealth1 (* strategyStart0 (+ 1 strategyReturn0))))
(check-sat)
(pop 1)
; Anti-vacuity: positive deposit and paid fee can coexist with admissible
; transitions and a nonzero comparison difference.
(push 1)
(assert (and (> deposit0 0) (> strategyFee0 0)
             (> strategyReturn0 0) (not (= relativeWealth 0))))
(check-sat)
(pop 1)
