{
  "credentialBindings": {
    "BINANCE": {
      "binding": "/root/.config/ordivon/secrets/binance/observer",
      "copyIntoRepository": false,
      "executorBindingExplicitlyExcluded": "/root/.config/ordivon/secrets/binance/executor",
      "historicalRole": "observer keypair distinct from executor keypair",
      "role": "observer"
    },
    "BINANCE_USDM": {
      "binding": "/root/.config/ordivon/secrets/binance/observer",
      "copyIntoRepository": false,
      "executorBindingExplicitlyExcluded": "/root/.config/ordivon/secrets/binance/executor",
      "permissionStanding": "PENDING_FRESH_PROVIDER_VERIFICATION",
      "productScope": "USD\u24c8-M Futures",
      "role": "observer-candidate"
    },
    "OKX": {
      "binding": "/root/.config/ordivon/secrets/okx/observer/config.toml",
      "copyIntoRepository": false,
      "historicalRole": "live read-only / signed GET-only observer",
      "role": "observer"
    }
  },
  "credentialPermissionStanding": "PENDING_FRESH_PROVIDER_VERIFICATION",
  "externalFinancialWritesAllowed": false,
  "kind": "ordivon.capital.governance.private-reality-policy",
  "normalization": {
    "authority": "thin venue-native normalization only",
    "credentialAccess": false,
    "implementation": "src/ordivon_capital/market/private_reality.py",
    "networkAccess": false,
    "schema": "schema/private-reality-snapshot-v2.schema.json"
  },
  "orderCapableCredentialsAllowed": false,
  "ownerCredentialUseMandate": "AUTHORIZED_READ_ONLY_PRIVATE_REALITY_OBSERVATION",
  "privateAccountDataAdmission": "NOT_ADMITTED",
  "privateAccountDataAllowed": false,
  "purpose": "READ_ONLY_AUTHORITATIVE_VENUE_REALITY_BEFORE_ANY_ORDER_CAPABLE_CREDENTIAL",
  "rules": [
    "read-only authoritative account reality must graduate before demo/testnet order submission",
    "ambient credential discovery remains forbidden; only the explicitly owner-authorized observer bindings may be used for bounded permission verification and read-only observation",
    "Owner Principal mandate is already present for the explicitly bound read-only observer credentials; provider permission/currentness must be verified independently",
    "read-only admission must not imply TRADE, withdrawal, demo-order or live-order authority",
    "venue-native account/order/trade reality remains authoritative; the Ordivon Capital Trading domain may only normalize and reconcile it",
    "observer credential locations are explicitly bound; secret bytes remain external to the repository and executor credentials are excluded",
    "fresh private-account permission verification must succeed before privateAccountDataAllowed may become true",
    "normalization is pure and must not read credentials, open network connections, or create execution authority"
  ],
  "schemaVersion": 2,
  "secretDiscoveryAllowed": false,
  "standing": "OWNER_MANDATE_PRESENT_PERMISSION_NOT_CURRENT",
  "venues": {
    "BINANCE": {
      "authoritativeReality": "Binance Spot USER_DATA API",
      "client": "binance-sdk-spot 11.3.0",
      "requiredQueries": [
        "get_account",
        "get_open_orders",
        "all_orders",
        "my_trades",
        "get_order"
      ],
      "requiredSecurityType": "USER_DATA",
      "tradePermissionRequired": false
    },
    "BINANCE_USDM": {
      "authoritativeReality": "Binance USD\u24c8-M Futures USER_DATA API + User Data Stream",
      "client": "binance-sdk-derivatives-trading-usds-futures 17.4.0",
      "credentialCarrier": "finance-binance-observer-materials Runtime InputAuthority",
      "credentialCarrierStanding": "ACTIVE_RUNTIME_INPUT_AUTHORITY",
      "expectedDigestStanding": "CALLER_COMMITMENT_MISSING",
      "normalizer": "src/ordivon_capital/market/private_reality.py::normalize_binance_usdm_observer",
      "permissionClient": "binance-sdk-wallet 13.4.0",
      "permissionGate": "enableReading=true; all write-capable permission flags=false",
      "permissionStanding": "PENDING_FRESH_PROVIDER_VERIFICATION",
      "permissionTruthOwner": "Binance Wallet GET /sapi/v1/account/apiRestrictions",
      "privateCaptureImplementation": "src/ordivon_capital/market/binance_usdm_private_capture.py",
      "productEligibilityStanding": "PENDING_PROVIDER_VERIFICATION",
      "requiredQueries": [
        "account_information_v3",
        "futures_account_balance_v3",
        "futures_account_configuration",
        "get_current_multi_assets_mode",
        "get_current_position_mode",
        "notional_and_leverage_brackets",
        "position_adl_quantile_estimation",
        "position_information_v3",
        "current_all_open_orders",
        "account_trade_list"
      ],
      "requiredSecurityType": "USER_DATA",
      "timelinessOwner": "USER_DATA ACCOUNT_UPDATE / ORDER_TRADE_UPDATE streams",
      "tradFiAgreementAutomationAllowed": false,
      "tradFiAgreementStanding": "UNKNOWN_NO_READ_ONLY_STATUS_API",
      "tradePermissionRequired": false
    },
    "OKX": {
      "authoritativeReality": "OKX private account/order/trade API",
      "client": "NautilusTrader OKXHttpClient 2.0.0rc4",
      "forbiddenPermissions": [
        "Trade",
        "Withdraw"
      ],
      "requiredPermission": "Read",
      "requiredQueries": [
        "get_balance",
        "request_account_state",
        "request_order_status_reports",
        "request_fill_reports",
        "request_trades"
      ]
    }
  },
  "withdrawalCredentialsAllowed": false
}
