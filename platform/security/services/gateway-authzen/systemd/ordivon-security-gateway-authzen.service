[Unit]
Description=Ordivon Security AuthZEN v1 Artifact PDP (OPA-backed)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=true
WorkingDirectory=/opt/ordivon/security/gateway-authzen/current
LoadCredential=pdp-token:/etc/ordivon/security/gateway-authzen/pdp-token
LoadCredential=tls-key:/etc/ordivon/security/gateway-authzen/server.key
LoadCredential=tls-cert:/etc/ordivon/security/gateway-authzen/server.pem
LoadCredential=trusted-issuer:/etc/ordivon/security/gateway-authzen/trusted-issuer.json
Environment=ORDIVON_SECURITY_AUTHZEN_TOKEN_FILE=%d/pdp-token
Environment=ORDIVON_SECURITY_AUTHZEN_POLICY_FILE=/opt/ordivon/security/gateway-authzen/current/policies/gateway_artifact.rego
Environment=ORDIVON_SECURITY_AUTHZEN_POLICY_DATA_FILE=%d/trusted-issuer
Environment=ORDIVON_SECURITY_AUTHZEN_OPA=/opt/ordivon/external/opa/1.20.2/bin/opa
ExecStart=/opt/ordivon/security/gateway-authzen/current/.venv/bin/uvicorn ordivon_security_gateway_authzen.server:app --host 127.0.0.1 --port 18787 --ssl-keyfile %d/tls-key --ssl-certfile %d/tls-cert
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
