[Unit]
Description=Private Chrome for Claude subscription OAuth
Requires=claude-private-oauth-display.service network-v2-claude-client.target
After=claude-private-oauth-display.service network-v2-claude-client.target
PartOf=claude-private-oauth.target

[Service]
Type=simple
User=ordivon
Group=ordivon
NetworkNamespacePath=/run/netns/nv2-claude-client
Environment=DISPLAY=:90
Environment=XAUTHORITY=/run/claude-private-oauth/xauth
Environment=TZ=UTC
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=HOME=/var/lib/claude-private-oauth-browser
Environment=XDG_CONFIG_HOME=/var/lib/claude-private-oauth-browser/config
Environment=XDG_CACHE_HOME=/var/lib/claude-private-oauth-browser/cache
StateDirectory=claude-private-oauth-browser
StateDirectoryMode=0700
ExecStartPre=/usr/local/libexec/claude-private/prepare-oauth-profile
ExecStart=/opt/claude-private/cft/chrome-linux64/chrome --user-data-dir=/var/lib/claude-private-oauth-browser/profile --remote-debugging-address=127.0.0.1 --remote-debugging-port=19990 --proxy-server=http://10.252.247.1:19482 "--host-resolver-rules=MAP * ~NOTFOUND , EXCLUDE 10.252.247.1" --force-webrtc-ip-handling-policy=disable_non_proxied_udp --lang=en-US --password-store=basic --disable-sync --disable-background-networking --disable-breakpad --disable-crash-reporter --noerrdialogs --no-first-run --no-default-browser-check about:blank
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
BindReadOnlyPaths=/tmp/.X11-unix
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
