#!/usr/bin/env bash
set -euo pipefail

CLIENT_TARGET=network-v2-claude-client.target
OAUTH_TARGET=claude-private-oauth.target
ENTER=/usr/local/libexec/claude-private/claude-private-enter
AUTH_WORKSPACE=/var/lib/claude-private/auth-workspace
OAUTH_UI='http://127.0.0.1:16090/vnc.html?host=127.0.0.1&port=16090&path=websockify&autoconnect=1&resize=scale'

if [[ ${EUID} -ne 0 ]]; then
  echo 'claude-private canary currently requires root on this WSL node' >&2
  exit 80
fi

if ! systemctl is-active --quiet "$CLIENT_TARGET"; then
  systemctl start "$CLIENT_TARGET"
fi

if [[ ${1:-} == auth ]]; then
  mkdir -p "$AUTH_WORKSPACE"
  chmod 0700 "$AUTH_WORKSPACE"
  source_pwd=$AUTH_WORKSPACE
else
  source_pwd=$PWD
fi

run_inner() {
  /usr/bin/ip netns exec nv2-claude-client \
    /usr/bin/unshare --mount --uts --fork --propagation private \
    "$ENTER" "$source_pwd" "$@"
}

if [[ ${1:-} == auth && ${2:-} == login ]]; then
  systemctl start "$OAUTH_TARGET"
  cleanup() { systemctl stop "$OAUTH_TARGET" >/dev/null 2>&1 || true; }
  trap cleanup EXIT INT TERM
  for _ in $(seq 1 60); do
    if /usr/bin/ip netns exec nv2-claude-client /usr/bin/curl -fsS http://127.0.0.1:19990/json/version >/dev/null 2>&1 && /usr/bin/curl -fsS http://127.0.0.1:16090/vnc.html >/dev/null 2>&1; then
      break
    fi
    sleep 0.25
  done
  /usr/bin/ip netns exec nv2-claude-client /usr/bin/curl -fsS http://127.0.0.1:19990/json/version >/dev/null
  /usr/bin/curl -fsS http://127.0.0.1:16090/vnc.html >/dev/null
  export CLAUDE_PRIVATE_BROWSER_MODE=oauth
  echo "Private Claude OAuth browser ready: $OAUTH_UI" >&2
  set +e
  run_inner "$@"
  rc=$?
  set -e
  exit "$rc"
fi

exec /usr/bin/ip netns exec nv2-claude-client \
  /usr/bin/unshare --mount --uts --fork --propagation private \
  "$ENTER" "$source_pwd" "$@"
