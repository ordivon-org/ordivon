#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo 'internal error: missing source working directory' >&2
  exit 81
fi

orig_pwd=$1
shift

PROFILE=/etc/claude-private
CLAUDE_BIN=/opt/claude-private/versions/2.1.274/claude
HOME_DIR=/var/lib/claude-private/home
WORKSPACE=/workspace

hostname claude-workspace
mount --bind "$PROFILE/nsswitch.conf" /etc/nsswitch.conf
mount --bind "$PROFILE/resolv.conf" /etc/resolv.conf
mount --bind "$PROFILE/hosts" /etc/hosts
mount --bind "$PROFILE/hostname" /etc/hostname
mount --bind "$PROFILE/machine-id" /etc/machine-id

export TZ=UTC LANG=C.UTF-8 LC_ALL=C.UTF-8
mount --bind "$orig_pwd" "$WORKSPACE"
mount -t tmpfs -o mode=0755,nosuid,nodev,noexec tmpfs /root
mount -t tmpfs -o mode=0755,nosuid,nodev,noexec tmpfs /home
mount -t tmpfs -o mode=0755,nosuid,nodev,noexec tmpfs /mnt
if [[ -d /run/systemd/resolve ]]; then
  mount -t tmpfs -o mode=0755,nosuid,nodev,noexec tmpfs /run/systemd/resolve
fi
if [[ -d /run/dbus ]]; then
  mount -t tmpfs -o mode=0755,nosuid,nodev,noexec tmpfs /run/dbus
fi

mkdir -p "$HOME_DIR"
chmod 0700 "$HOME_DIR"
export HOME="$HOME_DIR"
export USER=claude-private LOGNAME=claude-private
export PATH=/usr/local/bin:/usr/bin:/bin

export HTTP_PROXY=http://10.252.247.1:19482
export HTTPS_PROXY=http://10.252.247.1:19482
export http_proxy=$HTTP_PROXY
export https_proxy=$HTTPS_PROXY
export NO_PROXY=
export no_proxy=
unset ALL_PROXY all_proxy || true
export CLAUDE_CODE_PROXY_RESOLVES_HOSTS=1
export DISABLE_TELEMETRY=1
export DISABLE_ERROR_REPORTING=1
export DISABLE_FEEDBACK_COMMAND=1
export CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY=1
export ENABLE_CLAUDEAI_MCP_SERVERS=false
export CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=1
if [[ ${CLAUDE_PRIVATE_BROWSER_MODE:-} == oauth ]]; then
  export BROWSER=/usr/local/libexec/claude-private/oauth-browser-open
else
  export BROWSER=echo
fi

cd "$WORKSPACE"
exec "$CLAUDE_BIN" --settings "$PROFILE/settings.json" "$@"
