[Unit]
Description=Ordivon Skills MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/ordivon/skills-mcp/current
Environment=ORDIVON_SKILLS_MCP_SOURCE_ROOT=/opt/ordivon/skills-mcp/current
ExecStartPre=/opt/ordivon/skills-mcp/current-env/bin/python /opt/ordivon/skills-mcp/current/scripts/skills_mcp.py --config /etc/ordivon/skills-mcp.json --token-file /etc/ordivon/skills-mcp.token --bind 127.0.0.1 --port 8895 --check
ExecStart=/opt/ordivon/skills-mcp/current-env/bin/python /opt/ordivon/skills-mcp/current/scripts/skills_mcp.py --config /etc/ordivon/skills-mcp.json --token-file /etc/ordivon/skills-mcp.token --bind 127.0.0.1 --port 8895
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
