[Unit]
Description=Network v2 shared egress network namespace (legacy installed unit name)
After=network-online.target
Wants=network-online.target
PartOf=network-v2-browserless.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/network-v2/browserless/provider.env
# Cold creation; a complete running namespace is verified and reused.
# Partial/drifted topology fails closed rather than deleting live consumers.
ExecStart=/usr/bin/python3 /usr/local/libexec/network-v2/shared-egress-netns ensure
TimeoutStartSec=90s
# Deliberately no ExecStop/ExecStopPost: stopping this dependency must not
# delete the namespace/veth while unrelated processes still reference them.
# Explicit retirement requires quiescing every consumer and operator review.
