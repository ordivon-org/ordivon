[Unit]
Description=Network v2 shared egress legacy Docker forwarding exception
Requires=network-v2-browserless-netns.service
After=network-v2-browserless-netns.service
BindsTo=network-v2-browserless-netns.service
PartOf=network-v2-shared-egress.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/network-v2/browserless/provider.env
# Docker's legacy FORWARD DROP still needs two exact owned exceptions.
# Do not delete-and-reinsert live exceptions on restart or stop.
# Physical retirement is an explicit operation after all consumers quiesce.
ExecStart=/usr/bin/python3 /usr/local/libexec/network-v2/shared-egress-forward ensure
