[Unit]
Description=Network v2 Browserless production forwarding policy
Requires=network-v2-browserless-netns.service
After=network-v2-browserless-netns.service
BindsTo=network-v2-browserless-netns.service
PartOf=network-v2-browserless.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/network-v2/browserless/provider.env
# Docker may set the legacy FORWARD policy to DROP. Own only the Browserless veth/CIDR
# exception and leave Docker's chains and global policy untouched.
ExecStartPre=-/usr/bin/iptables-legacy -D FORWARD -i ${HOST_IF} -s ${NS_CIDR} -m comment --comment network-v2-browserless-forward-v1 -j ACCEPT
ExecStartPre=-/usr/bin/iptables-legacy -D FORWARD -o ${HOST_IF} -d ${NS_CIDR} -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment network-v2-browserless-forward-v1 -j ACCEPT
ExecStart=/usr/bin/iptables-legacy -I FORWARD 1 -i ${HOST_IF} -s ${NS_CIDR} -m comment --comment network-v2-browserless-forward-v1 -j ACCEPT
ExecStart=/usr/bin/iptables-legacy -I FORWARD 1 -o ${HOST_IF} -d ${NS_CIDR} -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment network-v2-browserless-forward-v1 -j ACCEPT
ExecStop=-/usr/bin/iptables-legacy -D FORWARD -i ${HOST_IF} -s ${NS_CIDR} -m comment --comment network-v2-browserless-forward-v1 -j ACCEPT
ExecStop=-/usr/bin/iptables-legacy -D FORWARD -o ${HOST_IF} -d ${NS_CIDR} -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment network-v2-browserless-forward-v1 -j ACCEPT
