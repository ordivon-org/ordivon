[Unit]
Description=Network v2 DNS carrier
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/dnsproxy -l 127.0.0.1 -p 25353 -u 1.1.1.1:53 -u 8.8.8.8:53 --upstream-mode parallel --cache --ipv6-disabled --refuse-any --pending-requests-enabled --timeout 5s
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
