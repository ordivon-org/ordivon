# SOURCE ONLY. Reuses existing sing-box candidate config and consumer seam.
[Unit]
Description=Network-v2 Gluetun owned sing-box compatibility adapter
Requires=network-v2-gluetun-owned.service network-v2-browserless-netns.service
BindsTo=network-v2-gluetun-owned.service
After=network-v2-gluetun-owned.service network-v2-browserless-netns.service
Conflicts=network-v2-browserless-provider-carrier.service
ConditionPathExists=/run/network-v2-gluetun/ownership-admitted

[Service]
Type=simple
User=sing-box
Group=sing-box
NetworkNamespacePath=/run/netns/nv2-browserless-prod
ExecStartPre=/usr/bin/sing-box check -c /etc/network-v2/browserless/provider-carrier-gluetun-candidate.json
ExecStart=/usr/bin/sing-box run -c /etc/network-v2/browserless/provider-carrier-gluetun-candidate.json
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
