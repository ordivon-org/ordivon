[Unit]
Description=Network v2 Browserless legacy WireGuard rollback carrier
Requires=network-v2-browserless-netns.service
After=network-v2-browserless-netns.service
BindsTo=network-v2-browserless-netns.service
PartOf=network-v2-browserless-legacy-provider.target
ConditionPathExists=!/etc/network-v2/gluetun/m4-owned-mode.selected

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/network-v2/browserless/provider.env
Environment=WG_QUICK_USERSPACE_IMPLEMENTATION=/usr/local/libexec/network-v2/wireguard-go
ExecStartPre=/usr/local/libexec/network-v2/provider-identity-exclusive legacy
NetworkNamespacePath=/run/netns/nv2-browserless-prod
ExecStartPre=/usr/bin/ip route replace ${ENDPOINT}/32 via ${HOST_IP} dev ${NS_IF}
ExecStart=/usr/bin/wg-quick up ${PROFILE}
ExecStartPost=/usr/bin/ip route replace default dev ${WG_IF}
ExecStop=-/usr/bin/wg-quick down ${PROFILE}
ExecStopPost=-/usr/bin/ip route del ${ENDPOINT}/32
