[Unit]
Description=Network-v2 Gluetun candidate failure -> fenced legacy restore
After=network-v2-gluetun-owned.service
ConditionPathExists=/run/network-v2-gluetun/ownership-admitted

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/network-v2/m4-owned-restore-legacy
TimeoutStartSec=90s
