[Unit]
Description=Network-v2 reconcile selected Gluetun provider after transient boot dependencies
ConditionPathExists=/etc/network-v2/gluetun/m4-owned-mode.selected
After=network-online.target

[Service]
Type=oneshot
# An explicitly disabled provider target means operator maintenance, not recovery.
ExecCondition=/usr/bin/systemctl is-enabled --quiet network-v2-gluetun-owned.target
# Forbid a second physical WireGuard identity while legacy mode is still active.
ExecStartPre=/usr/local/libexec/network-v2/provider-identity-exclusive gluetun
# Starting an already-active target alone will NOT heal a failed required service.
# systemctl start is idempotent for healthy services; restore the actual
# physical Provider and its internal compatibility adapter independently.
ExecStart=/usr/bin/systemctl start network-v2-gluetun-owned.service network-v2-gluetun-owned-adapter.service
# Reuse this existing 2-minute owner timer for a bounded quality-aware
# supplemental recovery, not another VPN or polling service. Healthy blackbox
# consumers exit early without any Provider GET/PUT or WAN probe.
ExecStartPost=/usr/bin/python3 /usr/local/libexec/network-v2/gluetun-native/native_switch.py --recover
# Explicitly includes the maximum guarded native API trial and rollback.
TimeoutStartSec=4min
