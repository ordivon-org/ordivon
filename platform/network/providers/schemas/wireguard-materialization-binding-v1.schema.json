{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ordivon:network-v2:wireguard-materialization-binding:v1",
  "title": "Network v2 WireGuard Materialization Binding v1",
  "description": "Binds one public ProviderProfile and one opaque ClientIdentity to a platform realization. It is a composition contract, not secret material.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "bindingId",
    "providerProfileRef",
    "clientIdentityRef",
    "platform",
    "outputKind",
    "compatibilityMode",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "ordivon.network-v2.wireguard-materialization-binding"
    },
    "bindingId": {
      "type": "string",
      "minLength": 1
    },
    "providerProfileRef": {
      "type": "string",
      "minLength": 1
    },
    "clientIdentityRef": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "enum": [
        "linux",
        "windows"
      ]
    },
    "outputKind": {
      "const": "standard-wireguard-config"
    },
    "compatibilityMode": {
      "enum": [
        "legacy-combined-profile",
        "separated-materialization"
      ]
    },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
