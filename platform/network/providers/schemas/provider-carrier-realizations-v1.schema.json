{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ordivon Network v2 Provider Carrier Realizations v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "providerProfileRef",
    "clientIdentityRef",
    "activeRealizationId",
    "candidateRealizationIds",
    "realizations",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "ordivon.network-v2.provider-carrier-realizations"},
    "providerProfileRef": {"type": "string", "minLength": 1},
    "clientIdentityRef": {"type": "string", "minLength": 1},
    "activeRealizationId": {"type": "string", "minLength": 1},
    "candidateRealizationIds": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "realizations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/realization"}
    },
    "nonClaims": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "$defs": {
    "upstreamRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "version", "revision", "lockFile"],
      "properties": {
        "repo": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "lockFile": {"type": "string", "minLength": 1}
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "lockFile"],
      "properties": {
        "kind": {"const": "oci-image"},
        "lockFile": {"type": "string", "minLength": 1}
      }
    },
    "realization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "realizationId",
        "standing",
        "mechanism",
        "activationMode",
        "productionAuthority",
        "concurrentWithActive",
        "providerProfileRef",
        "clientIdentityRef",
        "materializationRef",
        "artifactRef",
        "upstreamRef"
      ],
      "properties": {
        "realizationId": {"type": "string", "minLength": 1},
        "standing": {"enum": ["active", "candidate"]},
        "mechanism": {"type": "string", "minLength": 1},
        "activationMode": {"enum": ["continuous", "serialized-only"]},
        "productionAuthority": {"type": "boolean"},
        "concurrentWithActive": {"type": "boolean"},
        "providerProfileRef": {"type": "string", "minLength": 1},
        "clientIdentityRef": {"type": "string", "minLength": 1},
        "materializationRef": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        },
        "artifactRef": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/artifactRef"}
          ]
        },
        "upstreamRef": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/upstreamRef"}
          ]
        }
      }
    }
  }
}
