[Unit]
Description=Network v2 Claude Code scoped egress authority
Requires=network-v2-claude-proxy.service network-v2-claude-relay.service
After=network-v2-browserless.target network-v2-claude-proxy.service network-v2-claude-relay.service
BindsTo=network-v2-browserless.target

[Install]
WantedBy=multi-user.target
