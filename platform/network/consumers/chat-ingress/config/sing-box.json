{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {"level": "warn", "timestamp": true},
  "dns": {
    "servers": [{"type": "udp", "tag": "namespace-dns", "server": "127.0.0.1", "server_port": 53}],
    "final": "namespace-dns",
    "strategy": "ipv4_only"
  },
  "inbounds": [{"type": "mixed", "tag": "chat-ingress", "listen": "127.0.0.1", "listen_port": 19080}],
  "outbounds": [{"type": "direct", "tag": "network-v2-browserless-egress"}],
  "route": {
    "default_domain_resolver": {"server": "namespace-dns", "strategy": "ipv4_only"},
    "rules": [{"action": "resolve", "strategy": "ipv4_only", "timeout": "5s"}],
    "final": "network-v2-browserless-egress"
  }
}
