[Unit]
Description=Network v2 Codex scoped ChatGPT egress
Requires=network-v2-codex-proxy.service network-v2-codex-relay.service
After=network-v2-browserless.target network-v2-codex-proxy.service network-v2-codex-relay.service
BindsTo=network-v2-browserless.target

[Install]
WantedBy=multi-user.target
