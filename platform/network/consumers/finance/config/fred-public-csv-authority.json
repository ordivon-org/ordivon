{
  "schemaVersion": 1,
  "kind": "ordivon.network-v2.scoped-egress-authority",
  "profile": "finance-fred-public-csv",
  "listenHost": "127.0.0.1",
  "listenPort": 19292,
  "proxy": "http://127.0.0.1:19292",
  "transport": "loopback-http-connect-explicit-public-direct-ipv4",
  "tlsOwnership": "caller-end-to-end",
  "allowedTcpPorts": [
    443
  ],
  "destination": {
    "host": "fred.stlouisfed.org",
    "port": 443,
    "url": "https://fred.stlouisfed.org/graph/fredgraph.csv?id=DCOILBRENTEU,DCOILWTICO"
  },
  "health": {
    "url": "https://fred.stlouisfed.org/graph/fredgraph.csv?id=DFF&cosd=2026-09-22&coed=2026-09-22",
    "note": "small exact-host CSV consequence; Capital separately validates energy-series provenance and semantics"
  },
  "providers": [],
  "selectionPolicy": "fixed-explicit-public-direct",
  "healthAuthority": "consumer-consequence-readiness",
  "staleBehavior": "fail-closed-on-destination-or-dns-unreachable",
  "directFallback": false,
  "serviceUnit": "network-v2-finance-egress.service",
  "targetUnit": "network-v2-finance.target",
  "groupTag": "public-direct"
}
