{
  "schemaVersion": 1,
  "kind": "ordivon.network-v2.scoped-egress-authority",
  "profile": "finance-binance-wallet",
  "listenHost": "127.0.0.1",
  "listenPort": 19290,
  "proxy": "http://127.0.0.1:19290",
  "transport": "loopback-http-connect-shared-provider-carrier-ipv4",
  "tlsOwnership": "caller-end-to-end",
  "allowedTcpPorts": [
    443
  ],
  "destination": {
    "host": "api.binance.com",
    "port": 443,
    "url": "https://api.binance.com/api/v3/time"
  },
  "health": {
    "authority": "consumer-consequence-readiness",
    "note": "shared carrier liveness is necessary but destination consequence remains authoritative"
  },
  "providers": [
    "network-v2-browserless/provider-b"
  ],
  "selectionPolicy": "fixed-shared-provider-carrier",
  "healthAuthority": "consumer-consequence-readiness",
  "staleBehavior": "fail-closed-when-shared-provider-carrier-unavailable",
  "directFallback": false,
  "serviceUnit": "network-v2-finance-egress.service",
  "targetUnit": "network-v2-finance.target",
  "groupTag": "provider-carrier",
  "networkAuthority": {
    "kind": "network-v2",
    "name": "browserless-prod",
    "namespace": "nv2-browserless-prod",
    "carrierService": "network-v2-browserless-provider-carrier.service",
    "providerSite": "th-bkk"
  }
}
