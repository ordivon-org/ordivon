{
  "schemaVersion": 1,
  "kind": "ordivon.network-v2.scoped-egress-authority",
  "profile": "finance-binance-wallet",
  "listenHost": "127.0.0.1",
  "listenPort": 19290,
  "proxy": "http://127.0.0.1:19290",
  "transport": "loopback-http-connect-provider-urltest-ipv4",
  "tlsOwnership": "caller-end-to-end",
  "allowedTcpPorts": [443],
  "destination": {"host": "api.binance.com", "port": 443, "url": "https://api.binance.com/api/v3/time"},
  "health": {"url": "https://1.1.1.1/cdn-cgi/trace", "note": "provider-path health only; destination reachability is verified by consumer consequence acceptance"},
  "providers": ["provider-a", "provider-b"],
  "selectionPolicy": "sing-box-urltest-latency-selection",
  "healthAuthority": "sing-box-urltest",
  "staleBehavior": "fail-closed-when-no-provider-healthy",
  "directFallback": false,
  "serviceUnit": "network-v2-finance-egress.service",
  "targetUnit": "network-v2-finance.target",
  "groupTag": "provider-auto"
}
