{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "http",
      "tag": "supply-chain-oci",
      "listen": "127.0.0.1",
      "listen_port": 19581
    }
  ],
  "outbounds": [
    {
      "type": "http",
      "tag": "provider-carrier",
      "server": "10.252.246.2",
      "server_port": 19680
    }
  ],
  "route": {
    "rules": [
      {
        "inbound": [
          "supply-chain-oci"
        ],
        "domain": [
          "registry-1.docker.io",
          "registry.docker.io",
          "auth.docker.io",
          "production.cloudflare.docker.com",
          "docker.elastic.co",
          "gcr.io"
        ],
        "domain_suffix": [
          "r2.cloudflarestorage.com",
          "gcr.io",
          "pkg.dev"
        ],
        "port": 443,
        "network": [
          "tcp"
        ],
        "action": "route",
        "outbound": "provider-carrier"
      },
      {
        "action": "reject"
      }
    ]
  }
}
