{
  "schemaVersion": 1,
  "kind": "ordivon.network-v2.supply-chain-egress",
  "listen": {
    "host": "127.0.0.1",
    "port": 19581,
    "protocol": "http"
  },
  "providerAuthority": {
    "kind": "surfshark",
    "profileOwner": "/etc/network-v2/providers",
    "composition": "dual-wireguard-urltest"
  },
  "allowedHttpsDomains": [
    "registry-1.docker.io",
    "registry.docker.io",
    "auth.docker.io",
    "production.cloudflare.docker.com",
    "docker.elastic.co",
    "gcr.io"
  ],
  "allowedHttpsDomainSuffixes": [
    "r2.cloudflarestorage.com",
    "gcr.io",
    "pkg.dev"
  ],
  "directFallback": false
}
