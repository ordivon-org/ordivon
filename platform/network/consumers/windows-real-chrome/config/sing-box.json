  "outbounds": [{"type": "http", "tag": "provider-carrier", "server": "10.252.246.2", "server_port": 19680}],
  "route": {
    "rules": [
      {"domain_regex": ["(?i)(^|\\.)localhost(?:\\.localdomain)?\\.?$", "(?i)(^|\\.)internal\\.?$", "(?i)^127(?:\\.[0-9]{1,3}){1,3}\\.?$", "(?i)^0x[0-9a-f]+\\.?$", "^[0-9]{7,10}\\.?$"], "action": "reject"},
