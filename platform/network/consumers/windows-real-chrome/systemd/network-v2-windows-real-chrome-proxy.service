[Unit]
Description=Network v2 Windows Real Chrome public-web proxy inside provider egress namespace
BindsTo=network-v2-browserless.target
After=network-v2-browserless.target network-v2-browserless-dns.service
PartOf=network-v2-windows-real-chrome.target

[Service]
Type=simple
NetworkNamespacePath=/run/netns/nv2-browserless-prod
ExecStartPre=/usr/bin/sing-box check -c /etc/network-v2/windows-real-chrome/sing-box.json
ExecStart=/usr/bin/sing-box run -c /etc/network-v2/windows-real-chrome/sing-box.json
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
