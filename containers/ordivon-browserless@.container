[Unit]
Description=Browserless Chromium carrier %i for Ordivon browser capabilities
RequiresMountsFor=/run/netns /var/lib/ordivon/browserless/%i
After=network-online.target
BindsTo=@NETWORK_AUTHORITY_SERVICE@
After=@NETWORK_AUTHORITY_SERVICE@
Requires=ordivon-browserless-display@%i.service
After=ordivon-browserless-display@%i.service

[Container]
Image=ghcr.io/browserless/chromium@sha256:5e3f3e59e5d8d545f0766534e3d76dc4fb6ac17b9e05f52d125dd51e3908f631
ContainerName=ordivon-browserless-%i
HostName=ordivon-browserless-%i
Network=ns:/run/netns/@NETWORK_NAMESPACE@
Volume=/var/lib/ordivon/browserless/%i:/data:U
Volume=/tmp/.X11-unix:/tmp/.X11-unix
Volume=/run/ordivon/browserless-xauth/%i:/run/ordivon-xauth:ro
Environment=CONCURRENT=1
Environment=QUEUED=8
Environment=TIMEOUT=180000
Environment=HEALTH=true
Environment=MAX_CPU_PERCENT=90
Environment=MAX_MEMORY_PERCENT=90
Environment=DEBUG=-*
Environment=DISPLAY=:1%i
Environment=XAUTHORITY=/run/ordivon-xauth
Environment=PORT=30%i
Secret=ordivon-browserless-token,type=env,target=TOKEN
ShmSize=2g
Pull=never

[Service]
Restart=on-failure
RestartSec=3s
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
