{
  "schemaVersion": 1,
  "kind": "ordivon.archived-source-reference-policy",
  "id": "host-v2-standalone",
  "legacyLocator": "/root/projects/ordivon-host-v2",
  "archivedSource": {
    "revision": "a95a8e112edfbe85582ff8e6fa25bb268038ea48",
    "standing": "RETIRED_ARCHIVED",
    "preserveGitHistoryForHistoricalLookup": false,
    "recoveryMode": "all-refs-bundle-plus-wip-capsule"
  },
  "allowedReferenceClasses": [
    {
      "id": "migration-acceptance-and-receipts",
      "globs": [
        "docs/migration/acceptance/**",
        "docs/migration/receipts/**"
      ],
      "reason": "Migration acceptance and source-history receipts retain the exact historical standalone locator."
    },
    {
      "id": "historical-next-migration-records",
      "globs": [
        "meta/next/migrations/records/host-*.md"
      ],
      "reason": "Dated Host migration records preserve repository topology observed before monorepo retirement."
    },
    {
      "id": "m0-planning-snapshots",
      "globs": [
        "meta/next/docs/superpowers/plans/2026-09-20-monorepo-m0-migration.md",
        "meta/next/planning/monorepo-migration-baseline-r1.json"
      ],
      "reason": "The frozen M0 plan and baseline intentionally name the pre-migration source repository."
    },
    {
      "id": "frozen-production-topology",
      "globs": [
        "capabilities/media/productions/*/source/**",
        "capabilities/media/productions/*/render/**"
      ],
      "reason": "Creation-time system-topology carriers remain immutable historical evidence."
    }
  ],
  "allowedExactPaths": []
}
