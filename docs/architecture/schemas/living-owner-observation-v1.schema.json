{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.local/schemas/living-owner-observation-v1.schema.json",
  "title": "Ordivon Living Owner Observation V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "subjectRef",
    "ownerRef",
    "observedAt",
    "operation",
    "standing",
    "evidenceRefs",
    "attributes"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "ordivon.living-owner-observation"},
    "subjectRef": {"type": "string", "minLength": 1},
    "ownerRef": {"type": "string", "minLength": 1},
    "observedAt": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "standing": {"type": "string", "minLength": 1},
    "evidenceRefs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "attributes": {"type": "object"},
    "sourceRevision": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "sourceDigest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "truthBoundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
