{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ordivon-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "ratelimits": [
    {
      "name": "BROWSER_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 1,
        "period": 10
      }
    },
    {
      "name": "FETCH_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "vars": {
    "EDGE_HMAC_KEY_ID": "runtime-v1",
    "FETCH_ALLOWED_HOSTS": "developers.cloudflare.com,api.github.com,raw.githubusercontent.com,github.com,example.com,openai.com"
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "ordivon-artifacts"
    }
  ],
  "routes": [
    {
      "pattern": "edge.ordivon.com",
      "custom_domain": true
    }
  ]
}
