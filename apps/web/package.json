{
  "name": "@ordivon/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "26.12.1",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "e2e": "bash ./browser-e2e.sh",
    "agent-native-e2e": "bash ./agent-native-e2e.sh",
    "ci": "pnpm --dir ../../platform/security/contracts/agent-request-verifier-v1 install --frozen-lockfile && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/csrf-protection": "8.0.2",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@simplewebauthn/server": "14.0.3",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@types/node": "26.6.5",
    "oauth4webapi": "3.8.8",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  }
}
