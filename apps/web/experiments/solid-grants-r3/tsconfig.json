{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "app.tsx",
    "operator.tsx",
    "operator-observation.ts",
    "operator-observation.test.ts",
    "operator-browser-probe.ts",
    "observation.ts",
    "observation.test.ts",
    "browser-probe.ts",
    "vite.config.ts"
  ]
}
