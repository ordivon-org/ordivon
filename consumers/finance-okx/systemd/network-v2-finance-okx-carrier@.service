[Unit]
Description=Network v2 finance-okx provider carrier %i
Requires=network-v2-finance-okx-wireguard@%i.service
After=network-v2-finance-okx-wireguard@%i.service
BindsTo=network-v2-finance-okx-wireguard@%i.service
PartOf=network-v2-finance-okx-shadow.target

[Service]
Type=simple
User=sing-box
Group=sing-box
NetworkNamespacePath=/run/netns/nv2-finance-%i
ExecStartPre=/usr/bin/sing-box check -c /etc/network-v2/finance-okx/provider-carrier.json
ExecStart=/usr/bin/sing-box run -c /etc/network-v2/finance-okx/provider-carrier.json
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
