{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "http",
      "tag": "finance-okx",
      "listen": "127.0.0.1",
      "listen_port": 19283
    }
  ],
  "outbounds": [
    {
      "type": "http",
      "tag": "provider-b",
      "server": "10.252.245.2",
      "server_port": 28221
    },
    {
      "type": "http",
      "tag": "provider-a",
      "server": "10.252.244.2",
      "server_port": 28221
    },
    {
      "type": "urltest",
      "tag": "finance-okx-auto",
      "outbounds": [
        "provider-b",
        "provider-a"
      ],
      "url": "https://openapi.okx.com/api/v5/public/time",
      "interval": "3s",
      "tolerance": 65535,
      "idle_timeout": "10m",
      "interrupt_exist_connections": true
    }
  ],
  "route": {
    "rules": [
      {
        "domain": "openapi.okx.com",
        "port": 443,
        "action": "route",
        "outbound": "finance-okx-auto"
      },
      {
        "action": "reject"
      }
    ]
  },
  "services": [
    {
      "type": "api",
      "tag": "local-api",
      "listen": "127.0.0.1",
      "listen_port": 19289
    }
  ]
}
