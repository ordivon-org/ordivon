[Unit]
Description=Network v2 Browserless production DNS
Requires=network-v2-browserless-wireguard.service
After=network-v2-browserless-wireguard.service
BindsTo=network-v2-browserless-wireguard.service
PartOf=network-v2-browserless.target

[Service]
Type=simple
NetworkNamespacePath=/run/netns/nv2-browserless-prod
ExecStart=/usr/bin/dnsproxy -l 127.0.0.1 -p 53 -u https://1.1.1.1/dns-query -u https://8.8.8.8/dns-query -f 162.252.172.57:53 -f 149.154.159.92:53 --upstream-mode parallel --cache --pending-requests-enabled --refuse-any --timeout 5s
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
